    - id: chapter01.node.12.help
      speakerId: ford_woman
      text:
      textBlocks:
      - blockId: chapter01.node.12.help_main
        kind: 0
        speakerIdOverride:
        text: "\u0420\u0430\u0431\u043E\u0442\u0430 \u043F\u0440\u043E\u0441\u0442\u0430\u044F: \u043F\u0435\u0440\u0435\u0445\u0432\u0430\u0442\u0438\u0442\u044C \u043A\u0440\u0430\u0439 \u0441\u0435\u0442\u0438, \u043F\u043E\u0434\u0435\u0440\u0436\u0430\u0442\u044C \u0448\u0435\u0441\u0442
          \u043F\u0440\u043E\u0442\u0438\u0432 \u0442\u0435\u0447\u0435\u043D\u0438\u044F, \u043F\u0435\u0440\u0435\u043D\u0435\u0441\u0442\u0438 \u0432\u044F\u0437\u0430\u043D\u043A\u0443 \u043D\u0430 \u0441\u0443\u0445\u043E\u0435. \u041D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u043C\u0438\u043D\u0443\u0442 \u2014
          \u0438 \u0434\u0435\u043B\u043E \u0441\u0434\u0435\u043B\u0430\u043D\u043E. \u0416\u0435\u043D\u0449\u0438\u043D\u0430 \u043D\u0435 \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u0438\u0442 \u0434\u043E\u043B\u0433\u043E, \u043D\u043E \u0438 \u043D\u0435
          \u043E\u0442\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F, \u043A\u0430\u043A \u0440\u0430\u043D\u044C\u0448\u0435."
        conditions:
          Combinator: 0
          Conditions: []
        hasPassiveCheck: 0
        passiveCheck:
          CheckId:
          Kind: 0
          Quality: 0
          CompetencyId:
          Difficulty: 13
