  profiles:
  - Data:
      Id: settlement.village.road
      Name: "\u0414\u0435\u0440\u0435\u0432\u043D\u044F \u0443 \u0434\u043E\u0440\u043E\u0433\u0438"
      Kind: 0
      ShortDescription: "\u0414\u0435\u0441\u044F\u0442\u043E\u043A \u0434\u0432\u043E\u0440\u043E\u0432
        \u0437\u0430 \u043F\u043B\u0435\u0442\u043D\u0451\u043C, \u043A\u043E\u043B\u043E\u0434\u0435\u0446
        \u0441 \u0436\u0443\u0440\u0430\u0432\u043B\u0451\u043C, \u0443 \u043E\u043A\u043E\u043B\u0438\u0446\u044B
        \u2014 \u0438\u0437\u0431\u0430 \u0434\u043B\u044F \u043F\u0440\u043E\u0435\u0437\u0436\u0438\u0445.
        \u0421\u043E\u0431\u0430\u043A\u0438 \u043B\u0430\u044E\u0442 \u0431\u043E\u043B\u044C\u0448\u0435
        \u0434\u043B\u044F \u043F\u043E\u0440\u044F\u0434\u043A\u0430."
      LongDescription: "\u0414\u0435\u0440\u0435\u0432\u043D\u044F \u0436\u0438\u0432\u0451\u0442
        \u0441 \u0434\u043E\u0440\u043E\u0433\u0438: \u043F\u0440\u043E\u0435\u0437\u0436\u0438\u043C
        \u043F\u0440\u043E\u0434\u0430\u044E\u0442 \u0449\u0438, \u0441\u0435\u043D\u043E
        \u0438 \u0441\u043E\u0432\u0435\u0442\u044B, \u043F\u0440\u0438\u0447\u0451\u043C
        \u0441\u043E\u0432\u0435\u0442\u044B \u0434\u043E\u0440\u043E\u0436\u0435
        \u0432\u0441\u0435\u0433\u043E."
      Tags:
      - "\u0434\u0435\u0440\u0435\u0432\u043D\u044F"
      - "\u0434\u043E\u0440\u043E\u0433\u0430"
      Variants:
      - Id: village.wolf_gone
        Priority: 10
        Conditions:
          Combinator: 0
          Conditions:
          - Type: 0
            StringParam: freeplay.coal.leader_killed
            QualityParam: 0
            IntParam: 0
            Negate: 0
        Description: "\u0412\u043E\u0437\u0447\u0438\u043A\u0438 \u0441\u043D\u043E\u0432\u0430
          \u043D\u043E\u0447\u0443\u044E\u0442 \u0443 \u043E\u043A\u043E\u043B\u0438\u0446\u044B,
          \u0438 \u0441\u043E\u0431\u0430\u043A\u0438 \u043B\u0430\u044E\u0442 \u0443\u0436\u0435
          \u043D\u0435 \u043D\u0430 \u043B\u0435\u0441, \u0430 \u043D\u0430 \u043D\u0438\u0445."
      People:
      - Id: village_elder
        SpeakerId: village_elder
        DisplayName: "\u0412\u044B\u0448\u0430\u0442\u0430"
        Role: "\u0441\u0442\u0430\u0440\u043E\u0441\u0442\u0430"
        Activity: "\u0427\u0438\u043D\u0438\u0442 \u0445\u043E\u043C\u0443\u0442
          \u043D\u0430 \u0437\u0430\u0432\u0430\u043B\u0438\u043D\u043A\u0435"
        DialogueId: settlement_village_elder
        MerchantId: 
