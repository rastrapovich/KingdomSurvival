        choiceId: chapter01.node.09.ulyana_continue
        kind: 4
        conditions:
          Combinator: 0
          Conditions: []
        unavailablePresentation: 0
        check:
          CheckId: 
          Kind: 0
          Quality: 0
          CompetencyId: 
          Difficulty: 13
          ModifierRules: []
        successNodeId: 
        failureNodeId: 
        successEffects: []
        failureEffects: []
      editorPosition: {x: 860, y: 0}
      hasEditorPosition: 1
    - id: chapter01.node.09.lada
      speakerId: lada
      text: 
      textBlocks:
      - blockId: chapter01.node.09.lada_main
        kind: 0
        speakerIdOverride: 
        text: "— И рыба. Она проводит пальцем вдоль старого хода воды. — Значит, мы чинили один узел, а изменили что-то большее."
        conditions:
          Combinator: 0
          Conditions: []
        hasPassiveCheck: 0
        passiveCheck:
          CheckId: 
