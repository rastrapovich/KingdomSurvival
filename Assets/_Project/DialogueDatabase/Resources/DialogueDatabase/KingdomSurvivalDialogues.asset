      - blockId: chapter01.node.12_water_wrong
        kind: 1
        speakerIdOverride:
        text: "\u0422\u0430\u043C, \u0433\u0434\u0435 \u0449\u0438\u0442 \u0434\u0435\u0440\u0436\u0438\u0442 \u0432\u043E\u0434\u0443, \u0442\u0435\u0447\u0435\u043D\u0438\u0435 \u0432\u0435\u0434\u0451\u0442 \u0441\u0435\u0431\u044F \u0442\u0438\u0448\u0435, \u0447\u0435\u043C
          \u0434\u043E\u043B\u0436\u043D\u043E \u043F\u0440\u0438 \u0442\u0430\u043A\u043E\u043C \u0443\u0440\u043E\u0432\u043D\u0435 \u2014 \u0442\u0430\u043A \u0436\u0435 \u043D\u0435\u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E, \u043A\u0430\u043A \u0438 \u0432\u0441\u044E\u0434\u0443
          \u0432 \u044D\u0442\u0438 \u0434\u043D\u0438, \u0442\u043E\u043B\u044C\u043A\u043E \u0437\u0434\u0435\u0441\u044C \u0437\u0430\u043C\u0435\u0442\u043D\u0435\u0435."
