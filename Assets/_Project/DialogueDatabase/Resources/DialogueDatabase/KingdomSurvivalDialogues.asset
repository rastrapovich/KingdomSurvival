  - id: settlement_town_milana
    title: "12\u0422 \u2014 \u041C\u0438\u043B\u0430\u043D\u0430, \u0436\u0435\u043D\u0430
      \u0441\u0442\u043E\u0440\u043E\u0436\u0430"
    category: 2
    status: 1
    developerComment: "12\u0422 [\u0420\u0410\u0411\u041E\u0427\u0415\u0415][KINGDOM
      SURVIVAL]. \u041F\u043E\u0441\u0435\u0442\u0438\u0442\u0435\u043B\u044C \u043A\u043E\u0440\u0447\u043C\u044B
      \u0443\u043A\u0440\u0435\u043F\u043B\u0451\u043D\u043D\u043E\u0433\u043E \u0433\u043E\u0440\u043E\u0434\u043A\u0430.
      \u041F\u043E\u0440\u0443\u0447\u0435\u043D\u0438\u0435 \xAB\u0412\u0435\u0441\u0442\u044C
      \u0441\u0442\u0430\u0440\u043E\u0441\u0442\u0435\xBB (ErrandId settlement.errand.town_message)
      \u2014 \u0442\u043E \u0436\u0435, \u0447\u0442\u043E \u043D\u0430 \u0434\u043E\u0441\u043A\u0435
      \u0433\u043E\u0440\u043E\u0434\u043A\u0430: \u043F\u0440\u0438\u043D\u044F\u0442\u044C
      (\u0444\u043B\u0430\u0433 settlement.town.message.accepted) \u2192 \u0441\u0442\u0430\u0440\u043E\u0441\u0442\u0430
      \u0434\u0435\u0440\u0435\u0432\u043D\u0438 (\u0444\u043B\u0430\u0433 settlement.town.message.delivered)
      \u2192 \u0432\u0435\u0440\u043D\u0443\u0442\u044C\u0441\u044F \u0437\u0430
      \u043F\u043B\u0430\u0442\u043E\u0439 (settlement.town.message.done). \u0421\u0440\u043E\u043A
      \u043F\u043E\u0440\u0443\u0447\u0435\u043D\u0438\u044F \u2014 \u0432 \u0411\u0430\u0437\u0435
      \u043F\u043E\u0441\u0435\u043B\u0435\u043D\u0438\u0439."
    sceneIllustration: {fileID: 0}
    sceneIllustrationFillFrame: 0
    sceneIllustrationScale: 1
    sceneIllustrationOffsetNormalized: {x: 0, y: 0}
    startNodeId: settlement.milana.start
    tags:
    - "\u043F\u043E\u0441\u0435\u043B\u0435\u043D\u0438\u044F"
    - "12\u0422"
    nodes:
    - id: settlement.milana.start
      speakerId: town_milana
      text: 
      textBlocks:
      - blockId: settlement.milana.start.scene
        kind: 5
        speakerIdOverride: narrator
        text: "\u0416\u0435\u043D\u0449\u0438\u043D\u0430 \u0443 \u043E\u043A\u043D\u0430
          \u0434\u0435\u0440\u0436\u0438\u0442 \u043A\u0440\u0443\u0436\u043A\u0443,
          \u0438\u0437 \u043A\u043E\u0442\u043E\u0440\u043E\u0439 \u043D\u0435 \u043F\u044C\u0451\u0442.
          \u041A\u0440\u0443\u0436\u043A\u0430 \u043D\u0443\u0436\u043D\u0430, \u0447\u0442\u043E\u0431\u044B
          \u043A\u043E\u0440\u0447\u043C\u0430\u0440\u044C \u043D\u0435 \u043F\u0440\u043E\u0433\u043D\u0430\u043B."
        conditions:
          Combinator: 0
          Conditions: []
        hasPassiveCheck: 0
        passiveCheck:
          CheckId: 
          Kind: 0
          Quality: 0
          CompetencyId: 
          Difficulty: 13
          ModifierRules: []
        onRevealEffects: []
      - blockId: settlement.milana.start.ask
        kind: 0
        speakerIdOverride: 
        text: "\u2014 \u0412\u044B \u0436\u0435 \u043D\u0430 \u0434\u043E\u0440\u043E\u0433\u0443?
          \u0412 \u0434\u0435\u0440\u0435\u0432\u043D\u0435 \u0443 \u0434\u043E\u0440\u043E\u0433\u0438
          \u0441\u0442\u0430\u0440\u043E\u0441\u0442\u0430, \u0412\u044B\u0448\u0430\u0442\u0430,
          \u2014 \u043F\u0435\u0440\u0435\u0434\u0430\u0439\u0442\u0435 \u0435\u043C\u0443:
          \u0441\u044B\u043D \u043C\u043E\u0439 \u0436\u0438\u0432, \u043A \u0437\u0438\u043C\u0435
          \u0432\u0435\u0440\u043D\u0451\u0442\u0441\u044F. \u0422\u043E\u043B\u044C\u043A\u043E
          \u043D\u0435 \u043F\u043E\u0437\u0436\u0435 \u0441\u0435\u0434\u043C\u0438\u0446\u044B:
          \u043F\u043E\u0442\u043E\u043C \u0441\u0442\u0430\u0440\u043E\u0441\u0442\u0430
          \u0443\u0439\u0434\u0451\u0442 \u043D\u0430 \u0434\u0430\u043B\u044C\u043D\u0438\u0435
          \u043F\u043E\u043A\u043E\u0441\u044B, \u0438 \u0438\u0449\u0438 \u0435\u0433\u043E
          \u0442\u0430\u043C. \u0417\u0430\u043F\u043B\u0430\u0447\u0443, \u043A\u043E\u0433\u0434\u0430
          \u0432\u0435\u0440\u043D\u0451\u0442\u0435\u0441\u044C, \u2014 \u0434\u0435\u043D\u044C\u0433\u0438
          \u0443 \u043C\u0443\u0436\u0430, \u0430 \u043C\u0443\u0436 \u043D\u0430
          \u0432\u043E\u0440\u043E\u0442\u0430\u0445 \u0434\u043E \u043D\u043E\u0447\u0438."
        conditions:
          Combinator: 0
          Conditions:
          - Type: 0
            StringParam: settlement.town.message.accepted
            QualityParam: 0
            IntParam: 0
            Negate: 1
          - Type: 0
            StringParam: settlement.town.message.done
            QualityParam: 0
            IntParam: 0
            Negate: 1
        hasPassiveCheck: 0
        passiveCheck:
          CheckId: 
          Kind: 0
          Quality: 0
          CompetencyId: 
          Difficulty: 13
          ModifierRules: []
        onRevealEffects: []
      - blockId: settlement.milana.start.wait
        kind: 0
        speakerIdOverride: 
        text: "\u2014 \u041D\u0435 \u0434\u043E\u0448\u043B\u0438 \u0435\u0449\u0451?
          \u0414\u043E\u0440\u043E\u0433\u0430, \u043E\u043D\u0430 \u0442\u0430\u043A\u0430\u044F.
          \u042F \u043F\u043E\u0434\u043E\u0436\u0434\u0443."
