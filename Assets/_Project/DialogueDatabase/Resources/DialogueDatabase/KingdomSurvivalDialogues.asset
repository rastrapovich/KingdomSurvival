          \u0434\u0435\u043D\u044C \u0441\u0438\u0434\u0438\u0442 \u0443 \u043E\u043A\u043D\u0430
          \u0441 \u043E\u0434\u043D\u043E\u0439 \u043A\u0440\u0443\u0436\u043A\u043E\u0439.
          \u0415\u0441\u043B\u0438 \u0438\u0434\u0451\u0442\u0435 \u043A \u0434\u0435\u0440\u0435\u0432\u043D\u0435
          \u0443 \u0434\u043E\u0440\u043E\u0433\u0438 \u2014 \u0441\u043F\u0440\u043E\u0441\u0438\u0442\u0435
          \u0435\u0451, \u043E\u043D\u0430 \u043E\u0431\u0440\u0430\u0434\u0443\u0435\u0442\u0441\u044F."
