    - id: hero_conditions
      speakerId: miller
      text: "\u042D\u0442\u0438 \u043E\u0442\u0432\u0435\u0442\u044B \u0447\u0438\u0442\u0430\u044E\u0442
        \u043F\u0440\u043E\u0444\u0438\u043B\u044C \u0442\u0435\u0441\u0442\u043E\u0432\u043E\u0433\u043E
        \u0433\u0435\u0440\u043E\u044F. \u041F\u043E\u0434\u043D\u0438\u043C\u0438
