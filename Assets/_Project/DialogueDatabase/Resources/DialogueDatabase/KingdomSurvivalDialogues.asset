    - id: man_found
      speakerId: narrator
      text: 
      textBlocks:
      - blockId: b_scene
        kind: 0
        speakerIdOverride: 
        text: "\u041F\u043E\u0434 \u043A\u043E\u0440\u043D\u044F\u043C\u0438 \u043B\u0435\u0436\u0438\u0442
          \u043C\u0443\u0436\u0447\u0438\u043D\u0430. \u041D\u0435 \u0440\u0430\u0437\u0431\u043E\u0439\u043D\u0438\u043A
          \u0432 \u043E\u0447\u0435\u0432\u0438\u0434\u043D\u043E\u0439 \u0444\u043E\u0440\u043C\u0435.
          \u041F\u0440\u043E\u0441\u0442\u043E \u0433\u0440\u044F\u0437\u043D\u044B\u0439,
          \u0438\u0437\u043C\u0443\u0447\u0435\u043D\u043D\u044B\u0439 \u0447\u0435\u043B\u043E\u0432\u0435\u043A.\n\n\u041E\u0434\u0438\u043D
          \u0441\u0430\u043F\u043E\u0433 \u043D\u0430 \u043D\u0451\u043C, \u0432\u0442\u043E\u0440\u043E\u0439
          \u0441\u0442\u043E\u0438\u0442 \u0440\u044F\u0434\u043E\u043C. \u041D\u043E\u0433\u0430
          \u0440\u0430\u0441\u043F\u0443\u0445\u043B\u0430.\n\n\u0420\u044F\u0434\u043E\u043C
          \u2014 \u043D\u043E\u0436, \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E
          \u043A\u0443\u0441\u043A\u043E\u0432 \u043E\u0432\u0435\u0447\u044C\u0435\u0433\u043E
          \u043C\u044F\u0441\u0430, \u0442\u0440\u044F\u043F\u043A\u0430, \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u0438\u0439
          \u0443\u0433\u0430\u0441\u0430\u044E\u0449\u0438\u0439 \u043A\u043E\u0441\u0442\u0451\u0440.\n\n\u041E\u043D
          \u0441\u043C\u043E\u0442\u0440\u0438\u0442 \u0441\u043D\u0430\u0447\u0430\u043B\u0430
