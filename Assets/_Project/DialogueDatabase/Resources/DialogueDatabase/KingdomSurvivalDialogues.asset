    - id: chapter01.node.04.fortitude_success
      speakerId: narrator
      text:
      textBlocks:
      - blockId: chapter01.node.04.fortitude_success_main
        kind: 0
        speakerIdOverride:
        text: "\u0425\u043E\u043B\u043E\u0434 \u0441\u0431\u0438\u0432\u0430\u0435\u0442 \u0434\u044B\u0445\u0430\u043D\u0438\u0435, \u043D\u043E \u0442\u044B \u043E\u0441\u0442\u0430\u0451\u0448\u044C\u0441\u044F \u043D\u0430 \u043C\u0435\u0441\u0442\u0435 \u2014 \u0442\u0430\u043C, \u0433\u0434\u0435 \u0442\u0435\u0447\u0435\u043D\u0438\u0435 \u0441\u0438\u043B\u044C\u043D\u0435\u0435 \u0432\u0441\u0435\u0433\u043E \u2014 \u0438 \u0434\u0435\u0440\u0436\u0438\u0448\u044C \u0431\u0440\u0443\u0441 \u0441\u043E\u0431\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u043C \u0432\u0435\u0441\u043E\u043C, \u043F\u043E\u043A\u0430 \u0432\u043E\u0434\u0430 \u0438\u0449\u0435\u0442 \u0434\u0440\u0443\u0433\u043E\u0439 \u043F\u0443\u0442\u044C. \u0422\u0435\u043B\u043E \u043D\u0430\u0447\u0438\u043D\u0430\u0435\u0442 \u0441\u0434\u0430\u0432\u0430\u0442\u044C, \u043D\u043E \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u043C\u0433\u043D\u043E\u0432\u0435\u043D\u0438\u0439 \u0443\u0436\u0435 \u0442\u0432\u043E\u0438. \u0421\u043F\u0430\u0441\u0442\u0438 \u0432\u0441\u0451 \u044D\u0442\u0438\u043C \u043D\u0435 \u0443\u0434\u0430\u0441\u0442\u0441\u044F."
        conditions:
          Combinator: 0
          Conditions: []
        hasPassiveCheck: 0
        passiveCheck:
          CheckId:
          Kind: 0
          Quality: 0
          CompetencyId:
          Difficulty: 13
