/* Stable army portrait layout. Loaded once at runtime after the base shell USS. */

.shell-main-row {
    margin-bottom: 5px;
}

.shell-bottom-bar {
    height: 42px;
    min-height: 42px;
    max-height: 42px;
}

.shell-navigation-bar {
    padding-top: 2px;
    padding-bottom: 2px;
}

.shell-nav-button {
    font-size: 11px;
    padding-top: 1px;
    padding-bottom: 1px;
}

.shell-resource-bar {
    padding-left: 8px;
    padding-right: 6px;
}

.shell-resource-box {
    height: 32px;
    min-height: 32px;
    max-height: 32px;
    margin-right: 5px;
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 2px;
    padding-bottom: 2px;
}

.shell-resource-box .resource-income {
    margin-top: 0px;
    font-size: 8px;
}

.shell-resource-box .food-expense-popup {
    bottom: 36px;
}

.shell-time-toggle-button {
    height: 32px;
    min-height: 32px;
    max-height: 32px;
    margin-left: 6px;
    border-radius: 5px;
    font-size: 12px;
}

.incident-notification-stack {
    bottom: 68px;
}
