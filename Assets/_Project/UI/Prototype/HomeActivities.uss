/* ================================================================
   ДЕЛА В ДОМЕ (ПР-02) — сцены первой главы, которые игрок открывает
   сам: человек и место. Карточка — шаблон HomeActivityCard.uxml.
   ================================================================ */

.home-activities-panel {
    margin-bottom: 18px;
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 10px;
    padding-bottom: 10px;
    background-color: rgb(34, 38, 45);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(79, 72, 63);
    border-right-color: rgb(79, 72, 63);
    border-top-color: rgb(79, 72, 63);
    border-bottom-color: rgb(79, 72, 63);
}

.home-activities-list {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: stretch;
}

.home-activities-empty {
    font-size: 12px;
    opacity: 0.6;
    white-space: normal;
}

.home-activity-card {
    width: 31.5%;
    min-width: 200px;
    margin-left: 0;
    margin-right: 8px;
    margin-top: 0;
    margin-bottom: 8px;
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 10px;
    padding-bottom: 10px;
    align-items: flex-start;
    -unity-text-align: upper-left;
}

.home-activity-urgent {
    display: none;
    font-size: 10px;
    -unity-font-style: bold;
    color: rgb(214, 128, 92);
    margin-bottom: 4px;
}

.home-activity-card--urgent .home-activity-urgent {
    display: flex;
}

.home-activity-card--urgent {
    border-left-color: rgb(214, 128, 92);
    border-left-width: 3px;
}

.home-activity-title {
    -unity-font-style: bold;
    font-size: 15px;
    white-space: normal;
    color: rgb(226, 214, 186);
}

.home-activity-where {
    margin-top: 4px;
    font-size: 11px;
    white-space: normal;
    color: rgb(193, 183, 158);
}
