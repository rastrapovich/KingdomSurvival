      - blockId: cave.crack.ruse_fail.text
        kind: 5
        speakerIdOverride: 
        text: "\u0412\u043E\u043B\u043A\u0438 \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u044E\u0442\u0441\u044F
          \u2014 \u0438 \u0438\u0434\u0443\u0442 \u043D\u0435 \u0437\u0430 \u0432\u0430\u043C\u0438,
          \u0430 \u0433\u043B\u0443\u0431\u0436\u0435, \u043A \u0441\u0440\u0435\u0434\u043D\u0435\u043C\u0443
          \u0437\u0430\u043B\u0443, \u0431\u0443\u0434\u0442\u043E \u0437\u043D\u0430\u044E\u0442,
          \u0433\u0434\u0435 \u0443 \u043D\u0438\u0445 \u0435\u0434\u0430. \u0421\u0442\u0443\u043A
          \u0437\u0430 \u0441\u043A\u0430\u043B\u043E\u0439 \u0443\u0447\u0430\u0449\u0430\u0435\u0442\u0441\u044F."
