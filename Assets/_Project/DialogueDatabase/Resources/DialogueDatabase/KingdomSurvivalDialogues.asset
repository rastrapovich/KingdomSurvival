    - id: chapter01.node.13.success
      speakerId: downstream_voice
      text:
      textBlocks:
      - blockId: chapter01.node.13.success_main
        kind: 0
        speakerIdOverride:
        text: "\u041E\u043D \u0432\u044B\u0434\u044B\u0445\u0430\u0435\u0442 \u0438 \u0441\u0430\u0434\u0438\u0442\u0441\u044F \u043D\u0430 \u043F\u0435\u0440\u0435\u0432\u0451\u0440\u043D\u0443\u0442\u0443\u044E \u0431\u043E\u0447\u043A\u0443 \u2014 \u0432\u043F\u0435\u0440\u0432\u044B\u0435 \u043D\u0435
          \u043A\u0430\u043A \u043F\u0435\u0440\u0435\u0434 \u0447\u0443\u0436\u0430\u043A\u043E\u043C. \u2014 \u0417\u043D\u0430\u0447\u0438\u0442, \u0432\u0441\u0451-\u0442\u0430\u043A\u0438 \u043D\u0435 \u0437\u0430 \u0442\u0435\u043C, \u0447\u0442\u043E\u0431\u044B
          \u043F\u043E\u0441\u0447\u0438\u0442\u0430\u0442\u044C, \u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0441 \u043D\u0430\u0441 \u0432\u0437\u044F\u0442\u044C. \u041B\u0430\u0434\u043D\u043E. \u0421\u043F\u0440\u0430\u0448\u0438\u0432\u0430\u0439 \u043F\u0440\u044F\u043C\u043E, \u044F
          \u043E\u0442\u0432\u0435\u0447\u0443 \u043F\u0440\u044F\u043C\u043E."
