        \u2014 \u0433\u0435\u0440\u043E\u0439 \u0434\u043E\u043B\u0436\u0435\u043D
        \u043E\u0441\u0442\u0430\u0442\u044C\u0441\u044F \u0443 \u0414\u043E\u043C\u0430,
        ActiveExpedition \u043E\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0443\u0435\u0442"
      - "\u041A\u043B\u0438\u043A\u043D\u0443\u0442\u044C \xAB\u0421\u043B\u0435\u0434
        \u0441\u0442\u0430\u0440\u043E\u0433\u043E \u0440\u0443\u0441\u043B\u0430\xBB
        \u043D\u0430 \u043A\u0430\u0440\u0442\u0435 \u2014 \u0442\u043E\u043B\u044C\u043A\u043E
        \u0442\u043E\u0433\u0434\u0430 \u043F\u043E\u044F\u0432\u043B\u044F\u044E\u0442\u0441\u044F
        ActiveExpedition \u0438 chapter01.flag.expedition_started"
