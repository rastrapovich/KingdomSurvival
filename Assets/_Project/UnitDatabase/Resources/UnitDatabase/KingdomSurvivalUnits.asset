  tags:
  - id: species.human
    displayLabel: "\u0427\u0435\u043B\u043E\u0432\u0435\u043A"
    category: "\u041F\u0440\u043E\u0438\u0441\u0445\u043E\u0436\u0434\u0435\u043D\u0438\u0435"
    color: {r: 0.72, g: 0.61, b: 0.42, a: 1}
    description: "\u0427\u0435\u043B\u043E\u0432\u0435\u043A \u0440\u0430\u0437\u0443\u043C\u043D\u044B\u0439."
  - id: species.beast
    displayLabel: "\u0417\u0432\u0435\u0440\u044C"
    category: "\u041F\u0440\u043E\u0438\u0441\u0445\u043E\u0436\u0434\u0435\u043D\u0438\u0435"
    color: {r: 0.62, g: 0.27, b: 0.2, a: 1}
    description: "\u041F\u043E\u0440\u043E\u0436\u0434\u0435\u043D\u0438\u0435 \u0434\u0438\u043A\u043E\u0439
      \u0447\u0430\u0449\u0438, \u043F\u0440\u0438\u0432\u044B\u043A\u0448\u0435\u0435
      \u0440\u0435\u0448\u0430\u0442\u044C \u0441\u043F\u043E\u0440\u044B \u043A\u043B\u044B\u043A\u0430\u043C\u0438
      \u0438 \u043A\u043E\u0433\u0442\u044F\u043C\u0438."
  - id: combat.ranged
    displayLabel: "\u0414\u0430\u043B\u044C\u043D\u0438\u0439 \u0431\u043E\u0439"
    category: "\u0422\u0438\u043F \u0430\u0442\u0430\u043A\u0438"
    color: {r: 0.28, g: 0.53, b: 0.66, a: 1}
    description: "\u041C\u043E\u0436\u0435\u0442 \u0430\u0442\u0430\u043A\u043E\u0432\u0430\u0442\u044C
      \u043D\u0430 \u0440\u0430\u0441\u0441\u0442\u043E\u044F\u043D\u0438\u0438.
      \u041F\u0440\u0438 \u0430\u0442\u0430\u043A\u0435 \u0446\u0435\u043B\u0438
      \u043D\u0430 \u0441\u043E\u0441\u0435\u0434\u043D\u0435\u043C \u0433\u0435\u043A\u0441\u0435
      \u0410\u0442\u0430\u043A\u0430 \u0441\u043D\u0438\u0436\u0430\u0435\u0442\u0441\u044F
      \u043D\u0430 50%."
  - id: role.defender
    displayLabel: "\u0417\u0430\u0449\u0438\u0442\u043D\u0438\u043A"
    category: "\u0420\u043E\u043B\u044C"
    color: {r: 0.35, g: 0.49, b: 0.62, a: 1}
    description: "\u041B\u0443\u0447\u0448\u0435 \u0434\u0440\u0443\u0433\u0438\u0445 \u0443\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0435\u0442 \u043F\u043E\u0437\u0438\u0446\u0438\u044E \u043F\u043E\u0434 \u043D\u0430\u0442\u0438\u0441\u043A\u043E\u043C \u0432\u0440\u0430\u0433\u0430. \u0417\u0430\u0449\u0438\u0442\u043D\u0430\u044F \u0441\u0442\u043E\u0439\u043A\u0430 \u2014 \u043E\u0431\u0449\u0430\u044F: +50% \u043A \u0417\u0430\u0449\u0438\u0442\u0435 (\u043E\u0442\u0434\u0435\u043B\u044C\u043D\u044B\u0439 \u0431\u043E\u043D\u0443\u0441 \u0417\u0430\u0449\u0438\u0442\u043D\u0438\u043A\u0430 \u0443\u0431\u0440\u0430\u043D 03.09.2026)."
  - id: trait.armored
    displayLabel: "\u0411\u0440\u043E\u043D\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u0439"
    category: "\u041E\u0441\u043E\u0431\u0435\u043D\u043D\u043E\u0441\u0442\u044C"
    color: {r: 0.49, g: 0.51, b: 0.53, a: 1}
    description: "\u0422\u044F\u0436\u0451\u043B\u0430\u044F \u0437\u0430\u0449\u0438\u0442\u0430
      \u043F\u0440\u0438\u043D\u0438\u043C\u0430\u0435\u0442 \u0447\u0430\u0441\u0442\u044C
      \u0443\u0434\u0430\u0440\u0430 \u043D\u0430 \u0441\u0435\u0431\u044F. \u041F\u043E\u0441\u0442\u043E\u044F\u043D\u043D\u043E
      \u0434\u0430\u0451\u0442 +2 \u043A \u0417\u0430\u0449\u0438\u0442\u0435."
  - id: trait.beast_slayer
    displayLabel: "\u0413\u0440\u043E\u0437\u0430 \u0437\u0432\u0435\u0440\u0435\u0439"
    category: "\u041E\u0441\u043E\u0431\u0435\u043D\u043D\u043E\u0441\u0442\u044C"
    color: {r: 0.68, g: 0.45, b: 0.22, a: 1}
    description: "\u0417\u043D\u0430\u0435\u0442, \u043A\u0443\u0434\u0430 \u0431\u0438\u0442\u044C
      \u0442\u0432\u0430\u0440\u044C, \u0447\u0442\u043E\u0431\u044B \u043E\u043D\u0430
      \u0431\u043E\u043B\u044C\u0448\u0435 \u043D\u0435 \u043F\u043E\u0434\u043D\u044F\u043B\u0430\u0441\u044C.
      \u0410\u0442\u0430\u043A\u0430 \u043F\u0440\u043E\u0442\u0438\u0432 \u0441\u0443\u0449\u0435\u0441\u0442\u0432
      \u0441 \u0442\u0435\u0433\u043E\u043C \xAB\u0417\u0432\u0435\u0440\u044C\xBB
      \u0443\u0432\u0435\u043B\u0438\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \u043D\u0430 50%."
  - id: trait.human_slayer
    displayLabel: "\u0413\u0440\u043E\u0437\u0430 \u043B\u044E\u0434\u0435\u0439"
    category: "\u041E\u0441\u043E\u0431\u0435\u043D\u043D\u043E\u0441\u0442\u044C"
    color: {r: 0.62, g: 0.22, b: 0.19, a: 1}
    description: "\u0421\u043B\u0438\u0448\u043A\u043E\u043C \u0445\u043E\u0440\u043E\u0448\u043E
      \u0437\u043D\u0430\u0435\u0442 \u0432\u043A\u0443\u0441 \u0447\u0435\u043B\u043E\u0432\u0435\u0447\u0435\u0441\u043A\u043E\u0439
      \u043A\u0440\u043E\u0432\u0438. \u0410\u0442\u0430\u043A\u0430 \u043F\u0440\u043E\u0442\u0438\u0432
      \u0441\u0443\u0449\u0435\u0441\u0442\u0432 \u0441 \u0442\u0435\u0433\u043E\u043C
      \xAB\u0427\u0435\u043B\u043E\u0432\u0435\u043A\xBB \u0443\u0432\u0435\u043B\u0438\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \u043D\u0430 50%."
