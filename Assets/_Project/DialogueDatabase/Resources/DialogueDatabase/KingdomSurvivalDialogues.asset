        text: "\u2014 \u0418 \u0435\u0449\u0451 \u043E\u0434\u043D\u043E. \u041E\u043D\u0430
          \u0437\u0430\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0435\u0442 \u0442\u0435\u0431\u044F
          \u0443 \u0434\u0432\u0435\u0440\u0438. \u2014 \u0415\u0441\u043B\u0438
          \u0432\u0441\u0442\u0440\u0435\u0442\u0438\u0448\u044C \u043A\u043E\u0433\u043E-\u043D\u0438\u0431\u0443\u0434\u044C,
          \u043A\u0442\u043E \u0437\u043D\u0430\u0435\u0442 \u0441\u0442\u0430\u0440\u044B\u0435
          \u0440\u0430\u0431\u043E\u0442\u044B \u0443 \u0432\u043E\u0434\u044B, \u0441\u043F\u0440\u043E\u0441\u0438
          \u043F\u0440\u043E \u0432\u0442\u043E\u0440\u043E\u0439 \u0445\u043B\u0435\u0431.
          \u041C\u044B \u043F\u043E\u043C\u043D\u0438\u043C, \u0447\u0442\u043E \u0435\u0433\u043E
          \u043D\u0435\u0441\u043B\u0438. \u041A\u043E\u043C\u0443 \u2014 \u0443\u0436\u0435
          \u043D\u0435\u0442."
