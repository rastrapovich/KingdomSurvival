      textBlocks:
      - blockId: chapter01.node.13.failure_main
        kind: 0
        speakerIdOverride:
        text: "\u041E\u043D \u043D\u0435 \u043E\u0442\u0441\u0442\u0443\u043F\u0430\u0435\u0442, \u043D\u043E \u0438 \u043D\u0435 \u043F\u043E\u0434\u0445\u043E\u0434\u0438\u0442 \u0431\u043B\u0438\u0436\u0435. \u2014 \u0420\u0430\u0437 \u043F\u0440\u0438\u0448\u043B\u0438 \u2014
          \u0437\u043D\u0430\u0447\u0438\u0442, \u0447\u0442\u043E-\u0442\u043E \u043D\u0443\u0436\u043D\u043E. \u0421\u043F\u0435\u0440\u0432\u0430 \u0434\u043E\u043A\u0430\u0436\u0438\u0442\u0435, \u0447\u0442\u043E \u043F\u0440\u0438\u0448\u043B\u0438 \u043D\u0435 \u0432
          \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0439 \u0440\u0430\u0437 \u0437\u0430\u0431\u0440\u0430\u0442\u044C, \u0430 \u0445\u043E\u0442\u044C \u0440\u0430\u0437 \u2014 \u0432\u0435\u0440\u043D\u0443\u0442\u044C. \u2014 \u0411\u043E\u043B\u044C\u0448\u0435 \u043E\u043D \u0432
