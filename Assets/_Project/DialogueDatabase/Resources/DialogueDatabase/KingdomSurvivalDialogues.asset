        kind: 0
        speakerIdOverride: 
        text: "\u041A\u043E\u0433\u0434\u0430 \u0441\u043D\u0438\u043C\u0430\u0435\u0448\u044C
          \u0441\u0430\u043F\u043E\u0433, \u0438\u0437 \u0448\u0432\u0430 \u0432\u044B\u043F\u0430\u0434\u0430\u0435\u0442
          \u0440\u0430\u0437\u0431\u0443\u0445\u0448\u0435\u0435 \u0437\u0435\u0440\u043D\u043E.\n\n\u041D\u0430
          \u0434\u043E\u0440\u043E\u0433\u0435 \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430
          \u0443\u0441\u043F\u0435\u043B\u0438 \u0432\u044B\u0442\u0430\u0449\u0438\u0442\u044C.
          \u041C\u0435\u0448\u043A\u0438 \u2014 \u043D\u0435\u0442.\n\n\u041E\u0434\u043D\u043E
          \u0437\u0435\u0440\u043D\u043E \u043C\u043E\u0436\u043D\u043E \u0431\u0440\u043E\u0441\u0438\u0442\u044C
          \u0432 \u043E\u0433\u043E\u043D\u044C. \u041E\u043D\u043E \u043B\u043E\u043F\u0430\u0435\u0442\u0441\u044F
          \u043F\u043E\u0447\u0442\u0438 \u0441\u0440\u0430\u0437\u0443.\n\n\u041E\u0441\u0442\u0430\u043B\u044C\u043D\u043E\u0435
          \u043A\u0442\u043E-\u043D\u0438\u0431\u0443\u0434\u044C \u0431\u0443\u0434\u0435\u0442
          \u0441\u0447\u0438\u0442\u0430\u0442\u044C \u0432\u0435\u0441\u043D\u043E\u0439."
