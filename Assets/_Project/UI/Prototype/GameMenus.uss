/* ================================================================
   ГЛАВНОЕ МЕНЮ, ПАУЗА, НАСТРОЙКИ (ПР-01)
   Полноэкранные слои поверх всего интерфейса. Показ — через класс
   game-menu-overlay--open (PrototypeUIController.GameMenus.cs).
   ================================================================ */

.game-menu-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    display: none;
    align-items: center;
    justify-content: center;
    background-color: rgba(8, 10, 13, 0.82);
}

.game-menu-overlay--open {
    display: flex;
}

.main-menu-overlay {
    background-color: rgb(12, 14, 18);
}

.game-menu-panel {
    width: 420px;
    padding-left: 28px;
    padding-right: 28px;
    padding-top: 24px;
    padding-bottom: 24px;
    background-color: rgb(28, 31, 37);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(79, 72, 63);
    border-right-color: rgb(79, 72, 63);
    border-top-color: rgb(79, 72, 63);
    border-bottom-color: rgb(79, 72, 63);
}

.main-menu-title {
    font-size: 34px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(226, 214, 186);
}

.main-menu-subtitle {
    font-size: 14px;
    -unity-text-align: middle-center;
    color: rgb(193, 183, 158);
    margin-bottom: 20px;
}

.game-menu-title {
    font-size: 20px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(226, 214, 186);
    margin-bottom: 16px;
}

.game-menu-button {
    height: 40px;
    margin-left: 0;
    margin-right: 0;
    margin-top: 6px;
    margin-bottom: 0;
    font-size: 15px;
}

.game-menu-button-small {
    flex-grow: 1;
    height: 32px;
    font-size: 13px;
    margin-right: 6px;
}

.game-menu-hint {
    font-size: 11px;
    white-space: normal;
    color: rgb(150, 143, 126);
    margin-top: 2px;
}

.game-menu-message {
    font-size: 12px;
    white-space: normal;
    color: rgb(214, 128, 92);
    margin-top: 12px;
    -unity-text-align: middle-center;
}

.game-menu-confirm {
    display: none;
    margin-top: 4px;
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 6px;
    padding-bottom: 8px;
    background-color: rgb(40, 34, 30);
}

.game-menu-confirm--open {
    display: flex;
}

.game-menu-confirm-row {
    flex-direction: row;
    margin-top: 4px;
}

.game-menu-setting {
    margin-top: 8px;
    margin-bottom: 8px;
}

/* ПР-04: выбор слота сохранения */

.saves-list {
    margin-bottom: 4px;
}

.save-slot-row {
    margin-left: 0;
    margin-right: 0;
    margin-top: 6px;
    margin-bottom: 0;
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 8px;
    padding-bottom: 8px;
    align-items: flex-start;
}

.save-slot-title {
    font-size: 15px;
    -unity-font-style: bold;
    color: rgb(226, 214, 186);
}

.save-slot-description {
    font-size: 12px;
    margin-top: 2px;
    color: rgb(193, 183, 158);
    white-space: normal;
}

/* Кнопки меню и строки слотов: тёмная подложка в тон панели вместо
   светлой стандартной — светлый текст читается. */

.game-menu-button,
.save-slot-row {
    background-color: rgb(44, 40, 34);
    color: rgb(226, 214, 186);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(96, 84, 64);
    border-right-color: rgb(96, 84, 64);
    border-top-color: rgb(96, 84, 64);
    border-bottom-color: rgb(96, 84, 64);
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    border-bottom-left-radius: 3px;
    border-bottom-right-radius: 3px;
}

.game-menu-button:hover,
.save-slot-row:hover {
    background-color: rgb(66, 57, 42);
    border-left-color: rgb(176, 146, 92);
    border-right-color: rgb(176, 146, 92);
    border-top-color: rgb(176, 146, 92);
    border-bottom-color: rgb(176, 146, 92);
}

.game-menu-button:active,
.save-slot-row:active {
    background-color: rgb(84, 70, 48);
}

.game-menu-button:disabled,
.save-slot-row:disabled {
    background-color: rgb(34, 33, 31);
    color: rgb(110, 104, 94);
    border-left-color: rgb(58, 54, 48);
    border-right-color: rgb(58, 54, 48);
    border-top-color: rgb(58, 54, 48);
    border-bottom-color: rgb(58, 54, 48);
}

/* ПР-05: итог перед стартом новой кампании */

.new-game-panel {
    width: 520px;
}

.new-game-section {
    margin-top: 12px;
    font-size: 11px;
    -unity-font-style: bold;
    color: rgb(150, 143, 126);
}

.new-game-option-title {
    margin-top: 2px;
    font-size: 17px;
    -unity-font-style: bold;
    color: rgb(226, 214, 186);
}

.new-game-option-summary {
    margin-top: 2px;
    font-size: 13px;
    white-space: normal;
    color: rgb(193, 183, 158);
}

.new-game-reminder {
    margin-top: 14px;
    margin-bottom: 4px;
}

/* ПР-12А: выбор режима новой кампании. */
.new-game-mode-row {
    flex-direction: row;
    margin-bottom: 6px;
}

.new-game-mode-button {
    flex-grow: 1;
    margin-right: 6px;
    opacity: 0.6;
}

.new-game-mode-selected {
    opacity: 1;
    border-bottom-width: 2px;
    border-bottom-color: rgb(214, 178, 110);
}
