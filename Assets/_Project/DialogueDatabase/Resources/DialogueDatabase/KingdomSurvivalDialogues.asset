  - id: chapter01_dialogue_01_ordinary_morning
    title: "N01 \u2014 \u041E\u0431\u044B\u0447\u043D\u043E\u0435 \u0443\u0442\u0440\u043E
      / \u041B\u0438\u0448\u043D\u0438\u0439 \u0445\u043B\u0435\u0431"
    category: 1
    status: 1
    developerComment: "P04-T05 production-\u0442\u0435\u043A\u0441\u0442. \u0423\u043B\u044C\u044F\u043D\u0430
      \u0438 \u0432\u0442\u043E\u0440\u043E\u0439 \u0445\u043B\u0435\u0431 \u0431\u0435\u0437
      \u043E\u0431\u044A\u044F\u0441\u043D\u044F\u044E\u0449\u0435\u0439 \u043B\u0435\u043A\u0446\u0438\u0438;
      \u043A\u043E\u0440\u043E\u0442\u043A\u0438\u0439 \u043C\u043E\u043C\u0435\u043D\u0442
      \u0441 \u041E\u0441\u0442\u0430\u0444\u0438\u0435\u043C; \u041B\u0430\u0434\u0430
      \u043F\u043E\u043A\u0430\u0437\u0430\u043D\u0430 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435\u043C;
      \u043C\u0435\u043B\u044C\u043D\u0438\u0446\u0430 \u041C\u0438\u0440\u043E\u043D\u0430
      \u2014 \u0447\u0430\u0441\u0442\u044C \u0444\u043E\u043D\u0430. \u041F\u0430\u0441\u0441\u0438\u0432\u043D\u043E\u0435
      \u0421\u0443\u0436\u0434\u0435\u043D\u0438\u0435 11 \u2014 \u043D\u0435\u043E\u0431\u044F\u0437\u0430\u0442\u0435\u043B\u044C\u043D\u043E\u0435
      \u0440\u0430\u043D\u043D\u0435\u0435 \u043D\u0430\u0431\u043B\u044E\u0434\u0435\u043D\u0438\u0435
      (\u043D\u0435 \u043B\u0435\u043A\u0446\u0438\u044F, \u0442\u0438\u0445\u043E\u0435
      \u0443\u043C\u043E\u0437\u0430\u043A\u043B\u044E\u0447\u0435\u043D\u0438\u0435
      \u0433\u0435\u0440\u043E\u044F)."
    startNodeId: chapter01.node.01
    tags:
    - "\u0433\u043B\u0430\u0432\u043001"
    - production
    nodes:
    - id: chapter01.node.01
      speakerId: ulyana
      text: 
      textBlocks:
      - blockId: chapter01.node.01_main
        kind: 0
        speakerIdOverride: 
        text: "\u0423\u043B\u044C\u044F\u043D\u0430 \u0432\u044B\u043D\u0438\u043C\u0430\u0435\u0442
          \u0438\u0437 \u043F\u0435\u0447\u0438 \u0432\u0442\u043E\u0440\u043E\u0439
          \u043A\u0430\u0440\u0430\u0432\u0430\u0439 \u2014 \u0441\u0432\u0435\u0440\u0445
          \u043E\u0431\u044B\u0447\u043D\u043E\u0439 \u043D\u043E\u0440\u043C\u044B
          \u2014 \u0438 \u0437\u0430\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u0435\u0442
          \u0435\u0433\u043E \u0432 \u0445\u043E\u043B\u0441\u0442\u0438\u043D\u0443.
          \xAB\u041E\u0442\u043D\u0435\u0441\u0438 \u043A \u0441\u0435\u0434\u044C\u043C\u043E\u043C\u0443
          \u0437\u0430\u0442\u0432\u043E\u0440\u0443, \u043A\u0430\u043A \u0432\u0441\u0435\u0433\u0434\u0430\xBB,
          \u2014 \u0433\u043E\u0432\u043E\u0440\u0438\u0442 \u043E\u043D\u0430, \u043D\u0435
          \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u044F \u0433\u043B\u0430\u0437
          \u043E\u0442 \u0442\u0435\u0441\u0442\u0430."
