  - id: chapter01_dialogue_14_agreement_revealed
    title: "N14 \u2014 \u0420\u0430\u0441\u043A\u0440\u044B\u0442\u0438\u0435 \u0441\u043E\u0433\u043B\u0430\u0448\u0435\u043D\u0438\u044F"
    category: 1
    status: 1
    developerComment: "\u0427\u0435\u0440\u043D\u043E\u0432\u043E\u0439 \u0443\u0437\u0435\u043B
      P03 (\u0435\u0434\u0438\u043D\u0430\u044F \u0438\u043D\u0441\u0442\u0440\u0443\u043A\u0446\u0438\u044F
      \xA78/\xA79): \u043D\u0435 \u043F\u043E\u043B\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u0439
      \u0442\u0435\u043A\u0441\u0442, \u0442\u043E\u043B\u044C\u043A\u043E \u043A\u0430\u0440\u043A\u0430\u0441
      \u043F\u0435\u0440\u0435\u0445\u043E\u0434\u043E\u0432 \u0438 \u0444\u043B\u0430\u0433\u043E\u0432."
    startNodeId: chapter01.node.14
    tags:
    - "\u0433\u043B\u0430\u0432\u043001"
    - "\u0447\u0435\u0440\u043D\u043E\u0432\u0438\u043A"
    nodes:
    - id: chapter01.node.14
      speakerId: narrator
      text: 
      textBlocks:
      - blockId: chapter01.node.14_main
        kind: 0
        speakerIdOverride: 
        text: "\u0412\u0435\u0449\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0439
          \u0441\u043B\u0435\u0434, \u0441\u043B\u043E\u0432\u0430 \u043C\u0435\u043B\u044C\u043D\u0438\u043A\u0430
          \u0438 \u043B\u044E\u0434\u0435\u0439 \u0437\u0430 \u0431\u0440\u043E\u0434\u043E\u043C
          \u0441\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u044E\u0442\u0441\u044F
          \u0432 \u043E\u0434\u043D\u0443 \u043F\u0440\u0438\u0447\u0438\u043D\u043D\u0443\u044E
          \u043A\u0430\u0440\u0442\u0438\u043D\u0443: \u0432\u043E\u0434\u043D\u0430\u044F
          \u0441\u0438\u0441\u0442\u0435\u043C\u0430 \u0414\u043E\u043C\u0430 \u043D\u0438\u043A\u043E\u0433\u0434\u0430
          \u043D\u0435 \u0431\u044B\u043B\u0430 \u0442\u043E\u043B\u044C\u043A\u043E
          \u0435\u0433\u043E \u0441\u043E\u0431\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0439
          \u2014 \u0435\u0439 \u0432\u043C\u0435\u0441\u0442\u0435 \u0432\u043B\u0430\u0434\u0435\u043B\u0438
          \u0438 \u0432\u043C\u0435\u0441\u0442\u0435 \u0437\u0430 \u043D\u0435\u0439
          \u0441\u043B\u0435\u0434\u0438\u043B\u0438."
