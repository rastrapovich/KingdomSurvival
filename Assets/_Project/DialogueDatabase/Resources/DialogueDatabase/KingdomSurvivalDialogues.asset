        kind: 0
        speakerIdOverride: 
        text: "\u2014 \u0422\u043E\u0447\u043D\u043E \u043C\u0435\u0441\u0442\u0430
          \u043D\u0435 \u0441\u043A\u0430\u0436\u0443, \u044F \u0442\u0430\u043C
          \u043C\u0430\u043B\u044C\u0447\u0438\u0448\u043A\u043E\u0439 \u0431\u044B\u043B.
