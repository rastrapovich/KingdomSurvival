    - id: chapter01.node.07c.lada
      speakerId: lada
      text: 
      textBlocks:
      - blockId: chapter01.node.07c.lada_old
        kind: 0
        speakerIdOverride: 
        text: "\u2014 \u041C\u044B \u0432\u0435\u0440\u043D\u0443\u043B\u0438 \u0441\u0445\u0435\u043C\u0443
          \u043A\u0430\u043A \u0431\u044B\u043B\u0430. \u0417\u043D\u0430\u0447\u0438\u0442,
          \u0435\u0441\u043B\u0438 \u044D\u0442\u043E \u0442\u043E\u043B\u044C\u043A\u043E
          \u043F\u043E\u043B\u043E\u043C\u043A\u0430, \u0432\u043E\u0434\u0430 \u0434\u043E\u043B\u0436\u043D\u0430
          \u0431\u044B\u043B\u0430 \u0443\u0441\u043F\u043E\u043A\u043E\u0438\u0442\u044C\u0441\u044F.
          \u041B\u0430\u0434\u0430 \u0441\u043C\u043E\u0442\u0440\u0438\u0442 \u043D\u0430
          \u0440\u0443\u0441\u043B\u043E. \u2014 \u041D\u0435 \u0443\u0441\u043F\u043E\u043A\u043E\u0438\u043B\u0430\u0441\u044C."
