          RewardText: "8 \u0437\u043E\u043B. \u043F\u043E \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0435\u043D\u0438\u0438"
        - Id: notice.town.wanted
          Title: "\u041A\u043E\u043D\u043E\u043A\u0440\u0430\u0434"
          Text: "\u041D\u0430\u0440\u0438\u0441\u043E\u0432\u0430\u043D \u0447\u0435\u043B\u043E\u0432\u0435\u043A
            \u0441 \u043E\u0434\u043D\u0438\u043C \u0443\u0445\u043E\u043C \u0438
            \u043B\u043E\u0448\u0430\u0434\u044C \u2014 \u0434\u0432\u0443\u043C\u044F.
            \u0421\u0442\u043E\u0440\u043E\u0436 \u043F\u043E\u044F\u0441\u043D\u044F\u0435\u0442:
            \u043A\u043E\u043D\u043E\u043A\u0440\u0430\u0434\u0430 \u0438\u0449\u0443\u0442
            \u0441 \u0432\u0435\u0441\u043D\u044B, \u043F\u0440\u0438\u043C\u0435\u0442\u0430
            \u2014 \u043D\u0435\u0442 \u043B\u0435\u0432\u043E\u0433\u043E \u0443\u0445\u0430.
            \u041A\u0442\u043E \u043F\u0440\u0438\u0432\u0435\u0434\u0451\u0442 \u0436\u0438\u0432\u044B\u043C
            \u2014 \u043F\u0443\u0441\u0442\u044C \u0433\u043E\u0432\u043E\u0440\u0438\u0442
            \u0441 \u0433\u043E\u0440\u043E\u0434\u043A\u043E\u043C."
