      speakerId: narrator
      text: 
      textBlocks:
      - blockId: cave.old_wall.start.text
        kind: 5
        speakerIdOverride: 
        text: "\u041A\u0430\u043C\u043D\u0438 \u043F\u043E\u0434\u043E\u0433\u043D\u0430\u043D\u044B
          \u0442\u0430\u043A, \u0447\u0442\u043E \u043D\u043E\u0436 \u043D\u0435
