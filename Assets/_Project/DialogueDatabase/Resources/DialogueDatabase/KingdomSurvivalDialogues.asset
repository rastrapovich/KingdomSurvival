        failureEffects: []
      editorPosition: {x: 1260, y: 0}
      hasEditorPosition: 1
    - id: chapter01.node.09.ostafiy
      speakerId: ostafiy
      text: 
      textBlocks:
      - blockId: chapter01.node.09.ostafiy_main
        kind: 0
        speakerIdOverride: 
        text: "— Седьмой рукав держали не от хорошей памяти и не от суеверия. Его открывали, закрывали, мерили. Он смотрит на калибр. — А куда весь этот порядок продолжался дальше — вот этого мы уже не помним."
        conditions:
          Combinator: 0
          Conditions: []
        hasPassiveCheck: 0
        passiveCheck:
          CheckId: 
          Kind: 0
          Quality: 0
          CompetencyId: 
          Difficulty: 13
          ModifierRules: []
        onRevealEffects: []
      choices:
      - text: "…"
        nextNodeId: chapter01.node.09.synthesis
