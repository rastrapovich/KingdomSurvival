      - blockId: settlement.hostess.start.wolf
        kind: 0
        speakerIdOverride: 
        text: "\u2014 \u0422\u043E\u043B\u044C\u043A\u043E \u043A \u043B\u0435\u0441\u0443
          \u043F\u043E \u0442\u0435\u043C\u043D\u043E\u0442\u0435 \u043D\u0435 \u0445\u043E\u0434\u0438\u0442\u0435.
          \u0412\u043E\u0437\u0447\u0438\u043A\u0438 \u0433\u043E\u0432\u043E\u0440\u044F\u0442,
          \u0441\u0442\u0430\u0440\u044B\u0439 \u0432\u043E\u043B\u043A \u0443 \u0434\u043E\u0440\u043E\u0433\u0438
          \u043E\u0432\u0435\u0446 \u0440\u0435\u0436\u0435\u0442 \u2014 \u0438 \u043D\u0435
          \u0431\u043E\u0438\u0442\u0441\u044F \u043D\u0438 \u043E\u0433\u043D\u044F,
          \u043D\u0438 \u043A\u0440\u0438\u043A\u0430."
        conditions:
          Combinator: 0
          Conditions:
          - Type: 0
            StringParam: freeplay.coal.leader_killed
