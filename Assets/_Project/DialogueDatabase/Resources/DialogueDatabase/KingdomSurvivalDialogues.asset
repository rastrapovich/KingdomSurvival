  - id: chapter01_dialogue_04_flood
    title: "N04 \u2014 \u041F\u0430\u0432\u043E\u0434\u043E\u043A / \u0421\u0438\u043D\u044F\u044F \u0441\u0442\u0430\u0432\u043D\u044F"
    category: 1
    status: 1
    developerComment: "P05 production-\u0441\u0446\u0435\u043D\u0430. \u041A\u0440\u0438\u0437\u0438\u0441 \u2192 \u0440\u0435\u0448\u0430\u044E\u0449\u0430\u044F \u043F\u0440\u043E\u0432\u0435\u0440\u043A\u0430 (\u0421\u0438\u043B\u0430/\u041B\u043E\u0432\u043A\u043E\u0441\u0442\u044C/\u0421\u0442\u043E\u0439\u043A\u043E\u0441\u0442\u044C, \u0441\u043B\u043E\u0436\u043D\u043E\u0441\u0442\u044C 13, chapter01.check.flood_response, ActiveDecisive) \u2192 \u0442\u044F\u0436\u0451\u043B\u044B\u0439 \u0432\u044B\u0431\u043E\u0440 \u043F\u0440\u0438\u043E\u0440\u0438\u0442\u0435\u0442\u0430 (\u043B\u044E\u0434\u0438/\u0441\u043A\u043E\u0442/\u043C\u0435\u043B\u044C\u043D\u0438\u0446\u0430) \u0438 \u043F\u043E\u0441\u043B\u0435 \u0443\u0441\u043F\u0435\u0445\u0430, \u0438 \u043F\u043E\u0441\u043B\u0435 \u043F\u0440\u043E\u0432\u0430\u043B\u0430 \u2192 \u0448\u0435\u0441\u0442\u044C \u043A\u043E\u043D\u0435\u0447\u043D\u044B\u0445 \u0443\u0437\u043B\u043E\u0432, \u043A\u0430\u0436\u0434\u044B\u0439 \u0432\u044B\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442 \u0441\u0432\u043E\u044E \u043A\u043E\u043C\u0431\u0438\u043D\u0430\u0446\u0438\u044E \u0444\u043B\u0430\u0433\u043E\u0432 \u043F\u043E\u0441\u043B\u0435\u0434\u0441\u0442\u0432\u0438\u0439 \u0438 chapter01.flag.flood_happened. FloodHappened \u0441\u0442\u0430\u0432\u0438\u0442\u0441\u044F \u0442\u043E\u043B\u044C\u043A\u043E \u0432 \u043A\u043E\u043D\u0435\u0447\u043D\u044B\u0445 \u0443\u0437\u043B\u0430\u0445, \u043D\u0435 \u043D\u0430 \u0441\u0442\u0430\u0440\u0442\u0435 \u2014 \u0438\u043D\u0430\u0447\u0435 Chapter01StoryDirector \u0441\u043E\u0447\u0442\u0451\u0442 N04 \u0437\u0430\u0432\u0435\u0440\u0448\u0451\u043D\u043D\u044B\u043C \u0434\u043E \u043F\u0440\u043E\u0432\u0435\u0440\u043A\u0438 \u0438 \u0432\u044B\u0431\u043E\u0440\u0430."
    startNodeId: chapter01.node.04
    tags:
    - "\u0433\u043B\u0430\u0432\u043001"
    - production
    nodes:
    - id: chapter01.node.04
      speakerId: narrator
      text:
      textBlocks:
      - blockId: chapter01.node.04_intro1
        kind: 0
        speakerIdOverride:
        text: "\u0421\u0440\u0435\u0434\u0438 \u043D\u043E\u0447\u0438 \u0437\u0432\u0443\u043A \u0432\u043E\u0434\u044B \u043C\u0435\u043D\u044F\u0435\u0442\u0441\u044F \u2014 \u043D\u0435 \u0442\u0435\u0447\u0451\u0442, \u0430 \u0431\u044C\u0451\u0442. \u0421\u0438\u043D\u044F\u044F \u0441\u0442\u0430\u0432\u043D\u044F \u043D\u0430 \u043F\u043B\u043E\u0442\u0438\u043D\u0435, \u0442\u0430, \u0447\u0442\u043E \u0432\u0441\u0435\u0433\u0434\u0430 \u0434\u0435\u0440\u0436\u0430\u043B\u0430 \u0431\u043E\u043A\u043E\u0432\u043E\u0439 \u0441\u0431\u0440\u043E\u0441, \u0434\u0440\u043E\u0436\u0438\u0442 \u0438 \u043D\u0435 \u043F\u043E\u0434\u0434\u0430\u0451\u0442\u0441\u044F. \u041C\u0435\u043B\u044C\u043D\u0438\u0446\u0430 \u041C\u0438\u0440\u043E\u043D\u0430 \u0433\u043B\u043E\u0442\u0430\u0435\u0442 \u0432\u043E\u0434\u0443 \u0440\u044B\u0432\u043A\u0430\u043C\u0438, \u0431\u0443\u0434\u0442\u043E \u0434\u0430\u0432\u0438\u0442\u0441\u044F."
        conditions:
          Combinator: 0
          Conditions: []
        hasPassiveCheck: 0
        passiveCheck:
          CheckId:
          Kind: 0
          Quality: 0
          CompetencyId:
          Difficulty: 13
          ModifierRules: []
        onRevealEffects: []
      - blockId: chapter01.node.04_intro2
        kind: 0
        speakerIdOverride:
        text: "\u041C\u0438\u0440\u043E\u043D \u0432 \u043E\u0434\u043D\u043E\u0439 \u0440\u0443\u0431\u0430\u0445\u0435 \u0443\u0436\u0435 \u0443 \u043A\u043E\u043B\u0435\u0441\u0430 \u2014 \u043E\u043D\u043E \u0432\u043E\u0442-\u0432\u043E\u0442 \u0441\u043E\u0440\u0432\u0451\u0442. \u041B\u0430\u0434\u0430 \u043A\u0440\u0438\u0447\u0438\u0442, \u0447\u0442\u043E \u043D\u0430\u0441\u0442\u0438\u043B \u0442\u0440\u0435\u0449\u0438\u0442 \u043F\u043E\u0434 \u043D\u043E\u0433\u0430\u043C\u0438. \u0423\u043B\u044C\u044F\u043D\u0430 \u0442\u0430\u0449\u0438\u0442 \u043F\u0435\u0440\u0435\u043F\u0443\u0433\u0430\u043D\u043D\u0443\u044E \u0441\u043A\u043E\u0442\u0438\u043D\u0443 \u043F\u0440\u043E\u0447\u044C \u043E\u0442 \u0432\u043E\u0434\u044B, \u0430 \u0443 \u043C\u0435\u043B\u044C\u043D\u0438\u0446\u044B \u0432\u0441\u0451 \u0435\u0449\u0451 \u0441\u0442\u043E\u044F\u0442 \u0440\u0430\u0431\u043E\u0442\u043D\u0438\u043A\u0438. \u041E\u0441\u0442\u0430\u0444\u0438\u0439 \u0431\u0435\u0436\u0438\u0442 \u043A \u0437\u0430\u0442\u0432\u043E\u0440\u0443 \u043F\u0440\u0438\u0432\u044B\u0447\u043D\u044B\u043C \u0448\u0430\u0433\u043E\u043C \u2014 \u043D\u043E \u0432\u043E\u0434\u0430 \u0432 \u044D\u0442\u0443 \u043D\u043E\u0447\u044C \u043D\u0435 \u0441\u043B\u0443\u0448\u0430\u0435\u0442 \u043F\u0440\u0438\u0432\u044B\u0447\u043A\u0443."
        conditions:
          Combinator: 0
          Conditions: []
        hasPassiveCheck: 0
        passiveCheck:
          CheckId:
          Kind: 0
          Quality: 0
          CompetencyId:
          Difficulty: 13
          ModifierRules: []
        onRevealEffects: []
      choices:
      - text: "\u041D\u0430\u0432\u0430\u043B\u0438\u0442\u044C\u0441\u044F \u043D\u0430 \u0441\u0442\u0432\u043E\u0440 \u0432\u0441\u0435\u043C \u0442\u0435\u043B\u043E\u043C \u2014 \u0441\u0434\u0432\u0438\u043D\u0443\u0442\u044C \u0435\u0433\u043E \u0441\u0438\u043B\u043E\u0439."
        nextNodeId:
