        onRevealEffects:
        - EffectExecutionId: chapter01.effect.n02_flag1
          Type: 0
          StringParam: chapter01.flag.house_people_met
          IntParam: 0
      - blockId: chapter01.node.02_ostafiy
        kind: 0
        speakerIdOverride: ostafiy
        text: "\xAB\u0417\u0430\u0440\u0443\u0431\u043A\u0443 \u0441\u0431\u0438\u043B\u0430\xBB,
          \u2014 \u0433\u043E\u0432\u043E\u0440\u0438\u0442 \u041E\u0441\u0442\u0430\u0444\u0438\u0439,
          \u043D\u0435 \u0433\u043B\u044F\u0434\u044F \u043D\u0430 \u041B\u0430\u0434\u0443,
          \u0438 \u0432\u0435\u0440\u0442\u0438\u0442 \u0432 \u0440\u0443\u043A\u0430\u0445
          \u0441\u0442\u0430\u0440\u044B\u0439 \u0431\u0440\u0443\u0441. \u2014 \xAB\u041E\u043D\u0430
          \u043D\u0435 \u0434\u043B\u044F \u043A\u0440\u0430\u0441\u043E\u0442\u044B
          \u0431\u044B\u043B\u0430 \u2014 \u043F\u043E \u043D\u0435\u0439 \u0432\u043E\u0434\u0443
          \u0447\u0438\u0442\u0430\u043B\u0438, \u0441\u043A\u043E\u043B\u044C\u043A\u043E
          \u043D\u0438 \u0441\u043F\u0440\u043E\u0441\u0438. \u0422\u0435\u043F\u0435\u0440\u044C
          \u043F\u043E\u0434\u0438 \u043F\u043E\u0439\u043C\u0438, \u0433\u0434\u0435
          \u043C\u0435\u0440\u0438\u0442\u044C\xBB."
        conditions:
          Combinator: 0
          Conditions: []
        hasPassiveCheck: 0
        passiveCheck:
          CheckId: 
          Kind: 0
          Quality: 0
          CompetencyId: 
          Difficulty: 13
          ModifierRules: []
        onRevealEffects: []
      - blockId: chapter01.node.02_lada
        kind: 0
        speakerIdOverride: lada
        text: "\xAB\u041E\u043D\u0430 \u0431\u044B \u0441\u0433\u043D\u0438\u043B\u0430
          \u0447\u0435\u0440\u0435\u0437 \u0433\u043E\u0434, \u0437\u0430\u0440\u0443\u0431\u043A\u0430
          \u0438\u043B\u0438 \u0431\u0435\u0437\xBB, \u2014 \u043E\u0442\u0432\u0435\u0447\u0430\u0435\u0442
          \u041B\u0430\u0434\u0430, \u043D\u0435 \u043E\u0442\u0440\u044B\u0432\u0430\u044F\u0441\u044C
          \u043E\u0442 \u0440\u0430\u0431\u043E\u0442\u044B. \u2014 \xAB\u041D\u043E\u0432\u0430\u044F
          \u0434\u0435\u0440\u0436\u0438\u0442 \u0432\u0434\u0432\u043E\u0435. \u0425\u043E\u0447\u0435\u0448\u044C
          \u043C\u0435\u0440\u0438\u0442\u044C \u2014 \u043F\u043E\u0441\u0442\u0430\u0432\u044C
          \u0440\u044F\u0434\u043E\u043C \u0440\u0435\u0439\u043A\u0443, \u0434\u0435\u043B\u043E
          \u043D\u0430 \u043F\u044F\u0442\u044C \u043C\u0438\u043D\u0443\u0442\xBB."
        conditions:
          Combinator: 0
          Conditions: []
        hasPassiveCheck: 0
        passiveCheck:
          CheckId: 
          Kind: 0
          Quality: 0
          CompetencyId: 
          Difficulty: 13
          ModifierRules: []
        onRevealEffects: []
      - blockId: chapter01.node.02_miron
        kind: 0
        speakerIdOverride: miron
        text: "\u041C\u0438\u0440\u043E\u043D, \u043D\u0435 \u043E\u0431\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u044F\u0441\u044C
          \u043E\u0442 \u043A\u043E\u043B\u0435\u0441\u0430, \u0431\u0440\u043E\u0441\u0430\u0435\u0442
          \u0447\u0435\u0440\u0435\u0437 \u043F\u043B\u0435\u0447\u043E: \xAB\u041C\u043D\u0435
          \u0432\u0441\u0451 \u0440\u0430\u0432\u043D\u043E, \u0447\u0435\u0439 \u0431\u0440\u0443\u0441,
          \u2014 \u043B\u0438\u0448\u044C \u0431\u044B \u043A\u043E\u043B\u0435\u0441\u043E
          \u043D\u0435 \u0441\u0431\u043E\u0438\u043B\u043E. \u041F\u043E\u043A\u0430
          \u043D\u0435 \u0441\u0431\u043E\u0438\u043B\u043E\xBB."
        conditions:
          Combinator: 0
          Conditions: []
        hasPassiveCheck: 0
        passiveCheck:
          CheckId: 
          Kind: 0
          Quality: 0
          CompetencyId: 
          Difficulty: 13
          ModifierRules: []
        onRevealEffects: []
      - blockId: chapter01.node.02_ulyana
        kind: 0
        speakerIdOverride: ulyana
        text: "\u0423\u043B\u044C\u044F\u043D\u0430 \u043F\u0440\u043E\u0445\u043E\u0434\u0438\u0442
          \u043C\u0438\u043C\u043E \u0441 \u043A\u043E\u0440\u0437\u0438\u043D\u043E\u0439
          \u0438 \u0432\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442 \u043D\u0430
          \u0445\u043E\u0434\u0443: \xAB\u0412\u044B \u0431\u044B \u043B\u0443\u0447\u0448\u0435
          \u0440\u0435\u0448\u0438\u043B\u0438, \u043A\u0442\u043E \u0441\u0435\u0433\u043E\u0434\u043D\u044F
          \u043F\u043E\u0434\u043C\u0435\u043D\u0438\u0442 \u041F\u0440\u043E\u0432\u0443
          \u0443 \u043A\u043E\u043B\u043E\u0434\u0446\u0430 \u2014 \u0443 \u043D\u0435\u0451
          \u043F\u043E\u0441\u043B\u0435 \u0441\u0442\u0438\u0440\u043A\u0438 \u043E\u043F\u044F\u0442\u044C
          \u0440\u0443\u043A\u0438 \u043D\u0435 \u0440\u0430\u0437\u0433\u0438\u0431\u0430\u044E\u0442\u0441\u044F.
          \u0414\u043E\u043C \u043D\u0435 \u0442\u043E\u043B\u044C\u043A\u043E \u0438\u0437
          \u0434\u043E\u0441\u043E\u043A \u0441\u0442\u043E\u0438\u0442\xBB."
        conditions:
          Combinator: 0
          Conditions: []
        hasPassiveCheck: 0
        passiveCheck:
          CheckId: 
          Kind: 0
          Quality: 0
          CompetencyId: 
          Difficulty: 13
          ModifierRules: []
        onRevealEffects: []
      - blockId: chapter01.node.02_appeal_ostafiy
        kind: 0
        speakerIdOverride: ostafiy
        text: "\xAB\u0422\u044B \u0442\u0435\u043F\u0435\u0440\u044C \u0443 \u043D\u0430\u0441
          \u0440\u0435\u0448\u0430\u0435\u0448\u044C\xBB, \u2014 \u0433\u043E\u0432\u043E\u0440\u0438\u0442
          \u041E\u0441\u0442\u0430\u0444\u0438\u0439 \u0433\u0435\u0440\u043E\u044E,
          \u043D\u0435 \u0442\u043E \u0432 \u0448\u0443\u0442\u043A\u0443, \u043D\u0435
          \u0442\u043E \u0432\u0441\u0435\u0440\u044C\u0451\u0437. \u2014 \xAB\u0412\u043E\u0442
          \u0438 \u0440\u0430\u0441\u0441\u0443\u0434\u0438\xBB."
        conditions:
          Combinator: 0
          Conditions: []
        hasPassiveCheck: 0
        passiveCheck:
          CheckId: 
          Kind: 0
          Quality: 0
          CompetencyId: 
          Difficulty: 13
          ModifierRules: []
