    acceptanceSummary: "\u0421\u043E\u0441\u0442\u0430\u0432 \u0433\u0440\u0443\u043F\u043F\u044B
      \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043A\u0438 \u0438 \u0442\u0435\u043A\u0441\u0442\u043E\u0432\u043E
