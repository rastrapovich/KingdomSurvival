    - id: logic_conditions
      speakerId: miller
      text: "\u0417\u0434\u0435\u0441\u044C \u0443\u0441\u043B\u043E\u0432\u0438\u044F
        \u0441\u043F\u0435\u0446\u0438\u0430\u043B\u044C\u043D\u043E \u043E\u0431\u044A\u0435\u0434\u0438\u043D\u0435\u043D\u044B.
        \u041F\u0435\u0440\u0432\u044B\u0439 \u043E\u0442\u0432\u0435\u0442 \u0442\u0440\u0435\u0431\u0443\u0435\u0442
        \u0412\u0421\u0415 \u0443\u0441\u043B\u043E\u0432\u0438\u044F, \u0432\u0442\u043E\u0440\u043E\u0439
        \u2014 \u0425\u041E\u0422\u042F \u0411\u042B \u041E\u0414\u041D\u041E. \u0422\u0440\u0435\u0442\u0438\u0439
        \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0435\u0442 \xAB\u041E\u0431\u0440\u0430\u0442\u0438\u0442\u044C
        \u0443\u0441\u043B\u043E\u0432\u0438\u0435\xBB: \u043E\u043D \u0434\u043E\u0441\u0442\u0443\u043F\u0435\u043D,
        \u043F\u043E\u043A\u0430 \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u0430
        demo_item \u041D\u0415\u0422."
