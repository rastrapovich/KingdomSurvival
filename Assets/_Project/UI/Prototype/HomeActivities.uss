/* ================================================================
   ДЕЛА В ДОМЕ (ПР-02) — сцены первой главы, которые игрок открывает
   сам: человек и место. Карточка — шаблон HomeActivityCard.uxml.
   ================================================================ */

.home-activities-panel {
    margin-bottom: 18px;
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 10px;
    padding-bottom: 10px;
    background-color: rgb(34, 38, 45);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(79, 72, 63);
    border-right-color: rgb(79, 72, 63);
    border-top-color: rgb(79, 72, 63);
    border-bottom-color: rgb(79, 72, 63);
}

.home-activities-list {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: stretch;
}

.home-activities-empty {
    font-size: 12px;
    opacity: 0.6;
    white-space: normal;
}

.home-activity-card {
    width: 31.5%;
    min-width: 200px;
    margin-left: 0;
    margin-right: 8px;
    margin-top: 0;
    margin-bottom: 8px;
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 10px;
    padding-bottom: 10px;
    align-items: flex-start;
    -unity-text-align: upper-left;
}

.home-activity-urgent {
    display: none;
    font-size: 10px;
    -unity-font-style: bold;
    color: rgb(214, 128, 92);
    margin-bottom: 4px;
}

.home-activity-card--urgent .home-activity-urgent {
    display: flex;
}

.home-activity-card--urgent {
    border-left-color: rgb(214, 128, 92);
    border-left-width: 3px;
}

.home-activity-title {
    -unity-font-style: bold;
    font-size: 15px;
    white-space: normal;
    color: rgb(226, 214, 186);
}

.home-activity-where {
    margin-top: 4px;
    font-size: 11px;
    white-space: normal;
    color: rgb(193, 183, 158);
}

/* ПР-06А: люди Дома */

.home-people-summary {
    font-size: 13px;
    color: rgb(226, 214, 186);
    margin-bottom: 6px;
}

.home-people-function {
    font-size: 12px;
    white-space: normal;
    color: rgb(193, 183, 158);
    margin-bottom: 2px;
}

.home-people-work-row {
    flex-direction: row;
    align-items: center;
    margin-top: 4px;
    margin-bottom: 6px;
}

.home-people-work-row .home-people-function {
    flex-grow: 1;
    flex-shrink: 1;
}

.home-people-work-button {
    width: 220px;
    height: 32px;
    margin-top: 0;
    margin-left: 8px;
    font-size: 13px;
}

.home-people-list {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 6px;
}

.person-row {
    width: 23.5%;
    min-width: 170px;
    margin-left: 0;
    margin-right: 6px;
    margin-top: 0;
    margin-bottom: 6px;
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 6px;
    padding-bottom: 6px;
    align-items: flex-start;
    background-color: rgb(44, 40, 34);
    border-left-color: rgb(96, 84, 64);
    border-right-color: rgb(96, 84, 64);
    border-top-color: rgb(96, 84, 64);
    border-bottom-color: rgb(96, 84, 64);
}

.person-row:hover {
    border-left-color: rgb(176, 146, 92);
    border-right-color: rgb(176, 146, 92);
    border-top-color: rgb(176, 146, 92);
    border-bottom-color: rgb(176, 146, 92);
}

.person-row--away {
    opacity: 0.7;
}

.person-row--dead {
    opacity: 0.45;
}

.person-row-name {
    font-size: 14px;
    -unity-font-style: bold;
    color: rgb(226, 214, 186);
}

.person-row-role {
    font-size: 11px;
    color: rgb(193, 183, 158);
}

.person-row-status {
    font-size: 11px;
    color: rgb(214, 180, 120);
    white-space: normal;
}

.home-people-detail {
    font-size: 12px;
    white-space: normal;
    color: rgb(193, 183, 158);
    margin-top: 4px;
}
