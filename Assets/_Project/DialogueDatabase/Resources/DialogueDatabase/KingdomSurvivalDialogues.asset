        kind: 0
        speakerIdOverride: 
        text: "\u0427\u0435\u0440\u0435\u0437 \u043D\u0438\u0437\u0438\u043D\u0443
          \u043C\u043E\u0436\u043D\u043E \u043F\u0440\u043E\u0439\u0442\u0438 \u043F\u0440\u044F\u043C\u043E.
