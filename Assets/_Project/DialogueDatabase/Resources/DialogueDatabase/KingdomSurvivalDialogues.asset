    category: 2
    status: 1
    developerComment: "\u041E\u0431\u044A\u0435\u043A\u0442 cave.chamber (\u043F\u043E\u0441\u043B\u0435
      \u0431\u043E\u044F). \u0412\u0441\u0442\u0440\u0435\u0447\u0430 \u0441 \u041D\u0435\u0436\u0430\u0442\u043E\u0439
      \u0438\u043B\u0438 \u0435\u0433\u043E \u043F\u0443\u0441\u0442\u0430\u044F
      \u0441\u0442\u043E\u044F\u043D\u043A\u0430; \u0441\u0442\u0430\u0440\u0430\u044F
      \u043A\u043B\u0430\u0434\u043A\u0430 \u0441\u043E \u0437\u043D\u0430\u043A\u043E\u043C."
    sceneIllustration: {fileID: 0}
