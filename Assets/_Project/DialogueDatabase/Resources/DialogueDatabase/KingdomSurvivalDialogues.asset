      - blockId: cave.cutter.wall.b
        kind: 0
        speakerIdOverride: nezhata
        text: "\u2014 \u0410 \u0437\u043D\u0430\u043A \u2014 \u044D\u0442\u043E \u043A\u0442\u043E-\u0442\u043E
          \u0441\u0432\u043E\u0451 \u043C\u0435\u0442\u0438\u043B. \u041A\u0430\u043C\u0435\u043D\u044C
