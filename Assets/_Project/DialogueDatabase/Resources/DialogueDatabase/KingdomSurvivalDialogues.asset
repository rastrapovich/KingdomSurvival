    - id: check_success
      speakerId: miller
      text: "\u041F\u0440\u043E\u0432\u0435\u0440\u043A\u0430 \u0437\u0430\u043A\u043E\u043D\u0447\u0438\u043B\u0430\u0441\u044C
        \u0443\u0441\u043F\u0435\u0445\u043E\u043C. \u0412\u0435\u0440\u043D\u0438\u0441\u044C
        \u043A \u0432\u0438\u0442\u0440\u0438\u043D\u0435: \xAB\u041F\u0440\u043E\u0432\u0435\u0440\u043A\u0430
        \u0431\u044B\u043B\u0430 \u0443\u0441\u043F\u0435\u0448\u043D\u043E\u0439\xBB
        \u0442\u0435\u043F\u0435\u0440\u044C \u0430\u043A\u0442\u0438\u0432\u043D\u0430,
        \xAB\u041F\u0440\u043E\u0432\u0435\u0440\u043A\u0430 \u0431\u044B\u043B\u0430
        \u043F\u0440\u043E\u0432\u0430\u043B\u0435\u043D\u0430\xBB \u2014 \u043D\u0435\u0442,
        \u0430 \xAB\u041F\u0440\u043E\u0432\u0435\u0440\u043A\u0430 \u0435\u0449\u0451
        \u043D\u0435 \u0432\u044B\u043F\u043E\u043B\u043D\u044F\u043B\u0430\u0441\u044C\xBB
        \u0438\u0441\u0447\u0435\u0437\u043B\u0430."
