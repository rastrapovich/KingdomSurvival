      - blockId: chapter01.node.11c.branch_saved_seed
        kind: 0
        speakerIdOverride: 
        text: "\u041D\u0430 \u0432\u0435\u0440\u0451\u0432\u043A\u0435 \u043E\u0441\u0442\u0430\u043B\u0430\u0441\u044C
          \u0443\u0437\u043A\u0430\u044F \u0442\u0451\u043C\u043D\u0430\u044F \u043F\u043E\u043B\u043E\u0441\u043A\u0430.
          \u0423 \u043E\u0433\u043D\u044F \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0441\u044F
          \u043F\u043E\u043D\u044F\u0442\u043D\u043E, \u0447\u0442\u043E \u044D\u0442\u043E
          \u043A\u0440\u043E\u0432\u044C.\n\n\u0417\u0430\u0436\u0430\u0442\u044B\u0439
          \u043C\u0443\u0436\u0447\u0438\u043D\u0430 \u0441\u0430\u043C \u0441\u043A\u0430\u0437\u0430\u043B:
          \xAB\u0417\u0435\u0440\u043D\u043E \u0441\u043D\u0430\u0447\u0430\u043B\u0430\xBB.\n\n\u0422\u0430\u043C,
          \u0443 \u0442\u0435\u043B\u0435\u0433\u0438, \u0432\u043E\u043A\u0440\u0443\u0433
          \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u043C\u043D\u043E\u0433\u043E
          \u0431\u044B\u043B\u043E \u043A\u0440\u0438\u043A\u0430, \u0434\u0435\u0440\u0435\u0432\u0430
          \u0438 \u043B\u043E\u0448\u0430\u0434\u0438.\n\n\u0417\u0434\u0435\u0441\u044C
          \u044D\u0442\u0430 \u0444\u0440\u0430\u0437\u0430 \u0437\u0432\u0443\u0447\u0438\u0442
          \u0433\u043E\u0440\u0430\u0437\u0434\u043E \u043E\u0442\u0447\u0451\u0442\u043B\u0438\u0432\u0435\u0435.\n\n\u041E\u043D
          \u043E\u0441\u0442\u0430\u043B\u0441\u044F \u0436\u0438\u0432. \u0427\u0442\u043E
          \u043E\u0441\u0442\u0430\u043D\u0435\u0442\u0441\u044F \u043E\u0442 \u0435\u0433\u043E
          \u043D\u043E\u0433\u0438 \u2014 \u0432\u044B\u044F\u0441\u043D\u0438\u0442\u0441\u044F
          \u0443\u0436\u0435 \u0431\u0435\u0437 \u0442\u0435\u0431\u044F."
