<?xml version="1.0" encoding="utf-8"?>

<ui:UXML
    xmlns:ui="UnityEngine.UIElements"
    xmlns:uie="UnityEditor.UIElements"
    editor-extension-mode="False">

    <Style src="Prototype_Main.uss" />
    <Style src="Prototype_DebugAndGameOver.uss" />
    <Style src="Prototype_Exploration.uss" />
    <Style src="Prototype_Shell.uss" />
    <Style src="Prototype_Camp.uss" />
    <Style src="Prototype_SharedPanels.uss" />
    <Style src="Journal.uss" />
    <Style src="HeroScreen.uss" />
    <Style src="Narrative.uss" />
    <Style src="BuildingCards.uss" />
    <Style src="Expedition.uss" />

    <ui:VisualElement name="screen" class="screen shell-screen">

        <ui:VisualElement class="shell-main-row">
            <ui:VisualElement class="shell-sidebar">
                <ui:Label text="KINGDOM SURVIVAL" class="shell-game-title" />

                <ui:VisualElement class="reports-dock shell-reports-dock">
                    <ui:VisualElement class="panel reports-panel shell-reports-panel">
                        <ui:Label text="КОРОЛЕВСКИЕ ДОНЕСЕНИЯ" class="panel-title shell-reports-title" />
                        <ui:ScrollView name="report-history-scroll" class="report-history-scroll shell-report-scroll">
                            <ui:Label name="report-history-label" text="Донесений пока нет." class="report-text shell-report-text" />
                        </ui:ScrollView>
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:VisualElement name="persistent-commander-panel" class="persistent-commander-panel">
                    <ui:Label text="КОМАНДИР" class="persistent-commander-title" />
                    <ui:VisualElement name="persistent-commander-status" class="persistent-commander-status">
                        <ui:Label name="persistent-commander-state" text="В ЗАМКЕ" class="persistent-commander-state" />
                        <ui:Label name="persistent-commander-target" text="Цель: —" class="persistent-commander-target" />
                    </ui:VisualElement>
                    <ui:VisualElement class="persistent-commander-content">
                        <ui:VisualElement class="persistent-commander-portrait">
                            <ui:Label text="ИЗОБРАЖЕНИЕ&#10;КОМАНДИРА" class="persistent-commander-portrait-text" />
                        </ui:VisualElement>
                        <ui:VisualElement class="persistent-commander-buttons">
                            <ui:VisualElement class="persistent-commander-button-row">
                                <ui:Button text="" class="persistent-commander-button persistent-commander-empty" />
                                <ui:Button text="" class="persistent-commander-button persistent-commander-empty" />
                            </ui:VisualElement>
                            <ui:VisualElement class="persistent-commander-button-row">
                                <ui:Button name="persistent-commander-expedition-button" text="ЛОКАЦИИ" tooltip="Открытые локации" class="persistent-commander-button persistent-commander-expedition-button" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement class="shell-workspace">
                <ui:VisualElement name="main-screen-scroll" class="main-screen-scroll shell-workspace-content">
                    <ui:VisualElement name="capital-screen" class="game-screen shell-content-screen">
                        <ui:ScrollView class="shell-screen-scroll">
                            <ui:VisualElement class="panel shell-content-panel">
                                <ui:Label text="СТОЛИЦА" class="panel-title" />
                                <ui:Label text="Здания и основные городские действия" class="panel-description" />
                                <ui:VisualElement name="building-grid" class="building-grid">
                                    <ui:Button text="Тронный зал" class="building-card" />
                                    <ui:Button text="Амбар" class="building-card" />
                                    <ui:Button text="Казармы" class="building-card" />
                                    <ui:Button text="Рынок" class="building-card" />
                                    <ui:Button text="Шахта" class="building-card" />
                                    <ui:Button text="Городские проекты" class="building-card" />
                                </ui:VisualElement>
                            </ui:VisualElement>
                        </ui:ScrollView>
                    </ui:VisualElement>

                    <ui:VisualElement name="expeditions-screen" class="game-screen shell-content-screen">
                        <ui:ScrollView class="shell-screen-scroll military-expedition-column">
                            <ui:VisualElement class="panel expedition-panel shell-content-panel shell-expedition-panel">
                                <ui:Label text="КАРТА" class="panel-title" />
                                <ui:Label name="expedition-status-label" text="Активная экспедиция: нет" class="status-label" />
                                <ui:VisualElement name="active-expedition-card" class="active-expedition-card">
                                    <ui:Label name="active-expedition-title" text="АКТИВНАЯ ЭКСПЕДИЦИЯ" class="active-expedition-title" />
                                    <ui:Label name="active-expedition-details" text="Данные экспедиции" class="active-expedition-details" />
                                    <ui:Button name="research-expedition-button" text="ИССЛЕДОВАТЬ" class="research-expedition-button" />
                                    <ui:Button name="return-expedition-button" text="Приказать возвращаться" class="return-expedition-button" />
                                </ui:VisualElement>
                                <ui:Label text="КАРТА ОКРЕСТНОСТЕЙ" class="section-title world-map-section-title" />
                                <ui:Label
                                    name="world-map-hint-label"
                                    text="Выберите неизведанную область. Маршрут армия пройдёт автоматически."
                                    class="world-map-hint" />

                                <ui:VisualElement name="world-map" class="world-map">
                                    <ui:VisualElement class="world-map-land world-map-land-west" />
                                    <ui:VisualElement class="world-map-land world-map-land-north" />
                                    <ui:VisualElement class="world-map-land world-map-land-east" />
                                    <ui:Label text="С&#10;↑" class="world-map-compass" />
                                    <ui:VisualElement name="world-map-terrain" class="world-map-layer world-map-terrain" />
                                    <ui:VisualElement name="world-map-routes" class="world-map-layer world-map-routes" />
                                    <ui:VisualElement name="world-map-markers" class="world-map-layer world-map-markers" />
                                    <ui:Button
                                        name="world-map-capital-button"
                                        text="СТОЛИЦА"
                                        tooltip="Во время похода нажмите, чтобы приказать армии возвращаться"
                                        class="world-map-capital" />
                                    <ui:VisualElement name="world-map-army-marker" class="world-map-army-marker">
                                        <ui:Label text="ОТРЯД" class="world-map-army-badge" />
                                        <ui:Label name="world-map-army-marker-label" text="" class="world-map-army-label" />
                                    </ui:VisualElement>
                                    <!-- UI-M08: карточка осмотра локации по ПКМ на маркере — постоянный,
                                         скрытый по умолчанию узел (display:none в
                                         .world-map-location-inspection-card, Prototype_Exploration.uss).
                                         Раньше её собирали по частям два разных файла:
                                         WorldMapInteractionPolish.cs (EnsureWorldMapLocationCard —
                                         заголовок/детали/кнопка закрытия) и WorldMapLocationActions.cs
                                         (EnsureWorldMapLocationActionElements — метка присутствия армии/
                                         кнопка "ИССЛЕДОВАТЬ", вставлявшиеся между ними через
                                         RemoveFromHierarchy+Add). Оба файла теперь только биндят
                                         Q<T>(name), порядок частей — из разметки, а не из кода. -->
                                    <ui:VisualElement name="world-map-location-inspection-card" class="world-map-location-inspection-card">
                                        <ui:Label name="world-map-location-inspection-title" class="world-map-location-inspection-title" />
                                        <ui:Label name="world-map-location-inspection-details" class="world-map-location-inspection-details" />
                                        <ui:Label name="world-map-location-inspection-presence" text="АРМИЯ НАХОДИТСЯ ЗДЕСЬ" class="world-map-location-inspection-presence" />
                                        <ui:Button name="world-map-location-inspection-research-button" text="ВОЙТИ В ЛОКАЦИЮ" class="world-map-location-inspection-research-button" />
                                        <ui:Button name="world-map-location-inspection-close-button" text="ЗАКРЫТЬ" class="world-map-location-inspection-close-button" />
                                    </ui:VisualElement>
                                </ui:VisualElement>

                                <ui:VisualElement name="map-selection-card" class="map-selection-card">
                                    <ui:Label name="map-selection-title" text="ВЫБЕРИТЕ ОБЛАСТЬ НА КАРТЕ" class="map-selection-title" />
                                    <ui:Label name="map-selection-details" text="Здесь появятся сведения о цели похода." class="map-selection-details" />
                                    <ui:Button name="map-send-button" text="ОТПРАВИТЬ НА РАЗВЕДКУ" class="send-button map-send-button" />
                                </ui:VisualElement>
                            </ui:VisualElement>
                        </ui:ScrollView>
                    </ui:VisualElement>
                </ui:VisualElement>

            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement class="shell-bottom-bar">
            <ui:VisualElement class="navigation-bar shell-navigation-bar">
                <ui:Button name="nav-capital-button" text="Столица" tooltip="Столица" class="nav-button shell-nav-button nav-capital" />
                <ui:Button name="nav-expeditions-button" text="Карта" tooltip="Глобальная карта" class="nav-button shell-nav-button nav-expedition" />
                <ui:Button name="nav-hero-button" text="Герой" tooltip="Экран героя: состав похода, характеристики, снаряжение" class="nav-button shell-nav-button nav-hero" />
                <ui:Button name="nav-journal-button" text="Журнал" tooltip="Цели и хроника" class="nav-button shell-nav-button nav-journal" />
                <ui:Button name="nav-camp-button" text="Лагерь" tooltip="Лагерь доступен во время похода." class="nav-button shell-nav-button nav-camp" />
            </ui:VisualElement>
            <ui:VisualElement class="shell-resource-bar">
                <ui:VisualElement class="resource-strip shell-resource-strip">
                    <ui:VisualElement class="resource-box shell-resource-box"><ui:Label name="day-label" text="День: 1" class="resource-value" /></ui:VisualElement>
                    <ui:VisualElement class="resource-box shell-resource-box">
                        <ui:Label name="gold-label" text="Золото: 120" class="resource-value" /><ui:Label name="gold-income-label" text="+3" class="resource-income" />
                        <ui:VisualElement class="resource-test-controls"><ui:Button name="gold-minus10-button" text="−10" class="resource-test-button" /><ui:Button name="gold-plus10-button" text="+10" class="resource-test-button" /></ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="resource-box food-box shell-resource-box">
                        <ui:Label name="food-label" text="Пища: 72" class="resource-value" /><ui:Label name="food-income-label" text="+7" class="resource-income" />
                        <ui:VisualElement class="resource-test-controls"><ui:Button name="food-minus10-button" text="−10" class="resource-test-button" /><ui:Button name="food-plus10-button" text="+10" class="resource-test-button" /></ui:VisualElement>
                        <ui:VisualElement class="food-expense-popup"><ui:Label name="food-consumption-label" text="Расход: 24 в день" class="food-expense-text" /></ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="resource-box shell-resource-box">
                        <ui:Label name="population-label" text="Население: 24" class="resource-value" /><ui:VisualElement class="resource-test-controls"><ui:Button name="population-minus10-button" text="−10" class="resource-test-button" /><ui:Button name="population-plus10-button" text="+10" class="resource-test-button" /></ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="resource-box shell-resource-box shell-mood-box">
                        <ui:Label name="mood-label" text="Настроение: 64/100" class="resource-value" /><ui:VisualElement class="resource-test-controls"><ui:Button name="mood-minus10-button" text="−10" class="resource-test-button" /><ui:Button name="mood-plus10-button" text="+10" class="resource-test-button" /></ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:Button name="time-toggle-button" text="ПУСК" tooltip="Продолжить течение времени" class="time-toggle-button shell-time-toggle-button" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement class="top-bar shell-debug-host" />
        <ui:VisualElement name="incident-notification-stack" class="incident-notification-stack" />
        <ui:VisualElement name="incident-modal-overlay" class="incident-modal-overlay">
            <ui:VisualElement class="incident-modal-window">
                <ui:Label name="incident-modal-title" text="ПРОИСШЕСТВИЕ" class="incident-modal-title" />
                <ui:VisualElement class="incident-modal-body">
                    <ui:VisualElement class="incident-image-placeholder"><ui:Label text="ИЗОБРАЖЕНИЕ" class="incident-image-placeholder-text" /></ui:VisualElement>
                    <ui:VisualElement class="incident-modal-text-column"><ui:Label name="incident-modal-description" text="Описание происшествия" class="incident-modal-description" /><ui:Label name="incident-modal-consequence" text="Последствие" class="incident-modal-consequence" /></ui:VisualElement>
                </ui:VisualElement>
                <ui:Button name="incident-understood-button" text="ПОНЯТНО" class="incident-understood-button" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="game-over-overlay" class="game-over-overlay">
            <ui:VisualElement class="game-over-window">
                <ui:Label text="ВАС СВЕРГЛИ" class="game-over-title" />
                <ui:Label text="Подданные наконец достигли редкого политического согласия: король им больше не нужен." class="game-over-description" />
                <ui:Label name="game-over-days-label" text="Вы удерживали трон: 0 дней" class="game-over-days" />
                <ui:Button name="restart-game-button" text="НАЧАТЬ ЗАНОВО" class="game-over-restart-button" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- P09: Лагерь — постоянный, скрытый по умолчанию экран (та же
             роль верхнего уровня, что incident-modal-overlay/game-over-
             overlay выше). Позиция/размеры/арт/цвет читаются из
             Prototype_Camp.uss и Kingdom Survival -> UI Конструктор
             (KingdomSurvivalUILayouts.asset, экран "camp"), а не из C# —
             PrototypeUIController.Camp.cs только ищет эти узлы по имени и
             подставляет текст/видимость. -->
        <ui:VisualElement name="camp-screen" class="camp-screen">
            <ui:VisualElement name="camp-header" class="camp-header">
                <ui:Label name="camp-title" text="ЛАГЕРЬ" class="camp-title" />
                <ui:Label name="camp-time-label" text="" class="camp-time-label" />
                <ui:Label name="camp-location-label" text="" class="camp-location-label" />
                <ui:Button name="camp-close-button" text="ЗАКРЫТЬ" class="camp-close-button" />
            </ui:VisualElement>
            <ui:VisualElement name="camp-body" class="camp-body">
                <ui:VisualElement name="camp-party-panel" class="camp-panel camp-party-panel">
                    <ui:Label text="ОТРЯД" class="camp-panel-title" />
                    <ui:VisualElement name="camp-commander-slot" class="camp-roster-slot camp-commander-slot">
                        <ui:Label name="camp-commander-name" text="" class="camp-roster-name" />
                        <ui:Label name="camp-commander-status" text="—" class="camp-roster-status" />
                    </ui:VisualElement>
                    <ui:VisualElement name="camp-fighter-slot-1" class="camp-roster-slot">
                        <ui:Label name="camp-fighter-name-1" text="" class="camp-roster-name" />
                        <ui:Label name="camp-fighter-status-1" text="—" class="camp-roster-status" />
                    </ui:VisualElement>
                    <ui:VisualElement name="camp-fighter-slot-2" class="camp-roster-slot">
                        <ui:Label name="camp-fighter-name-2" text="" class="camp-roster-name" />
                        <ui:Label name="camp-fighter-status-2" text="—" class="camp-roster-status" />
                    </ui:VisualElement>
                    <ui:VisualElement name="camp-fighter-slot-3" class="camp-roster-slot">
                        <ui:Label name="camp-fighter-name-3" text="" class="camp-roster-name" />
                        <ui:Label name="camp-fighter-status-3" text="—" class="camp-roster-status" />
                    </ui:VisualElement>
                    <ui:VisualElement name="camp-fighter-slot-4" class="camp-roster-slot">
                        <ui:Label name="camp-fighter-name-4" text="" class="camp-roster-name" />
                        <ui:Label name="camp-fighter-status-4" text="—" class="camp-roster-status" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="camp-art" class="camp-art" />
                <ui:VisualElement name="camp-scenes-panel" class="camp-panel camp-scenes-panel">
                    <ui:Label text="СЦЕНЫ" class="camp-panel-title" />
                    <ui:VisualElement name="camp-scene-list" class="camp-scene-list" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="camp-footer" class="camp-footer">
                <ui:VisualElement name="camp-status-panel" class="camp-panel camp-status-panel">
                    <ui:Label text="СОСТОЯНИЕ ПОХОДА" class="camp-panel-title" />
                    <ui:Label name="camp-status-text" text="" class="camp-status-text" />
                </ui:VisualElement>
                <ui:VisualElement name="camp-actions-panel" class="camp-panel camp-actions-panel">
                    <ui:Label text="ДЕЙСТВИЯ" class="camp-panel-title" />
                    <ui:Label name="camp-actions-placeholder" text="Пока нет доступных действий." class="camp-placeholder-text" />
                </ui:VisualElement>
                <ui:Button name="camp-continue-button" text="ПРОДОЛЖИТЬ ПУТЬ" class="camp-continue-button" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- UI-M02: Журнал — постоянный, скрытый по умолчанию экран (та же
             роль верхнего уровня, что camp-screen/incident-modal-overlay/
             game-over-overlay выше). Цвета/панели/кнопки — из общих классов
             Prototype_SharedPanels.uss (.ks-*), раскладка — из Journal.uss,
             позиция/размеры — из Kingdom Survival -> UI Конструктор
             (KingdomSurvivalUILayouts.asset, экран "journal"). C# только
             ищет эти узлы по имени и наполняет данными из
             Chapter01JournalProvider. -->
        <ui:VisualElement name="journal-overlay" class="journal-overlay ks-panel-backdrop">
            <ui:VisualElement name="journal-header" class="journal-header">
                <ui:Label name="journal-title" text="ЖУРНАЛ" class="journal-title ks-gold-text" />
                <ui:Button name="journal-close-button" text="ЗАКРЫТЬ" class="ks-button journal-close-button" />
            </ui:VisualElement>
            <ui:VisualElement name="journal-tabs" class="journal-tabs">
                <ui:Button name="journal-tab-goals" text="ЦЕЛИ" class="ks-button journal-tab nav-button-active" />
                <ui:Button
                    name="journal-tab-chronicle"
                    text="ХРОНИКА"
                    tooltip="Хроника событий будет подключена позже."
                    class="ks-button journal-tab" />
            </ui:VisualElement>
            <ui:VisualElement name="journal-columns" class="journal-columns">
                <ui:VisualElement name="journal-goals-column" class="journal-goals-column">
                    <ui:ScrollView
                        name="journal-goals-scroll"
                        class="journal-goals-scroll"
                        horizontal-scroller-visibility="Hidden">
                        <ui:VisualElement name="journal-main-section" class="ks-panel journal-goal-section">
                            <ui:Label name="journal-main-section-title" text="ОСНОВНАЯ ЦЕЛЬ" class="ks-panel-title" />
                            <ui:VisualElement name="journal-main-section-list" class="journal-goal-list" />
                        </ui:VisualElement>
                        <ui:VisualElement name="journal-optional-section" class="ks-panel journal-goal-section">
                            <ui:Label name="journal-optional-section-title" text="ДОПОЛНИТЕЛЬНЫЕ" class="ks-panel-title" />
                            <ui:VisualElement name="journal-optional-section-list" class="journal-goal-list" />
                        </ui:VisualElement>
                        <ui:VisualElement name="journal-completed-section" class="ks-panel journal-goal-section">
                            <ui:Label name="journal-completed-section-title" text="ЗАВЕРШЁННЫЕ" class="ks-panel-title" />
                            <ui:VisualElement name="journal-completed-section-list" class="journal-goal-list" />
                        </ui:VisualElement>
                    </ui:ScrollView>
                </ui:VisualElement>
                <ui:VisualElement name="journal-detail-column" class="journal-detail-column">
                    <ui:ScrollView
                        name="journal-detail-scroll"
                        class="journal-detail-scroll"
                        horizontal-scroller-visibility="Hidden">
                        <ui:VisualElement name="journal-detail-panel" class="ks-panel journal-detail-panel">
                            <ui:Label name="journal-detail-panel-title" text="ВЫБЕРИТЕ ЦЕЛЬ" class="ks-panel-title" />
                            <ui:Label name="journal-detail-title" text="" class="journal-detail-title ks-text" />
                            <ui:Label name="journal-detail-description" text="" class="journal-detail-description ks-text" />
                            <ui:Label name="journal-detail-step-caption" text="ТЕКУЩИЙ ШАГ" class="journal-detail-step-caption ks-muted-text" />
                            <ui:Label name="journal-detail-current-step" text="" class="journal-detail-current-step ks-text" />
                        </ui:VisualElement>
                    </ui:ScrollView>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="hero-screen-overlay" class="hero-screen-overlay ks-panel-backdrop">
            <ui:VisualElement name="hero-screen-header" class="hero-screen-header">
                <ui:Label name="hero-screen-title" text="ГЕРОЙ" class="hero-screen-title ks-gold-text" />
                <ui:Button name="hero-screen-close-button" text="ЗАКРЫТЬ" class="ks-button hero-screen-close-button" />
            </ui:VisualElement>
            <ui:VisualElement name="hero-screen-columns" class="hero-screen-columns">
                <ui:VisualElement name="hero-screen-left-column" class="hero-screen-left-column">
                    <ui:ScrollView name="hero-screen-left-column-scroll" class="hero-screen-column-scroll" horizontal-scroller-visibility="Hidden">
                        <ui:VisualElement name="hero-screen-identity" class="ks-panel">
                            <ui:Label name="hero-screen-identity-title" text="ГЕРОЙ" class="ks-panel-title" />
                            <ui:VisualElement name="hero-screen-portrait" class="hero-screen-portrait-slot" />
                            <ui:Label name="hero-screen-name" text="Командир" class="hero-screen-name ks-text" />
                            <ui:Label name="hero-screen-role" text="Командир поселения" class="hero-screen-role ks-muted-text" />
                            <ui:VisualElement name="hero-screen-experience" class="hero-screen-experience">
                                <ui:VisualElement class="hero-screen-experience-row">
                                    <ui:Label name="hero-screen-level" text="Уровень 1" class="hero-screen-level ks-gold-text" />
                                    <ui:Label name="hero-screen-experience-label" text="система опыта не продумана" class="hero-screen-experience-label ks-muted-text" />
                                </ui:VisualElement>
                                <ui:VisualElement name="hero-screen-experience-track" class="hero-screen-experience-track">
                                    <ui:VisualElement name="hero-screen-experience-fill" class="hero-screen-experience-fill" />
                                </ui:VisualElement>
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement name="hero-screen-states" class="ks-panel">
                            <ui:Label name="hero-screen-states-title" text="СОСТОЯНИЯ" class="ks-panel-title" />
                            <ui:VisualElement name="hero-screen-states-row" class="hero-screen-wrap-row">
                                <ui:Label name="hero-screen-state-phase-chip" class="hero-screen-chip" />
