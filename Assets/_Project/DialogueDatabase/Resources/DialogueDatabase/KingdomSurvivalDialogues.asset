        kind: 0
        speakerIdOverride: 
        text: "\u041A\u043E\u0433\u0434\u0430 \u043E\u0433\u043E\u043D\u044C \u043D\u0430\u043A\u043E\u043D\u0435\u0446
          \u0431\u0435\u0440\u0451\u0442\u0441\u044F, \u0441\u043E \u0441\u0442\u043E\u0440\u043E\u043D\u044B
          \u043F\u0440\u043E\u0439\u0434\u0435\u043D\u043D\u043E\u0439 \u0434\u043E\u0440\u043E\u0433\u0438
          \u0434\u043E\u043D\u043E\u0441\u0438\u0442\u0441\u044F \u0433\u043B\u0443\u0445\u043E\u0439
          \u0443\u0434\u0430\u0440.\n\n\u041F\u043E\u0442\u043E\u043C \u0432\u0442\u043E\u0440\u043E\u0439.\n\n\u0414\u043E\u043B\u0433\u0430\u044F
          \u043F\u0430\u0443\u0437\u0430.\n\n\u0415\u0449\u0451 \u0434\u0432\u0430.\n\n\u041F\u043E\u0442\u043E\u043C
          \u043D\u0438\u0447\u0435\u0433\u043E.\n\n\u0422\u044B \u043D\u0435 \u0437\u043D\u0430\u0435\u0448\u044C,
          \u0432\u044B\u0442\u0430\u0449\u0438\u043B\u0438 \u043B\u0438 \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430.
