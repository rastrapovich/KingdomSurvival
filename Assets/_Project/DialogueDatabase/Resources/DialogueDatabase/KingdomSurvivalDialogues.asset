    - id: chapter01.node.09
      speakerId: ostafiy
      text: 
      textBlocks:
      - blockId: chapter01.node.09_main
        kind: 0
        speakerIdOverride: 
        text: "\u0421\u043E\u0431\u0440\u0430\u043D\u043D\u043E\u0433\u043E \u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E,
          \u0447\u0442\u043E\u0431\u044B \u043F\u043E\u043D\u044F\u0442\u044C: \u043F\u0440\u0438\u0447\u0438\u043D\u0430
          \u043D\u0435 \u0432 \u0441\u0430\u043C\u043E\u043C \u0440\u0435\u043C\u043E\u043D\u0442\u0435,
          \u0430 \u0432 \u0447\u0451\u043C-\u0442\u043E \u0431\u043E\u043B\u0435\u0435
          \u0441\u0442\u0430\u0440\u043E\u043C. \u041F\u043E\u0440\u0430 \u0438\u0434\u0442\u0438
          \u0442\u0443\u0434\u0430, \u043E\u0442\u043A\u0443\u0434\u0430 \u0442\u0435\u0447\u0451\u0442
          \u0432\u043E\u0434\u0430 \u2014 \u0437\u0430 \u043F\u0440\u0435\u0434\u0435\u043B\u044B
          \u043F\u0440\u0438\u0432\u044B\u0447\u043D\u044B\u0445 \u0442\u0440\u043E\u043F
          \u0414\u043E\u043C\u0430."
