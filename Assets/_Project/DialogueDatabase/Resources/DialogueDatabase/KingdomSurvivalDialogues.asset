    - id: chapter01.node.02_side_ostafiy
      speakerId: ostafiy
      text: 
      textBlocks:
      - blockId: chapter01.node.02_side_ostafiy_main
        kind: 0
        speakerIdOverride: 
        text: "\u041E\u0441\u0442\u0430\u0444\u0438\u0439 \u043A\u043E\u0440\u043E\u0442\u043A\u043E
          \u043A\u0438\u0432\u0430\u0435\u0442 \u2014 \u043D\u0435 \u043F\u043E\u0431\u0435\u0434\u043D\u043E,
          \u0441\u043A\u043E\u0440\u0435\u0435 \u0441 \u043E\u0431\u043B\u0435\u0433\u0447\u0435\u043D\u0438\u0435\u043C,
          \u0447\u0442\u043E \u0435\u0433\u043E \u0432\u043E\u043E\u0431\u0449\u0435
          \u0443\u0441\u043B\u044B\u0448\u0430\u043B\u0438. \xAB\u0425\u043E\u0442\u044C
          \u043E\u0434\u0438\u043D \u0432 \u0414\u043E\u043C\u0435 \u0435\u0449\u0451
          \u043F\u043E\u043C\u043D\u0438\u0442, \u0447\u0442\u043E \u043D\u0435 \u0432\u0441\u0451
          \u043C\u0435\u0440\u044F\u0435\u0442\u0441\u044F \u0440\u0435\u0439\u043A\u043E\u0439\xBB,
          \u2014 \u0433\u043E\u0432\u043E\u0440\u0438\u0442 \u043E\u043D \u0438 \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u0435\u0442\u0441\u044F
          \u043A \u0437\u0430\u0441\u043E\u0432\u0443."
