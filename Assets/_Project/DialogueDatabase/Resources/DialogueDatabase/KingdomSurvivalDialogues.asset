        kind: 4
        conditions:
          Combinator: 0
          Conditions: []
        unavailablePresentation: 0
        check:
          CheckId: 
          Kind: 0
          Quality: 0
          CompetencyId: 
          Difficulty: 13
          ModifierRules: []
        successNodeId: 
        failureNodeId: 
        successEffects: []
        failureEffects: []
      editorPosition: {x: 460, y: 0}
      hasEditorPosition: 1
    - id: chapter01.node.11.03
      speakerId: narrator
      text: 
      textBlocks:
      - blockId: chapter01.node.11.03_main
        kind: 0
        speakerIdOverride: 
        text: "Через низину можно пройти прямо. До другого края — меньше получаса. Старый путь делает крюк на несколько часов."
        conditions:
          Combinator: 0
          Conditions: []
        hasPassiveCheck: 0
        passiveCheck:
          CheckId: 
          Kind: 0
          Quality: 0
          CompetencyId: 
          Difficulty: 13
          ModifierRules: []
        onRevealEffects: []
      - blockId: chapter01.node.11.03_check_success
        kind: 0
        speakerIdOverride: 
        text: "Самая странная часть дороги — не крюк. Странно то, что старая колея несколько раз подходит к низине почти вплотную и каждый раз отворачивает.\n\nНа двух деревьях по разные стороны сохранился один и тот же старый знак. Не предупреждение об обрыве. Не метка брода. Похоже на границу."
        conditions:
          Combinator: 0
          Conditions: []
        hasPassiveCheck: 1
        passiveCheck:
          CheckId: chapter01.check.road_reading
          Kind: 0
          Quality: 3
          CompetencyId: fieldcraft
          Difficulty: 13
          ModifierRules: []
        onRevealEffects:
        - EffectExecutionId: chapter01.effect.n11_knowledge_road_avoided_lowland
