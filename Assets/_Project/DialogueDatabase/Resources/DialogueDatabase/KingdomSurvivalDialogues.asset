    nodes:
    - id: freeplay.mine.entry.start
      speakerId: narrator
      text: 
      textBlocks:
      - blockId: freeplay.mine.entry.start.scene
        kind: 5
        speakerIdOverride: 
        text: "\u0428\u0442\u043E\u043B\u044C\u043D\u0438 \u0441\u0443\u0445\u0438\u0435,
          \u043A\u0430\u043A \u0438 \u0433\u043E\u0432\u043E\u0440\u0438\u043B\u0438.
          \u0423 \u0432\u0445\u043E\u0434\u0430 \u2014 \u043E\u0442\u0432\u0430\u043B\u044B,
          \u0437\u0430\u0440\u043E\u0441\u0448\u0438\u0435 \u0438\u0432\u0430\u043D-\u0447\u0430\u0435\u043C,
          \u0438 \u0438\u0437 \u043D\u0438\u0445 \u0442\u043E\u0440\u0447\u0438\u0442
          \u0436\u0435\u043B\u0435\u0437\u043E: \u0433\u0434\u0435 \u0441\u043A\u043E\u0431\u0430,
          \u0433\u0434\u0435 \u043E\u0431\u0443\u0445, \u0433\u0434\u0435 \u0447\u0442\u043E-\u0442\u043E,
          \u0447\u0435\u043C\u0443 \u0443\u0436\u0435 \u043D\u0435\u0442 \u0438\u043C\u0435\u043D\u0438."
