      - Id: village.rest
        Type: 3
        Label: "\u041F\u0435\u0440\u0435\u043D\u043E\u0447\u0435\u0432\u0430\u0442\u044C
          \u0432 \u0438\u0437\u0431\u0435"
        Hint: "\u041D\u043E\u0447\u043B\u0435\u0433 \u043F\u043E\u0434 \u043A\u0440\u044B\u0448\u0435\u0439
          \u0434\u043B\u044F \u0442\u0435\u0445, \u043A\u0442\u043E \u0432\u043E\u0448\u0451\u043B."
        TargetId: 
