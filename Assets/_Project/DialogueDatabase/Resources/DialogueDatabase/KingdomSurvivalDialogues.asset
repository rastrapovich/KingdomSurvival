      - blockId: chapter01.node.08.check_failure_main
        kind: 0
        speakerIdOverride: 
        text: "\u0417\u0443\u0431\u0446\u044B \u0441\u043B\u0438\u0448\u043A\u043E\u043C
          \u0441\u0442\u0451\u0440\u0442\u044B, \u0430 \u0441\u0442\u0430\u0440\u044B\u0439
