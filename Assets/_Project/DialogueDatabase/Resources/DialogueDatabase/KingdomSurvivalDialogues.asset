          \u043F\u043E\u0434\u0445\u043E\u0434\u0438\u0442 \u043A \u043D\u0438\u0437\u0438\u043D\u0435
          \u043F\u043E\u0447\u0442\u0438 \u0432\u043F\u043B\u043E\u0442\u043D\u0443\u044E
          \u0438 \u043A\u0430\u0436\u0434\u044B\u0439 \u0440\u0430\u0437 \u043E\u0442\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u0435\u0442.\n\n\u041D\u0430
          \u0434\u0432\u0443\u0445 \u0434\u0435\u0440\u0435\u0432\u044C\u044F\u0445
          \u043F\u043E \u0440\u0430\u0437\u043D\u044B\u0435 \u0441\u0442\u043E\u0440\u043E\u043D\u044B
          \u0441\u043E\u0445\u0440\u0430\u043D\u0438\u043B\u0441\u044F \u043E\u0434\u0438\u043D
          \u0438 \u0442\u043E\u0442 \u0436\u0435 \u0441\u0442\u0430\u0440\u044B\u0439
          \u0437\u043D\u0430\u043A. \u041D\u0435 \u043F\u0440\u0435\u0434\u0443\u043F\u0440\u0435\u0436\u0434\u0435\u043D\u0438\u0435
