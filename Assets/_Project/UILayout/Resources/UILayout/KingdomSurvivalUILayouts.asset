    displayName: "\u041B\u0430\u0433\u0435\u0440\u044C"
    description: "\u041F\u043E\u0441\u0442\u043E\u044F\u043D\u043D\u044B\u0439 fullscreen-\u044D\u043A\u0440\u0430\u043D
      \u043F\u043E\u0445\u043E\u0434\u0430: \u043E\u0442\u0440\u044F\u0434, \u0438\u043B\u043B\u044E\u0441\u0442\u0440\u0430\u0446\u0438\u044F
      \u043C\u0435\u0441\u0442\u0430, \u0434\u043E\u0441\u0442\u0443\u043F\u043D\u0430\u044F
      \u0430\u0432\u0442\u043E\u0440\u0441\u043A\u0430\u044F \u0441\u0446\u0435\u043D\u0430
      \u0438 \u043C\u0435\u0441\u0442\u043E \u0434\u043B\u044F \u0431\u0443\u0434\u0443\u0449\u0438\u0445
      \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0439. \u041D\u0435 CampManager
      \u0438 \u043D\u0435 survival-\u0441\u0438\u0441\u0442\u0435\u043C\u0430 \u2014
      \u0442\u043E\u043B\u044C\u043A\u043E \u043F\u043E\u043A\u0430\u0437 \u0441\u043E\u0441\u0442\u043E\u044F\u043D\u0438\u044F
      \u0438 \u0437\u0430\u043F\u0443\u0441\u043A Dialogue System \u0447\u0435\u0440\u0435\u0437
      Chapter01CampSceneProvider."
