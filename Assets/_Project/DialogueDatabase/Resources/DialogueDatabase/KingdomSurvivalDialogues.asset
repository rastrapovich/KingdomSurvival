        kind: 0
        speakerIdOverride: 
        text: "\u2014 \u0414\u0435\u0434 \u043C\u043E\u0439 \u0441\u043E\u043B\u044C
          \u0432\u043E\u0437\u0438\u043B. \u041F\u043E\u043C\u0438\u0440\u0430\u044F,
          \u0441\u043A\u0430\u0437\u0430\u043B: \u0443 \u0441\u0442\u0430\u0440\u043E\u0433\u043E
          \u0440\u0443\u0441\u043B\u0430, \u043F\u043E\u0434 \u0438\u0432\u043E\u0439
          \u0441 \u0442\u0440\u0435\u043C\u044F \u0437\u0430\u0440\u0443\u0431\u043A\u0430\u043C\u0438,
          \u0433\u043E\u0440\u0448\u043E\u043A. \u0421\u0435\u0440\u0435\u0431\u0440\u043E
          \u2014 \u0431\u0435\u0440\u0438 \u043A\u0442\u043E \u043D\u0430\u0439\u0434\u0451\u0442,
          \u0430 \u043D\u043E\u0436 \u0435\u0433\u043E \u0441 \u043C\u0435\u0434\u043D\u043E\u0439
          \u043D\u0430\u0441\u0435\u0447\u043A\u043E\u0439 \u2014 \u043C\u043D\u0435.
          \u0421\u0430\u043C \u044F \u0442\u0443\u0434\u0430 \u043D\u0435 \u0434\u043E\u0439\u0434\u0443:
          \u0441\u043F\u0438\u043D\u0430. \u0413\u0434\u0435 \u0438\u0432\u0430 \u2014
          \u0441\u043A\u0430\u0436\u0443 \u0437\u0430 \u0434\u0432\u0435\u043D\u0430\u0434\u0446\u0430\u0442\u044C.
          \u042F \u043D\u0435 \u0436\u0430\u0434\u043D\u044B\u0439, \u0443 \u043C\u0435\u043D\u044F
          \u043F\u0440\u043E\u0441\u0442\u043E \u0434\u0435\u0442\u0438."
