  - Id: gloom
    Name: "\u041C\u0440\u0430\u0447\u043D\u044B\u0439"
    Note: "\u0421\u0443\u043C\u0435\u0440\u043A\u0438 \u0442\u0451\u043C\u043D\u043E\u0433\u043E
      \u0444\u044D\u043D\u0442\u0435\u0437\u0438: \u043F\u0440\u0438\u0433\u043B\u0443\u0448\u0451\u043D\u043D\u044B\u0435
      \u0441\u0438\u0437\u043E-\u043B\u0438\u043B\u043E\u0432\u044B\u0435 \u0442\u0435\u043D\u0438,
      \u043E\u043B\u0438\u0432\u043A\u043E\u0432\u043E-\u0431\u0443\u0440\u0430\u044F
      \u0437\u0435\u043C\u043B\u044F, \u0442\u0451\u043F\u043B\u044B\u0435 \u043E\u0433\u043D\u0438
      \u043E\u043A\u043E\u043D \u0438 \u0444\u043E\u043D\u0430\u0440\u0435\u0439."
