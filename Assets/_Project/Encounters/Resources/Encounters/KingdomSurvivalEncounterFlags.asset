  - FlagId: ROAD_WARM_SHEEP_MAN_SUPPLIED
    DisplayName: "\u0427\u0435\u043B\u043E\u0432\u0435\u043A\u0443 \u043E\u0441\u0442\u0430\u0432\u0438\u043B\u0438
