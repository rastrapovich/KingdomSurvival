    - id: chapter01.node.13.approach_calm
      speakerId: downstream_voice
      text:
      textBlocks:
      - blockId: chapter01.node.13.approach_calm_main
        kind: 0
        speakerIdOverride:
        text: "\u0411\u043E\u0439\u0446\u044B \u0437\u0430 \u0441\u043F\u0438\u043D\u043E\u0439 \u0433\u0435\u0440\u043E\u044F \u043E\u043F\u0443\u0441\u043A\u0430\u044E\u0442 \u0440\u0443\u043A\u0438 \u043E\u0442 \u043E\u0440\u0443\u0436\u0438\u044F, \u043A\u0442\u043E-\u0442\u043E
          \u043E\u0442\u0441\u0442\u0443\u043F\u0430\u0435\u0442 \u043D\u0430 \u043F\u043E\u043B\u0448\u0430\u0433\u0430 \u043D\u0430\u0437\u0430\u0434. \u041C\u0443\u0436\u0447\u0438\u043D\u0430 \u0441\u043C\u043E\u0442\u0440\u0438\u0442 \u043D\u0430 \u044D\u0442\u043E \u0434\u043E\u043B\u044C\u0448\u0435,
          \u0447\u0435\u043C \u043D\u0430 \u043B\u0438\u0446\u043E \u0433\u0435\u0440\u043E\u044F, \u0438 \u0447\u0443\u0442\u044C \u0440\u0430\u0441\u0441\u043B\u0430\u0431\u043B\u044F\u0435\u0442 \u043F\u043B\u0435\u0447\u0438."
