    - id: take_meat_now
      speakerId: narrator
      text: 
      textBlocks:
      - blockId: b_butcher
        kind: 5
        speakerIdOverride: 
        text: "\u041D\u043E\u0436 \u0432\u0445\u043E\u0434\u0438\u0442 \u0442\u044F\u0436\u0435\u043B\u043E.
          \u0428\u043A\u0443\u0440\u0430 \u0435\u0449\u0451 \u0434\u0435\u0440\u0436\u0438\u0442
          \u0442\u0435\u043F\u043B\u043E.\n\n\u0427\u0435\u0440\u0435\u0437 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E
          \u043C\u0438\u043D\u0443\u0442 \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0441\u044F
          \u044F\u0441\u043D\u043E, \u0447\u0442\u043E \u043F\u0435\u0440\u0435\u0434\u043D\u044E\u044E
          \u043F\u043E\u043B\u043E\u0432\u0438\u043D\u0443 \u0442\u0443\u0448\u0438
          \u043D\u0438\u043A\u0442\u043E \u043D\u0435 \u0442\u0440\u043E\u0433\u0430\u043B.
          \u0414\u043B\u044F \u0434\u043E\u0440\u043E\u0433\u0438 \u043C\u044F\u0441\u0430
          \u0437\u0434\u0435\u0441\u044C \u0431\u043E\u043B\u044C\u0448\u0435, \u0447\u0435\u043C
          \u043C\u043E\u0436\u043D\u043E \u0443\u043D\u0435\u0441\u0442\u0438 \u0431\u0435\u0437
          \u043B\u0438\u0448\u043D\u0435\u0433\u043E \u0432\u0435\u0441\u0430.\n\n\u0412
          \u0448\u0435\u0440\u0441\u0442\u0438 \u043D\u0430 \u0431\u0440\u044E\u0445\u0435
          \u0437\u0430\u0441\u0442\u0440\u044F\u043B \u0434\u043B\u0438\u043D\u043D\u044B\u0439
          \u0441\u0443\u0445\u043E\u0439 \u043B\u0438\u0441\u0442. \u0422\u0430\u043A\u0438\u0445
          \u0432\u043E\u0437\u043B\u0435 \u0434\u043E\u0440\u043E\u0433\u0438 \u043D\u0435\u0442."
