          StringParam: chapter01.knowledge.old_road_avoided_lowland
          IntParam: 0
      - blockId: chapter01.node.11.03_check_failure
        kind: 0
        speakerIdOverride: 
        text: "Очевидное объяснение находится быстро: раньше здесь наверняка стояла вода. Болото ушло, а старая дорога осталась."
        conditions:
          Combinator: 0
          Conditions:
          - Type: 9
            StringParam: chapter01.check.road_reading
            QualityParam: 0
            IntParam: 0
            Negate: 0
        hasPassiveCheck: 0
        passiveCheck:
          CheckId: 
