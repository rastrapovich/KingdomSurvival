        kind: 5
        speakerIdOverride: 
        text: "\u041A\u043B\u0435\u0439\u043C\u043E \u0432\u044B\u0431\u0438\u0442\u043E
          \u043E\u0434\u043D\u0438\u043C \u0438 \u0442\u0435\u043C \u0436\u0435 \u043F\u0443\u0430\u043D\u0441\u043E\u043D\u043E\u043C
          \u2014 \u0440\u043E\u0432\u043D\u043E, \u0431\u0435\u0437 \u043F\u0435\u0440\u0435\u043A\u043E\u0441\u0430.
          \u042D\u0442\u043E \u043D\u0435 \u043A\u0443\u0437\u043D\u0435\u0446-\u043E\u0434\u0438\u043D\u043E\u0447\u043A\u0430,
          \u044D\u0442\u043E \u043C\u0430\u0441\u0442\u0435\u0440\u0441\u043A\u0430\u044F:
          \u043A\u0442\u043E-\u0442\u043E \u043C\u0435\u0442\u0438\u043B \u0441\u0432\u043E\u0451
          \u0436\u0435\u043B\u0435\u0437\u043E, \u0447\u0442\u043E\u0431\u044B \u0435\u0433\u043E
          \u0443\u0437\u043D\u0430\u0432\u0430\u043B\u0438."
