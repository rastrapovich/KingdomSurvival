      - blockId: chapter01.node.12.talk_gauge
        kind: 1
        speakerIdOverride:
        text: "\u041E\u043D\u0430 \u0441\u043C\u043E\u0442\u0440\u0438\u0442 \u043D\u0430 \u043F\u043B\u0430\u0441\u0442\u0438\u043D\u0443 \u0443 \u043F\u043E\u044F\u0441\u0430 \u0433\u0435\u0440\u043E\u044F \u0434\u043E\u043B\u044C\u0448\u0435, \u0447\u0435\u043C \u043D\u0430
          \u043B\u0438\u0446\u043E. \u2014 \u0422\u0430\u043A\u0443\u044E \u0432\u0435\u0449\u044C \u0443 \u043D\u0430\u0441 \u043D\u0430\u0437\u044B\u0432\u0430\u043B\u0438 \u043C\u0435\u0440\u043E\u0439. \u0415\u0439 \u043C\u0435\u0440\u0438\u043B\u0438, \u0441\u043A\u043E\u043B\u044C\u043A\u043E
          \u0432\u043E\u0434\u044B \u043E\u0442\u043F\u0443\u0441\u0442\u0438\u0442\u044C, \u0430 \u043D\u0435 \u0432\u0437\u044F\u0442\u044C."
