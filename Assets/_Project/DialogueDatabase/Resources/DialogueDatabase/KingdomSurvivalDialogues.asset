      - blockId: chapter01.node.05.check_livestock_main
        kind: 0
        speakerIdOverride: ulyana
        text: "\u2014 \u0414\u043E \u0432\u0435\u0447\u0435\u0440\u0430 \u0437\u0430\u0433\u043E\u043D
          \u043F\u0435\u0440\u0435\u0441\u0447\u0438\u0442\u0430\u044E \u0435\u0449\u0451
          \u0440\u0430\u0437. \u041F\u043E\u0442\u043E\u043C \u0441\u043A\u0430\u0436\u0443,
          \u0441\u043A\u043E\u043B\u044C\u043A\u043E \u043C\u044B \u043F\u043E\u0442\u0435\u0440\u044F\u043B\u0438.
          \u0421\u0435\u0439\u0447\u0430\u0441 \u043C\u043D\u0435 \u0432\u0430\u0436\u043D\u0435\u0435
          \u0437\u043D\u0430\u0442\u044C, \u0441\u043A\u043E\u043B\u044C\u043A\u043E
          \u043B\u044E\u0434\u0435\u0439 \u0432\u044B \u0437\u0430\u0431\u0435\u0440\u0451\u0442\u0435
          \u043D\u0430 \u043F\u043B\u043E\u0442\u0438\u043D\u0443."
