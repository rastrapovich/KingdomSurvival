  dialogues:
  - id: chapter01_dialogue_01_ordinary_morning
    title: "N01 \u2014 \u041E\u0431\u044B\u0447\u043D\u043E\u0435 \u0443\u0442\u0440\u043E
      / \u041B\u0438\u0448\u043D\u0438\u0439 \u0445\u043B\u0435\u0431"
    category: 1
    status: 1
    developerComment: "P04-T05 production-\u0442\u0435\u043A\u0441\u0442. \u0423\u043B\u044C\u044F\u043D\u0430
      \u0438 \u0432\u0442\u043E\u0440\u043E\u0439 \u0445\u043B\u0435\u0431 \u0431\u0435\u0437
      \u043E\u0431\u044A\u044F\u0441\u043D\u044F\u044E\u0449\u0435\u0439 \u043B\u0435\u043A\u0446\u0438\u0438;
      \u043A\u043E\u0440\u043E\u0442\u043A\u0438\u0439 \u043C\u043E\u043C\u0435\u043D\u0442
      \u0441 \u041E\u0441\u0442\u0430\u0444\u0438\u0435\u043C; \u041B\u0430\u0434\u0430
      \u043F\u043E\u043A\u0430\u0437\u0430\u043D\u0430 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435\u043C;
      \u043C\u0435\u043B\u044C\u043D\u0438\u0446\u0430 \u041C\u0438\u0440\u043E\u043D\u0430
      \u2014 \u0447\u0430\u0441\u0442\u044C \u0444\u043E\u043D\u0430. \u041F\u0430\u0441\u0441\u0438\u0432\u043D\u043E\u0435
      \u0421\u0443\u0436\u0434\u0435\u043D\u0438\u0435 11 \u2014 \u043D\u0435\u043E\u0431\u044F\u0437\u0430\u0442\u0435\u043B\u044C\u043D\u043E\u0435
      \u0440\u0430\u043D\u043D\u0435\u0435 \u043D\u0430\u0431\u043B\u044E\u0434\u0435\u043D\u0438\u0435
      (\u043D\u0435 \u043B\u0435\u043A\u0446\u0438\u044F, \u0442\u0438\u0445\u043E\u0435
      \u0443\u043C\u043E\u0437\u0430\u043A\u043B\u044E\u0447\u0435\u043D\u0438\u0435
      \u0433\u0435\u0440\u043E\u044F)."
    startNodeId: chapter01.node.01
    tags:
    - "\u0433\u043B\u0430\u0432\u043001"
    - production
    nodes:
    - id: chapter01.node.01
      speakerId: ulyana
      text: 
      textBlocks:
      - blockId: chapter01.node.01_main
        kind: 0
        speakerIdOverride: 
        text: "\u0423\u043B\u044C\u044F\u043D\u0430 \u0432\u044B\u043D\u0438\u043C\u0430\u0435\u0442
          \u0438\u0437 \u043F\u0435\u0447\u0438 \u0432\u0442\u043E\u0440\u043E\u0439
          \u043A\u0430\u0440\u0430\u0432\u0430\u0439 \u2014 \u0441\u0432\u0435\u0440\u0445
          \u043E\u0431\u044B\u0447\u043D\u043E\u0439 \u043D\u043E\u0440\u043C\u044B
          \u2014 \u0438 \u0437\u0430\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u0435\u0442
          \u0435\u0433\u043E \u0432 \u0445\u043E\u043B\u0441\u0442\u0438\u043D\u0443.
          \xAB\u041E\u0442\u043D\u0435\u0441\u0438 \u043A \u0441\u0435\u0434\u044C\u043C\u043E\u043C\u0443
          \u0437\u0430\u0442\u0432\u043E\u0440\u0443, \u043A\u0430\u043A \u0432\u0441\u0435\u0433\u0434\u0430\xBB,
          \u2014 \u0433\u043E\u0432\u043E\u0440\u0438\u0442 \u043E\u043D\u0430, \u043D\u0435
          \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u044F \u0433\u043B\u0430\u0437
          \u043E\u0442 \u0442\u0435\u0441\u0442\u0430."
        conditions:
          Combinator: 0
          Conditions: []
        hasPassiveCheck: 0
        passiveCheck:
          CheckId: 
          Kind: 0
          Quality: 0
          CompetencyId: 
          Difficulty: 13
          ModifierRules: []
        onRevealEffects:
        - EffectExecutionId: chapter01.effect.n01_flag1
          Type: 0
          StringParam: chapter01.flag.started
          IntParam: 0
        - EffectExecutionId: chapter01.effect.n01_flag2
          Type: 0
          StringParam: chapter01.flag.home_intro_seen
          IntParam: 0
        - EffectExecutionId: chapter01.effect.n01_home_baseline
          Type: 0
          StringParam: chapter01.flag.home_baseline_captured
          IntParam: 0
      - blockId: chapter01.node.01_observation
        kind: 1
        speakerIdOverride: 
        text: "\u041E\u043D\u0430 \u0437\u0430\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u0435\u0442
          \u0431\u0443\u0445\u0430\u043D\u043A\u0443 \u043D\u0435 \u043F\u0440\u0430\u0437\u0434\u043D\u0438\u0447\u043D\u044B\u043C
          \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u0435\u043C \u0438 \u043D\u0435
          \u0442\u0430\u043A, \u043A\u0430\u043A \u043F\u043E\u0434\u0430\u044E\u0442
          \u043C\u0438\u043B\u043E\u0441\u0442\u044B\u043D\u044E, \u2014 \u0430 \u0431\u0443\u0434\u043D\u0438\u0447\u043D\u043E,
          \u043A\u0430\u043A \u043E\u0442\u0434\u0430\u044E\u0442 \u0442\u043E, \u0447\u0442\u043E
          \u0434\u0430\u0432\u043D\u043E \u0438 \u0431\u0435\u0437 \u0441\u043F\u043E\u0440\u0430
          \u0441\u0447\u0438\u0442\u0430\u0435\u0442\u0441\u044F \u0447\u0443\u0436\u0438\u043C.
          \u0414\u0435\u043B\u043E, \u0430 \u043D\u0435 \u0434\u0430\u0440."
        conditions:
          Combinator: 0
          Conditions: []
        hasPassiveCheck: 1
        passiveCheck:
          CheckId: chapter01.check.second_loaf_judgment
          Kind: 0
          Quality: 4
          CompetencyId: 
          Difficulty: 11
          ModifierRules: []
        onRevealEffects:
        - EffectExecutionId: chapter01.effect.n01_knowledge1
          Type: 2
          StringParam: chapter01.knowledge.second_loaf_is_ration
          IntParam: 0
      choices:
      - text: "\u0421\u043F\u0440\u043E\u0441\u0438\u0442\u044C, \u043A\u043E\u043C\u0443
          \u043F\u0440\u0435\u0434\u043D\u0430\u0437\u043D\u0430\u0447\u0435\u043D
          \u0445\u043B\u0435\u0431."
        nextNodeId: chapter01.node.01_ask
        endsDialogue: 0
        choiceId: chapter01.node.01_ask_choice
        kind: 0
        conditions:
          Combinator: 0
          Conditions: []
        unavailablePresentation: 0
        check:
          CheckId: 
          Kind: 0
          Quality: 0
          CompetencyId: 
          Difficulty: 13
          ModifierRules: []
        successNodeId: 
        failureNodeId: 
        successEffects: []
        failureEffects: []
      - text: "\u041D\u0435 \u0441\u043F\u0440\u0430\u0448\u0438\u0432\u0430\u0442\u044C
          \u0438 \u0437\u0430\u043D\u044F\u0442\u044C\u0441\u044F \u0441\u0432\u043E\u0438\u043C\u0438
          \u0434\u0435\u043B\u0430\u043C\u0438."
        nextNodeId: chapter01.node.01_ostafiy
        endsDialogue: 0
        choiceId: chapter01.node.01_skip_choice
