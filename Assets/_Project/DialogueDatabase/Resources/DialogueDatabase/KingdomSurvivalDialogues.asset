        kind: 0
        speakerIdOverride: 
        text: "\u2014 \u0421\u0442\u0430\u0440\u043E\u0441\u0442\u0430 \u0443\u0436\u0435
          \u043D\u0430 \u043F\u043E\u043A\u043E\u0441\u0430\u0445, \u0430 \u0432\u0435\u0441\u0442\u044C
          \u0442\u0430\u043A \u0438 \u043D\u0435 \u0434\u043E\u0448\u043B\u0430.
          \u041D\u0443 \u0447\u0442\u043E \u0436. \u041E\u0442\u043F\u0440\u0430\u0432\u043B\u044E
          \u0441 \u043A\u0435\u043C-\u043D\u0438\u0431\u0443\u0434\u044C \u0435\u0449\u0451."
