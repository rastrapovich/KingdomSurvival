          RewardText: 
        - Id: notice.village.wolf_gone
          Title: "\u0412\u043E\u043B\u043A\u0430 \u0431\u043E\u043B\u044C\u0448\u0435
            \u043D\u0435\u0442"
          Text: "\u0412\u044B\u0448\u0430\u0442\u0430, \u043D\u0435 \u0434\u043E\u0436\u0438\u0434\u0430\u044F\u0441\u044C
            \u0432\u043E\u043F\u0440\u043E\u0441\u0430: \xAB\u0412\u043E\u043B\u043A\u0430
            \u0443 \u0434\u043E\u0440\u043E\u0433\u0438 \u0443\u043B\u043E\u0436\u0438\u043B\u0438.
            \u041A\u0442\u043E \u2014 \u0442\u043E\u043B\u043A\u043E\u043C \u043D\u0435
            \u0437\u043D\u0430\u044E\u0442, \u043D\u043E \u0432\u043E\u0437\u0447\u0438\u043A\u0438
            \u0442\u0435\u043F\u0435\u0440\u044C \u043D\u043E\u0447\u0443\u044E\u0442
            \u0443 \u043D\u0430\u0441, \u0430 \u043D\u0435 \u0432 \u043B\u0435\u0441\u0443.
            \u0418 \u0442\u043E\u0440\u0433 \u0431\u043E\u0439\u0447\u0435\u0435
            \u043F\u043E\u0448\u0451\u043B\xBB."
          Type: 5
          Medium: 3
          AuthorName: "\u0441\u0442\u0430\u0440\u043E\u0441\u0442\u0430 \u0412\u044B\u0448\u0430\u0442\u0430"
