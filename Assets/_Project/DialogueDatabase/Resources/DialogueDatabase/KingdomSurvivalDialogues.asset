      - blockId: chapter01.node.12.woman_small_party
        kind: 0
        speakerIdOverride:
        text: "\u041E\u043D\u0430 \u0443\u0441\u043C\u0435\u0445\u0430\u0435\u0442\u0441\u044F \u043E\u0434\u043D\u0438\u043C \u0443\u0433\u043E\u043B\u043A\u043E\u043C \u0440\u0442\u0430. \u2014 \u0414\u0432\u043E\u0435 \u2014 \u044D\u0442\u043E \u0435\u0449\u0451 \u043D\u0435
          \u043E\u0442\u0440\u044F\u0434. \u0425\u043E\u0442\u044C \u043D\u0435 \u043F\u0443\u0433\u0430\u0435\u0442."
