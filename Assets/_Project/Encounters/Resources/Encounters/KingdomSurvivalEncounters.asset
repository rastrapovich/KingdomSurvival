  pools:
  - PoolId: ROAD_POOL_01
    DisplayName: "\u0414\u043E\u0440\u043E\u0436\u043D\u044B\u0435 \u0432\u0441\u0442\u0440\u0435\u0447\u0438
      (\u043F\u0435\u0440\u0432\u044B\u0439 \u0440\u0435\u0433\u0438\u043E\u043D)"
    Enabled: 1
    GlobalTriggerChancePercent: 60
    MinimumHoursBetweenEncounters: 24
    MinimumHoursBetweenReactiveEncounters: 0
    MaxReactiveEncountersPerTravelDay: 0
    DesignerNotes: "\u041F\u0420-12: 20 \u0441\u0430\u043C\u043E\u0441\u0442\u043E\u044F\u0442\u0435\u043B\u044C\u043D\u044B\u0445
      \u043C\u0430\u043B\u044B\u0445 \u0438\u0441\u0442\u043E\u0440\u0438\u0439 \u0438
      \u043E\u0442\u0434\u0435\u043B\u044C\u043D\u0430\u044F \u0431\u043E\u043B\u044C\u0448\u0430\u044F
      \u0438\u0441\u0442\u043E\u0440\u0438\u044F \xAB\u0422\u0451\u043F\u043B\u0430\u044F
      \u043E\u0432\u0446\u0430\xBB. \u041E\u0434\u043D\u043E \u0434\u043E\u0440\u043E\u0436\u043D\u043E\u0435
      \u0441\u043E\u0431\u044B\u0442\u0438\u0435 \u0432 \u0441\u0443\u0442\u043A\u0438
      \u043C\u0430\u043A\u0441\u0438\u043C\u0443\u043C."
  encounters:
  - EncounterId: ROAD_WARM_SHEEP_01
    DisplayName: "\u0422\u0451\u043F\u043B\u0430\u044F \u043E\u0432\u0446\u0430"
    Description: "\u041E\u0432\u0446\u0430 \u043B\u0435\u0436\u0438\u0442 \u043F\u043E\u0447\u0442\u0438
      \u043F\u043E\u0441\u0440\u0435\u0434\u0438 \u0434\u043E\u0440\u043E\u0433\u0438,
      \u0435\u0449\u0451 \u0442\u0451\u043F\u043B\u0430\u044F. \u0413\u043E\u0440\u043B\u043E
      \u0446\u0435\u043B\u043E, \u0437\u0430\u0434\u043D\u044F\u044F \u043D\u043E\u0433\u0430
      \u043E\u0431\u043E\u0434\u0440\u0430\u043D\u0430 \u0434\u043E \u043A\u043E\u0441\u0442\u0438."
