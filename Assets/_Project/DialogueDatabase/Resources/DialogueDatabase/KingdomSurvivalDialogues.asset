    - id: chapter01.node.12.direction
      speakerId: ford_woman
      text:
      textBlocks:
      - blockId: chapter01.node.12.direction_main
        kind: 0
        speakerIdOverride:
        text: "\u2014 \u0414\u0430\u043B\u044C\u0448\u0435 \u043F\u043E \u0442\u0435\u0447\u0435\u043D\u0438\u044E \u2014 \u043B\u044E\u0434\u0438, \u2014 \u043E\u043D\u0430 \u0432\u044B\u0442\u0438\u0440\u0430\u0435\u0442 \u0440\u0443\u043A\u0438 \u0438 \u0441\u043C\u043E\u0442\u0440\u0438\u0442
          \u0432\u043D\u0438\u0437 \u043F\u043E \u0432\u043E\u0434\u0435. \u2014 \u041D\u0435 \u043C\u043E\u0438, \u043D\u043E \u0432\u043E\u0434\u0443 \u0434\u0435\u043B\u044F\u0442 \u0442\u0443 \u0436\u0435. \u0421\u043A\u0430\u0436\u0438, \u0447\u0442\u043E \u0448\u0451\u043B
          \u043C\u0438\u043C\u043E, \u0430 \u043D\u0435 \u0447\u0442\u043E \u0448\u0451\u043B \u043A \u043D\u0438\u043C \u2014 \u0442\u0430\u043A \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u0435\u0435 \u0434\u043B\u044F \u0432\u0441\u0435\u0445."
