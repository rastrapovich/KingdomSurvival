  screens:
  - id: narrative-dialogue
    displayName: "\u0414\u0438\u0430\u043B\u043E\u0433"
    description: "UI-M04: \u043F\u043E\u0441\u0442\u043E\u044F\u043D\u043D\u0430\u044F
      \u0441\u0442\u0440\u0443\u043A\u0442\u0443\u0440\u0430 \u2014 Prototype_Main.uxml
      (narrative-dialogue-overlay) + Narrative.uss; \u043F\u0440\u0438\u043C\u0435\u043D\u044F\u0435\u0442\u0441\u044F
      \u043E\u0431\u0449\u0438\u043C UILayoutScreenBinder. portrait \u2014 \u0438\u0441\u043A\u043B\u044E\u0447\u0435\u043D\u0438\u0435
      (Kind.Portrait \u0432\u0441\u0435\u0433\u0434\u0430 \u043F\u043E\u043B\u0443\u0447\u0430\u0435\u0442
      Rect/Background \u043E\u0442 \u0431\u0430\u0439\u043D\u0434\u0435\u0440\u0430);
      \u043F\u043E\u0437\u0438\u0446\u0438\u0438 \u043E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u0445
      \u044D\u043B\u0435\u043C\u0435\u043D\u0442\u043E\u0432 \u0434\u0435\u0440\u0436\u0438\u0442
      CSS, override-\u0444\u043B\u0430\u0433\u0438 \u0432\u044B\u043A\u043B\u044E\u0447\u0435\u043D\u044B.
      \u041F\u043E\u0440\u0442\u0440\u0435\u0442 \u0433\u043E\u0432\u043E\u0440\u044F\u0449\u0435\u0433\u043E
      \u043F\u043E-\u043F\u0440\u0435\u0436\u043D\u0435\u043C\u0443 \u0441\u0442\u0430\u0432\u0438\u0442
      \u0437\u0430\u0449\u0438\u0449\u0451\u043D\u043D\u044B\u0439 \u043A\u043E\u0434
      PrototypeUIController.ApplyNarrativeSpeakerPortrait."
    usesDimming: 1
    dimmingOpacity: 0.91
    autoApply: 1
