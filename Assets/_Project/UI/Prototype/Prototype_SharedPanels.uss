/* Общая палитра/компонентные классы, вынесенные из приватных констант и
   хелперов PrototypeUIController.HeroScreen.cs (HeroScreenBackdrop/Panel/
   PanelDeep/Border/Gold/Text/Muted/SlotEmpty, CreateHeroScreenPanel,
   StyleHeroScreenButton) — единый источник для любого экрана, использующего
   этот визуальный язык, а не копия в каждом партиал-файле контроллера.
   Journal (UI-M02) — первый потребитель; Hero Screen при своей миграции
   (UI-M03) переходит на эти же классы и удаляет исходные C#-константы.
   ProjectDocs/UI_ARCHITECTURE.md §6. */

.ks-panel-backdrop {
    background-color: rgba(14, 16, 20, 0.97);
}

.ks-panel {
    background-color: rgb(42, 46, 54);
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 8px;
    padding-bottom: 8px;
    margin-bottom: 10px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(91, 80, 62);
    border-right-color: rgb(91, 80, 62);
    border-top-color: rgb(91, 80, 62);
    border-bottom-color: rgb(91, 80, 62);
}

.ks-panel-title {
    color: rgb(221, 181, 99);
    font-size: 11px;
    -unity-font-style: bold;
    margin-bottom: 6px;
}

.ks-panel-deep {
    background-color: rgb(27, 31, 37);
}

.ks-border {
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(91, 80, 62);
    border-right-color: rgb(91, 80, 62);
    border-top-color: rgb(91, 80, 62);
    border-bottom-color: rgb(91, 80, 62);
}

.ks-gold-text {
    color: rgb(221, 181, 99);
}

.ks-text {
    color: rgb(226, 219, 204);
}

.ks-muted-text {
    color: rgb(156, 154, 148);
}

.ks-slot-empty {
    background-color: rgb(33, 37, 44);
}

.ks-button {
    color: rgb(226, 219, 204);
    font-size: 11px;
    background-color: rgb(27, 31, 37);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(91, 80, 62);
    border-right-color: rgb(91, 80, 62);
    border-top-color: rgb(91, 80, 62);
    border-bottom-color: rgb(91, 80, 62);
    border-radius: 3px;
}

.ks-button:hover {
    background-color: rgb(38, 43, 50);
}

.ks-button:disabled {
    opacity: 0.4;
}
