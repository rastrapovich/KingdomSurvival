        successEffects: []
        failureEffects: []
      - text: "\u041D\u0435 \u0432\u0441\u0442\u0430\u0432\u0430\u0442\u044C \u043D\u0438
          \u043D\u0430 \u0447\u044C\u044E \u0441\u0442\u043E\u0440\u043E\u043D\u0443:
          \xAB\u041F\u0443\u0441\u0442\u044C \u0440\u0435\u0448\u0430\u0435\u0442
          \u0442\u043E\u0442, \u043A\u0442\u043E \u0434\u0435\u0440\u0436\u0438\u0442
          \u0438\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442\xBB."
