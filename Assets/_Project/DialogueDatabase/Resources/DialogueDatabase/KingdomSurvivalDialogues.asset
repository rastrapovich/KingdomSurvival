          Difficulty: 13
          ModifierRules: []
        onRevealEffects: []
      choices:
      - text: "\u041D\u0430\u0432\u0430\u043B\u0438\u0442\u044C\u0441\u044F \u043D\u0430
          \u0441\u0442\u0432\u043E\u0440 \u0432\u0441\u0435\u043C \u0442\u0435\u043B\u043E\u043C
          \u2014 \u0441\u0434\u0432\u0438\u043D\u0443\u0442\u044C \u0435\u0433\u043E
          \u0441\u0438\u043B\u043E\u0439."
