    - id: inspect_success
      speakerId: narrator
      text: 
      textBlocks:
      - blockId: b_success
        kind: 1
        speakerIdOverride: 
        text: "\u0428\u0435\u0440\u0441\u0442\u044C \u0432\u043E\u043A\u0440\u0443\u0433
          \u0440\u0430\u043D\u044B \u043F\u043E\u0447\u0442\u0438 \u0441\u0443\u0445\u0430\u044F.
          \u0417\u0443\u0431\u044B \u0437\u0434\u0435\u0441\u044C \u0431\u044B\u043B\u0438
          \u2014 \u043D\u043E \u0443\u0436\u0435 \u043F\u043E\u0441\u043B\u0435 \u0441\u043C\u0435\u0440\u0442\u0438.\n\n\u041D\u0430
          \u0432\u043D\u0443\u0442\u0440\u0435\u043D\u043D\u0435\u0439 \u0441\u0442\u043E\u0440\u043E\u043D\u0435
          \u043D\u043E\u0433\u0438 \u0432\u0438\u0434\u043D\u044B \u0434\u0440\u0443\u0433\u0438\u0435
          \u0441\u043B\u0435\u0434\u044B: \u043A\u043E\u0440\u043E\u0442\u043A\u0438\u0435
          \u043F\u0440\u044F\u043C\u044B\u0435 \u043D\u0430\u0434\u0440\u0435\u0437\u044B.
          \u041D\u043E\u0436 \u0431\u044B\u043B \u0442\u0443\u043F\u043E\u0439. \u0418
          \u0442\u043E\u0442, \u043A\u0442\u043E \u0438\u043C \u0440\u0430\u0431\u043E\u0442\u0430\u043B,
          \u043E\u0447\u0435\u043D\u044C \u0441\u043F\u0435\u0448\u0438\u043B.\n\n\u041A\u0442\u043E-\u0442\u043E
          \u0440\u0430\u0437\u0434\u0435\u043B\u044B\u0432\u0430\u043B \u043E\u0432\u0446\u0443
          \u0441\u043E\u0432\u0441\u0435\u043C \u043D\u0435\u0434\u0430\u0432\u043D\u043E.\n\n\u0412
          \u0433\u0440\u044F\u0437\u0438 \u043F\u043E\u0434 \u0431\u0440\u044E\u0445\u043E\u043C
          \u043E\u0442\u043F\u0435\u0447\u0430\u0442\u0430\u043B\u0430\u0441\u044C
          \u043F\u044F\u0442\u043A\u0430. \u0427\u0435\u043B\u043E\u0432\u0435\u0447\u0435\u0441\u043A\u0430\u044F.
          \u0411\u0435\u0437 \u0441\u0430\u043F\u043E\u0433\u0430."
        conditions:
