  - id: freeplay_cave_wall
    title: "\u041A\u043B\u0430\u0434\u043A\u0430 \u0432 \u0443\u0441\u0442\u044C\u0435"
    category: 2
    status: 1
    developerComment: "\u041E\u0431\u044A\u0435\u043A\u0442 cave.wall. \u0418\u0437\u043D\u0443\u0442\u0440\u0438
      \u0432\u0438\u0434\u043D\u043E: \u0443\u0441\u0442\u044C\u0435 \u0437\u0430\u043B\u043E\u0436\u0435\u043D\u043E
      \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u043E\u043C, \u0432 \u0441\u043F\u0435\u0448\u043A\u0435.
      \u0421\u0442\u0443\u043A \u0438\u0437 \u0433\u043B\u0443\u0431\u0438\u043D\u044B."
    sceneIllustration: {fileID: 0}
    sceneIllustrationFillFrame: 0
    sceneIllustrationScale: 1
    sceneIllustrationOffsetNormalized: {x: 0, y: 0}
    startNodeId: cave.wall.start
    tags:
    - "\u0441\u0432\u043E\u0431\u043E\u0434\u043D\u0430\u044F_\u0438\u0433\u0440\u0430"
    - "\u043F\u0435\u0449\u0435\u0440\u0430"
    nodes:
    - id: cave.wall.start
      speakerId: narrator
      text: 
      textBlocks:
      - blockId: cave.wall.start.text
        kind: 5
        speakerIdOverride: 
        text: "\u0418\u0437\u043D\u0443\u0442\u0440\u0438 \u0437\u0430\u0432\u0430\u043B
          \u0432\u044B\u0433\u043B\u044F\u0434\u0438\u0442 \u0438\u043D\u0430\u0447\u0435,
          \u0447\u0435\u043C \u0441\u043D\u0430\u0440\u0443\u0436\u0438. \u041A\u0430\u043C\u043D\u0438
          \u043D\u0435 \u0443\u043F\u0430\u043B\u0438 \u2014 \u0438\u0445 \u0441\u043B\u043E\u0436\u0438\u043B\u0438:
          \u043F\u043B\u043E\u0441\u043A\u0438\u0435 \u0432\u043D\u0438\u0437, \u043A\u0440\u0443\u0433\u043B\u044B\u0435
          \u0432 \u0449\u0435\u043B\u0438, \u0441\u0432\u0435\u0440\u0445\u0443 \u043F\u0440\u043E\u043C\u0430\u0437\u0430\u043D\u043E
          \u0433\u043B\u0438\u043D\u043E\u0439 \u043F\u043E\u043F\u043E\u043B\u0430\u043C
          \u0441 \u043C\u0445\u043E\u043C. \u0422\u0430\u043A \u043F\u0435\u0447\u043D\u0438\u043A
          \u043A\u043B\u0430\u0434\u0451\u0442 \u043F\u043E\u0434, \u043A\u043E\u0433\u0434\u0430
          \u0441\u043F\u0435\u0448\u0438\u0442 \u043A \u0443\u0436\u0438\u043D\u0443."
        conditions:
          Combinator: 0
          Conditions: []
        hasPassiveCheck: 0
        passiveCheck:
          CheckId: 
          Kind: 0
          Quality: 0
          CompetencyId: 
          Difficulty: 13
          ModifierRules: []
        onRevealEffects:
        - EffectExecutionId: freeplay.cave.entered
          Type: 0
          StringParam: freeplay.cave.entered
          IntParam: 0
      - blockId: cave.wall.start.haste
        kind: 1
        speakerIdOverride: 
        text: "\u041D\u0438\u0436\u043D\u0438\u0435 \u0440\u044F\u0434\u044B \u0440\u043E\u0432\u043D\u044B\u0435,
          \u0432\u0435\u0440\u0445\u043D\u0438\u0435 \u043D\u0430\u0431\u0440\u043E\u0441\u0430\u043D\u044B
          \u043A\u0430\u043A \u043F\u043E\u043F\u0430\u043B\u043E. \u0422\u043E\u0442,
          \u043A\u0442\u043E \u043A\u043B\u0430\u043B, \u043D\u0430\u0447\u0430\u043B
          \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u043E, \u0430 \u0437\u0430\u043A\u043E\u043D\u0447\u0438\u043B
          \u0442\u0430\u043A, \u0431\u0443\u0434\u0442\u043E \u0437\u0430 \u0441\u043F\u0438\u043D\u043E\u0439
          \u0443\u0436\u0435 \u043A\u0442\u043E-\u0442\u043E \u0434\u044B\u0448\u0430\u043B."
