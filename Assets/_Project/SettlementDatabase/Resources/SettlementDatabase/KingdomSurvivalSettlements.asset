  - Data:
      Id: settlement.trading.post
      Name: "\u0422\u043E\u0440\u0433\u043E\u0432\u043E\u0435 \u0441\u0435\u043B\u043E"
      Kind: 1
      ShortDescription: "\u0422\u043E\u0440\u0433 \u043D\u0430 \u043F\u043B\u043E\u0449\u0430\u0434\u0438,
        \u0433\u0434\u0435 \u0432 \u0442\u043E\u0440\u0433\u043E\u0432\u044B\u0439
        \u0434\u0435\u043D\u044C \u0431\u043E\u043B\u044C\u0448\u0435 \u0442\u0435\u043B\u0435\u0433,
        \u0447\u0435\u043C \u043B\u044E\u0434\u0435\u0439. \u041F\u0430\u0445\u043D\u0435\u0442
        \u0434\u0451\u0433\u0442\u0435\u043C, \u0440\u044B\u0431\u043E\u0439 \u0438
        \u0441\u0432\u0435\u0436\u0438\u043C \u0442\u0451\u0441\u043E\u043C."
      LongDescription: "\u0421\u044E\u0434\u0430 \u0441\u0432\u043E\u0437\u044F\u0442
        \u0432\u043E\u0441\u043A, \u0448\u043A\u0443\u0440\u043A\u0438 \u0438 \u0440\u044B\u0431\u0443,
        \u0430 \u0443\u0432\u043E\u0437\u044F\u0442 \u0441\u043E\u043B\u044C, \u0436\u0435\u043B\u0435\u0437\u043E
        \u0438 \u0441\u043B\u0443\u0445\u0438. \u0421\u043B\u0443\u0445\u0438 \u2014
        \u0431\u0435\u0441\u043F\u043B\u0430\u0442\u043D\u043E, \u043D\u043E \u0441
        \u043D\u0430\u0446\u0435\u043D\u043A\u043E\u0439."
