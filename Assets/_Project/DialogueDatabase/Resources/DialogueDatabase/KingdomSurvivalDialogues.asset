      speakerId: miron
      text: 
      textBlocks:
      - blockId: chapter01.node.07a_main
        kind: 0
        speakerIdOverride: 
        text: "\u041C\u0438\u0440\u043E\u043D \u043F\u0440\u0438\u0437\u043D\u0430\u0451\u0442\u0441\u044F:
          \u044D\u0442\u043E\u0439 \u043D\u043E\u0447\u044C\u044E \u043A\u043E\u043B\u0435\u0441\u043E
          \u043C\u0435\u043B\u044C\u043D\u0438\u0446\u044B \u043A\u0440\u0443\u0442\u0438\u043B\u043E\u0441\u044C
          \u0441\u0430\u043C\u043E, \u0445\u043E\u0442\u044F \u0432\u043E\u0434\u0430
          \u0441\u0442\u043E\u044F\u043B\u0430 \u043F\u043E\u0447\u0442\u0438 \u043D\u0435\u043F\u043E\u0434\u0432\u0438\u0436\u043D\u043E.
          \u0420\u0430\u043D\u044C\u0448\u0435 \u0441\u0435\u0434\u044C\u043C\u043E\u0439
          \u0437\u0430\u0442\u0432\u043E\u0440 \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u043B\u0438
          \u043F\u043E \u0443\u0441\u043B\u043E\u0432\u043D\u044B\u043C \u0441\u0442\u0443\u043A\u0430\u043C
          \u2014 \u0442\u0435\u043F\u0435\u0440\u044C \u044D\u0442\u043E\u0433\u043E
          \u043D\u0435 \u0434\u0435\u043B\u0430\u0435\u0442 \u043D\u0438\u043A\u0442\u043E."
