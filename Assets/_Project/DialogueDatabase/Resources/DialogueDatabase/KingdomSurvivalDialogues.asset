      - blockId: b_confess2
        kind: 4
        speakerIdOverride: traveller
        text: "\xAB\u041A\u0430\u043A\u0438\u0435 \u0433\u043B\u0430\u0437\u0430?\xBB\n\n\u2014
          \u041E\u0432\u0435\u0447\u044C\u0438. \u0422\u043E\u043B\u044C\u043A\u043E
          \u0441\u043C\u043E\u0442\u0440\u0435\u043B\u0430 \u0432\u0441\u0451 \u0432\u0440\u0435\u043C\u044F
          \u0432 \u043E\u0434\u043D\u0443 \u0441\u0442\u043E\u0440\u043E\u043D\u0443.\n\n\xAB\u041A\u0443\u0434\u0430?\xBB\n\n\u0427\u0435\u043B\u043E\u0432\u0435\u043A
          \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442 \u0432 \u043B\u0435\u0441.
          \u041D\u0435 \u043D\u0430 \u0434\u043E\u0440\u043E\u0433\u0443. \u041D\u0435
          \u0442\u0443\u0434\u0430, \u043E\u0442\u043A\u0443\u0434\u0430 \u043F\u0440\u0438\u0448\u0451\u043B.
          \u041F\u0440\u043E\u0441\u0442\u043E \u043C\u0435\u0436\u0434\u0443 \u0434\u0432\u0443\u043C\u044F
          \u0434\u0435\u0440\u0435\u0432\u044C\u044F\u043C\u0438.\n\n\u0422\u0430\u043C
          \u043D\u0438\u0447\u0435\u0433\u043E \u043D\u0435\u0442."
