  - id: settlement_village_hostess
    title: "12\u0422 \u2014 \u0425\u043E\u0437\u044F\u0439\u043A\u0430 \u043F\u043E\u0441\u0442\u043E\u044F\u043B\u043E\u0433\u043E
      \u0434\u0432\u043E\u0440\u0430"
    category: 4
    status: 1
    developerComment: "12\u0422 [\u0420\u0410\u0411\u041E\u0427\u0415\u0415]. \u0425\u043E\u0437\u044F\u0439\u043A\u0430
      \xAB\u0418\u0437\u0431\u044B \u0443 \u0434\u043E\u0440\u043E\u0433\u0438\xBB
      (\u0434\u0435\u0440\u0435\u0432\u043D\u044F). \u041F\u0440\u0435\u0434\u0443\u043F\u0440\u0435\u0436\u0434\u0435\u043D\u0438\u0435
      \u043E \u0437\u0432\u0435\u0440\u0435 \u0443 \u0434\u043E\u0440\u043E\u0433\u0438
      \u2014 \u0442\u043E \u0436\u0435 \u0437\u043D\u0430\u043D\u0438\u0435, \u0447\u0442\u043E
      \u043D\u0430 \u0434\u043E\u0441\u043A\u0435 (settlement.knowledge.wolf_road),
      \u043F\u043E\u043A\u0430 \u0436\u0438\u0432 \u0432\u043E\u0436\u0430\u043A
      \u0443\u0433\u043B\u0435\u0436\u043E\u0433\u043E\u0432; \u043F\u043E\u0441\u043B\u0435
      freeplay.coal.leader_killed \u2014 \u043D\u043E\u0432\u043E\u0441\u0442\u044C."
    sceneIllustration: {fileID: 0}
    sceneIllustrationFillFrame: 0
    sceneIllustrationScale: 1
    sceneIllustrationOffsetNormalized: {x: 0, y: 0}
    startNodeId: settlement.hostess.start
    tags:
    - "\u043F\u043E\u0441\u0435\u043B\u0435\u043D\u0438\u044F"
    - "12\u0422"
    nodes:
    - id: settlement.hostess.start
      speakerId: village_hostess
      text: 
      textBlocks:
      - blockId: settlement.hostess.start.line
        kind: 0
        speakerIdOverride: 
        text: "\u2014 \u041B\u0430\u0432\u043A\u0438 \u0448\u0438\u0440\u043E\u043A\u0438\u0435,
          \u043A\u043B\u043E\u043F\u043E\u0432 \u043C\u0430\u043B\u043E, \u0449\u0438
          \u0432\u0447\u0435\u0440\u0430\u0448\u043D\u0438\u0435, \u043D\u043E \u0447\u0435\u0441\u0442\u043D\u044B\u0435.
          \u0411\u043E\u043B\u044C\u0448\u0435 \u0432 \u043E\u043A\u0440\u0443\u0433\u0435
          \u044D\u0442\u043E\u0433\u043E \u043D\u0438\u043A\u0442\u043E \u043D\u0435
          \u0441\u043A\u0430\u0436\u0435\u0442."
        conditions:
          Combinator: 0
          Conditions: []
        hasPassiveCheck: 0
        passiveCheck:
          CheckId: 
