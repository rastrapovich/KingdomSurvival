    - id: chapter01.node.13.approach
      speakerId: downstream_voice
      text:
      textBlocks:
      - blockId: chapter01.node.13.approach_main
        kind: 0
        speakerIdOverride:
        text: "\u041D\u0430\u0432\u0441\u0442\u0440\u0435\u0447\u0443 \u0432\u044B\u0445\u043E\u0434\u0438\u0442 \u043D\u0435\u0432\u044B\u0441\u043E\u043A\u0438\u0439 \u043C\u0443\u0436\u0447\u0438\u043D\u0430 \u0432 \u0440\u0430\u0431\u043E\u0447\u0435\u0439 \u043E\u0434\u0435\u0436\u0434\u0435 \u2014
          \u043D\u0435 \u0441\u0442\u0430\u0440\u0435\u0439\u0448\u0438\u043D\u0430, \u0441\u0443\u0434\u044F \u043F\u043E \u0432\u0438\u0434\u0443, \u043F\u0440\u043E\u0441\u0442\u043E \u0442\u043E\u0442, \u043A\u0442\u043E \u043E\u043A\u0430\u0437\u0430\u043B\u0441\u044F \u0431\u043B\u0438\u0436\u0435.
          \u041E\u043D \u043E\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u0435\u0442\u0441\u044F \u043D\u0430 \u0442\u0430\u043A\u043E\u043C \u0440\u0430\u0441\u0441\u0442\u043E\u044F\u043D\u0438\u0438, \u0447\u0442\u043E\u0431\u044B \u0443\u0441\u043F\u0435\u0442\u044C \u0443\u0439\u0442\u0438,
          \u0435\u0441\u043B\u0438 \u043F\u0440\u0438\u0434\u0451\u0442\u0441\u044F."
        conditions:
          Combinator: 0
          Conditions: []
