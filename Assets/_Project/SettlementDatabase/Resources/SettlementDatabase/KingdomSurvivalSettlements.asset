      Board:
        Enabled: 1
        Name: "\u0414\u043E\u0441\u043A\u0430 \u0443 \u0442\u043E\u0440\u0433\u0430"
        Description: "\u0414\u043E\u0449\u0435\u0447\u043A\u0438 \u043D\u0430 \u0433\u0432\u043E\u0437\u0434\u044F\u0445
          \u0443 \u0432\u043E\u0440\u043E\u0442 \u0442\u043E\u0440\u0433\u0430. \u0413\u0440\u0430\u043C\u043E\u0442\u043D\u044B\u0445
          \u0442\u0443\u0442 \u0434\u0432\u043E\u0435: \u0434\u044C\u044F\u0447\u043E\u043A
          \u0438 \u0442\u043E\u0442, \u043A\u0442\u043E \u0434\u044C\u044F\u0447\u043A\u0443
          \u0434\u043E\u043B\u0436\u0435\u043D."
        ReaderNote: "\u0417\u0430 \u043C\u0435\u0434\u044F\u043A \u0434\u044C\u044F\u0447\u043E\u043A
          \u043F\u0440\u043E\u0447\u0442\u0451\u0442 \u0432\u0441\u043B\u0443\u0445;
          \u0437\u0430 \u0434\u0432\u0430 \u2014 \u0441 \u0432\u044B\u0440\u0430\u0436\u0435\u043D\u0438\u0435\u043C."
        Notices:
        - Id: notice.trade.carter
          Title: "\u0418\u0449\u0443 \u0434\u0435\u0434\u043E\u0432 \u043D\u043E\u0436"
          Text: "\u041D\u0430 \u0434\u043E\u0449\u0435\u0447\u043A\u0435 \u0432\u044B\u0436\u0436\u0435\u043D\u044B
            \u043D\u043E\u0436 \u0441 \u0442\u0440\u0435\u043C\u044F \u0432\u0438\u0442\u043A\u0430\u043C\u0438
            \u043D\u0430 \u0440\u0443\u043A\u043E\u044F\u0442\u0438 \u0438 \u0438\u0432\u0430.
            \u0414\u044C\u044F\u0447\u043E\u043A \u0447\u0438\u0442\u0430\u0435\u0442:
            \xAB\u041A\u0442\u043E \u043D\u0430\u0439\u0434\u0451\u0442 \u043F\u043E\u0434
            \u0438\u0432\u043E\u0439 \u0443 \u0441\u0442\u0430\u0440\u043E\u0433\u043E
            \u0440\u0443\u0441\u043B\u0430 \u0434\u0435\u0434\u043E\u0432\u043E \u0434\u043E\u0431\u0440\u043E
            \u2014 \u0441\u0435\u0440\u0435\u0431\u0440\u043E \u0441\u0435\u0431\u0435,
            \u043D\u043E\u0436 \u043C\u043D\u0435. \u0421\u043F\u0440\u043E\u0441\u0438\u0442\u044C
            \u0416\u0434\u0430\u043D\u0430-\u0432\u043E\u0437\u0447\u0438\u043A\u0430
            \u0432 \u043A\u043E\u0440\u0447\u043C\u0435\xBB."
          Type: 0
          Medium: 1
          AuthorName: "\u0432\u043E\u0437\u0447\u0438\u043A \u0416\u0434\u0430\u043D"
          ContactName: "\u0416\u0434\u0430\u043D, \u0432 \u043A\u043E\u0440\u0447\u043C\u0435
            \u0443 \u0442\u043E\u0440\u0433\u0430"
          ContactPersonId: carter
          ErrandId: settlement.errand.carter_knife
          DialogueId: 
          KnowledgeId: 
