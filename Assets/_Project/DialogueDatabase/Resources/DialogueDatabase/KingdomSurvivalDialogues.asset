        text: "\xAB\u0418\u043B\u0438 \u043D\u0435 \u0440\u0430\u0441\u0441\u0443\u0436\u0434\u0430\u0439\xBB,
          \u2014 \u0442\u0443\u0442 \u0436\u0435 \u0434\u043E\u0431\u0430\u0432\u043B\u044F\u0435\u0442
          \u041B\u0430\u0434\u0430. \u2014 \xAB\u041F\u0440\u043E\u0441\u0442\u043E
          \u0434\u0430\u0439 \u043C\u043D\u0435 \u0437\u0430\u043A\u043E\u043D\u0447\u0438\u0442\u044C
          \u2014 \u0438 \u0432\u0441\u0451 \u0432\u0441\u0442\u0430\u043D\u0435\u0442
          \u043D\u0430 \u043C\u0435\u0441\u0442\u043E \u0431\u0435\u0437 \u0441\u0443\u0434\u0430\xBB."
        conditions:
          Combinator: 0
