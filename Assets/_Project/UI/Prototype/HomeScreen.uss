/* ================================================================
   ЭКРАН ДОМА (ПР-07А-2, PR07_HOME_SPEC §4). Прокручиваемая часть —
   сводка, образ Дома, заботы, дела главы, люди; панель подготовки
   похода закреплена внизу и видна вместе с кандидатами.
   ================================================================ */

.home-screen {
    flex-direction: column;
}

.home-screen-scroll {
    flex-grow: 1;
    flex-shrink: 1;
    height: auto;
}

.home-screen-panel {
    padding-bottom: 12px;
}

.home-header {
    flex-direction: row;
    align-items: flex-start;
    flex-wrap: wrap;
    margin-bottom: 10px;
}

.home-title {
    margin-right: 18px;
    margin-bottom: 4px;
}

.home-summary {
    flex-grow: 1;
    flex-shrink: 1;
    margin-bottom: 0;
}

.home-summary-strip {
    flex-direction: row;
    flex-wrap: wrap;
}

.home-summary-box {
    min-width: 170px;
    margin-right: 8px;
    margin-bottom: 6px;
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 6px;
    padding-bottom: 6px;
    align-items: flex-start;
    -unity-text-align: upper-left;
}

.home-summary-hint {
    font-size: 11px;
    white-space: normal;
    max-width: 260px;
    color: rgb(193, 183, 158);
}

.home-summary-detail {
    display: none;
    font-size: 12px;
    white-space: normal;
    max-width: 900px;
    color: rgb(226, 214, 186);
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 6px;
    padding-bottom: 6px;
    background-color: rgb(40, 44, 52);
}

.home-away-notice {
    display: none;
    font-size: 14px;
    white-space: normal;
    color: rgb(226, 214, 186);
    padding-top: 12px;
    padding-bottom: 12px;
}

.home-main-row {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: flex-start;
}

.home-scene-column {
    flex-grow: 3;
    flex-shrink: 1;
    flex-basis: 480px;
    min-width: 360px;
    max-width: 900px;
    margin-right: 12px;
    margin-bottom: 12px;
}

.home-side-column {
    flex-grow: 2;
    flex-shrink: 1;
    flex-basis: 360px;
    min-width: 300px;
    max-width: 700px;
}

/* ---- Образ Дома: схема из слоёв. Рисунки художника — в
   Resources/HomeScene/<слой>_<состояние>.png, см. ProjectDocs/HOME_SCENE_ART_LIST.md. */

.home-scene {
    position: relative;
    height: 260px;
    background-color: rgb(38, 45, 38);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(79, 72, 63);
    border-right-color: rgb(79, 72, 63);
    border-top-color: rgb(79, 72, 63);
    border-bottom-color: rgb(79, 72, 63);
    margin-bottom: 8px;
}

.home-scene-layer {
    position: absolute;
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    padding-left: 6px;
    padding-right: 6px;
    padding-top: 4px;
    padding-bottom: 4px;
    align-items: flex-start;
    justify-content: flex-end;
    background-color: rgba(70, 64, 52, 0.85);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgb(120, 108, 88);
    border-right-color: rgb(120, 108, 88);
    border-top-color: rgb(120, 108, 88);
    border-bottom-color: rgb(120, 108, 88);
    -unity-background-scale-mode: scale-to-fit;
}

.home-scene-layer--art {
    background-color: rgba(0, 0, 0, 0);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
}

.home-scene-layer--selected {
    border-left-color: rgb(226, 190, 120);
    border-right-color: rgb(226, 190, 120);
    border-top-color: rgb(226, 190, 120);
    border-bottom-color: rgb(226, 190, 120);
    border-left-width: 3px;
    border-right-width: 3px;
    border-top-width: 3px;
    border-bottom-width: 3px;
}

.home-scene-caption {
    font-size: 11px;
    white-space: normal;
    color: rgb(236, 226, 200);
    -unity-font-style: bold;
}

.home-scene-yard { left: 2%; top: 4%; width: 30%; height: 30%; }
.home-scene-livestock { left: 68%; top: 4%; width: 30%; height: 30%; }
.home-scene-mill { left: 40%; top: 18%; width: 24%; height: 40%; }
.home-scene-walkway { left: 66%; top: 40%; width: 24%; height: 18%; }
.home-scene-dam { left: 4%; top: 40%; width: 30%; height: 22%; }
.home-scene-water { left: 0; top: 70%; width: 100%; height: 30%; background-color: rgba(52, 78, 96, 0.9); }

/* Состояние — не только цветом: рамка меняет вид, подпись называет его. */
.home-scene-layer--FloodDisturbed { background-color: rgba(84, 78, 58, 0.95); border-top-width: 6px; }
.home-scene-layer--Wrong { background-color: rgba(64, 52, 86, 0.95); border-left-width: 6px; border-right-width: 6px; border-left-color: rgb(170, 130, 210); border-right-color: rgb(170, 130, 210); }
.home-scene-layer--RestoredOldPattern { background-color: rgba(52, 84, 96, 0.9); }
.home-scene-layer--AlteredByNewRepair { background-color: rgba(52, 96, 90, 0.9); border-bottom-width: 6px; }
.home-scene-layer--DamagedOrStopped,
.home-scene-layer--Destroyed,
.home-scene-layer--Damaged,
.home-scene-layer--Broken,
.home-scene-layer--Lost { background-color: rgba(96, 58, 48, 0.9); border-left-color: rgb(214, 128, 92); border-right-color: rgb(214, 128, 92); border-top-color: rgb(214, 128, 92); border-bottom-color: rgb(214, 128, 92); }
.home-scene-layer--ChosenOld,
.home-scene-layer--ChosenNew,
.home-scene-layer--Repairing,
.home-scene-layer--AvoidingWater { background-color: rgba(96, 84, 48, 0.9); border-top-width: 6px; }

/* ---- Объекты Дома */

.home-objects-list {
    flex-direction: column;
}

.home-object-row {
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 6px;
    padding-bottom: 6px;
    margin-bottom: 4px;
    background-color: rgb(34, 38, 45);
    border-left-width: 3px;
    border-left-color: rgb(79, 72, 63);
}

.home-object-row--selected {
    border-left-color: rgb(226, 190, 120);
    background-color: rgb(44, 48, 56);
}

.home-object-title {
    -unity-font-style: bold;
    font-size: 13px;
    color: rgb(226, 214, 186);
}

.home-object-state {
    font-size: 12px;
    white-space: normal;
    color: rgb(214, 204, 180);
}

.home-object-source {
    font-size: 11px;
    white-space: normal;
    color: rgb(160, 152, 132);
    -unity-font-style: italic;
}

.home-object-action {
    align-self: flex-start;
    height: 28px;
    margin-top: 4px;
    font-size: 12px;
}

/* ---- Заботы */

.home-cares-list {
    flex-direction: column;
    margin-top: 6px;
}

.home-care-card {
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 8px;
    padding-bottom: 8px;
    margin-bottom: 6px;
    background-color: rgb(40, 44, 52);
    border-left-width: 3px;
    border-left-color: rgb(120, 108, 88);
}

.home-care-card--urgent {
    border-left-color: rgb(214, 128, 92);
}

.home-care-title {
    -unity-font-style: bold;
    font-size: 14px;
    color: rgb(226, 214, 186);
}

.home-care-cause,
.home-care-status,
.home-care-detail {
    font-size: 12px;
    white-space: normal;
    color: rgb(200, 190, 166);
}

.home-care-status {
    color: rgb(226, 214, 186);
}

.home-care-action {
    align-self: flex-start;
    height: 30px;
    margin-top: 6px;
    font-size: 12px;
}

/* ---- Подготовка похода (закреплена внизу) */

.home-prep-panel {
    flex-shrink: 0;
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 8px;
    padding-bottom: 8px;
    background-color: rgb(30, 34, 40);
    border-top-width: 2px;
    border-top-color: rgb(120, 108, 88);
}

.home-prep-header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 6px;
}

.home-prep-title {
    margin-right: 12px;
    margin-bottom: 0;
}

.home-prep-message {
    flex-grow: 1;
    flex-shrink: 1;
    font-size: 12px;
    white-space: normal;
    color: rgb(226, 214, 186);
}

.home-prep-route-button {
    width: 180px;
    height: 34px;
    margin-top: 0;
    font-size: 14px;
}

.home-prep-body {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: stretch;
}

.home-prep-slots {
    flex-direction: row;
    flex-wrap: wrap;
    flex-shrink: 0;
    margin-right: 10px;
}

.home-prep-slot {
    width: 128px;
    min-height: 92px;
    margin-right: 6px;
    margin-bottom: 6px;
    padding-left: 6px;
    padding-right: 6px;
    padding-top: 4px;
    padding-bottom: 4px;
    background-color: rgb(44, 48, 56);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgb(90, 84, 72);
    border-right-color: rgb(90, 84, 72);
    border-top-color: rgb(90, 84, 72);
    border-bottom-color: rgb(90, 84, 72);
}

.home-prep-slot--commander {
    border-left-color: rgb(226, 190, 120);
    border-right-color: rgb(226, 190, 120);
    border-top-color: rgb(226, 190, 120);
    border-bottom-color: rgb(226, 190, 120);
}

.home-prep-slot--retinue {
    margin-left: 8px;
    border-left-color: rgb(120, 150, 170);
    border-right-color: rgb(120, 150, 170);
    border-top-color: rgb(120, 150, 170);
    border-bottom-color: rgb(120, 150, 170);
}

.home-prep-slot--empty {
    background-color: rgb(36, 40, 46);
}

.home-prep-slot--blocked {
    border-left-color: rgb(214, 128, 92);
    border-right-color: rgb(214, 128, 92);
    border-top-color: rgb(214, 128, 92);
    border-bottom-color: rgb(214, 128, 92);
}

.home-prep-slot-caption {
    font-size: 10px;
    color: rgb(160, 152, 132);
}

.home-prep-slot-name {
    font-size: 13px;
    -unity-font-style: bold;
    color: rgb(236, 226, 200);
    white-space: normal;
}

.home-prep-slot-role,
.home-prep-slot-state {
    font-size: 11px;
    white-space: normal;
    color: rgb(193, 183, 158);
}

.home-prep-slot-buttons {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 2px;
}

.home-prep-slot-button {
    height: 22px;
    font-size: 11px;
    margin-left: 0;
    margin-right: 3px;
    margin-top: 2px;
    margin-bottom: 0;
    padding-left: 4px;
    padding-right: 4px;
}

.home-prep-candidates {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 280px;
    padding-left: 6px;
    padding-right: 6px;
    padding-top: 4px;
    padding-bottom: 4px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(60, 58, 54);
    border-right-color: rgb(60, 58, 54);
    border-top-color: rgb(60, 58, 54);
    border-bottom-color: rgb(60, 58, 54);
}

.home-prep-filters {
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
    margin-bottom: 4px;
}

.home-prep-filter {
    height: 22px;
    font-size: 11px;
    margin-left: 0;
    margin-right: 4px;
}

.home-prep-filter--selected {
    border-bottom-width: 2px;
    border-bottom-color: rgb(226, 190, 120);
}

.home-prep-candidates-hint {
    font-size: 11px;
    color: rgb(160, 152, 132);
    white-space: normal;
    margin-left: 6px;
}

.home-prep-candidate-list {
    flex-direction: row;
    flex-wrap: wrap;
}

.home-prep-candidate {
    width: 132px;
    margin-right: 6px;
    margin-bottom: 6px;
    padding-left: 6px;
    padding-right: 6px;
    padding-top: 4px;
    padding-bottom: 4px;
    background-color: rgb(44, 48, 56);
    border-left-width: 2px;
    border-left-color: rgb(90, 84, 72);
}

.home-prep-candidate--blocked {
    opacity: 0.7;
    border-left-color: rgb(214, 128, 92);
}

.home-prep-draggable:hover {
    background-color: rgb(52, 56, 66);
}

.home-prep-drag-source {
    opacity: 0.45;
}

.home-prep-drop--valid {
    border-left-color: rgb(140, 196, 120);
    border-right-color: rgb(140, 196, 120);
    border-top-color: rgb(140, 196, 120);
    border-bottom-color: rgb(140, 196, 120);
}

.home-prep-drop--invalid {
    opacity: 0.5;
}

.home-prep-ghost {
    position: absolute;
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 6px;
    padding-bottom: 6px;
    font-size: 13px;
    -unity-font-style: bold;
    color: rgb(236, 226, 200);
    background-color: rgba(60, 64, 74, 0.8);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(226, 190, 120);
    border-right-color: rgb(226, 190, 120);
    border-top-color: rgb(226, 190, 120);
    border-bottom-color: rgb(226, 190, 120);
}

.home-prep-forecast {
    font-size: 12px;
    white-space: normal;
    color: rgb(214, 204, 180);
    margin-top: 4px;
    max-height: 96px;
    overflow: hidden;
}

.person-row--prepared .person-row-status {
    color: rgb(226, 190, 120);
}
