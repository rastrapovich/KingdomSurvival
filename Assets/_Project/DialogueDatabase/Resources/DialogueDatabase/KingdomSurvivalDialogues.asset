    - id: chapter01.node.04.failure_workers
      speakerId: narrator
      text:
      textBlocks:
      - blockId: chapter01.node.04.failure_workers_main
        kind: 0
        speakerIdOverride:
        text: "\u041D\u0435\u0441\u043C\u043E\u0442\u0440\u044F \u043D\u0430 \u0432\u0441\u0451, \u0447\u0442\u043E \u043F\u043E\u0448\u043B\u043E \u043D\u0435 \u0442\u0430\u043A, \u0442\u044B \u0443\u0441\u043F\u0435\u0432\u0430\u0435\u0448\u044C \u0432\u044B\u0442\u043E\u043B\u043A\u043D\u0443\u0442\u044C \u0440\u0430\u0431\u043E\u0442\u043D\u0438\u043A\u043E\u0432 \u043D\u0430 \u0441\u0443\u0445\u043E\u0435 \u2014 \u043E\u043D\u0438 \u0446\u0435\u043B\u044B, \u0445\u043E\u0442\u044C \u0438 \u043E\u0433\u043B\u0443\u0448\u0435\u043D\u044B. \u0422\u0435\u0431\u0435 \u044D\u0442\u043E \u0441\u0442\u043E\u0438\u0442 \u0434\u043E\u0440\u043E\u0433\u043E: \u0440\u0443\u043A\u0443 \u043F\u0440\u0438\u0436\u0430\u043B\u043E \u043E\u0431\u043B\u043E\u043C\u043A\u043E\u043C, \u0438 \u0431\u043E\u043B\u044C \u043D\u0435 \u043E\u0442\u043F\u0443\u0441\u043A\u0430\u0435\u0442. \u041F\u043E\u043A\u0430 \u0442\u044B \u0432\u043E\u0437\u0438\u0448\u044C\u0441\u044F \u0441 \u043B\u044E\u0434\u044C\u043C\u0438, \u0432\u043E\u0434\u0430 \u0443\u043D\u043E\u0441\u0438\u0442 \u0441\u043A\u043E\u0442\u0438\u043D\u0443, \u0430 \u043D\u0430\u0441\u0442\u0438\u043B \u0443 \u043C\u0435\u043B\u044C\u043D\u0438\u0446\u044B \u0441 \u0442\u0440\u0435\u0441\u043A\u043E\u043C \u043E\u0431\u0440\u0443\u0448\u0438\u0432\u0430\u0435\u0442\u0441\u044F \u0432 \u043F\u043E\u0442\u043E\u043A."
