          \u043D\u043E\u0433\u043E\u0439, \u0441 \u043D\u043E\u0436\u043E\u043C,
          \u0441 \u0442\u0435\u043C \u043D\u0435\u043C\u043D\u043E\u0433\u0438\u043C
          \u043C\u044F\u0441\u043E\u043C, \u0447\u0442\u043E \u043E\u0441\u0442\u0430\u043B\u043E\u0441\u044C.
