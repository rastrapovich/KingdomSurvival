        kind: 4
        conditions:
          Combinator: 0
          Conditions: []
        unavailablePresentation: 0
        check:
          CheckId: 
          Kind: 0
          Quality: 0
          CompetencyId: 
          Difficulty: 13
          ModifierRules: []
        successNodeId: 
        failureNodeId: 
        successEffects: []
        failureEffects: []
      editorPosition: {x: 60, y: 0}
      hasEditorPosition: 1
    - id: chapter01.node.11.02
      speakerId: narrator
      text: 
      textBlocks:
      - blockId: chapter01.node.11.02_main
        kind: 0
        speakerIdOverride: 
        text: "Дорога подходит к сухой низине и резко забирает влево, будто обходя то, чего здесь больше нет."
        conditions:
          Combinator: 0
          Conditions: []
        hasPassiveCheck: 0
        passiveCheck:
          CheckId: 
          Kind: 0
          Quality: 0
          CompetencyId: 
          Difficulty: 13
