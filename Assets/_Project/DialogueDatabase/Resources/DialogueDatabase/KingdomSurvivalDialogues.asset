      - blockId: chapter01.node.12.woman_line
        kind: 0
        speakerIdOverride:
        text: "\u2014 \u0411\u0440\u043E\u0434 \u043D\u0435 \u0432\u0430\u0448, \u2014 \u0433\u043E\u0432\u043E\u0440\u0438\u0442 \u043E\u043D\u0430, \u043D\u0435 \u0433\u043B\u044F\u0434\u044F \u0432\u0432\u0435\u0440\u0445. \u2014 \u0418\u0434\u0438\u0442\u0435,
          \u043E\u0442\u043A\u0443\u0434\u0430 \u043F\u0440\u0438\u0448\u043B\u0438, \u0435\u0441\u043B\u0438 \u043F\u0440\u0438\u0448\u043B\u0438 \u043D\u0435 \u0437\u0430 \u044D\u0442\u0438\u043C."
