        \u043A\u043E\u0442\u043E\u0440\u043E\u0439 \u043D\u0435\u0442\xBB"
      details: "\u0422\u0440\u0438\u0433\u0433\u0435\u0440\u0438\u0442\u0441\u044F
        \u043D\u0435 \u043A\u043B\u0438\u043A\u043E\u043C \u0438\u0433\u0440\u043E\u043A\u0430
        \u0438 \u043D\u0435 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u043C
        \u0448\u0430\u0433\u043E\u043C Chapter01StoryDirector.Sequence, \u0430 \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043A\u0438\u043C
        \u043F\u0440\u043E\u0433\u0440\u0435\u0441\u0441\u043E\u043C \u0442\u0435\u043A\u0443\u0449\u0435\u0433\u043E
        \u043C\u0430\u0440\u0448\u0440\u0443\u0442\u0430 (~30%) \u0432\u043E \u0432\u0440\u0435\u043C\u044F
        \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u044F \u2014 \u0435\u0434\u0438\u043D\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0435
        \u043D\u0430\u043C\u0435\u0440\u0435\u043D\u043D\u043E\u0435 \u0438\u0441\u043A\u043B\u044E\u0447\u0435\u043D\u0438\u0435
        \u0438\u0437 \u043E\u0431\u0449\u0435\u0433\u043E \u043F\u0440\u0430\u0432\u0438\u043B\u0430
        \u0440\u0443\u0447\u043D\u043E\u0433\u043E \u043E\u0442\u043A\u0440\u044B\u0442\u0438\u044F
        \u0434\u0438\u0430\u043B\u043E\u0433\u043E\u0432."
