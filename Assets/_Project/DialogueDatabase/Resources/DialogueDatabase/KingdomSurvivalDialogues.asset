    - id: chapter01.node.02_side_lada
      speakerId: lada
      text: 
      textBlocks:
      - blockId: chapter01.node.02_side_lada_main
        kind: 0
        speakerIdOverride: 
        text: "\u041B\u0430\u0434\u0430 \u0447\u0443\u0442\u044C \u0443\u043B\u044B\u0431\u0430\u0435\u0442\u0441\u044F
          \u2014 \u043D\u0435 \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u043D\u043E,
          \u043F\u043E-\u0434\u0435\u043B\u043E\u0432\u043E\u043C\u0443. \xAB\u0412\u043E\u0442
          \u0438 \u0441\u043B\u0430\u0432\u043D\u043E. \u0422\u043E\u0433\u0434\u0430
          \u044F \u0437\u0430\u043A\u043E\u043D\u0447\u0443 \u2014 \u0438 \u043F\u043E\u043A\u0430\u0436\u0443,
          \u0447\u0442\u043E \u043D\u0435 \u0440\u0430\u0437\u0432\u0430\u043B\u0438\u0442\u0441\u044F\xBB,
          \u2014 \u0438 \u0441\u043D\u043E\u0432\u0430 \u0431\u0435\u0440\u0451\u0442\u0441\u044F
          \u0437\u0430 \u0440\u0430\u0441\u043F\u043E\u0440\u043A\u0443."
