        nextNodeId: chapter01.node.10.ostafiy
        endsDialogue: 0
        choiceId: chapter01.node.10_continue
        kind: 4
        conditions:
          Combinator: 0
          Conditions: []
        unavailablePresentation: 0
        check:
          CheckId: 
          Kind: 0
          Quality: 0
          CompetencyId: 
          Difficulty: 13
          ModifierRules: []
        successNodeId: 
