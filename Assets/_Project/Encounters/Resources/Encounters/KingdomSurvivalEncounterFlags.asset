  - FlagId: ROAD_WARM_SHEEP_HUMAN_TRACE_KNOWN
    DisplayName: "\u0421\u043B\u0435\u0434 \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430
      \u0437\u0430\u043C\u0435\u0447\u0435\u043D"
    Description: "\u041F\u0440\u0438 \u043E\u0441\u043C\u043E\u0442\u0440\u0435 \u0442\u0443\u0448\u0438
      \u0433\u0435\u0440\u043E\u0439 \u0437\u0430\u043C\u0435\u0442\u0438\u043B \u0447\u0435\u043B\u043E\u0432\u0435\u0447\u0435\u0441\u043A\u0438\u0439
      \u0441\u043B\u0435\u0434 \u0431\u0435\u0437 \u043E\u0431\u0443\u0432\u0438."
    Category: road_warm_sheep
    Status: 0
    FutureUseNotes: "\u041F\u043E\u0442\u0440\u0435\u0431\u0438\u0442\u0435\u043B\u044C:
      \u0443\u0441\u043B\u043E\u0432\u043D\u044B\u0439 \u0442\u0435\u043A\u0441\u0442\u043E\u0432\u044B\u0439
      \u0431\u043B\u043E\u043A \u0443\u0437\u043B\u0430 follow_tracks (\u043C\u0435\u043D\u044F\u0435\u0442
      \u0442\u043E\u043D \u043E\u043F\u0438\u0441\u0430\u043D\u0438\u044F \u043F\u043E\u0433\u043E\u043D\u0438)."
  - FlagId: ROAD_WARM_SHEEP_INSPECTED
    DisplayName: "\u0422\u0443\u0448\u0430 \u043E\u0441\u043C\u043E\u0442\u0440\u0435\u043D\u0430"
    Description: "\u0413\u0435\u0440\u043E\u0439 \u043F\u043E\u043F\u044B\u0442\u0430\u043B\u0441\u044F
      \u043E\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C \u0442\u0443\u0448\u0443
      (\u043D\u0435\u0437\u0430\u0432\u0438\u0441\u0438\u043C\u043E \u043E\u0442
      \u0438\u0441\u0445\u043E\u0434\u0430 \u043F\u0440\u043E\u0432\u0435\u0440\u043A\u0438)."
    Category: road_warm_sheep
    Status: 1
    FutureUseNotes: "\u0414\u043B\u044F \u0431\u0443\u0434\u0443\u0449\u0438\u0445
      \u0441\u0446\u0435\u043D, \u043A\u043E\u0442\u043E\u0440\u044B\u043C \u0432\u0430\u0436\u043D\u043E,
      \u043F\u044B\u0442\u0430\u043B\u0441\u044F \u043B\u0438 \u0433\u0435\u0440\u043E\u0439
      \u0432\u043E\u043E\u0431\u0449\u0435 \u0440\u0430\u0437\u043E\u0431\u0440\u0430\u0442\u044C\u0441\u044F,
      \u0430 \u043D\u0435 \u0442\u043E\u043B\u044C\u043A\u043E what he found."
  - FlagId: ROAD_WARM_SHEEP_FOLLOWED_TRACKS
    DisplayName: "\u041F\u0440\u043E\u0448\u0451\u043B \u043F\u043E \u0441\u043B\u0435\u0434\u0430\u043C"
    Description: "\u0413\u0435\u0440\u043E\u0439 \u043F\u043E\u0448\u0451\u043B \u043F\u043E
