      \u043E\u0449\u0443\u0449\u0435\u043D\u0438\u044E \u2014 \u0441\u043B\u0443\u0447\u0430\u0439\u043D\u0430\u044F
      \u0434\u043E\u0440\u043E\u0436\u043D\u0430\u044F \u0432\u0441\u0442\u0440\u0435\u0447\u0430,
      \u0442\u0435\u0445\u043D\u0438\u0447\u0435\u0441\u043A\u0438 \u0432 \u043F\u0435\u0440\u0432\u043E\u043C
      \u043F\u043E\u0445\u043E\u0434\u0435 \u2014 \u0433\u0430\u0440\u0430\u043D\u0442\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u0439
      tutorial-encounter (\u0440\u0430\u0437\u0434\u0435\u043B \"\u041A\u0430\u043A
      \u0432\u0441\u0442\u0440\u0435\u0447\u0430 \u043F\u043E\u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F\":
      \u0438\u043C\u0435\u043D\u043D\u043E \u043E\u043D\u0430 \u0440\u0430\u0437\u0431\u043B\u043E\u043A\u0438\u0440\u0443\u0435\u0442
      \u043B\u0430\u0433\u0435\u0440\u044C, \u0447\u0438\u0441\u0442\u044B\u0439
      RNG \u0440\u0438\u0441\u043A\u0443\u0435\u0442 \u043F\u0440\u043E\u043F\u0443\u0441\u043A\u043E\u043C
      \u0441\u0438\u0441\u0442\u0435\u043C\u044B). \u0422\u0440\u0438\u0433\u0433\u0435\u0440\u0438\u0442\u0441\u044F
      Chapter01StoryDirector.GetPendingRoadEventDialogueId \u043D\u0430 ~60% \u043C\u0430\u0440\u0448\u0440\u0443\u0442\u0430
      \u043F\u043E\u0441\u043B\u0435 N11. \u0420\u043E\u0432\u043D\u043E \u043E\u0434\u0438\u043D
      \u0438\u0437 \u0447\u0435\u0442\u044B\u0440\u0451\u0445 \u0438\u0441\u0445\u043E\u0434\u043E\u0432
      (CartOutcomeSavedBoth/SavedMan/SavedSeed/PassedBy) + CartResolved + CampUnlocked
      \u0441\u0442\u0430\u0432\u044F\u0442\u0441\u044F \u0441\u0430\u043C\u0438\u043C
      \u0434\u0438\u0430\u043B\u043E\u0433\u043E\u043C (SetFlag); \u0446\u0435\u043D\u0430
      \u0432 \u0447\u0430\u0441\u0430\u0445 \u043D\u0435 \u0443\u043C\u0435\u0435\u0442
      \u0441\u0442\u0430\u0432\u0438\u0442\u044C\u0441\u044F \u0434\u0438\u0430\u043B\u043E\u0433\u043E\u0432\u044B\u043C
      \u044D\u0444\u0444\u0435\u043A\u0442\u043E\u043C \u2014 \u0435\u0451 \u0441\u0442\u0430\u0440\u0442\u0443\u0435\u0442
      Chapter01OutcomeApplier.ApplyCartConsequences \u0447\u0435\u0440\u0435\u0437
      GameState.TryStartRoadActivity, \u0432\u044B\u0437\u0432\u0430\u043D\u043D\u044B\u0439
      Chapter01StoryDirector.HandleDialogueCompleted. \"\u0420\u0430\u0437\u0434\u0435\u043B\u0438\u0442\u044C
      \u043B\u044E\u0434\u0435\u0439\" \u2014 \u0434\u0432\u0430 \u0432\u0437\u0430\u0438\u043C\u043E\u0438\u0441\u043A\u043B\u044E\u0447\u0430\u044E\u0449\u0438\u0445
      Normal-\u0432\u044B\u0431\u043E\u0440\u0430 \u0441 \u043E\u0434\u0438\u043D\u0430\u043A\u043E\u0432\u044B\u043C
      nextNodeId (saved_both), \u0440\u0430\u0437\u043B\u0438\u0447\u0430\u044E\u0442\u0441\u044F
      \u0442\u043E\u043B\u044C\u043A\u043E PartySizeAtLeast-\u0443\u0441\u043B\u043E\u0432\u0438\u044F\u043C\u0438
      \u0438 \u0446\u0435\u043D\u043E\u0439 \u0432 \u0442\u0435\u043A\u0441\u0442\u0435:
      1 \u0431\u043E\u0435\u0446 = 3\u0447, 2-4 \u0431\u043E\u0439\u0446\u0430 =
      2\u0447; \u043F\u0440\u0438 0 \u0431\u043E\u0439\u0446\u0430\u0445 \u043D\u0438
      \u043E\u0434\u0438\u043D \u0438\u0437 \u043D\u0438\u0445 \u043D\u0435 \u043F\u0440\u043E\u0445\u043E\u0434\u0438\u0442
      \u0443\u0441\u043B\u043E\u0432\u0438\u0435 \u2014 \u0432\u0430\u0440\u0438\u0430\u043D\u0442\u0430
      \u043D\u0435\u0442 \u0432\u043E\u043E\u0431\u0449\u0435 (\u0440\u0430\u0437\u0434\u0435\u043B
      \"\u0420\u0435\u0448\u0435\u043D\u0438\u0435 C\")."
