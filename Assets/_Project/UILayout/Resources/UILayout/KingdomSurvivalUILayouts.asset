  - id: camp
    displayName: "Лагерь"
    description: "Постоянный fullscreen-экран похода: отряд, иллюстрация места, доступная авторская сцена и место для будущих действий. Не CampManager и не survival-система — только показ состояния и запуск Dialogue System через Chapter01CampSceneProvider."
    usesDimming: 1
    dimmingOpacity: 0.68
    autoApply: 1
    rootName: camp-screen
    requiredElements:
    - elementId: camp-screen
      expectedParentId: 
    - elementId: camp-art
      expectedParentId: camp-body
    - elementId: camp-title
      expectedParentId: camp-header
    - elementId: camp-time-label
      expectedParentId: camp-header
    - elementId: camp-party-panel
      expectedParentId: camp-body
    - elementId: camp-scenes-panel
      expectedParentId: camp-body
    - elementId: camp-actions-panel
      expectedParentId: camp-footer
    - elementId: camp-continue-button
      expectedParentId: camp-footer
    - elementId: camp-close-button
      expectedParentId: camp-header
