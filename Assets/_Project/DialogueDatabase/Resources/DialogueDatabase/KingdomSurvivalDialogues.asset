          StringParam: chapter01.flag.home_baseline_captured
          IntParam: 0
      - blockId: chapter01.node.01_observation
        kind: 1
        speakerIdOverride: 
        text: "\u041E\u043D\u0430 \u0437\u0430\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u0435\u0442
          \u0431\u0443\u0445\u0430\u043D\u043A\u0443 \u043D\u0435 \u043F\u0440\u0430\u0437\u0434\u043D\u0438\u0447\u043D\u044B\u043C
          \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u0435\u043C \u0438 \u043D\u0435
          \u0442\u0430\u043A, \u043A\u0430\u043A \u043F\u043E\u0434\u0430\u044E\u0442
          \u043C\u0438\u043B\u043E\u0441\u0442\u044B\u043D\u044E, \u2014 \u0430 \u0431\u0443\u0434\u043D\u0438\u0447\u043D\u043E,
          \u043A\u0430\u043A \u043E\u0442\u0434\u0430\u044E\u0442 \u0442\u043E, \u0447\u0442\u043E
          \u0434\u0430\u0432\u043D\u043E \u0438 \u0431\u0435\u0437 \u0441\u043F\u043E\u0440\u0430
          \u0441\u0447\u0438\u0442\u0430\u0435\u0442\u0441\u044F \u0447\u0443\u0436\u0438\u043C.
          \u0414\u0435\u043B\u043E, \u0430 \u043D\u0435 \u0434\u0430\u0440."
        conditions:
          Combinator: 0
          Conditions: []
        hasPassiveCheck: 1
        passiveCheck:
          CheckId: chapter01.check.second_loaf_judgment
