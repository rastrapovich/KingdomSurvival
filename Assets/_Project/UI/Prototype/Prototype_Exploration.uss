/* ================================================================
   ДОБЫЧА ОТРЯДА И ИССЛЕДОВАНИЕ ЛОКАЦИИ
   ================================================================ */

.army-gold-value {
    margin-bottom: 8px;
    color: rgb(235, 194, 104);
    font-size: 15px;
    -unity-font-style: bold;
}

.supply-subtitle {
    margin-bottom: 5px;
    color: rgb(193, 183, 158);
    font-size: 11px;
    -unity-font-style: bold;
}

.research-expedition-button {
    display: none;
    height: 38px;
    margin-bottom: 7px;
    background-color: rgb(56, 79, 64);
    color: rgb(228, 235, 220);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(103, 140, 109);
    border-right-color: rgb(103, 140, 109);
    border-top-color: rgb(103, 140, 109);
    border-bottom-color: rgb(103, 140, 109);
    border-radius: 4px;
    -unity-font-style: bold;
}

.research-expedition-button:hover {
    background-color: rgb(69, 96, 77);
}

.research-expedition-button:disabled {
    opacity: 0.55;
}

/* ================================================================
   НАДЁЖНЫЙ SPLIT-VIEW АРМИИ / ЭКСПЕДИЦИЙ
   ================================================================ */

.military-split-screen {
    width: 100%;
    height: 100%;
    min-height: 0;
    flex-direction: row;
    align-items: stretch;
}

.military-column-scroll {
    width: 50%;
    min-width: 0;
    height: 100%;
    flex-grow: 0;
    flex-shrink: 1;
}

.military-column-divider {
    width: 8px;
    min-width: 8px;
    max-width: 8px;
    height: 100%;
    margin-left: 5px;
    margin-right: 5px;
    background-color: rgb(20, 23, 29);
}

.military-panel-fill {
    min-height: 100%;
    margin-bottom: 0;
}

.commander-supply-row {
    width: 100%;
    flex-direction: row;
    align-items: flex-start;
    justify-content: space-between;
}

.commander-profile-column {
    width: 52%;
    min-width: 0;
    margin-right: 10px;
}

.commander-section-title {
    margin-top: 0;
}

.commander-image-placeholder {
    width: 170px;
    max-width: 100%;
    height: 190px;
    margin-bottom: 9px;
    align-items: center;
    justify-content: center;
    background-color: rgb(40, 45, 54);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(92, 80, 58);
    border-right-color: rgb(92, 80, 58);
    border-top-color: rgb(92, 80, 58);
    border-bottom-color: rgb(92, 80, 58);
    border-radius: 5px;
}

.commander-image-placeholder-text {
    max-width: 145px;
    color: rgb(119, 124, 133);
    font-size: 10px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: normal;
}

.commander-profile-column .commander-dropdown {
    width: 100%;
}

.commander-profile-column .commander-dropdown > .unity-base-field__label {
    min-width: 72px;
}

.military-supply-block {
    width: 44%;
    min-width: 190px;
    margin-top: 0;
}

.military-supply-block .supply-controls {
    width: 100%;
}

.military-supply-block .supply-value {
    min-width: 54px;
    margin-left: 4px;
    margin-right: 4px;
}

/* ================================================================
   ДВА ГАРНИЗОНА И ПЕРЕТАСКИВАНИЕ БОЙЦОВ
   ================================================================ */

.fighter-selection-hint {
    margin-top: 7px;
    margin-bottom: 8px;
    color: rgb(204, 193, 168);
    font-size: 11px;
    white-space: normal;
}

.army-transfer-board {
    width: 100%;
    min-height: 244px;
    flex-direction: row;
    align-items: stretch;
    margin-bottom: 6px;
}

.army-roster-drop-zone {
    position: relative;
    width: 45%;
    min-width: 0;
    min-height: 238px;
    padding-left: 9px;
    padding-right: 9px;
    padding-top: 9px;
    padding-bottom: 8px;
    background-color: rgb(36, 41, 49);
    border-left-width: 2px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-radius: 5px;
}

.commander-garrison-zone {
    border-left-color: rgb(195, 152, 76);
    border-right-color: rgb(100, 82, 55);
    border-top-color: rgb(100, 82, 55);
    border-bottom-color: rgb(100, 82, 55);
}

.capital-garrison-zone {
    border-left-color: rgb(82, 139, 96);
    border-right-color: rgb(61, 88, 70);
    border-top-color: rgb(61, 88, 70);
    border-bottom-color: rgb(61, 88, 70);
}

.army-roster-drop-hover {
    background-color: rgb(62, 66, 55);
    border-left-color: rgb(237, 196, 103);
    border-right-color: rgb(237, 196, 103);
    border-top-color: rgb(237, 196, 103);
    border-bottom-color: rgb(237, 196, 103);
}

.capital-garrison-zone.army-roster-drop-hover {
    background-color: rgb(43, 65, 51);
    border-left-color: rgb(134, 195, 145);
    border-right-color: rgb(134, 195, 145);
    border-top-color: rgb(134, 195, 145);
    border-bottom-color: rgb(134, 195, 145);
}

.capital-garrison-zone.army-roster-empty-danger {
    background-color: rgb(65, 40, 41);
    border-left-color: rgb(190, 87, 79);
    border-right-color: rgb(124, 64, 61);
    border-top-color: rgb(124, 64, 61);
    border-bottom-color: rgb(124, 64, 61);
}

.army-roster-title {
    margin-bottom: 3px;
    color: rgb(224, 187, 102);
    font-size: 11px;
    -unity-font-style: bold;
    white-space: normal;
}

.capital-garrison-zone .army-roster-title {
    color: rgb(142, 190, 151);
}

.army-roster-summary {
    margin-bottom: 7px;
    color: rgb(184, 180, 168);
    font-size: 10px;
    white-space: normal;
}

.army-roster-scroll {
    width: 100%;
    height: 181px;
    max-height: 181px;
}

.army-roster-list {
    min-width: 100%;
    min-height: 169px;
    flex-direction: row;
    flex-wrap: nowrap;
    align-items: flex-start;
}

.army-roster-empty-label {
    position: absolute;
    left: 12px;
    right: 12px;
    top: 66px;
    bottom: 12px;
    color: rgb(139, 126, 98);
    font-size: 10px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: normal;
}

.army-roster-empty-warning {
    color: rgb(219, 111, 101);
}

.army-transfer-arrows {
    width: 10%;
    min-width: 42px;
    align-items: center;
    justify-content: center;
}

.army-transfer-arrows-icon {
    color: rgb(214, 181, 105);
    font-size: 25px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.army-transfer-arrows-label {
    margin-top: 2px;
    color: rgb(124, 126, 128);
    font-size: 7px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: normal;
}

.army-roster-list .fighter-card {
    width: 112px;
    min-width: 112px;
    max-width: 112px;
    min-height: 166px;
    margin-right: 7px;
    margin-bottom: 3px;
    padding-left: 6px;
    padding-right: 6px;
    padding-top: 6px;
    padding-bottom: 6px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(92, 80, 58);
    border-right-color: rgb(72, 76, 85);
    border-top-color: rgb(72, 76, 85);
    border-bottom-color: rgb(72, 76, 85);
    border-radius: 4px;
    align-items: flex-start;
    -unity-text-align: upper-left;
}

.fighter-image-placeholder {
    width: 90px;
    height: 88px;
    margin-bottom: 6px;
    align-items: center;
    justify-content: center;
    background-color: rgb(35, 40, 48);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(74, 80, 91);
    border-right-color: rgb(74, 80, 91);
    border-top-color: rgb(74, 80, 91);
    border-bottom-color: rgb(74, 80, 91);
    border-radius: 3px;
}

.fighter-image-placeholder-text {
    color: rgb(105, 111, 121);
    font-size: 8px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.army-roster-list .fighter-role {
    font-size: 12px;
    white-space: normal;
}

.army-roster-list .fighter-info {
    font-size: 9px;
    white-space: normal;
}

.fighter-name {
    margin-bottom: 2px;
    color: rgb(237, 232, 217);
    font-size: 12px;
    -unity-font-style: bold;
    white-space: normal;
}

.fighter-assignment {
    margin-top: 5px;
    color: rgb(147, 186, 151);
    font-size: 8px;
    -unity-font-style: bold;
    white-space: normal;
}

.fighter-card-selected {
    background-color: rgb(67, 57, 39);
    border-left-color: rgb(224, 187, 102);
    border-right-color: rgb(165, 132, 73);
    border-top-color: rgb(165, 132, 73);
    border-bottom-color: rgb(165, 132, 73);
}

.fighter-card-selected .fighter-assignment {
    color: rgb(235, 194, 104);
}

.fighter-card-garrison {
    background-color: rgb(39, 51, 47);
    border-left-color: rgb(92, 138, 102);
}

.fighter-card:disabled {
    opacity: 1;
}

.fighter-card-dragging {
    opacity: 0.32;
}

.fighter-drag-ghost {
    position: absolute;
    width: 132px;
    height: 74px;
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 9px;
    padding-bottom: 8px;
    background-color: rgb(65, 56, 40);
    border-left-width: 2px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(235, 194, 104);
    border-right-color: rgb(167, 132, 70);
    border-top-color: rgb(167, 132, 70);
    border-bottom-color: rgb(167, 132, 70);
    border-radius: 5px;
    opacity: 0.94;
}

.fighter-drag-ghost-name {
    color: rgb(244, 232, 203);
    font-size: 13px;
    -unity-font-style: bold;
}

.fighter-drag-ghost-role {
    margin-top: 5px;
    color: rgb(190, 183, 164);
    font-size: 10px;
}

.military-expedition-column .location-info-row {
    flex-wrap: wrap;
}

.military-expedition-column .active-expedition-details,
.military-expedition-column .location-name,
.military-expedition-column .location-info,
.military-expedition-column .status-label {
    white-space: normal;
}

/* ================================================================
   ИЗОБРАЖЕНИЯ НА КАРТОЧКАХ ЛОКАЦИЙ
   ================================================================ */

.location-image-placeholder {
    width: 100%;
    height: 112px;
    margin-bottom: 9px;
    align-items: center;
    justify-content: center;
    background-color: rgb(35, 40, 48);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(74, 80, 91);
    border-right-color: rgb(74, 80, 91);
    border-top-color: rgb(74, 80, 91);
    border-bottom-color: rgb(74, 80, 91);
    border-radius: 4px;
}

.location-image-placeholder-text {
    color: rgb(105, 111, 121);
    font-size: 9px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

/* ================================================================
   ВСПЛЫВАЮЩИЙ РАСХОД ГОРОДСКОЙ ПИЩИ
   ================================================================ */

.food-expense-popup {
    top: 100%;
    margin-top: 2px;
}

/* ================================================================
   СХЕМАТИЧЕСКАЯ КАРТА ОКРЕСТНОСТЕЙ
   ================================================================ */

.world-map-section-title {
    margin-bottom: 3px;
}

.world-map-hint {
    margin-bottom: 8px;
    color: rgb(163, 158, 143);
    font-size: 10px;
    white-space: normal;
}

.world-map {
    position: relative;
    width: 100%;
    height: 350px;
    min-height: 350px;
    margin-bottom: 9px;
    overflow: hidden;
    background-color: rgb(38, 40, 39);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(112, 96, 67);
    border-right-color: rgb(87, 77, 58);
    border-top-color: rgb(112, 96, 67);
    border-bottom-color: rgb(72, 65, 52);
    border-radius: 5px;
}

.world-map-land {
    position: absolute;
    background-color: rgb(48, 51, 46);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(75, 79, 67);
    border-right-color: rgb(64, 68, 59);
    border-top-color: rgb(75, 79, 67);
    border-bottom-color: rgb(64, 68, 59);
    border-radius: 18px;
    opacity: 0.72;
}

.world-map-land-west {
    left: -4%;
    top: 10%;
    width: 42%;
    height: 44%;
}

.world-map-land-north {
    left: 29%;
    top: -7%;
    width: 42%;
    height: 41%;
}

.world-map-land-east {
    left: 62%;
    top: 13%;
    width: 44%;
    height: 48%;
}

.world-map-compass {
    position: absolute;
    left: 4%;
    top: 73%;
    width: 30px;
    color: rgb(164, 145, 100);
    font-size: 11px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: normal;
}

.world-map-layer {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.world-map-route-dot {
    position: absolute;
    width: 5px;
    height: 5px;
    background-color: rgb(103, 99, 84);
    border-radius: 3px;
    opacity: 0.54;
}

.world-map-route-dot-active {
    width: 7px;
    height: 7px;
    background-color: rgb(226, 187, 99);
    border-radius: 4px;
    opacity: 0.96;
}

.world-map-route-dot-preview {
    width: 6px;
    height: 6px;
    background-color: rgb(190, 164, 104);
    border-radius: 3px;
    opacity: 0.82;
}

.world-map-blocked-cell {
    position: absolute;
    width: 4.5%;
    height: 6.8%;
    background-color: rgb(69, 65, 60);
    border-radius: 3px;
    opacity: 0.72;
}

.world-map-destination-marker {
    position: absolute;
    width: 18px;
    height: 18px;
    margin-left: -9px;
    margin-top: -9px;
    background-color: rgb(196, 87, 67);
    border-left-width: 3px;
    border-right-width: 3px;
    border-top-width: 3px;
    border-bottom-width: 3px;
    border-left-color: rgb(244, 213, 151);
    border-right-color: rgb(244, 213, 151);
    border-top-color: rgb(244, 213, 151);
    border-bottom-color: rgb(244, 213, 151);
    border-radius: 9px;
}

.world-map-node {
    position: absolute;
    width: 34px;
    height: 34px;
    min-height: 34px;
    margin-left: -17px;
    margin-top: -17px;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    color: rgb(205, 198, 178);
    background-color: rgb(47, 50, 49);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(110, 107, 94);
    border-right-color: rgb(85, 83, 74);
    border-top-color: rgb(110, 107, 94);
    border-bottom-color: rgb(85, 83, 74);
    border-radius: 17px;
    font-size: 14px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: normal;
}

.world-map-node:hover {
    background-color: rgb(59, 62, 57);
    border-left-color: rgb(183, 151, 85);
    border-right-color: rgb(183, 151, 85);
    border-top-color: rgb(183, 151, 85);
    border-bottom-color: rgb(183, 151, 85);
}

.world-map-node-unknown {
    color: rgb(176, 172, 159);
    background-color: rgb(43, 46, 46);
    border-left-color: rgb(91, 96, 95);
    border-right-color: rgb(76, 80, 80);
    border-top-color: rgb(91, 96, 95);
    border-bottom-color: rgb(76, 80, 80);
}

.world-map-node-known {
    color: rgb(236, 220, 180);
    background-color: rgb(58, 55, 45);
    border-left-color: rgb(151, 124, 70);
}

.world-map-node-explored {
    color: rgb(182, 215, 184);
    background-color: rgb(42, 59, 49);
    border-left-color: rgb(95, 150, 107);
    border-right-color: rgb(69, 109, 79);
    border-top-color: rgb(95, 150, 107);
    border-bottom-color: rgb(69, 109, 79);
}

.world-map-node-selected {
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgb(235, 194, 104);
    border-right-color: rgb(235, 194, 104);
    border-top-color: rgb(235, 194, 104);
    border-bottom-color: rgb(235, 194, 104);
}

.world-map-node-active {
    background-color: rgb(72, 58, 38);
    color: rgb(250, 222, 159);
}

.world-map-capital {
    position: absolute;
    left: 37%;
    top: 74%;
    width: 26%;
    height: 48px;
    color: rgb(226, 225, 214);
    background-color: rgb(47, 54, 61);
    border-left-width: 2px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(150, 158, 164);
    border-right-color: rgb(96, 105, 113);
    border-top-color: rgb(96, 105, 113);
    border-bottom-color: rgb(96, 105, 113);
    border-radius: 5px;
    font-size: 10px;
    -unity-font-style: bold;
    white-space: normal;
}

.world-map-capital:hover {
    background-color: rgb(61, 69, 76);
}

.world-map-capital-return {
    color: rgb(245, 218, 175);
    background-color: rgb(82, 57, 45);
    border-left-color: rgb(195, 129, 86);
    border-right-color: rgb(143, 92, 66);
    border-top-color: rgb(143, 92, 66);
    border-bottom-color: rgb(143, 92, 66);
}

.world-map-capital:disabled {
    opacity: 0.78;
}

.world-map-army-marker {
    display: none;
    position: absolute;
    width: 74px;
    min-height: 38px;
    align-items: center;
}

.world-map-army-badge {
    padding-left: 5px;
    padding-right: 5px;
    padding-top: 3px;
    padding-bottom: 3px;
    color: rgb(42, 34, 22);
    background-color: rgb(232, 192, 98);
    border-radius: 3px;
    font-size: 9px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.world-map-army-label {
    margin-top: 2px;
    color: rgb(243, 218, 162);
    font-size: 8px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: normal;
}

.map-selection-card {
    margin-bottom: 8px;
    padding-left: 11px;
    padding-right: 11px;
    padding-top: 9px;
    padding-bottom: 9px;
    background-color: rgb(40, 44, 50);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(92, 84, 65);
    border-right-color: rgb(70, 68, 62);
    border-top-color: rgb(92, 84, 65);
    border-bottom-color: rgb(70, 68, 62);
    border-radius: 5px;
}

.map-selection-title {
    margin-bottom: 5px;
    color: rgb(229, 210, 167);
    font-size: 13px;
    -unity-font-style: bold;
    white-space: normal;
}

.map-selection-details {
    margin-bottom: 8px;
    color: rgb(184, 180, 167);
    font-size: 10px;
    white-space: normal;
}

.map-send-button {
    min-height: 36px;
    -unity-font-style: bold;
    white-space: normal;
}

.map-send-button:disabled {
    opacity: 0.48;
}
