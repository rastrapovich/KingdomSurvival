    - id: chapter01.node.04.strength_failure
      speakerId: narrator
      text: 
      textBlocks:
      - blockId: chapter01.node.04.strength_failure_main
        kind: 0
        speakerIdOverride: 
        text: "\u0421\u0442\u0432\u043E\u0440 \u043D\u0435 \u0434\u0432\u0438\u0433\u0430\u0435\u0442\u0441\u044F
          \u2014 \u0441\u0440\u044B\u0432\u0430\u044E\u0442\u0441\u044F \u0442\u043E\u043B\u044C\u043A\u043E
          \u0440\u0443\u043A\u0438, \u0430 \u0431\u0440\u0443\u0441, \u0437\u0430
          \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u0442\u044B \u0434\u0435\u0440\u0436\u0430\u043B\u0441\u044F,
          \u043B\u043E\u043F\u0430\u0435\u0442\u0441\u044F \u043F\u043E\u043F\u043E\u043B\u0430\u043C.
          \u0422\u0435\u0431\u044F \u043E\u0442\u0431\u0440\u0430\u0441\u044B\u0432\u0430\u0435\u0442
          \u043D\u0430\u0437\u0430\u0434, \u0432 \u043B\u0435\u0434\u044F\u043D\u0443\u044E
          \u0432\u043E\u0434\u0443. \u0414\u0440\u0430\u0433\u043E\u0446\u0435\u043D\u043D\u044B\u0435
          \u043C\u0433\u043D\u043E\u0432\u0435\u043D\u0438\u044F \u0443\u0445\u043E\u0434\u044F\u0442
          \u0432\u043F\u0443\u0441\u0442\u0443\u044E."
