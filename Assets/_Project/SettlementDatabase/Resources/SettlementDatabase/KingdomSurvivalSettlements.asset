  - Data:
      Id: settlement.town.fort
      Name: "\u0413\u043E\u0440\u043E\u0434\u043E\u043A \u0437\u0430 \u0447\u0430\u0441\u0442\u043E\u043A\u043E\u043B\u043E\u043C"
      Kind: 2
      ShortDescription: "\u0411\u0440\u0435\u0432\u0435\u043D\u0447\u0430\u0442\u044B\u0439
        \u0447\u0430\u0441\u0442\u043E\u043A\u043E\u043B, \u0431\u0430\u0448\u043D\u044F
        \u043D\u0430\u0434 \u0432\u043E\u0440\u043E\u0442\u0430\u043C\u0438, \u0432
        \u043D\u0435\u0439 \u2014 \u0441\u0442\u043E\u0440\u043E\u0436 \u0438 \u0435\u0433\u043E
        \u043A\u0430\u0448\u0435\u043B\u044C. \u0412\u043D\u0443\u0442\u0440\u0438
        \u0442\u0435\u0441\u043D\u043E, \u0437\u0430\u0442\u043E \u0441\u0443\u0445\u043E."
      LongDescription: "\u0413\u043E\u0440\u043E\u0434\u043E\u043A \u0434\u0435\u0440\u0436\u0438\u0442
        \u043A\u0443\u0437\u043D\u044F \u0438 \u0432\u043E\u0440\u043E\u0442\u0430:
        \u0437\u0430 \u0436\u0435\u043B\u0435\u0437\u043E\u043C \u0435\u0434\u0443\u0442
        \u0438\u0437\u0434\u0430\u043B\u0435\u043A\u0430, \u0430 \u0443 \u0432\u043E\u0440\u043E\u0442
        \u0441\u043F\u0440\u0430\u0448\u0438\u0432\u0430\u044E\u0442, \u0437\u0430\u0447\u0435\u043C."
      Tags:
      - "\u0433\u043E\u0440\u043E\u0434\u043E\u043A"
      - "\u043A\u0443\u0437\u043D\u044F"
