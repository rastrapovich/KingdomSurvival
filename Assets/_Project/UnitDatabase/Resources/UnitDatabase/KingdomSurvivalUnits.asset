  tags:
  - id: species.human
    displayLabel: "Человек"
    category: "Происхождение"
    color: {r: 0.72, g: 0.61, b: 0.42, a: 1}
    description: "Человек разумный."
  - id: species.beast
    displayLabel: "Зверь"
    category: "Происхождение"
    color: {r: 0.62, g: 0.27, b: 0.2, a: 1}
    description: "Порождение дикой чащи, привыкшее решать споры клыками и когтями."
  - id: combat.ranged
    displayLabel: "Дальний бой"
    category: "Тип атаки"
    color: {r: 0.28, g: 0.53, b: 0.66, a: 1}
    description: "Может атаковать на расстоянии. При атаке цели на соседнем гексе Атака снижается на 50%."
  - id: role.defender
    displayLabel: "Защитник"
    category: "Роль"
    color: {r: 0.35, g: 0.49, b: 0.62, a: 1}
    description: "Лучше других удерживает позицию под натиском врага. В защитной стойке получает ещё +25% к Защите."
  - id: trait.armored
    displayLabel: "Бронированный"
    category: "Особенность"
    color: {r: 0.49, g: 0.51, b: 0.53, a: 1}
    description: "Тяжёлая защита принимает часть удара на себя. Постоянно даёт +2 к Защите."
  - id: trait.beast_slayer
    displayLabel: "Гроза зверей"
    category: "Особенность"
    color: {r: 0.68, g: 0.45, b: 0.22, a: 1}
    description: "Знает, куда бить тварь, чтобы она больше не поднялась. Атака против существ с тегом «Зверь» увеличивается на 50%."
  - id: trait.human_slayer
    displayLabel: "Гроза людей"
    category: "Особенность"
    color: {r: 0.62, g: 0.22, b: 0.19, a: 1}
    description: "Слишком хорошо знает вкус человеческой крови. Атака против существ с тегом «Человек» увеличивается на 50%."
