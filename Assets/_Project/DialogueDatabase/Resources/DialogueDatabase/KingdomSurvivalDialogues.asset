      - blockId: chapter01.node.12.woman_large_party
        kind: 0
        speakerIdOverride:
        text: "\u041E\u043D\u0430 \u043E\u0442\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0435\u0442 \u0441\u0435\u0442\u044C \u0432 \u0441\u0442\u043E\u0440\u043E\u043D\u0443, \u043D\u0435 \u0441\u043F\u0443\u0441\u043A\u0430\u044F \u0433\u043B\u0430\u0437 \u0441 \u0431\u043E\u0439\u0446\u043E\u0432
