    - id: chapter01.node.04.strength_success
      speakerId: narrator
      text:
      textBlocks:
      - blockId: chapter01.node.04.strength_success_main
        kind: 0
        speakerIdOverride:
        text: "\u0421\u0442\u0432\u043E\u0440 \u043F\u043E\u0434\u0434\u0430\u0451\u0442\u0441\u044F \u043D\u0435 \u0441\u0440\u0430\u0437\u0443 \u2014 \u043D\u043E \u043F\u043E\u0434\u0434\u0430\u0451\u0442\u0441\u044F. \u041E\u043D \u0441 \u0445\u0440\u0443\u0441\u0442\u043E\u043C \u0441\u0434\u0432\u0438\u0433\u0430\u0435\u0442\u0441\u044F \u043D\u0430 \u043F\u044F\u0434\u044C, \u0438 \u0447\u0430\u0441\u0442\u044C \u043F\u043E\u0442\u043E\u043A\u0430 \u0443\u0445\u043E\u0434\u0438\u0442 \u0432 \u0441\u0442\u0430\u0440\u043E\u0435 \u0440\u0443\u0441\u043B\u043E. \u0422\u044B \u0432\u044B\u0438\u0433\u0440\u0430\u043B \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u043C\u0433\u043D\u043E\u0432\u0435\u043D\u0438\u0439 \u2014 \u0438 \u0442\u0443\u0442 \u0436\u0435 \u043F\u043E\u043D\u0438\u043C\u0430\u0435\u0448\u044C: \u044D\u0442\u043E\u0433\u043E \u043C\u0430\u043B\u043E, \u0447\u0442\u043E\u0431\u044B \u0441\u043F\u0430\u0441\u0442\u0438 \u0432\u0441\u0451."
