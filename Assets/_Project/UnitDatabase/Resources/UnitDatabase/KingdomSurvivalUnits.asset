    description: "\u041F\u043E\u0441\u043B\u0435 \u0431\u043B\u0438\u0436\u043D\u0435\u0433\u043E
      \u043F\u043E\u043F\u0430\u0434\u0430\u043D\u0438\u044F \u043F\u043E \u043D\u043E\u0441\u0438\u0442\u0435\u043B\u044E
      \u043F\u0435\u0440\u0432\u044B\u0439 \u043E\u0442\u0445\u043E\u0434 \u043D\u0430\u043F\u0430\u0432\u0448\u0435\u0433\u043E
      \u0438\u0437 \u0441\u043E\u0441\u0435\u0434\u0441\u0442\u0432\u0430 \u0441\u0442\u043E\u0438\u0442
      +1 \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u0435 (\u0434\u043E \u043A\u043E\u043D\u0446\u0430
      \u0435\u0433\u043E \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0433\u043E
      \u0445\u043E\u0434\u0430)."
  - id: passive.status.20261120.015
    displayLabel: "\u041A\u043E\u0440\u043D\u0438 \u0434\u0435\u0440\u0436\u0430\u0442
      \u0434\u043E\u0431\u044B\u0447\u0443"
    category: "\u041F\u0430\u0441\u0441\u0438\u0432"
    color: {r: 0.45, g: 0.38, b: 0.52, a: 1}
    description: "\u041F\u0435\u0440\u0432\u043E\u0435 \u043F\u043E\u043F\u0430\u0434\u0430\u043D\u0438\u0435
      \u0437\u0430 \u0441\u0432\u043E\u0439 \u0445\u043E\u0434 \u043F\u043E \u0446\u0435\u043B\u0438
      \u043F\u043E\u0434 \u0441\u043E\u0431\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0439
      \u043B\u043E\u0437\u043E\u0439: +1 \u0443\u0440\u043E\u043D."
  - id: trait.exposed_flanks
    displayLabel: "\u041E\u0442\u043A\u0440\u044B\u0442\u044B\u0435 \u0431\u043E\u043A\u0430"
    category: "\u041F\u0430\u0441\u0441\u0438\u0432"
    color: {r: 0.45, g: 0.38, b: 0.52, a: 1}
    description: "\u22122 \u0417\u0430\u0449\u0438\u0442\u044B, \u043F\u043E\u043A\u0430
      \u0440\u044F\u0434\u043E\u043C \u0441\u0442\u043E\u044F\u0442 \u0445\u043E\u0442\u044F
      \u0431\u044B \u0434\u0432\u0430 \u0432\u0440\u0430\u0433\u0430."
  - id: passive.status.20261120.019
    displayLabel: "\u041D\u0435 \u043F\u043E\u0434\u043F\u0443\u0441\u043A\u0430\u0435\u0442
      \u043F\u0430\u043B\u0430\u0447\u0430"
    category: "\u041F\u0430\u0441\u0441\u0438\u0432"
    color: {r: 0.45, g: 0.38, b: 0.52, a: 1}
    description: "\u041F\u0435\u0440\u0432\u044B\u0439 \u043F\u0440\u044F\u043C\u043E\u0439
      \u0443\u0434\u0430\u0440 \u0437\u0430 \u0440\u0430\u0443\u043D\u0434 \u043F\u043E
      \u0441\u043E\u0441\u0435\u0434\u043D\u0435\u043C\u0443 \u0441\u043E\u044E\u0437\u043D\u0438\u043A\u0443
      \u043F\u043E\u0434 \u041E\u0433\u043B\u0443\u0448\u0435\u043D\u0438\u0435\u043C,
      \u041F\u0430\u0440\u0430\u043B\u0438\u0447\u043E\u043C, \u041E\u043A\u0430\u043C\u0435\u043D\u0435\u043D\u0438\u0435\u043C
      \u0438\u043B\u0438 \u0417\u0430\u043C\u043E\u0440\u043E\u0437\u043A\u043E\u0439:
      \u22121 \u0443\u0440\u043E\u043D (\u043C\u0438\u043D\u0438\u043C\u0443\u043C
      1)."
