/* ================================================================
   ВРЕМЕННЫЕ КНОПКИ ТЕСТИРОВАНИЯ РЕСУРСОВ
   ================================================================ */

/* Старые контейнеры остаются в UXML для совместимости с основным
   контроллером, но сами кнопки переносятся в DEBUG MENU во время запуска. */
.resource-test-controls {
    display: none;
}

.resource-test-button {
    width: 24px;
    min-width: 24px;
    max-width: 24px;
    height: 14px;
    margin-right: 2px;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    background-color: rgb(57, 62, 72);
    color: rgb(205, 199, 184);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(83, 88, 99);
    border-right-color: rgb(83, 88, 99);
    border-top-color: rgb(83, 88, 99);
    border-bottom-color: rgb(83, 88, 99);
    border-radius: 2px;
    font-size: 8px;
    -unity-font-style: bold;
}

.resource-test-button:hover {
    background-color: rgb(72, 78, 90);
}

.resource-test-button:disabled {
    opacity: 0.4;
}

/* ================================================================
   DEBUG MENU
   ================================================================ */

.debug-toggle-button {
    width: 72px;
    min-width: 72px;
    max-width: 72px;
    height: 34px;
    margin-left: 8px;
    flex-shrink: 0;
    background-color: rgb(67, 56, 39);
    color: rgb(236, 202, 128);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(133, 105, 59);
    border-right-color: rgb(133, 105, 59);
    border-top-color: rgb(133, 105, 59);
    border-bottom-color: rgb(133, 105, 59);
    border-radius: 4px;
    font-size: 11px;
    -unity-font-style: bold;
}

.debug-toggle-button:hover {
    background-color: rgb(82, 68, 46);
}

.debug-panel {
    position: absolute;
    right: 16px;
    top: 98px;
    bottom: 110px;
    width: 420px;
    max-width: 46%;
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 10px;
    padding-bottom: 12px;
    background-color: rgb(24, 27, 33);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(126, 99, 55);
    border-right-color: rgb(126, 99, 55);
    border-top-color: rgb(126, 99, 55);
    border-bottom-color: rgb(126, 99, 55);
    border-radius: 6px;
}

.debug-header {
    height: 34px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 5px;
}

.debug-title {
    color: rgb(230, 191, 103);
    font-size: 16px;
    -unity-font-style: bold;
}

.debug-close-button {
    width: 30px;
    min-width: 30px;
    max-width: 30px;
    height: 28px;
    background-color: rgb(52, 56, 65);
    color: rgb(220, 215, 201);
    border-radius: 3px;
    font-size: 17px;
    -unity-font-style: bold;
}

.debug-scroll {
    flex-grow: 1;
    min-height: 0;
}

.debug-section-title {
    margin-top: 9px;
    margin-bottom: 5px;
    padding-bottom: 4px;
    color: rgb(194, 181, 151);
    font-size: 11px;
    -unity-font-style: bold;
    border-bottom-width: 1px;
    border-bottom-color: rgb(62, 66, 75);
}

.debug-resource-row {
    min-height: 34px;
    flex-direction: row;
    align-items: center;
    margin-bottom: 4px;
}

.debug-resource-name {
    width: 128px;
    min-width: 128px;
    color: rgb(206, 201, 187);
    font-size: 11px;
}

.debug-resource-value {
    width: 64px;
    min-width: 64px;
    margin-left: 5px;
    margin-right: 5px;
    color: rgb(238, 231, 213);
    font-size: 13px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.debug-step-button,
.resource-test-button.debug-step-button {
    width: 46px;
    min-width: 46px;
    max-width: 46px;
    height: 27px;
    margin-right: 0;
    padding-left: 2px;
    padding-right: 2px;
    background-color: rgb(55, 61, 72);
    color: rgb(229, 222, 204);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(83, 88, 99);
    border-right-color: rgb(83, 88, 99);
    border-top-color: rgb(83, 88, 99);
    border-bottom-color: rgb(83, 88, 99);
    border-radius: 3px;
    font-size: 10px;
    -unity-font-style: bold;
}

.debug-step-button:hover,
.resource-test-button.debug-step-button:hover {
    background-color: rgb(69, 76, 88);
}

.debug-step-button:disabled,
.resource-test-button.debug-step-button:disabled {
    opacity: 0.4;
}

.debug-state-label {
    margin-bottom: 8px;
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 7px;
    padding-bottom: 7px;
    background-color: rgb(36, 40, 48);
    color: rgb(190, 195, 201);
    border-radius: 3px;
    font-size: 10px;
    white-space: normal;
}

.debug-action-button {
    width: 100%;
    min-height: 32px;
    margin-bottom: 5px;
    background-color: rgb(48, 57, 65);
    color: rgb(219, 217, 207);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(76, 88, 98);
    border-right-color: rgb(76, 88, 98);
    border-top-color: rgb(76, 88, 98);
    border-bottom-color: rgb(76, 88, 98);
    border-radius: 3px;
    font-size: 10px;
    -unity-font-style: bold;
}

.debug-action-button:hover {
    background-color: rgb(60, 70, 79);
}

.debug-action-button:disabled {
    opacity: 0.4;
}

.debug-danger-button {
    background-color: rgb(78, 45, 42);
    border-left-color: rgb(119, 66, 59);
    border-right-color: rgb(119, 66, 59);
    border-top-color: rgb(119, 66, 59);
    border-bottom-color: rgb(119, 66, 59);
    color: rgb(231, 199, 190);
}

.debug-note {
    margin-top: 7px;
    color: rgb(127, 132, 140);
    font-size: 9px;
    white-space: normal;
}

/* ================================================================
   ОКНО СВЕРЖЕНИЯ
   ================================================================ */

.game-over-overlay {
    display: none;
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(9, 10, 13, 0.42);
}

.game-over-window {
    width: 430px;
    max-width: 72%;
    padding-left: 24px;
    padding-right: 24px;
    padding-top: 24px;
    padding-bottom: 22px;
    align-items: center;
    background-color: rgb(31, 34, 41);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgb(129, 65, 57);
    border-right-color: rgb(129, 65, 57);
    border-top-color: rgb(129, 65, 57);
    border-bottom-color: rgb(129, 65, 57);
    border-radius: 8px;
}

.game-over-title {
    margin-bottom: 14px;
    color: rgb(215, 112, 96);
    font-size: 26px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.game-over-description {
    max-width: 370px;
    margin-bottom: 18px;
    color: rgb(217, 209, 190);
    font-size: 13px;
    white-space: normal;
    -unity-text-align: middle-center;
}

.game-over-days {
    margin-bottom: 20px;
    color: rgb(235, 194, 104);
    font-size: 17px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.game-over-restart-button {
    width: 200px;
    height: 40px;
    background-color: rgb(92, 63, 43);
    color: rgb(248, 234, 204);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(180, 133, 72);
    border-right-color: rgb(180, 133, 72);
    border-top-color: rgb(180, 133, 72);
    border-bottom-color: rgb(180, 133, 72);
    border-radius: 5px;
    -unity-font-style: bold;
}

.game-over-restart-button:hover {
    background-color: rgb(115, 78, 49);
}
