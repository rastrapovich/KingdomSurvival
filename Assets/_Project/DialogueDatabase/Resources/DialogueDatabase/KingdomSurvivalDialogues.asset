%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4a1274bd9904406299a87fe67ad1cb8b, type: 3}
  m_Name: KingdomSurvivalDialogues
  m_EditorClassIdentifier: 
  speakers:
  - id: miller
    displayName: "\u041C\u0435\u043B\u044C\u043D\u0438\u043A"
    role: "\u0416\u0438\u0442\u0435\u043B\u044C \u0414\u043E\u043C\u0430 \xB7 \u043F\u0440\u043E\u0442\u043E\u0442\u0438\u043F"
    portrait: {fileID: 0}
  dialogues:
  - id: prototype_miller
    title: "\u0422\u0435\u0441\u0442\u043E\u0432\u044B\u0439 \u0440\u0430\u0437\u0433\u043E\u0432\u043E\u0440
      \u0441 \u043C\u0435\u043B\u044C\u043D\u0438\u043A\u043E\u043C"
    category: 0
    status: 0
    developerComment: "\u041F\u0435\u0440\u0435\u043D\u0435\u0441\u0435\u043D\u043E
      \u0438\u0437 PrototypeUIController.Narrative.cs. \u0421\u043B\u0443\u0436\u0438\u0442
      \u043F\u0435\u0440\u0432\u044B\u043C \u044D\u0442\u0430\u043B\u043E\u043D\u043E\u043C
      Dialogue Database \u0438 \u043D\u0435 \u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F
      \u0444\u0438\u043D\u0430\u043B\u044C\u043D\u044B\u043C \u0441\u044E\u0436\u0435\u0442\u043D\u044B\u043C
      \u0442\u0435\u043A\u0441\u0442\u043E\u043C."
    startNodeId: opening
    tags:
    - "\u0442\u0435\u0441\u0442"
    - "\u043F\u043B\u043E\u0442\u0438\u043D\u0430"
    - "\u0440\u0430\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u043D\u0438\u0435"
    nodes:
    - id: opening
      speakerId: miller
      text: "\u041F\u043B\u043E\u0442\u0438\u043D\u0443 \u043F\u043E\u0441\u043B\u0435
        \u043F\u0430\u0432\u043E\u0434\u043A\u0430 \u043F\u043E\u0432\u0435\u043B\u043E
        \u0441\u0438\u043B\u044C\u043D\u0435\u0435, \u0447\u0435\u043C \u044F \u0434\u0443\u043C\u0430\u043B.
        \u0412\u043E\u0434\u0430 \u0443\u0445\u043E\u0434\u0438\u0442 \u043D\u0435
        \u0442\u0443\u0434\u0430, \u043A\u0443\u0434\u0430 \u0434\u043E\u043B\u0436\u043D\u0430."
      choices:
      - text: "\u041F\u043E\u043A\u0430\u0436\u0438, \u0433\u0434\u0435 \u0437\u0430\u043C\u0435\u0442\u0438\u043B\u0438
          \u043F\u0440\u043E\u0431\u043B\u0435\u043C\u0443."
        nextNodeId: details
        endsDialogue: 0
      - text: "\u0427\u0442\u043E \u043C\u043E\u0433\u043B\u043E \u044D\u0442\u043E
          \u0432\u044B\u0437\u0432\u0430\u0442\u044C?"
        nextNodeId: cause
        endsDialogue: 0
      - text: "\u0412\u0435\u0440\u043D\u0451\u043C\u0441\u044F \u043A \u044D\u0442\u043E\u043C\u0443
          \u043F\u043E\u0437\u0436\u0435."
        nextNodeId: 
        endsDialogue: 1
    - id: details
      speakerId: miller
      text: "\u0421\u043D\u0430\u0447\u0430\u043B\u0430 \u043F\u0440\u043E\u0441\u0435\u043B\u0438
        \u043E\u043F\u043E\u0440\u044B \u0443 \u0441\u0442\u0430\u0440\u043E\u0433\u043E
        \u0448\u043B\u044E\u0437\u0430. \u0420\u0430\u0431\u043E\u0447\u0438\u0435
        \u0433\u043E\u0432\u043E\u0440\u044F\u0442, \u0447\u0442\u043E \u0443\u0442\u0440\u043E\u043C
        \u0432\u043E\u0434\u0430 \u0443\u0436\u0435 \u0448\u043B\u0430 \u043D\u0438\u0436\u0435
        \u043E\u0431\u044B\u0447\u043D\u043E\u0433\u043E."
      choices:
      - text: "\u0410 \u0441\u043B\u0435\u0434\u044B \u0432\u043E\u043A\u0440\u0443\u0433
          \u043F\u0440\u043E\u0432\u0435\u0440\u044F\u043B\u0438?"
        nextNodeId: tracks
        endsDialogue: 0
      - text: "\u0427\u0442\u043E \u0442\u044B \u0441\u0430\u043C \u0434\u0443\u043C\u0430\u0435\u0448\u044C?"
        nextNodeId: cause
        endsDialogue: 0
      - text: "\u041F\u043E\u043A\u0430 \u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E."
        nextNodeId: 
        endsDialogue: 1
    - id: cause
      speakerId: miller
      text: "\u041F\u043E\u0441\u043B\u0435 \u043F\u0430\u0432\u043E\u0434\u043A\u0430
        \u0432\u0441\u044F\u043A\u043E\u0435 \u0431\u044B\u0432\u0430\u0435\u0442.
        \u041D\u043E \u0437\u0434\u0435\u0441\u044C \u0441\u043B\u0438\u0448\u043A\u043E\u043C
        \u043C\u043D\u043E\u0433\u043E\u0435 \u0438\u0437\u043C\u0435\u043D\u0438\u043B\u043E\u0441\u044C
        \u0437\u0430 \u043E\u0434\u043D\u0443 \u043D\u043E\u0447\u044C. \u042F \u0431\u044B
        \u0441\u043F\u0435\u0440\u0432\u0430 \u043E\u0441\u043C\u043E\u0442\u0440\u0435\u043B
        \u0441\u0442\u0430\u0440\u0443\u044E \u0447\u0430\u0441\u0442\u044C \u043F\u043B\u043E\u0442\u0438\u043D\u044B."
      choices:
      - text: "\u041F\u043E\u043A\u0430\u0436\u0438 \u0441\u0442\u0430\u0440\u0443\u044E
          \u0447\u0430\u0441\u0442\u044C \u043F\u043B\u043E\u0442\u0438\u043D\u044B."
        nextNodeId: old_dam
        endsDialogue: 0
      - text: "\u0420\u0430\u0431\u043E\u0447\u0438\u0435 \u0447\u0442\u043E-\u043D\u0438\u0431\u0443\u0434\u044C
          \u0437\u0430\u043C\u0435\u0442\u0438\u043B\u0438?"
        nextNodeId: workers
        endsDialogue: 0
      - text: "\u0412\u0435\u0440\u043D\u0451\u043C\u0441\u044F \u043A \u0442\u043E\u043C\u0443,
          \u0447\u0442\u043E \u0442\u044B \u0432\u0438\u0434\u0435\u043B."
        nextNodeId: details
        endsDialogue: 0
      - text: "\u042F\u0441\u043D\u043E. \u041F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u043C
          \u043F\u043E\u0437\u0436\u0435."
        nextNodeId: 
        endsDialogue: 1
    - id: tracks
      speakerId: miller
      text: "\u0421\u043B\u0435\u0434\u044B \u0435\u0441\u0442\u044C, \u043D\u043E
        \u043F\u043E\u0441\u043B\u0435 \u043F\u0430\u0432\u043E\u0434\u043A\u0430
        \u0434\u0432\u043E\u0440 \u0432\u0435\u0441\u044C \u0432 \u0433\u0440\u044F\u0437\u0438.
        \u041E\u0434\u0438\u043D \u0440\u0430\u0431\u043E\u0447\u0438\u0439 \u0443\u0432\u0435\u0440\u044F\u0435\u0442,
        \u0447\u0442\u043E \u0432\u0438\u0434\u0435\u043B \u0441\u0432\u0435\u0436\u0438\u0435
        \u043E\u0442\u043C\u0435\u0442\u0438\u043D\u044B \u0443 \u043D\u0430\u0441\u0442\u0438\u043B\u0430."
      choices:
      - text: "\u041F\u043E\u0437\u043E\u0432\u0438 \u0442\u0435\u0445, \u043A\u0442\u043E
          \u0440\u0430\u0431\u043E\u0442\u0430\u043B \u043D\u043E\u0447\u044C\u044E."
        nextNodeId: workers
        endsDialogue: 0
      - text: "\u0421\u043D\u0430\u0447\u0430\u043B\u0430 \u0445\u043E\u0447\u0443
          \u0435\u0449\u0451 \u0440\u0430\u0437 \u0443\u0441\u043B\u044B\u0448\u0430\u0442\u044C
          \u0432\u0441\u0451 \u0441 \u043D\u0430\u0447\u0430\u043B\u0430."
        nextNodeId: opening
        endsDialogue: 0
      - text: "\u042D\u0442\u043E\u0433\u043E \u043F\u043E\u043A\u0430 \u0445\u0432\u0430\u0442\u0438\u0442."
        nextNodeId: 
        endsDialogue: 1
    - id: workers
      speakerId: miller
      text: "\u041E\u0434\u0438\u043D \u0433\u043E\u0432\u043E\u0440\u0438\u0442,
        \u0447\u0442\u043E \u0432\u043E\u0434\u0430 \u0440\u0435\u0437\u043A\u043E
        \u043F\u043E\u0434\u043D\u044F\u043B\u0430\u0441\u044C. \u0414\u0440\u0443\u0433\u043E\u0439
        \u2014 \u0447\u0442\u043E \u043E\u043D\u0430, \u043D\u0430\u043E\u0431\u043E\u0440\u043E\u0442,
        \u0443\u0448\u043B\u0430. \u041E\u0431\u0430 \u0441\u0442\u043E\u044F\u043B\u0438
        \u0437\u0434\u0435\u0441\u044C \u0432 \u043E\u0434\u043D\u0443 \u0438 \u0442\u0443
        \u0436\u0435 \u043D\u043E\u0447\u044C."
      choices:
      - text: "\u0417\u043D\u0430\u0447\u0438\u0442, \u043E\u0441\u043C\u043E\u0442\u0440\u0438\u043C
          \u0432\u0441\u0451 \u043F\u043E \u043F\u043E\u0440\u044F\u0434\u043A\u0443."
        nextNodeId: old_dam
        endsDialogue: 0
      - text: "\u042F \u043F\u043E\u0433\u043E\u0432\u043E\u0440\u044E \u0441 \u043D\u0438\u043C\u0438
          \u043F\u043E\u0437\u0436\u0435."
        nextNodeId: 
        endsDialogue: 1
    - id: old_dam
      speakerId: miller
      text: "\u041D\u0430\u0447\u043D\u0438 \u0441\u043E \u0441\u0442\u0430\u0440\u043E\u0433\u043E
        \u0448\u043B\u044E\u0437\u0430. \u0422\u0430\u043C \u0434\u0435\u0440\u0435\u0432\u043E
        \u0442\u0435\u043C\u043D\u0435\u0435 \u0438 \u043A\u0440\u0435\u043F\u0451\u0436
        \u0441\u0442\u0430\u0440\u044B\u0439 \u2014 \u0441\u0440\u0430\u0437\u0443
        \u0443\u0432\u0438\u0434\u0438\u0448\u044C. \u041F\u043E\u0442\u043E\u043C
        \u0441\u0440\u0430\u0432\u043D\u0438 \u0441 \u043D\u043E\u0432\u044B\u043C\u0438
        \u043E\u043F\u043E\u0440\u0430\u043C\u0438."
      choices:
      - text: "\u0425\u043E\u0440\u043E\u0448\u043E. \u042F \u043E\u0441\u043C\u043E\u0442\u0440\u044E."
        nextNodeId: 
        endsDialogue: 1
      - text: "\u0415\u0449\u0451 \u043E\u0434\u0438\u043D \u0432\u043E\u043F\u0440\u043E\u0441."
        nextNodeId: opening
        endsDialogue: 0
