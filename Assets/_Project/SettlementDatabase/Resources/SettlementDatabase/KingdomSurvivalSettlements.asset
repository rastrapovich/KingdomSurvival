        Id: town.tavern
        Name: "\u041A\u043E\u0440\u0447\u043C\u0430 \u0443 \u0432\u043E\u0440\u043E\u0442"
        Description: "\u0421\u0440\u0430\u0437\u0443 \u0437\u0430 \u0432\u043E\u0440\u043E\u0442\u0430\u043C\u0438,
          \u0447\u0442\u043E\u0431\u044B \u0441\u0442\u0440\u0430\u0436\u0443 \u0431\u044B\u043B\u043E
          \u043D\u0435\u0434\u0430\u043B\u0435\u043A\u043E \u0445\u043E\u0434\u0438\u0442\u044C.
          \u041D\u0430 \u0441\u0442\u0435\u043D\u0435 \u2014 \u043F\u0440\u0430\u0432\u0438\u043B\u0430,
          \u0432\u044B\u0440\u0435\u0437\u0430\u043D\u043D\u044B\u0435 \u043D\u043E\u0436\u043E\u043C;
          \u0447\u0438\u0442\u0430\u0442\u044C \u0438\u0445 \u043D\u0435 \u043D\u0443\u0436\u043D\u043E,
          \u0445\u043E\u0437\u044F\u0439\u043A\u0430 \u0441\u043A\u0430\u0436\u0435\u0442."
