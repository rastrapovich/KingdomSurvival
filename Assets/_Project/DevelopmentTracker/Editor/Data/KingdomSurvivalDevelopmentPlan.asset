      \u043E\u043F\u0446\u0438\u043E\u043D\u0430\u043B\u044C\u043D\u044B\u0435 \u0434\u0430\u043B\u044C\u043D\u0438\u0435
      \u0446\u0435\u043B\u0438) \u0438 N10 (\u0432\u044B\u0431\u043E\u0440 0\u20134
      \u0431\u043E\u0439\u0446\u043E\u0432 \u0438\u0437 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u044E\u0449\u0435\u0433\u043E
      \u0441\u043E\u0441\u0442\u0430\u0432\u0430)."
    order: 8
    required: 1
    dependencies:
