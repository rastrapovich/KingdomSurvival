<?xml version="1.0" encoding="utf-8"?>

<ui:UXML
    xmlns:ui="UnityEngine.UIElements"
    xmlns:uie="UnityEditor.UIElements"
    editor-extension-mode="False">

    <!-- Подключаем оформление из файла Prototype_Main.uss -->
    <Style src="Prototype_Main.uss" />

    <!-- Корневой контейнер всего игрового интерфейса -->
    <ui:VisualElement name="screen" class="screen">

        <!-- ===================================================== -->
        <!-- ВЕРХНЯЯ ПАНЕЛЬ: ДЕНЬ, РЕСУРСЫ И НАСТРОЕНИЕ             -->
        <!-- ===================================================== -->

        <ui:VisualElement class="top-bar">

            <ui:Label
                text="KINGDOM SURVIVAL"
                class="game-title" />

            <ui:VisualElement class="resource-strip">

                <ui:VisualElement class="resource-box">
                    <ui:Label
                        name="day-label"
                        text="День: 1"
                        class="resource-value" />
                </ui:VisualElement>

                <ui:VisualElement class="resource-box">
                    <ui:Label
                        name="gold-label"
                        text="Золото: 120"
                        class="resource-value" />
                </ui:VisualElement>

                <ui:VisualElement class="resource-box food-box">
                    <ui:Label
                        name="food-label"
                        text="Пища: 72"
                        class="resource-value" />

                    <!-- Расход рассчитывается в C#: население × 1 -->
                    <ui:Label
                        name="food-consumption-label"
                        text="Расход: 24 в день"
                        class="resource-note" />
                </ui:VisualElement>

                <ui:VisualElement class="resource-box">
                    <ui:Label
                        name="population-label"
                        text="Население: 24"
                        class="resource-value" />
                </ui:VisualElement>

                <ui:VisualElement class="resource-box">
                    <ui:Label
                        name="mood-label"
                        text="Настроение: 64/100"
                        class="resource-value" />
                </ui:VisualElement>

            </ui:VisualElement>

            <ui:Button
                name="end-day-button"
                text="Завершить день"
                class="end-day-button" />

        </ui:VisualElement>

        <!-- Прокручиваемая основная область интерфейса -->
        <ui:ScrollView name="main-scroll" class="main-scroll">

            <ui:VisualElement class="main-grid">

                <!-- ================================================= -->
                <!-- ЛЕВАЯ КОЛОНКА: СТОЛИЦА И АРМИЯ                    -->
                <!-- ================================================= -->

                <ui:VisualElement class="left-column">

                    <!-- Панель столицы -->
                    <ui:VisualElement class="panel">

                        <ui:Label
                            text="СТОЛИЦА"
                            class="panel-title" />

                        <ui:Label
                            text="Здания и основные городские действия"
                            class="panel-description" />

                        <ui:VisualElement class="building-grid">

                            <ui:Button
                                text="Тронный зал"
                                class="building-card" />

                            <ui:Button
                                text="Амбар"
                                class="building-card" />

                            <ui:Button
                                text="Казармы"
                                class="building-card" />

                            <ui:Button
                                text="Рынок"
                                class="building-card" />

                            <ui:Button
                                text="Шахта"
                                class="building-card" />

                            <ui:Button
                                text="Городские проекты"
                                class="building-card" />

                        </ui:VisualElement>

                    </ui:VisualElement>

                    <!-- Панель единственной армии -->
                    <ui:VisualElement class="panel army-panel">

                        <ui:Label
                            text="ЕДИНСТВЕННАЯ АРМИЯ"
                            class="panel-title" />

                        <ui:Label
                            text="Выберите одного руководителя армии"
                            class="panel-description" />

                        <!-- Список заполняется в PrototypeUIController.cs -->
                        <ui:DropdownField
                            name="commander-dropdown"
                            label="Командир"
                            class="commander-dropdown" />

                        <!-- Здесь будет описание выбранного командира -->
                        <ui:Label
                            name="commander-detail-label"
                            text="Командир пока не выбран"
                            class="commander-detail" />

                        <!-- Статус меняется после отправки экспедиции -->
                        <ui:Label
                            name="army-status-label"
                            text="Статус армии: в столице"
                            class="status-label" />

                        <ui:VisualElement class="section-divider" />

                        <ui:Label
                            text="ВОИНЫ — 5 ИЗ 6"
                            class="section-title" />

                        <ui:Label
                            text="Каждая карточка представляет одного отдельного воина"
                            class="panel-description" />

                        <!-- Только отдельные воины. Никаких отрядов -->
                        <ui:VisualElement name="fighters-list">

                            <ui:VisualElement class="fighter-card">
                                <ui:Label
                                    text="Годрик Железный"
                                    class="fighter-name" />
                                <ui:Label
                                    text="Гвардеец · уровень 2 · здоров"
                                    class="fighter-info" />
                            </ui:VisualElement>

                            <ui:VisualElement class="fighter-card">
                                <ui:Label
                                    text="Элина Меткий Глаз"
                                    class="fighter-name" />
                                <ui:Label
                                    text="Лучница · уровень 1 · здорова"
                                    class="fighter-info" />
                            </ui:VisualElement>

                            <ui:VisualElement class="fighter-card">
                                <ui:Label
                                    text="Торвальд"
                                    class="fighter-name" />
                                <ui:Label
                                    text="Копейщик · уровень 1 · здоров"
                                    class="fighter-info" />
                            </ui:VisualElement>

                            <ui:VisualElement class="fighter-card">
                                <ui:Label
                                    text="Марта"
                                    class="fighter-name" />
                                <ui:Label
                                    text="Лекарь · уровень 1 · здорова"
                                    class="fighter-info" />
                            </ui:VisualElement>

                            <ui:VisualElement class="fighter-card">
                                <ui:Label
                                    text="Борислав"
                                    class="fighter-name" />
                                <ui:Label
                                    text="Разведчик · уровень 1 · здоров"
                                    class="fighter-info" />
                            </ui:VisualElement>

                        </ui:VisualElement>

                    </ui:VisualElement>

                </ui:VisualElement>

                <!-- ================================================= -->
                <!-- ПРАВАЯ КОЛОНКА: ЭКСПЕДИЦИИ И ДОНЕСЕНИЯ             -->
                <!-- ================================================= -->

                <ui:VisualElement class="right-column">

                    <ui:VisualElement class="panel expedition-panel">

                        <ui:Label
                            text="ЭКСПЕДИЦИИ"
                            class="panel-title" />

                        <ui:Label
                            name="expedition-status-label"
                            text="Активная экспедиция: нет"
                            class="status-label" />

                        <ui:Label
                            text="НАЙДЕННЫЕ ЛОКАЦИИ"
                            class="section-title" />

                        <!-- Локация 1 -->
                        <ui:VisualElement class="location-card">

                            <ui:Label
                                text="Затопленные руины"
                                class="location-name" />

                            <ui:VisualElement class="location-info-row">
                                <ui:Label
                                    text="Расстояние: 2 дня"
                                    class="location-info" />
                                <ui:Label
                                    text="Угроза: низкая"
                                    class="threat-low" />
                            </ui:VisualElement>

                            <!-- Предполагаемую награду не показываем -->
                            <ui:Button
                                name="send-ruins-button"
                                text="Отправить"
                                class="send-button" />

                        </ui:VisualElement>

                        <!-- Локация 2 -->
                        <ui:VisualElement class="location-card">

                            <ui:Label
                                text="Старая шахта"
                                class="location-name" />

                            <ui:VisualElement class="location-info-row">
                                <ui:Label
                                    text="Расстояние: 3 дня"
                                    class="location-info" />
                                <ui:Label
                                    text="Угроза: средняя"
                                    class="threat-medium" />
                            </ui:VisualElement>

                            <ui:Button
                                name="send-mine-button"
                                text="Отправить"
                                class="send-button" />

                        </ui:VisualElement>

                        <!-- Локация 3 -->
                        <ui:VisualElement class="location-card">

                            <ui:Label
                                text="Чёрный лес"
                                class="location-name" />

                            <ui:VisualElement class="location-info-row">
                                <ui:Label
                                    text="Расстояние: 5 дней"
                                    class="location-info" />
                                <ui:Label
                                    text="Угроза: высокая"
                                    class="threat-high" />
                            </ui:VisualElement>

                            <ui:Button
                                name="send-forest-button"
                                text="Отправить"
                                class="send-button" />

                        </ui:VisualElement>

                    </ui:VisualElement>

                    <!-- Панель сообщений -->
                    <ui:VisualElement class="panel reports-panel">

                        <ui:Label
                            text="КОРОЛЕВСКИЕ ДОНЕСЕНИЯ"
                            class="panel-title" />

                        <ui:Label
                            name="report-label"
                            text="Новых донесений нет."
                            class="report-text" />

                    </ui:VisualElement>

                </ui:VisualElement>

            </ui:VisualElement>

        </ui:ScrollView>

    </ui:VisualElement>

</ui:UXML>