      - blockId: chapter01.node.09.departure_decided_main
        kind: 0
        speakerIdOverride: 
        text: "Цель определена: пройти по старому водному следу за пределы знакомых дорог и найти следующий сохранившийся след системы."
        conditions:
          Combinator: 0
