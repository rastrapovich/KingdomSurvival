    nodes:
    - id: cave.cutter.start
      speakerId: narrator
      text: 
      textBlocks:
      - blockId: cave.cutter.start.here
        kind: 5
        speakerIdOverride: 
        text: "\u0412 \u0434\u0430\u043B\u044C\u043D\u0435\u043C \u0437\u0430\u043B\u0435
          \u0443\u0437\u043A\u043E \u0438 \u0442\u0435\u043F\u043B\u043E \u043E\u0442
          \u043B\u0443\u0447\u0438\u043D\u044B. \u041D\u0430 \u043F\u043E\u043B\u0443
          \u2014 \u043A\u0430\u043C\u0435\u043D\u043D\u0430\u044F \u0441\u0442\u0440\u0443\u0436\u043A\u0430,
          \u0441\u0435\u0440\u0430\u044F, \u043A\u0430\u043A \u0437\u043E\u043B\u0430,
          \u0442\u0440\u0438 \u043D\u0435\u0434\u043E\u0440\u0435\u0437\u0430\u043D\u043D\u044B\u0445
          \u0431\u0440\u0443\u0441\u043A\u0430 \u0438 \u0447\u0435\u043B\u043E\u0432\u0435\u043A
          \u0441 \u043C\u043E\u043B\u043E\u0442\u043A\u043E\u043C \u0432 \u0440\u0443\u043A\u0435.
          \u041E\u043D \u043D\u0435 \u0432\u0441\u0442\u0430\u0451\u0442: \u043D\u043E\u0433\u0438
          \u0437\u0430\u0442\u0435\u043A\u043B\u0438."
        conditions:
          Combinator: 0
          Conditions:
          - Type: 0
            StringParam: freeplay.cave.cutter_gone
            QualityParam: 0
            IntParam: 0
