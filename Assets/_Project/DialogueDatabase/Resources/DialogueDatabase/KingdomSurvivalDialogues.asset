      - text: "\u041F\u0440\u043E\u0439\u0442\u0438 \u043F\u043E \u0441\u043B\u0435\u0434\u0430\u043C,
          \u043F\u043E\u043A\u0430 \u043E\u043D\u0438 \u0441\u0432\u0435\u0436\u0438\u0435."
