  - id: chapter01_dialogue_11c_camp_after_cart
    title: "\u041F\u043E\u0441\u043B\u0435 \u0442\u0435\u043B\u0435\u0433\u0438"
    category: 1
    status: 1
    developerComment: "P09-T06 production-\u0441\u0446\u0435\u043D\u0430. \u041E\u0434\u043D\u0430
      \u0441\u0446\u0435\u043D\u0430 \u0441 \u0447\u0435\u0442\u044B\u0440\u044C\u043C\u044F
      \u0432\u0437\u0430\u0438\u043C\u043E\u0438\u0441\u043A\u043B\u044E\u0447\u0430\u044E\u0449\u0438\u043C\u0438
      \u0432\u0435\u0442\u043A\u0430\u043C\u0438 \u043F\u043E CartOutcome*-\u0444\u043B\u0430\u0433\u0443
      (\u0443\u0441\u043B\u043E\u0432\u0438\u0435 FlagSet \u043D\u0430 textBlock,
      \u0442\u043E\u0442 \u0436\u0435 \u043C\u0435\u0445\u0430\u043D\u0438\u0437\u043C,
      \u0447\u0442\u043E \u0443\u0436\u0435 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0435\u0442
      D09 \u0434\u043B\u044F \u043E\u043F\u0446\u0438\u043E\u043D\u0430\u043B\u044C\u043D\u044B\u0445
      \u0446\u0435\u043B\u0435\u0439 \u043F\u043E\u0445\u043E\u0434\u0430), \u043D\u0435
      \u0447\u0435\u0442\u044B\u0440\u0435 \u0440\u0430\u0437\u043D\u044B\u0445 Dialogue.
      \u0417\u0430\u043F\u0443\u0441\u043A\u0430\u0435\u0442\u0441\u044F \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438
      \u043F\u043E\u0432\u0435\u0440\u0445 \u044D\u043A\u0440\u0430\u043D\u0430 \u041B\u0430\u0433\u0435\u0440\u044F
      (PrototypeUIController.Camp.cs.OpenCampScreen) \u0447\u0435\u0440\u0435\u0437
      Chapter01CampSceneProvider, \u0434\u043E\u0441\u0442\u0443\u043F\u043D\u0430
      \u043F\u043E\u043A\u0430 CartResolved && !CartCampEchoSeen. \u041D\u0438\u043A\u0430\u043A\u043E\u0433\u043E
      \u043D\u043E\u0432\u043E\u0433\u043E \u043C\u043E\u0440\u0430\u043B\u044C\u043D\u043E\u0433\u043E
      \u0432\u044B\u0431\u043E\u0440\u0430 \u0432\u043D\u0443\u0442\u0440\u0438 \u2014
      \u0440\u0430\u0437\u0434\u0435\u043B \"\u041F\u043E\u0447\u0435\u043C\u0443
      \u0441\u0446\u0435\u043D\u0435 \u043D\u0435 \u043D\u0443\u0436\u0435\u043D
      \u043D\u043E\u0432\u044B\u0439 \u0432\u044B\u0431\u043E\u0440\": \u0441\u0446\u0435\u043D\u0430
      \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442 \u043E\u0442\u043B\u043E\u0436\u0435\u043D\u043D\u043E\u0435
      \u044D\u0445\u043E \u0443\u0436\u0435 \u0441\u0434\u0435\u043B\u0430\u043D\u043D\u043E\u0433\u043E
      \u0440\u0435\u0448\u0435\u043D\u0438\u044F, \u0430 \u043D\u0435 \u043D\u043E\u0432\u043E\u0435
      \u0440\u0435\u0448\u0435\u043D\u0438\u0435. \u0420\u0430\u0431\u043E\u0442\u0430\u0435\u0442
      \u043E\u0434\u0438\u043D\u0430\u043A\u043E\u0432\u043E, \u0438\u0434\u0451\u0442
      \u0433\u0435\u0440\u043E\u0439 \u043E\u0434\u0438\u043D \u0438\u043B\u0438
      \u0441 \u043E\u0442\u0440\u044F\u0434\u043E\u043C \u2014 \u0440\u0430\u0437\u0434\u0435\u043B
      \"\u0415\u0441\u043B\u0438 \u0433\u0435\u0440\u043E\u0439 \u0438\u0434\u0451\u0442
      \u043E\u0434\u0438\u043D\"."
    startNodeId: chapter01.node.11c
    tags:
    - "\u0433\u043B\u0430\u0432\u043001"
    - production
    nodes:
    - id: chapter01.node.11c
      speakerId: narrator
      text: 
      textBlocks:
      - blockId: chapter01.node.11c_main
        kind: 0
        speakerIdOverride: 
        text: "\u041E\u0433\u043E\u043D\u044C \u0437\u0430\u043D\u0438\u043C\u0430\u0435\u0442\u0441\u044F
          \u043D\u0435 \u0441\u0440\u0430\u0437\u0443. \u0414\u043E\u0440\u043E\u0436\u043D\u0430\u044F
          \u0433\u0440\u044F\u0437\u044C \u0443\u0436\u0435 \u043F\u043E\u0434\u0441\u043E\u0445\u043B\u0430
          \u043D\u0430 \u0441\u0430\u043F\u043E\u0433\u0430\u0445, \u043D\u043E \u0437\u0430\u043F\u0430\u0445
          \u0441\u044B\u0440\u043E\u0439 \u0437\u0435\u043C\u043B\u0438 \u0432\u0441\u0451
          \u0435\u0449\u0451 \u0442\u044F\u043D\u0435\u0442\u0441\u044F \u0441\u043B\u0435\u0434\u043E\u043C."
