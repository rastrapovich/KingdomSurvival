    - id: chapter01.node.04.priority_failure
      speakerId: narrator
      text:
      textBlocks:
      - blockId: chapter01.node.04.priority_failure_main
        kind: 0
        speakerIdOverride:
        text: "\u0412\u0440\u0435\u043C\u044F, \u043A\u043E\u0442\u043E\u0440\u043E\u0435 \u0442\u044B \u043F\u043E\u0442\u0435\u0440\u044F\u043B, \u043D\u0435 \u043E\u0442\u043C\u0435\u043D\u044F\u0435\u0442 \u0432\u044B\u0431\u043E\u0440\u0430 \u2014 \u043E\u043D\u043E \u0435\u0433\u043E \u0441\u0443\u0436\u0430\u0435\u0442. \u0423 \u043C\u0435\u043B\u044C\u043D\u0438\u0446\u044B \u2014 \u0440\u0430\u0431\u043E\u0442\u043D\u0438\u043A\u0438, \u0447\u0442\u043E \u043D\u0435 \u0443\u0441\u043F\u0435\u043B\u0438 \u043E\u0442\u043E\u0439\u0442\u0438. \u0423 \u0432\u043E\u0434\u044B \u2014 \u043E\u0431\u0435\u0437\u0443\u043C\u0435\u0432\u0448\u0438\u0439 \u0441\u043A\u043E\u0442. \u041F\u043E\u0434 \u043D\u043E\u0433\u0430\u043C\u0438 \u2014 \u0442\u043E \u043D\u0435\u043C\u043D\u043E\u0433\u043E\u0435, \u0447\u0442\u043E \u0435\u0449\u0451 \u0434\u0435\u0440\u0436\u0438\u0442\u0441\u044F \u043E\u0442 \u043D\u0430\u0441\u0442\u0438\u043B\u0430 \u0438 \u043C\u0435\u0445\u0430\u043D\u0438\u0437\u043C\u0430. \u0420\u0435\u0448\u0430\u0442\u044C \u043D\u0443\u0436\u043D\u043E \u043F\u0440\u044F\u043C\u043E \u0441\u0435\u0439\u0447\u0430\u0441."
