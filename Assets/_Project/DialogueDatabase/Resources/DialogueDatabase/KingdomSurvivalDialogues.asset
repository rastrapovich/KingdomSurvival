  - id: freeplay_carter
    title: "12\u0422 \u2014 \u0412\u043E\u0437\u0447\u0438\u043A \u0416\u0434\u0430\u043D"
    category: 2
    status: 1
    developerComment: "12\u0422, \u043F\u0438\u043B\u043E\u0442 \xAB\u0422\u0430\u0439\u043D\u0438\u043A
      \u0443 \u0441\u0442\u0430\u0440\u043E\u0433\u043E \u0440\u0443\u0441\u043B\u0430\xBB
      [\u0420\u0410\u0411\u041E\u0427\u0415\u0415][KINGDOM SURVIVAL]. \u0412\u043E\u0437\u0447\u0438\u043A
      \u0432 \u043A\u043E\u0440\u0447\u043C\u0435 \u0442\u043E\u0440\u0433\u043E\u0432\u043E\u0433\u043E
      \u0441\u0435\u043B\u0430. \u041F\u043E\u0440\u0443\u0447\u0435\u043D\u0438\u0435
      \xAB\u041D\u043E\u0436 \u0434\u0435\u0434\u0430\xBB (ErrandId settlement.errand.carter_knife):
      \u043F\u0440\u0438\u043D\u044F\u0442\u044C \u0437\u0434\u0435\u0441\u044C (\u0444\u043B\u0430\u0433
      freeplay.cache.errand.accepted), \u043D\u0430 \u0434\u043E\u0441\u043A\u0435
      \u0438\u043B\u0438 \u0432 \u043A\u043E\u0440\u0447\u043C\u0435 \u2014 \u0441\u043E\u0441\u0442\u043E\u044F\u043D\u0438\u0435
      \u043E\u0431\u0449\u0435\u0435. \u0421\u0432\u0435\u0434\u0435\u043D\u0438\u044F
      \u043E \u043C\u0435\u0441\u0442\u0435 \u043F\u0440\u043E\u0434\u0430\u044E\u0442\u0441\u044F
      \u043E\u0442\u0434\u0435\u043B\u044C\u043D\u044B\u043C \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0435\u043D\u0438\u0435\u043C
      \u043A\u043E\u0440\u0447\u043C\u044B (\u043E\u043F\u043B\u0430\u0442\u0430
      \u2014 \u043A\u043E\u043C\u0430\u043D\u0434\u043E\u0439 TavernService). \u041D\u043E\u0436
      \u2014 \u0432\u0435\u0449\u044C item.carter_token_knife \u0432 \u0441\u0443\u043C\u043A\u0435
      (ItemPresent); \u043E\u0442\u0434\u0430\u0442\u044C \u2014 \u0444\u043B\u0430\u0433
      freeplay.cache.token_returned, \u043A\u043E\u0434 \u0437\u0430\u0431\u0438\u0440\u0430\u0435\u0442
      \u044D\u043A\u0437\u0435\u043C\u043F\u043B\u044F\u0440. \u0414\u0435\u0434
      \u0438 \u0442\u0430\u0439\u043D\u0438\u043A \u2014 \u0440\u0430\u0431\u043E\u0447\u0438\u0439
      \u043A\u043E\u043D\u0442\u0435\u043D\u0442, \u043D\u0435 \u0444\u0430\u043A\u0442
      \u043C\u0438\u0440\u0430."
    sceneIllustration: {fileID: 0}
    sceneIllustrationFillFrame: 0
    sceneIllustrationScale: 1
    sceneIllustrationOffsetNormalized: {x: 0, y: 0}
    startNodeId: freeplay.carter.start
    tags:
    - "\u043F\u043E\u0441\u0435\u043B\u0435\u043D\u0438\u044F"
    - "12\u0422"
    - "\u0442\u0430\u0439\u043D\u0438\u043A"
    nodes:
    - id: freeplay.carter.start
      speakerId: carter
      text: 
      textBlocks:
      - blockId: freeplay.carter.start.scene
        kind: 5
        speakerIdOverride: narrator
        text: "\u0412\u043E\u0437\u0447\u0438\u043A \u0441\u0438\u0434\u0438\u0442
          \u0431\u043E\u043A\u043E\u043C \u043A \u0441\u0442\u043E\u043B\u0443, \u0447\u0442\u043E\u0431\u044B
          \u0441\u043F\u0438\u043D\u0430 \u043D\u0435 \u043A\u0430\u0441\u0430\u043B\u0430\u0441\u044C
          \u043B\u0430\u0432\u043A\u0438. \u041F\u043E \u0442\u043E\u043C\u0443,
          \u043A\u0430\u043A \u043E\u043D \u043C\u043E\u0440\u0449\u0438\u0442\u0441\u044F,
          \u0434\u043E\u0442\u044F\u0433\u0438\u0432\u0430\u044F\u0441\u044C \u0434\u043E
          \u043A\u0440\u0443\u0436\u043A\u0438, \u0441\u043F\u0438\u043D\u0430 \u0443
          \u043D\u0435\u0433\u043E \u0433\u043B\u0430\u0432\u043D\u044B\u0439 \u0441\u043E\u0431\u0435\u0441\u0435\u0434\u043D\u0438\u043A."
