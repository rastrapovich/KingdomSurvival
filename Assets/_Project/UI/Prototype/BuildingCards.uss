/* ================================================================
   BUILDING CARD (UI-M05) — карточка постройки в building-grid
   ================================================================ */

.building-grid {
    align-items: stretch;
}

.building-card {
    width: 31.5%;
    min-width: 230px;
    margin-right: 8px;
    margin-bottom: 8px;
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 10px;
    padding-bottom: 10px;
}

.building-card-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.building-card-title {
    -unity-font-style: bold;
    font-size: 15px;
    white-space: normal;
    flex-grow: 1;
}

.building-card-status {
    font-size: 10px;
    margin-left: 8px;
    -unity-text-align: middle-right;
}

.building-card-image {
    height: 72px;
    margin-top: 8px;
    margin-bottom: 8px;
    -unity-text-align: middle-center;
    font-size: 10px;
    opacity: 0.55;
}

.building-card-description {
    white-space: normal;
    font-size: 11px;
    margin-bottom: 6px;
}

.building-card-effect {
    white-space: normal;
    font-size: 11px;
    -unity-font-style: bold;
    margin-bottom: 7px;
}

.building-card-meta {
    white-space: normal;
    font-size: 10px;
    margin-bottom: 6px;
}

.building-card-progress {
    height: 18px;
    margin-bottom: 7px;
}

.building-card-action {
    height: 34px;
}
