    - id: chapter01.node.04.priority_success
      speakerId: narrator
      text:
      textBlocks:
      - blockId: chapter01.node.04.priority_success_main
        kind: 0
        speakerIdOverride:
        text: "\u0412\u044B\u0438\u0433\u0440\u0430\u043D\u043D\u044B\u0445 \u043C\u0433\u043D\u043E\u0432\u0435\u043D\u0438\u0439 \u0445\u0432\u0430\u0442\u0438\u0442 \u043D\u0430 \u0447\u0442\u043E-\u0442\u043E \u043E\u0434\u043D\u043E. \u0423 \u043C\u0435\u043B\u044C\u043D\u0438\u0446\u044B \u2014 \u0440\u0430\u0431\u043E\u0442\u043D\u0438\u043A\u0438, \u0447\u0442\u043E \u043D\u0435 \u0443\u0441\u043F\u0435\u043B\u0438 \u043E\u0442\u043E\u0439\u0442\u0438. \u0423 \u0432\u043E\u0434\u044B \u2014 \u043E\u0431\u0435\u0437\u0443\u043C\u0435\u0432\u0448\u0438\u0439 \u0441\u043A\u043E\u0442. \u041F\u043E\u0434 \u043D\u043E\u0433\u0430\u043C\u0438 \u2014 \u043D\u0430\u0441\u0442\u0438\u043B \u0438 \u043C\u0435\u0445\u0430\u043D\u0438\u0437\u043C, \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u0442\u044B \u0442\u043E\u043B\u044C\u043A\u043E \u0447\u0442\u043E \u043F\u0440\u0438\u0434\u0435\u0440\u0436\u0430\u043B \u0446\u0435\u043D\u043E\u0439 \u0441\u0438\u043B. \u0421\u043F\u0430\u0441\u0442\u0438 \u0432\u0441\u0451 \u0441\u0440\u0430\u0437\u0443 \u043D\u0435 \u043F\u043E\u043B\u0443\u0447\u0438\u0442\u0441\u044F."
        conditions:
          Combinator: 0
          Conditions: []
        hasPassiveCheck: 0
        passiveCheck:
          CheckId:
