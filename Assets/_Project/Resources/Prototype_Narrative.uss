.narrative-dialogue-overlay {
    display: none;
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(5, 7, 8, 0.68);
}

.narrative-dialogue-panel {
    position: absolute;
    right: 0;
    top: 0;
    bottom: 0;
    width: 38%;
    min-width: 500px;
    padding-left: 44px;
    padding-right: 42px;
    padding-top: 58px;
    padding-bottom: 48px;
    background-color: rgba(12, 14, 15, 0.98);
    border-left-width: 1px;
    border-left-color: rgb(94, 87, 70);
}

.narrative-dialogue-portrait {
    position: absolute;
    right: 34%;
    top: 18%;
    width: 23%;
    max-width: 430px;
    height: 58%;
    min-height: 360px;
    justify-content: center;
    align-items: center;
    background-color: rgb(31, 34, 34);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(113, 101, 76);
    border-right-color: rgb(113, 101, 76);
    border-top-color: rgb(113, 101, 76);
    border-bottom-color: rgb(113, 101, 76);
}

.narrative-dialogue-portrait-placeholder {
    color: rgb(117, 116, 108);
    font-size: 13px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: normal;
}

.narrative-dialogue-speaker {
    margin-bottom: 5px;
    color: rgb(218, 182, 111);
    font-size: 27px;
    -unity-font-style: bold;
    white-space: normal;
}

.narrative-dialogue-role {
    margin-bottom: 15px;
    color: rgb(133, 130, 120);
    font-size: 11px;
    white-space: normal;
}

.narrative-dialogue-divider {
    height: 1px;
    margin-bottom: 22px;
    background-color: rgb(89, 77, 56);
}

.narrative-dialogue-text-scroll {
    flex-grow: 1;
    min-height: 120px;
    margin-bottom: 24px;
}

.narrative-dialogue-history {
    flex-grow: 1;
    padding-right: 8px;
}

/* Одна группа = один вызов DisplayNarrativeView (дополнение к инструкции
   "новое отображение пассивных наблюдений и проверок" — "новый текст
   всегда появляется цельным"). Сам отступ группы от следующей группы даёт
   margin-bottom последнего .narrative-dialogue-history-entry/-check-result
   внутри неё — отдельный отступ на .narrative-dialogue-history-group не нужен. */
.narrative-dialogue-history-group {
    flex-shrink: 0;
}

.narrative-dialogue-history-entry {
    margin-bottom: 18px;
}

.narrative-dialogue-history-speaker {
    margin-bottom: 4px;
    color: rgb(178, 148, 91);
    font-size: 12px;
    -unity-font-style: bold;
    white-space: normal;
}

.narrative-dialogue-history-text {
    margin-top: 4px;
    color: rgb(224, 219, 205);
    font-size: 17px;
    white-space: normal;
}

.narrative-dialogue-history-player {
    margin-left: 24px;
    margin-bottom: 18px;
    padding-left: 12px;
    border-left-width: 2px;
    border-left-color: rgb(119, 96, 58);
    color: rgb(194, 187, 170);
    font-size: 14px;
    -unity-font-style: italic;
    white-space: normal;
}

.narrative-dialogue-choices {
    flex-shrink: 0;
}

.narrative-dialogue-choice {
    width: 100%;
    min-height: 48px;
    margin-bottom: 8px;
    padding-left: 18px;
    padding-right: 18px;
    padding-top: 9px;
    padding-bottom: 9px;
    background-color: rgba(24, 26, 25, 0.88);
    color: rgb(209, 205, 193);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(64, 65, 60);
    border-right-color: rgb(64, 65, 60);
    border-top-color: rgb(64, 65, 60);
    border-bottom-color: rgb(64, 65, 60);
    border-radius: 2px;
    font-size: 13px;
    -unity-text-align: middle-left;
    white-space: normal;
}

.narrative-dialogue-choice:hover {
    background-color: rgba(53, 46, 32, 0.95);
    color: rgb(241, 226, 194);
    border-left-color: rgb(184, 137, 65);
    border-right-color: rgb(184, 137, 65);
    border-top-color: rgb(184, 137, 65);
    border-bottom-color: rgb(184, 137, 65);
}

.narrative-dialogue-choice-exit {
    color: rgb(148, 146, 139);
}

.narrative-dialogue-choice-continue {
    min-height: 32px;
    padding-top: 6px;
    padding-bottom: 6px;
    background-color: rgba(24, 26, 25, 0.4);
    color: rgb(158, 154, 142);
    font-size: 16px;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    -unity-text-align: middle-center;
}

.narrative-dialogue-choice-continue:hover {
    background-color: rgba(53, 46, 32, 0.6);
    color: rgb(224, 214, 190);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
}

.narrative-dialogue-choice-mechanic {
    margin-top: -4px;
    margin-bottom: 8px;
    margin-left: 18px;
    color: rgb(150, 145, 128);
    font-size: 10px;
    white-space: normal;
}

.narrative-dialogue-choice-disabled {
    opacity: 0.55;
}

.narrative-dialogue-choice-hint {
    margin-top: -4px;
    margin-bottom: 8px;
    margin-left: 18px;
    color: rgb(158, 112, 92);
    font-size: 10px;
    white-space: normal;
}

.narrative-dialogue-history-check-result {
    margin-left: 24px;
    margin-bottom: 18px;
    padding-left: 12px;
    border-left-width: 2px;
    border-left-color: rgb(74, 84, 74);
    white-space: normal;
}

/* Narrative Check Presentation Layer — единый компонент для пассивных
   блоков и активных проверок (§13 инструкции по визуализации проверок). */

.narrative-check-header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 4px;
}

.narrative-check-source {
    margin-right: 10px;
    color: rgb(158, 154, 140);
    font-size: 11px;
    letter-spacing: 1px;
    -unity-font-style: bold;
    white-space: normal;
}

.narrative-check-result {
    font-size: 12px;
    letter-spacing: 1px;
    -unity-font-style: bold;
    white-space: normal;
}

.narrative-check-result--success {
    color: rgb(150, 190, 132);
}

.narrative-check-result--failure {
    color: rgb(196, 122, 100);
}

.narrative-check-result:hover {
    opacity: 0.8;
}

/* Инлайн-строка "ИСТОЧНИК: РЕЗУЛЬТАТ — текст" для checked-observation
   блоков (§7/§24 инструкции "новое отображение пассивных наблюдений и
   проверок"). Переиспользует narrative-check-header/-source/-result и
   narrative-dialogue-history-text — вторая независимая цветовая система
   не создаётся. */
.narrative-check-inline {
    align-items: flex-start;
    flex-wrap: wrap;
}

.narrative-check-inline-body {
    flex-grow: 1;
    flex-shrink: 1;
    margin-left: 6px;
}

.narrative-check-tooltip {
    position: absolute;
    width: 320px;
    padding-left: 14px;
    padding-right: 14px;
    padding-top: 12px;
    padding-bottom: 12px;
    background-color: rgb(18, 20, 20);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(113, 101, 76);
    border-right-color: rgb(113, 101, 76);
    border-top-color: rgb(113, 101, 76);
    border-bottom-color: rgb(113, 101, 76);
}

.narrative-check-tooltip-title {
    margin-bottom: 8px;
    color: rgb(218, 182, 111);
    font-size: 12px;
    letter-spacing: 1px;
    -unity-font-style: bold;
    white-space: normal;
}

.narrative-check-tooltip-row {
    margin-bottom: 2px;
    color: rgb(200, 196, 184);
    font-size: 11px;
    white-space: normal;
}

.narrative-check-tooltip-divider {
    height: 1px;
    margin-top: 6px;
    margin-bottom: 6px;
    background-color: rgb(64, 65, 60);
}

.narrative-check-tooltip-total {
    color: rgb(224, 219, 205);
    font-size: 12px;
    -unity-font-style: bold;
    white-space: normal;
}
