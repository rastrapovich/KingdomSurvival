      - blockId: chapter01.node.05.opening_02_main
        kind: 0
        speakerIdOverride: 
        text: "\u041B\u0430\u0434\u0430 \u0441\u0438\u0434\u0438\u0442 \u043F\u0440\u044F\u043C\u043E
          \u043D\u0430 \u043C\u043E\u043A\u0440\u043E\u0439 \u0434\u043E\u0441\u043A\u0435
          \u0438 \u043D\u043E\u0436\u043E\u043C \u0441\u0447\u0438\u0449\u0430\u0435\u0442
          \u0440\u0430\u0437\u043C\u043E\u043A\u0448\u0435\u0435 \u0434\u0435\u0440\u0435\u0432\u043E
          \u0432\u043E\u043A\u0440\u0443\u0433 \u0442\u0440\u0435\u0441\u043D\u0443\u0432\u0448\u0435\u0433\u043E
          \u043F\u0430\u0437\u0430. \u041E\u0441\u0442\u0430\u0444\u0438\u0439 \u0441\u0442\u043E\u0438\u0442
          \u043D\u0430\u0434 \u043D\u0435\u0439 \u0441 \u0434\u043B\u0438\u043D\u043D\u044B\u043C
          \u0448\u0435\u0441\u0442\u043E\u043C \u0438 \u043F\u043E \u043E\u0447\u0435\u0440\u0435\u0434\u0438
          \u043A\u0430\u0441\u0430\u0435\u0442\u0441\u044F \u0441\u0435\u043C\u0438
          \u0437\u0430\u0442\u0432\u043E\u0440\u043E\u0432."
