/* ================================================================
   ДОБЫЧА ОТРЯДА И ИССЛЕДОВАНИЕ ЛОКАЦИИ
   ================================================================ */

.research-expedition-button {
    display: none;
    height: 38px;
    margin-bottom: 7px;
    background-color: rgb(56, 79, 64);
    color: rgb(228, 235, 220);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(103, 140, 109);
    border-right-color: rgb(103, 140, 109);
    border-top-color: rgb(103, 140, 109);
    border-bottom-color: rgb(103, 140, 109);
    border-radius: 4px;
    -unity-font-style: bold;
}

.research-expedition-button:hover {
    background-color: rgb(69, 96, 77);
}

.research-expedition-button:disabled {
    opacity: 0.55;
}

.military-expedition-column .location-info-row {
    flex-wrap: wrap;
}

.military-expedition-column .active-expedition-details,
.military-expedition-column .location-name,
.military-expedition-column .location-info,
.military-expedition-column .status-label {
    white-space: normal;
}

/* ================================================================
   ИЗОБРАЖЕНИЯ НА КАРТОЧКАХ ЛОКАЦИЙ
   ================================================================ */

.location-image-placeholder {
    width: 100%;
    height: 112px;
    margin-bottom: 9px;
    align-items: center;
    justify-content: center;
    background-color: rgb(35, 40, 48);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(74, 80, 91);
    border-right-color: rgb(74, 80, 91);
    border-top-color: rgb(74, 80, 91);
    border-bottom-color: rgb(74, 80, 91);
    border-radius: 4px;
}

.location-image-placeholder-text {
    color: rgb(105, 111, 121);
    font-size: 9px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

/* ================================================================
   ВСПЛЫВАЮЩИЙ РАСХОД ГОРОДСКОЙ ПИЩИ
   ================================================================ */

.food-expense-popup {
    top: 100%;
    margin-top: 2px;
}

/* ================================================================
   СХЕМАТИЧЕСКАЯ КАРТА ОКРЕСТНОСТЕЙ
   ================================================================ */

.world-map-section-title {
    margin-bottom: 3px;
}

.world-map-hint {
    margin-bottom: 8px;
    color: rgb(163, 158, 143);
    font-size: 10px;
    white-space: normal;
}

.world-map-viewport {
    position: relative;
    width: 100%;
    height: 350px;
    min-height: 350px;
    margin-bottom: 9px;
    overflow: hidden;
    background-color: rgb(38, 40, 39);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(112, 96, 67);
    border-right-color: rgb(87, 77, 58);
    border-top-color: rgb(112, 96, 67);
    border-bottom-color: rgb(72, 65, 52);
    border-radius: 5px;
}

.world-map {
    /* WM-03: карта (canvas) теперь живёт внутри .world-map-viewport — рамка
       фиксированного размера с overflow:hidden. Сама .world-map заполняет
       viewport на 100% при zoom=1 и панорамируется/зумируется через
       style.left/top/scale в WorldMapViewportController, а не через layout. */
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    transform-origin: 0% 0%;
}

.world-map-land {
    position: absolute;
    background-color: rgb(48, 51, 46);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(75, 79, 67);
    border-right-color: rgb(64, 68, 59);
    border-top-color: rgb(75, 79, 67);
    border-bottom-color: rgb(64, 68, 59);
    border-radius: 18px;
    opacity: 0.72;
}

.world-map-land-west {
    left: -4%;
    top: 10%;
    width: 42%;
    height: 44%;
}

.world-map-land-north {
    left: 29%;
    top: -7%;
    width: 42%;
    height: 41%;
}

.world-map-land-east {
    left: 62%;
    top: 13%;
    width: 44%;
    height: 48%;
}

.world-map-compass {
    position: absolute;
    left: 4%;
    top: 73%;
    width: 30px;
    color: rgb(164, 145, 100);
    font-size: 11px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: normal;
}

.world-map-layer {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.world-map-route-dot {
    position: absolute;
    width: 5px;
    height: 5px;
    background-color: rgb(103, 99, 84);
    border-radius: 3px;
    opacity: 0.54;
}

.world-map-route-dot-active {
    width: 7px;
    height: 7px;
    background-color: rgb(226, 187, 99);
    border-radius: 4px;
    opacity: 0.96;
}

.world-map-route-dot-preview {
    width: 6px;
    height: 6px;
    background-color: rgb(190, 164, 104);
    border-radius: 3px;
    opacity: 0.82;
}

.world-map-terrain-cell {
    position: absolute;
    width: 4.5%;
    height: 6.8%;
    border-radius: 3px;
    opacity: 0.72;
}

.world-map-terrain-mass {
    /* WM-04: базовый размер "массы" ~2.5 клетки сетки (26x16), центрируется
       на точке через отрицательные margin. Художник управляет тем, что внутри
       этого прямоугольника, через сами спрайты в WorldMapTerrainVisualProfile —
       размер здесь только задаёт масштаб размещения, не финальный визуал. */
    position: absolute;
    width: 10%;
    height: 16%;
    margin-left: -5%;
    margin-top: -8%;
    transform-origin: 50% 50%;
}

.world-map-destination-marker {
    position: absolute;
    width: 18px;
    height: 18px;
    margin-left: -9px;
    margin-top: -9px;
    background-color: rgb(196, 87, 67);
    border-left-width: 3px;
    border-right-width: 3px;
    border-top-width: 3px;
    border-bottom-width: 3px;
    border-left-color: rgb(244, 213, 151);
    border-right-color: rgb(244, 213, 151);
    border-top-color: rgb(244, 213, 151);
    border-bottom-color: rgb(244, 213, 151);
    border-radius: 9px;
}

.world-map-node {
    position: absolute;
    width: 34px;
    height: 34px;
    min-height: 34px;
    margin-left: -17px;
    margin-top: -17px;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    color: rgb(205, 198, 178);
    background-color: rgb(47, 50, 49);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(110, 107, 94);
    border-right-color: rgb(85, 83, 74);
    border-top-color: rgb(110, 107, 94);
    border-bottom-color: rgb(85, 83, 74);
    border-radius: 17px;
    font-size: 14px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: normal;
}

.world-map-node-icon {
    position: absolute;
    width: 26px;
    height: 26px;
    left: 3px;
    top: 3px;
    -unity-background-scale-mode: scale-to-fit;
}

.world-map-node:hover {
    background-color: rgb(59, 62, 57);
    border-left-color: rgb(183, 151, 85);
    border-right-color: rgb(183, 151, 85);
    border-top-color: rgb(183, 151, 85);
    border-bottom-color: rgb(183, 151, 85);
}

.world-map-node-unknown {
    color: rgb(176, 172, 159);
    background-color: rgb(43, 46, 46);
    border-left-color: rgb(91, 96, 95);
    border-right-color: rgb(76, 80, 80);
    border-top-color: rgb(91, 96, 95);
    border-bottom-color: rgb(76, 80, 80);
}

.world-map-node-known {
    color: rgb(236, 220, 180);
    background-color: rgb(58, 55, 45);
    border-left-color: rgb(151, 124, 70);
}

.world-map-node-explored {
    color: rgb(182, 215, 184);
    background-color: rgb(42, 59, 49);
    border-left-color: rgb(95, 150, 107);
    border-right-color: rgb(69, 109, 79);
    border-top-color: rgb(95, 150, 107);
    border-bottom-color: rgb(69, 109, 79);
}

.world-map-node-selected {
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgb(235, 194, 104);
    border-right-color: rgb(235, 194, 104);
    border-top-color: rgb(235, 194, 104);
    border-bottom-color: rgb(235, 194, 104);
}

.world-map-node-active {
    background-color: rgb(72, 58, 38);
    color: rgb(250, 222, 159);
}

.world-map-capital {
    position: absolute;
    left: 37%;
    top: 74%;
    width: 26%;
    height: 48px;
    color: rgb(226, 225, 214);
    background-color: rgb(47, 54, 61);
    border-left-width: 2px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(150, 158, 164);
    border-right-color: rgb(96, 105, 113);
    border-top-color: rgb(96, 105, 113);
    border-bottom-color: rgb(96, 105, 113);
    border-radius: 5px;
    font-size: 10px;
    -unity-font-style: bold;
    white-space: normal;
}

.world-map-capital:hover {
    background-color: rgb(61, 69, 76);
}

.world-map-capital-return {
    color: rgb(245, 218, 175);
    background-color: rgb(82, 57, 45);
    border-left-color: rgb(195, 129, 86);
    border-right-color: rgb(143, 92, 66);
    border-top-color: rgb(143, 92, 66);
    border-bottom-color: rgb(143, 92, 66);
}

.world-map-capital:disabled {
    opacity: 0.78;
}

.world-map-army-marker {
    display: none;
    position: absolute;
    width: 74px;
    min-height: 38px;
    align-items: center;
}

.world-map-army-badge {
    padding-left: 5px;
    padding-right: 5px;
    padding-top: 3px;
    padding-bottom: 3px;
    color: rgb(42, 34, 22);
    background-color: rgb(232, 192, 98);
    border-radius: 3px;
    font-size: 9px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.world-map-army-label {
    margin-top: 2px;
    color: rgb(243, 218, 162);
    font-size: 8px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: normal;
}

.world-map-activity {
    display: none;
    position: absolute;
    width: 138px;
    padding-left: 5px;
    padding-right: 5px;
    padding-top: 4px;
    padding-bottom: 5px;
    background-color: rgba(24, 27, 31, 0.94);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(203, 165, 82);
    border-right-color: rgb(111, 91, 51);
    border-top-color: rgb(203, 165, 82);
    border-bottom-color: rgb(111, 91, 51);
    border-radius: 4px;
}

.world-map-army-activity {
    left: -32px;
    bottom: 40px;
}

.world-map-location-activity {
    margin-left: -69px;
    margin-top: -58px;
}

.world-map-activity-label {
    margin-bottom: 3px;
    color: rgb(242, 218, 163);
    font-size: 8px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: normal;
}

.world-map-activity-track {
    width: 100%;
    height: 7px;
    background-color: rgb(48, 48, 44);
    border-radius: 3px;
    overflow: hidden;
}

.world-map-activity-fill {
    width: 0%;
    height: 100%;
    background-color: rgb(220, 177, 78);
    border-radius: 3px;
}

.map-selection-card {
    margin-bottom: 8px;
    padding-left: 11px;
    padding-right: 11px;
    padding-top: 9px;
    padding-bottom: 9px;
    background-color: rgb(40, 44, 50);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(92, 84, 65);
    border-right-color: rgb(70, 68, 62);
    border-top-color: rgb(92, 84, 65);
    border-bottom-color: rgb(70, 68, 62);
    border-radius: 5px;
}

.map-selection-title {
    margin-bottom: 5px;
    color: rgb(229, 210, 167);
    font-size: 13px;
    -unity-font-style: bold;
    white-space: normal;
}

.map-selection-details {
    margin-bottom: 8px;
    color: rgb(184, 180, 167);
    font-size: 10px;
    white-space: normal;
}

.map-send-button {
    min-height: 36px;
    -unity-font-style: bold;
    white-space: normal;
}

.map-send-button:disabled {
    opacity: 0.48;
}

/* UI-M08: карточка осмотра локации по ПКМ на маркере мира. */

.world-map-location-inspection-card {
    display: none;
    position: absolute;
    right: 14px;
    bottom: 14px;
    width: 300px;
    padding-left: 14px;
    padding-right: 14px;
    padding-top: 12px;
    padding-bottom: 12px;
    background-color: rgba(35, 39, 46, 0.97);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(177, 139, 73);
    border-right-color: rgb(93, 79, 56);
    border-top-color: rgb(177, 139, 73);
    border-bottom-color: rgb(93, 79, 56);
    border-radius: 5px;
}

.world-map-location-inspection-title {
    margin-bottom: 7px;
    color: rgb(235, 194, 104);
    font-size: 14px;
    -unity-font-style: bold;
    white-space: normal;
}

.world-map-location-inspection-details {
    margin-bottom: 10px;
    color: rgb(207, 201, 184);
    font-size: 11px;
    white-space: normal;
}

.world-map-location-inspection-presence {
    display: none;
    margin-bottom: 8px;
    color: rgb(155, 207, 155);
    font-size: 11px;
    -unity-font-style: bold;
}

.world-map-location-inspection-research-button {
    height: 34px;
    margin-bottom: 6px;
    -unity-font-style: bold;
}

.world-map-location-inspection-close-button {
    height: 32px;
    -unity-font-style: bold;
}
