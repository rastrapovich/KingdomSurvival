          Combinator: 0
          Conditions: []
        unavailablePresentation: 0
        check:
          CheckId: ""
          Kind: 0
          Quality: 0
          CompetencyId: ""
          Difficulty: 13
          ModifierRules: []
        successNodeId: ""
        failureNodeId: ""
        successEffects: []
        failureEffects: []
      - text: "4. Логика группы — ВСЕ / ХОТЯ БЫ ОДНО / обращение условия."
        nextNodeId: "logic_conditions"
        endsDialogue: 0
