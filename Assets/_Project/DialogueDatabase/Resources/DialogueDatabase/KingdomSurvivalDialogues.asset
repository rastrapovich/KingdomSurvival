      - blockId: chapter01.node.12.talk_old_custom
        kind: 1
        speakerIdOverride:
        text: "\u2014 \u0420\u0430\u0437 \u0437\u043D\u0430\u0435\u0448\u044C, \u0447\u0442\u043E \u0437\u0434\u0435\u0441\u044C \u0440\u0430\u043D\u044C\u0448\u0435 \u0432\u0435\u043B\u0438 \u0441\u0447\u0451\u0442, \u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0434\u043D\u0435\u0439
          \u0434\u0435\u0440\u0436\u0430\u0442\u044C \u0441\u0442\u043E\u043A \u043E\u0442\u043A\u0440\u044B\u0442\u044B\u043C, \u2014 \u0431\u0440\u043E\u0434 \u0434\u043B\u044F \u0442\u0435\u0431\u044F \u043D\u0435 \u0437\u0430\u0433\u0430\u0434\u043A\u0430, \u0430 \u0437\u0430\u0431\u044B\u0442\u0430\u044F
          \u0440\u0430\u0431\u043E\u0442\u0430."
