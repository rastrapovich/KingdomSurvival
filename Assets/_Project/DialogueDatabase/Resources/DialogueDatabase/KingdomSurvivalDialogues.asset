  dialogues:
  - id: road_warm_sheep_01
    title: "\u0422\u0451\u043F\u043B\u0430\u044F \u043E\u0432\u0446\u0430"
    category: 3
    status: 1
    developerComment: "[\u0420\u0410\u0411\u041E\u0427\u0415\u0415] \u0421\u0446\u0435\u043D\u0430\u0440\u043D\u0430\u044F
      \u0432\u0435\u0440\u0441\u0438\u044F \u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u0435\u043B\u044F
      \u043E\u0442 2026-09-12. \u041F\u0440\u0438\u0447\u0438\u043D\u0430 \u0441\u043C\u0435\u0440\u0442\u0438
      \u043E\u0432\u0446\u044B \u043D\u0430\u043C\u0435\u0440\u0435\u043D\u043D\u043E
      \u043D\u0435 \u0440\u0430\u0441\u043A\u0440\u044B\u0442\u0430 \u2014 \u0441\u043C.
      FutureHooksNotes \u043D\u0430 EncounterDefinition ROAD_WARM_SHEEP_01."
    sceneIllustration: {fileID: 0}
    sceneIllustrationFillFrame: 0
    sceneIllustrationScale: 1
    sceneIllustrationOffsetNormalized: {x: 0, y: 0}
    startNodeId: start
    tags:
    - road
    - warm_sheep
    nodes:
    - id: start
      speakerId: narrator
      text: 
      textBlocks:
      - blockId: b_main
        kind: 0
        speakerIdOverride: 
        text: "\u041E\u0432\u0446\u0430 \u043B\u0435\u0436\u0438\u0442 \u043F\u043E\u0447\u0442\u0438
          \u043F\u043E\u0441\u0440\u0435\u0434\u0438 \u0434\u043E\u0440\u043E\u0433\u0438
          \u2014 \u0442\u0430\u043A \u043D\u0435\u0431\u0440\u0435\u0436\u043D\u043E,
          \u0431\u0443\u0434\u0442\u043E \u0441\u043E\u0431\u0438\u0440\u0430\u043B\u0430\u0441\u044C
          \u043F\u0435\u0440\u0435\u0439\u0442\u0438 \u043D\u0430 \u0434\u0440\u0443\u0433\u0443\u044E
          \u0441\u0442\u043E\u0440\u043E\u043D\u0443 \u0438 \u043F\u0435\u0440\u0435\u0434\u0443\u043C\u0430\u043B\u0430
          \u043D\u0430 \u043F\u043E\u043B\u043F\u0443\u0442\u0438.\n\n\u041E\u043D\u0430
          \u0435\u0449\u0451 \u0442\u0451\u043F\u043B\u0430\u044F.\n\n\u0413\u043E\u0440\u043B\u043E
          \u0446\u0435\u043B\u043E. \u0428\u0435\u0440\u0441\u0442\u044C \u043D\u0430
          \u0448\u0435\u0435 \u0434\u0430\u0436\u0435 \u043D\u0435 \u043F\u0440\u0438\u043C\u044F\u0442\u0430.\n\n\u0417\u0430\u0442\u043E
          \u043E\u0434\u043D\u0430 \u0437\u0430\u0434\u043D\u044F\u044F \u043D\u043E\u0433\u0430
          \u043E\u0431\u043E\u0434\u0440\u0430\u043D\u0430 \u043F\u043E\u0447\u0442\u0438
          \u0434\u043E \u043A\u043E\u0441\u0442\u0438. \u041C\u044F\u0441\u043E \u0441\u043D\u044F\u0442\u043E
          \u043A\u043B\u043E\u0447\u044C\u044F\u043C\u0438, \u0438 \u043A\u0440\u0430\u0441\u043D\u0430\u044F
          \u043A\u043E\u0441\u0442\u044C \u0431\u0435\u043B\u0435\u0435\u0442 \u043C\u0435\u0436\u0434\u0443
          \u0448\u0435\u0440\u0441\u0442\u044C\u044E.\n\n\u0412\u043E\u043A\u0440\u0443\u0433
          \u0442\u0438\u0445\u043E. \u041D\u0438 \u043F\u0430\u0441\u0442\u0443\u0445\u0430.
          \u041D\u0438 \u0441\u043E\u0431\u0430\u043A. \u041D\u0438 \u0441\u0442\u0430\u0434\u0430."
        conditions:
          Combinator: 0
          Conditions: []
        hasPassiveCheck: 0
