          RewardText: "\u0441\u0435\u0440\u0435\u0431\u0440\u043E \u0438\u0437 \u0442\u0430\u0439\u043D\u0438\u043A\u0430;
            \u043E\u0442 \u0416\u0434\u0430\u043D\u0430 \u2014 \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u043D\u043E\u0441\u0442\u044C"
        - Id: notice.trade.peddler
          Title: "\u0412\u0435\u0449\u0438 \u0441 \u0438\u0441\u0442\u043E\u0440\u0438\u0435\u0439"
          Text: "\xAB\u0413\u043E\u0441\u0442\u044F\u0442\u0430, \u0432\u0435\u0449\u0438
            \u0441 \u0438\u0441\u0442\u043E\u0440\u0438\u0435\u0439. \u0421\u0438\u0436\u0443
            \u0432 \u043A\u043E\u0440\u0447\u043C\u0435 \u0434\u043E\u2026\xBB \u2014
            \u0434\u0430\u043B\u044C\u0448\u0435 \u0431\u0435\u0440\u0435\u0441\u0442\u0430
            \u043E\u0442\u043E\u0440\u0432\u0430\u043D\u0430. \u0414\u044C\u044F\u0447\u043E\u043A
            \u043F\u0440\u0435\u0434\u043F\u043E\u043B\u0430\u0433\u0430\u0435\u0442,
            \u0447\u0442\u043E \u0434\u043E \u0445\u043E\u043B\u043E\u0434\u043E\u0432."
          Type: 4
          Medium: 0
          AuthorName: "\u043F\u0440\u043E\u0435\u0437\u0436\u0438\u0439 \u0442\u043E\u0440\u0433\u043E\u0432\u0435\u0446
