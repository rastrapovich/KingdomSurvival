    - id: chapter01.node.12.talk
      speakerId: ford_woman
      text:
      textBlocks:
      - blockId: chapter01.node.12.talk_main
        kind: 0
        speakerIdOverride:
        text: "\u2014 \u041C\u0435\u043D\u044F \u0437\u0434\u0435\u0441\u044C \u043D\u0438\u043A\u0442\u043E \u043D\u0435 \u0441\u043F\u0440\u0430\u0448\u0438\u0432\u0430\u043B \u0440\u0430\u043D\u044C\u0448\u0435, \u0438 \u043F\u043E\u0442\u043E\u043C \u043D\u0435
          \u0441\u043F\u0440\u0430\u0448\u0438\u0432\u0430\u043B \u0442\u043E\u0436\u0435, \u2014 \u043E\u043D\u0430 \u043D\u0430\u043A\u043E\u043D\u0435\u0446 \u0441\u0430\u0434\u0438\u0442\u0441\u044F \u043D\u0430 \u043A\u0430\u043C\u0435\u043D\u044C, \u0432\u044B\u0442\u0438\u0440\u0430\u044F \u0440\u0443\u043A\u0438
          \u043E \u043F\u043E\u0434\u043E\u043B. \u2014 \u0411\u0440\u043E\u0434 \u0434\u0435\u0440\u0436\u0430\u043B\u0438. \u0422\u0435\u043F\u0435\u0440\u044C \u043D\u0438\u043A\u0442\u043E \u043D\u0435 \u0434\u0435\u0440\u0436\u0438\u0442."
        conditions:
          Combinator: 0
          Conditions: []
        hasPassiveCheck: 0
        passiveCheck:
          CheckId:
          Kind: 0
          Quality: 0
          CompetencyId:
          Difficulty: 13
          ModifierRules: []
        onRevealEffects: []
      - blockId: chapter01.node.12.talk_story
        kind: 2
        speakerIdOverride:
        text: "\u041E\u043D\u0430 \u043A\u0438\u0432\u0430\u0435\u0442 \u0432 \u0441\u0442\u043E\u0440\u043E\u043D\u0443 \u043A\u043E\u043B\u044C\u0435\u0432. \u2014 \u0417\u0434\u0435\u0441\u044C \u0436\u0435\u043D\u0449\u0438\u043D\u0430 \u0443\u0442\u043E\u043D\u0443\u043B\u0430, \u0435\u0449\u0451
          \u0434\u043E \u043F\u043E\u0442\u043E\u043F\u0430, \u0434\u043E \u0442\u043E\u0433\u043E, \u043A\u0430\u043A \u044F \u0441\u044E\u0434\u0430 \u043F\u0440\u0438\u0448\u043B\u0430. \u041B\u044E\u0434\u0438 \u043F\u043E\u043C\u043D\u044F\u0442 \u043F\u043E-\u0440\u0430\u0437\u043D\u043E\u043C\u0443:
          \u043A\u0442\u043E \u0433\u043E\u0432\u043E\u0440\u0438\u0442 \u2014 \u0441\u0430\u043C\u0430 \u0437\u0430\u0448\u043B\u0430 \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u0434\u0430\u043B\u0435\u043A\u043E, \u043A\u0442\u043E \u2014 \u0447\u0442\u043E \u0435\u0451
          \u0441\u0442\u043E\u043B\u043A\u043D\u0443\u043B\u0438 \u0437\u0430\u0431\u043E\u0442\u044B, \u0430 \u043D\u0435 \u0447\u0435\u043B\u043E\u0432\u0435\u043A. \u0421 \u0442\u0435\u0445 \u043F\u043E\u0440 \u0443 \u0431\u0440\u043E\u0434\u0430 \u043D\u0435 \u043A\u0443\u043F\u0430\u044E\u0442\u0441\u044F
          \u043D\u043E\u0447\u044C\u044E \u2014 \u043D\u0435 \u0441\u043E \u0441\u0442\u0440\u0430\u0445\u0443 \u043F\u0435\u0440\u0435\u0434 \u0434\u0443\u0445\u0430\u043C\u0438, \u0430 \u043F\u043E \u043F\u0440\u0438\u0432\u044B\u0447\u043A\u0435, \u0447\u0442\u043E \u0442\u0430\u043A
          \u0434\u0435\u043B\u0430\u044E\u0442 \u0432\u0441\u0435."
        conditions:
          Combinator: 0
          Conditions: []
        hasPassiveCheck: 0
        passiveCheck:
          CheckId:
          Kind: 0
          Quality: 0
          CompetencyId:
          Difficulty: 13
