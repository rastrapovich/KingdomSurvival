    - id: chapter01.node.04.success_workers
      speakerId: narrator
      text: 
      textBlocks:
      - blockId: chapter01.node.04.success_workers_main
        kind: 0
        speakerIdOverride: 
        text: "\u0422\u044B \u0443\u0441\u043F\u0435\u0432\u0430\u0435\u0448\u044C
          \u0432\u044B\u0442\u0430\u0449\u0438\u0442\u044C \u0440\u0430\u0431\u043E\u0442\u043D\u0438\u043A\u043E\u0432
          \u043D\u0430 \u0441\u0443\u0445\u043E\u0435 \u2014 \u0432\u0441\u0435 \u043D\u0430
          \u043D\u043E\u0433\u0430\u0445, \u043F\u0435\u0440\u0435\u043F\u0443\u0433\u0430\u043D\u044B,
          \u043D\u043E \u0446\u0435\u043B\u044B. \u041F\u043E\u043A\u0430 \u0442\u044B
          \u0434\u0435\u0440\u0436\u0438\u0448\u044C \u0438\u0445 \u0437\u0430 \u0440\u0443\u043A\u0438
          \u043D\u0430 \u0441\u043A\u043E\u043B\u044C\u0437\u043A\u0438\u0445 \u043C\u043E\u0441\u0442\u043A\u0430\u0445,
          \u043A\u043E\u0440\u043E\u0432\u0438\u0439 \u0440\u0451\u0432 \u0442\u043E\u043D\u0435\u0442
          \u0432 \u0448\u0443\u043C\u0435 \u0432\u043E\u0434\u044B: \u0441\u043A\u043E\u0442\u0438\u043D\u0443
          \u0443\u043D\u0435\u0441\u043B\u043E \u0442\u0435\u0447\u0435\u043D\u0438\u0435\u043C,
          \u0438 \u0435\u0451 \u0431\u043E\u043B\u044C\u0448\u0435 \u043D\u0435 \u0432\u0438\u0434\u043D\u043E.
          \u041C\u0438\u0440\u043E\u043D \u0441\u0442\u043E\u0438\u0442 \u0443 \u0441\u043F\u0430\u0441\u0451\u043D\u043D\u043E\u0433\u043E
          \u043C\u0435\u0445\u0430\u043D\u0438\u0437\u043C\u0430, \u0443 \u043D\u0435\u0433\u043E
          \u0434\u0440\u043E\u0436\u0430\u0442 \u0440\u0443\u043A\u0438 \u2014 \u043D\u0435
          \u043E\u0442 \u0445\u043E\u043B\u043E\u0434\u0430."
        conditions:
          Combinator: 0
          Conditions: []
        hasPassiveCheck: 0
        passiveCheck:
