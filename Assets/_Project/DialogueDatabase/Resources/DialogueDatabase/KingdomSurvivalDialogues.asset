  - id: chapter01_dialogue_03_first_pressure
    title: "N03 \u2014 \u041F\u0435\u0440\u0432\u043E\u0435 \u0434\u0430\u0432\u043B\u0435\u043D\u0438\u0435"
    category: 1
    status: 1
    developerComment: "P04-T05 production-\u0442\u0435\u043A\u0441\u0442. \u0420\u0435\u0430\u043A\u0446\u0438\u044F
      \u0440\u0430\u0441\u043F\u0440\u0435\u0434\u0435\u043B\u0435\u043D\u0430 \u043F\u043E
      \u0440\u0430\u0437\u0434\u0435\u043B\u0443 17 \u0438\u043D\u0441\u0442\u0440\u0443\u043A\u0446\u0438\u0438:
      \u041C\u0438\u0440\u043E\u043D \u2014 \u0444\u0430\u043A\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0435
      \u043D\u0430\u0431\u043B\u044E\u0434\u0435\u043D\u0438\u0435, \u041B\u0430\u0434\u0430
      \u2014 \u043C\u0435\u0445\u0430\u043D\u0438\u0447\u0435\u0441\u043A\u043E\u0435
      \u043E\u0431\u044A\u044F\u0441\u043D\u0435\u043D\u0438\u0435, \u041E\u0441\u0442\u0430\u0444\u0438\u0439
      \u2014 \u0441\u0440\u0430\u0432\u043D\u0435\u043D\u0438\u0435 \u0441 \u043F\u0440\u043E\u0448\u043B\u044B\u043C,
      \u0423\u043B\u044C\u044F\u043D\u0430 \u2014 \u0431\u044B\u0442\u043E\u0432\u043E\u0435
      \u043F\u043E\u0441\u043B\u0435\u0434\u0441\u0442\u0432\u0438\u0435. \u041D\u0438\u043A\u0442\u043E
      \u043D\u0435 \u043F\u0440\u043E\u0438\u0437\u043D\u043E\u0441\u0438\u0442 \u0433\u043E\u0442\u043E\u0432\u0443\u044E
      \u0438\u0441\u0442\u0438\u043D\u0443."
    startNodeId: chapter01.node.03
    tags:
    - "\u0433\u043B\u0430\u0432\u043001"
    - production
    nodes:
    - id: chapter01.node.03
      speakerId: narrator
      text: 
      textBlocks:
      - blockId: chapter01.node.03_scene
        kind: 1
        speakerIdOverride: 
        text: "\u0412\u043E\u0434\u0430 \u0443 \u0431\u0435\u0440\u0435\u0433\u0430
          \u0448\u0443\u043C\u0438\u0442 \u043D\u0435 \u0442\u0430\u043A, \u043A\u0430\u043A
          \u0432\u0447\u0435\u0440\u0430 \u2014 \u0447\u0443\u0442\u044C \u0438\u043D\u0430\u0447\u0435,
          \u0431\u0443\u0434\u0442\u043E \u043D\u0430 \u043C\u0438\u0433 \u043A\u0442\u043E-\u0442\u043E
          \u043F\u0435\u0440\u0435\u0441\u0442\u0430\u0432\u0438\u043B \u043A\u0430\u043C\u0435\u043D\u044C
          \u043F\u043E\u0434 \u0441\u0442\u0440\u0443\u0451\u0439. \u0427\u0435\u0440\u0435\u0437
          \u043C\u0438\u043D\u0443\u0442\u0443 \u0432\u0441\u0451 \u0441\u043D\u043E\u0432\u0430
          \u0437\u0432\u0443\u0447\u0438\u0442 \u043F\u0440\u0438\u0432\u044B\u0447\u043D\u043E,
          \u0438 \u043C\u043E\u0436\u043D\u043E \u0431\u044B \u0437\u0430\u0431\u044B\u0442\u044C,
          \u0435\u0441\u043B\u0438 \u0431\u044B \u043D\u0435 \u043F\u0440\u0438\u0432\u044B\u0447\u043A\u0430
          \u0434\u043E\u0441\u043B\u0443\u0448\u0438\u0432\u0430\u0442\u044C \u0434\u043E
          \u043A\u043E\u043D\u0446\u0430."
        conditions:
          Combinator: 0
          Conditions: []
        hasPassiveCheck: 0
        passiveCheck:
          CheckId: 
          Kind: 0
          Quality: 0
          CompetencyId: 
          Difficulty: 13
          ModifierRules: []
        onRevealEffects:
        - EffectExecutionId: chapter01.effect.n03_flag1
          Type: 0
          StringParam: chapter01.flag.first_pressure_seen
          IntParam: 0
      - blockId: chapter01.node.03_miron
        kind: 0
        speakerIdOverride: miron
        text: "\u041C\u0438\u0440\u043E\u043D \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0435\u0442
          \u0433\u043E\u043B\u043E\u0432\u0443 \u0440\u0430\u043D\u044C\u0448\u0435,
          \u0447\u0435\u043C \u0442\u044B \u0443\u0441\u043F\u0435\u0432\u0430\u0435\u0448\u044C
          \u0441\u043F\u0440\u043E\u0441\u0438\u0442\u044C. \xAB\u041A\u043E\u043B\u0435\u0441\u043E
          \u0434\u0432\u0430 \u0440\u0430\u0437\u0430 \u0441\u0431\u0438\u043B\u043E\u0441\u044C
          \u0437\u0430 \u0447\u0430\u0441 \u2014 \u043D\u0435 \u043F\u043E\u0434
          \u043C\u043E\u044E \u0440\u0443\u043A\u0443, \u0441\u0430\u043C\u043E.
          \u041E\u0442\u043C\u0435\u0442\u0438\u043B, \u0434\u0430\u043B\u044C\u0448\u0435
          \u0432\u0438\u0434\u043D\u043E \u0431\u0443\u0434\u0435\u0442\xBB."
        conditions:
          Combinator: 0
          Conditions: []
        hasPassiveCheck: 0
        passiveCheck:
          CheckId: 
          Kind: 0
          Quality: 0
          CompetencyId: 
          Difficulty: 13
          ModifierRules: []
        onRevealEffects: []
      - blockId: chapter01.node.03_lada
        kind: 0
        speakerIdOverride: lada
        text: "\u041B\u0430\u0434\u0430, \u0443\u0441\u043B\u044B\u0448\u0430\u0432,
          \u043F\u043E\u0436\u0438\u043C\u0430\u0435\u0442 \u043F\u043B\u0435\u0447\u0430\u043C\u0438.
          \xAB\u0417\u0430\u0434\u0432\u0438\u0436\u043A\u0443, \u043C\u043E\u0436\u0435\u0442,
          \u043F\u043E\u0434\u043F\u0435\u0440\u043B\u043E \u0432\u0435\u0442\u043A\u043E\u0439,
          \u0438\u043B\u0438 \u043B\u044E\u0444\u0442 \u0432 \u043E\u0441\u0438 \u2014
          \u0441\u0430\u043C\u043E \u0443\u043B\u044F\u0436\u0435\u0442\u0441\u044F.
          \u0415\u0441\u043B\u0438 \u043D\u0435\u0442, \u0433\u043B\u044F\u043D\u0443
          \u0440\u0430\u0441\u043F\u043E\u0440\u043A\u0443\xBB."
        conditions:
          Combinator: 0
          Conditions: []
        hasPassiveCheck: 0
        passiveCheck:
          CheckId: 
          Kind: 0
          Quality: 0
          CompetencyId: 
          Difficulty: 13
          ModifierRules: []
        onRevealEffects: []
      - blockId: chapter01.node.03_ostafiy
        kind: 0
        speakerIdOverride: ostafiy
        text: "\u041E\u0441\u0442\u0430\u0444\u0438\u0439 \u043E\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u0435\u0442\u0441\u044F
          \u0440\u044F\u0434\u043E\u043C \u0438 \u0441\u043B\u0443\u0448\u0430\u0435\u0442
          \u0434\u043E\u043B\u044C\u0448\u0435, \u0447\u0435\u043C \u043D\u0443\u0436\u043D\u043E
          \u0434\u043B\u044F \u043E\u0442\u0432\u0435\u0442\u0430. \xAB\u0422\u0430\u043A
          \u043E\u043D\u0430 \u0440\u0430\u043D\u044C\u0448\u0435 \u043D\u0435 \u0434\u0435\u043B\u0430\u043B\u0430.
          \u0414\u0430\u0436\u0435 \u0432 \u043F\u0430\u0432\u043E\u0434\u043E\u043A
          \u2014 \u043D\u0435 \u0442\u0430\u043A\xBB."
        conditions:
          Combinator: 0
          Conditions: []
        hasPassiveCheck: 0
        passiveCheck:
          CheckId: 
          Kind: 0
          Quality: 0
          CompetencyId: 
          Difficulty: 13
          ModifierRules: []
        onRevealEffects: []
      - blockId: chapter01.node.03_ulyana
        kind: 0
        speakerIdOverride: ulyana
        text: "\u0423\u043B\u044C\u044F\u043D\u0430 \u0438\u0434\u0451\u0442 \u043C\u0438\u043C\u043E
          \u0441 \u0432\u0435\u0434\u0440\u043E\u043C \u0438 \u043C\u043E\u0440\u0449\u0438\u0442\u0441\u044F.
          \xAB\u0421\u043E \u0432\u0447\u0435\u0440\u0430\u0448\u043D\u0435\u0433\u043E
          \u0432\u043E\u0434\u0430 \u0438\u0437 \u043A\u043E\u043B\u043E\u0434\u0446\u0430
          \u0433\u043E\u0440\u0447\u0438\u0442 \u2014 \u043D\u0435 \u043F\u043E\u043A\u0430\u0437\u0430\u043B\u043E\u0441\u044C.
          \u0418 \u0441\u043A\u043E\u0442\u0438\u043D\u0430 \u043D\u0435 \u0441\u0440\u0430\u0437\u0443
          \u043F\u044C\u0451\u0442\xBB."
