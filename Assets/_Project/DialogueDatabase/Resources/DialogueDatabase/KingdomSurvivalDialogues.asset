    - id: cave.crack.ruse_ok
      speakerId: narrator
      text: 
      textBlocks:
      - blockId: cave.crack.ruse_ok.text
        kind: 5
        speakerIdOverride: 
        text: "\u0412\u0441\u0451 \u0432\u044B\u0445\u043E\u0434\u0438\u0442, \u043A\u0430\u043A
          \u0437\u0430\u0434\u0443\u043C\u0430\u043D\u043E, \u0442\u043E\u043B\u044C\u043A\u043E
          \u0434\u043E\u043B\u044C\u0448\u0435. \u0412\u044B \u0433\u0440\u0435\u043C\u0438\u0442\u0435
          \u043A\u043E\u0442\u0435\u043B\u043A\u043E\u043C \u0443 \u043B\u0430\u0437\u0430
          \u0438 \u0442\u0430\u0449\u0438\u0442\u0435 \u043F\u043E \u0437\u0435\u043C\u043B\u0435
          \u0442\u0440\u0435\u0431\u0443\u0445\u0443 \u0438\u0437 \u0441\u0443\u043C\u043A\u0438;
          \u0437\u0432\u0435\u0440\u0438, \u043F\u043E\u0432\u043E\u0440\u0447\u0430\u0432,
          \u0443\u0445\u043E\u0434\u044F\u0442 \u0437\u0430 \u0437\u0430\u043F\u0430\u0445\u043E\u043C
          \u0432 \u043E\u043B\u044C\u0448\u0430\u043D\u0438\u043A. \u041D\u0430 \u0440\u0430\u0441\u0441\u0432\u0435\u0442\u0435
          \u0438\u0437 \u0443\u0441\u0442\u044C\u044F \u043F\u0430\u0434\u0430\u0435\u0442
          \u043A\u0430\u043C\u0435\u043D\u044C, \u0437\u0430 \u043D\u0438\u043C \u0434\u0440\u0443\u0433\u043E\u0439
          \u2014 \u0438 \u043D\u0430\u0440\u0443\u0436\u0443 \u0432\u044B\u0431\u0438\u0440\u0430\u0435\u0442\u0441\u044F
          \u0445\u0443\u0434\u043E\u0439 \u0447\u0435\u043B\u043E\u0432\u0435\u043A
          \u0441 \u043C\u0435\u0448\u043A\u043E\u043C \u043D\u0430 \u043F\u043B\u0435\u0447\u0435."
