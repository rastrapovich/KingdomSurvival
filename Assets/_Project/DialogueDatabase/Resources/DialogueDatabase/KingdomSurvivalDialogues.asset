    - id: inspect_failure
      speakerId: narrator
      text: 
      textBlocks:
      - blockId: b_failure
        kind: 1
        speakerIdOverride: 
        text: "\u0427\u0435\u043C \u0434\u043E\u043B\u044C\u0448\u0435 \u0441\u043C\u043E\u0442\u0440\u0438\u0448\u044C,
          \u0442\u0435\u043C \u043C\u0435\u043D\u044C\u0448\u0435 \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0441\u044F
          \u043F\u043E\u043D\u044F\u0442\u043D\u043E. \u0421\u043B\u0435\u0434\u043E\u0432
          \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u043C\u043D\u043E\u0433\u043E:
          \u043E\u0432\u0435\u0447\u044C\u0438 \u043A\u043E\u043F\u044B\u0442\u0430,
          \u0441\u043E\u0431\u0441\u0442\u0432\u0435\u043D\u043D\u0430\u044F \u043A\u0440\u043E\u0432\u044C,
          \u043F\u0440\u043E\u0434\u0430\u0432\u043B\u0435\u043D\u043D\u0430\u044F
          \u0442\u0440\u0430\u0432\u0430, \u0433\u0440\u044F\u0437\u044C \u0441 \u0434\u043E\u0440\u043E\u0433\u0438.\n\n\u041E\u0434\u043D\u043E
          \u044F\u0441\u043D\u043E \u2014 \u0435\u0441\u043B\u0438 \u0447\u0442\u043E-\u0442\u043E
          \u0438 \u043F\u0440\u043E\u0438\u0437\u043E\u0448\u043B\u043E \u0437\u0434\u0435\u0441\u044C,
          \u0434\u043E\u0436\u0434\u044C \u0438\u043B\u0438 \u043F\u0435\u0440\u0432\u044B\u0439
          \u043F\u0440\u043E\u0435\u0437\u0436\u0438\u0439 \u0443\u043D\u0438\u0447\u0442\u043E\u0436\u0430\u0442
