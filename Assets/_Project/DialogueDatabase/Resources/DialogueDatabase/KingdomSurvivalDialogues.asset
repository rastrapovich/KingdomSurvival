      - blockId: chapter01.node.07a.old_signal_main
        kind: 0
        speakerIdOverride: 
        text: "\u2014 \u0420\u0430\u043D\u044C\u0448\u0435 \u0441\u0435\u0434\u044C\u043C\u043E\u0439
          \u0440\u0443\u043A\u0430\u0432 \u0431\u0435\u0437 \u043D\u0443\u0436\u0434\u044B
