# ================================
# Изображения игры — только локально
# ================================
# Решение пользователя 01.10.2026: картинки и атласы хранятся только на
# компьютере разработчика и в его резервной копии, в git их нет.
# Их .meta остаются в git: в них GUID ассетов, нарезка атласов и точки
# опоры, поэтому ссылки из баз оживают, как только картинки на месте.

/[Aa]ssets/**/*.[Pp][Nn][Gg]
/[Aa]ssets/**/*.[Jj][Pp][Gg]
/[Aa]ssets/**/*.[Jj][Pp][Ee][Gg]
/[Aa]ssets/**/*.[Pp][Ss][Dd]
/[Aa]ssets/**/*.[Tt][Gg][Aa]
/[Aa]ssets/**/*.[Tt][Ii][Ff]
/[Aa]ssets/**/*.[Tt][Ii][Ff][Ff]
/[Aa]ssets/**/*.[Bb][Mm][Pp]
/[Aa]ssets/**/*.[Gg][Ii][Ff]
/[Aa]ssets/**/*.[Ww][Ee][Bb][Pp]
/[Aa]ssets/**/*.[Ee][Xx][Rr]
/[Aa]ssets/**/*.[Hh][Dd][Rr]

# Данные высоты земли из Blender (ПР-12О) — производные от PNG-экспорта,
# как и сами рисунки: только локально; их .meta остаются в git.
/[Aa]ssets/**/*_height__*.bytes

# Аддон Blender (Tools/Blender): кэш Python и вывод тестов
__pycache__/
/Tools/Blender/tests/_out/
