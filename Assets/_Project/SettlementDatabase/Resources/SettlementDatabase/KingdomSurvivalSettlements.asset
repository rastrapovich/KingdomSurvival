  errands:
  - Id: settlement.errand.carter_knife
    Title: "\u041D\u043E\u0436 \u0434\u0435\u0434\u0430"
    Summary: "\u0412\u043E\u0437\u0447\u0438\u043A \u0416\u0434\u0430\u043D \u0438\u0437
      \u0442\u043E\u0440\u0433\u043E\u0432\u043E\u0433\u043E \u0441\u0435\u043B\u0430
      \u043F\u0440\u043E\u0441\u0438\u0442 \u043D\u0430\u0439\u0442\u0438 \u0442\u0430\u0439\u043D\u0438\u043A
      \u0434\u0435\u0434\u0430 \u0443 \u0441\u0442\u0430\u0440\u043E\u0433\u043E
      \u0440\u0443\u0441\u043B\u0430 \u0438 \u043F\u0440\u0438\u043D\u0435\u0441\u0442\u0438
      \u043D\u043E\u0436 \u0441 \u043C\u0435\u0434\u043D\u043E\u0439 \u043D\u0430\u0441\u0435\u0447\u043A\u043E\u0439."
    GiverName: "\u0432\u043E\u0437\u0447\u0438\u043A \u0416\u0434\u0430\u043D"
    AcceptedFlag: freeplay.cache.errand.accepted
    CompletedFlag: freeplay.cache.errand.done
    FailedFlag: 
    AcceptedStepText: "\u0423\u0437\u043D\u0430\u0442\u044C \u0443 \u0416\u0434\u0430\u043D\u0430,
      \u0433\u0434\u0435 \u0438\u0432\u0430, \u043D\u0430\u0439\u0442\u0438 \u0442\u0430\u0439\u043D\u0438\u043A
      \u0443 \u0441\u0442\u0430\u0440\u043E\u0433\u043E \u0440\u0443\u0441\u043B\u0430
      \u0438 \u043F\u0440\u0438\u043D\u0435\u0441\u0442\u0438 \u043D\u043E\u0436."
    CompletedText: "\u0416\u0434\u0430\u043D \u043F\u043E\u043B\u0443\u0447\u0438\u043B
      \u0434\u0435\u0434\u043E\u0432 \u043D\u043E\u0436 \u0438 \u0437\u0430\u043F\u043B\u0430\u0442\u0438\u043B
      \u043E\u0442 \u0441\u0435\u0431\u044F."
    Stages:
    - Flag: freeplay.cache.stage.area
      Text: "\u0418\u0432\u0430 \u2014 \u0443 \u0441\u0442\u0430\u0440\u043E\u0433\u043E
        \u0440\u0443\u0441\u043B\u0430: \u043E\u0431\u043B\u0430\u0441\u0442\u044C
        \u043F\u043E\u0438\u0441\u043A\u0430 \u043E\u0442\u043C\u0435\u0447\u0435\u043D\u0430
        \u043D\u0430 \u043A\u0430\u0440\u0442\u0435. \u041D\u0430\u0439\u0442\u0438
        \u0440\u0430\u0441\u043A\u043E\u043B\u043E\u0442\u0443\u044E \u0438\u0432\u0443
        \u0441 \u0442\u0440\u0435\u043C\u044F \u0437\u0430\u0440\u0443\u0431\u043A\u0430\u043C\u0438."
    - Flag: freeplay.cache.found
      Text: "\u0422\u0430\u0439\u043D\u0438\u043A \u043D\u0430\u0439\u0434\u0435\u043D.
        \u041E\u0442\u043D\u0435\u0441\u0442\u0438 \u043D\u043E\u0436 \u0416\u0434\u0430\u043D\u0443
        \u0432 \u043A\u043E\u0440\u0447\u043C\u0443 \u0442\u043E\u0440\u0433\u043E\u0432\u043E\u0433\u043E
        \u0441\u0435\u043B\u0430."
    CompletionLimitHours: 0
    RewardText: "\u0441\u0435\u0440\u0435\u0431\u0440\u043E \u0438\u0437 \u0442\u0430\u0439\u043D\u0438\u043A\u0430
      \u0438 \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u043D\u043E\u0441\u0442\u044C
      \u0416\u0434\u0430\u043D\u0430"
  - Id: settlement.errand.town_message
    Title: "\u0412\u0435\u0441\u0442\u044C \u0441\u0442\u0430\u0440\u043E\u0441\u0442\u0435"
    Summary: "\u041C\u0438\u043B\u0430\u043D\u0430, \u0436\u0435\u043D\u0430 \u0441\u0442\u043E\u0440\u043E\u0436\u0430
      \u0433\u043E\u0440\u043E\u0434\u043A\u0430, \u043F\u0440\u043E\u0441\u0438\u0442
      \u043F\u0435\u0440\u0435\u0434\u0430\u0442\u044C \u0441\u0442\u0430\u0440\u043E\u0441\u0442\u0435
      \u0434\u0435\u0440\u0435\u0432\u043D\u0438 \u0443 \u0434\u043E\u0440\u043E\u0433\u0438
      \u0432\u0435\u0441\u0442\u044C \u043E \u0441\u044B\u043D\u0435."
    GiverName: "\u041C\u0438\u043B\u0430\u043D\u0430, \u0436\u0435\u043D\u0430 \u0441\u0442\u043E\u0440\u043E\u0436\u0430"
    AcceptedFlag: settlement.town.message.accepted
    CompletedFlag: settlement.town.message.done
    FailedFlag: settlement.town.message.failed
    AcceptedStepText: "\u0414\u043E\u0439\u0442\u0438 \u0434\u043E \u0434\u0435\u0440\u0435\u0432\u043D\u0438
      \u0443 \u0434\u043E\u0440\u043E\u0433\u0438 \u0438 \u043F\u0435\u0440\u0435\u0434\u0430\u0442\u044C
      \u0432\u0435\u0441\u0442\u044C \u0441\u0442\u0430\u0440\u043E\u0441\u0442\u0435
      \u0412\u044B\u0448\u0430\u0442\u0435."
    CompletedText: "\u041C\u0438\u043B\u0430\u043D\u0430 \u0437\u0430\u043F\u043B\u0430\u0442\u0438\u043B\u0430
      \u0437\u0430 \u0432\u0435\u0441\u0442\u044C, \u043A\u0430\u043A \u043E\u0431\u0435\u0449\u0430\u043B\u0430."
    Stages:
    - Flag: settlement.town.message.delivered
      Text: "\u0412\u0435\u0441\u0442\u044C \u043F\u0435\u0440\u0435\u0434\u0430\u043D\u0430.
        \u0412\u0435\u0440\u043D\u0443\u0442\u044C\u0441\u044F \u043A \u041C\u0438\u043B\u0430\u043D\u0435
        \u0432 \u043A\u043E\u0440\u0447\u043C\u0443 \u0433\u043E\u0440\u043E\u0434\u043A\u0430
        \u0437\u0430 \u043F\u043B\u0430\u0442\u043E\u0439."
    CompletionLimitHours: 168
    RewardText: "8 \u0437\u043E\u043B. \u043F\u043E \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0435\u043D\u0438\u0438"
