      - blockId: b_confess1
        kind: 4
        speakerIdOverride: traveller
        text: "\u2014 \u042F \u0434\u0443\u043C\u0430\u043B, \u043E\u043D\u0430 \u0431\u043E\u043B\u044C\u043D\u0430\u044F.
