    - id: chapter01.node.03_check
      speakerId: narrator
      text: 
      textBlocks:
      - blockId: chapter01.node.03_check_main
        kind: 5
        speakerIdOverride: 
        text: "\u0422\u044B \u043F\u043E\u0434\u0445\u043E\u0434\u0438\u0448\u044C
          \u043A \u0437\u0430\u0442\u0432\u043E\u0440\u0443. \u041D\u0430 \u0432\u0438\u0434
          \u0432\u0441\u0451 \u043A\u0430\u043A \u043E\u0431\u044B\u0447\u043D\u043E:
          \u043C\u043E\u043A\u0440\u043E\u0435 \u0434\u0435\u0440\u0435\u0432\u043E,
          \u0440\u043E\u0432\u043D\u044B\u0439 \u0433\u0443\u043B. \u0422\u043E\u043B\u044C\u043A\u043E
          \u0441\u043B\u043E\u0432\u0430 \u041E\u0441\u0442\u0430\u0444\u0438\u044F
          \u043D\u0435 \u0438\u0434\u0443\u0442 \u0438\u0437 \u0433\u043E\u043B\u043E\u0432\u044B:
          \xAB\u041C\u043E\u0436\u0435\u0442, \u0438 \u043D\u0438\u0447\u0435\u0433\u043E.
          \u0410 \u043C\u043E\u0436\u0435\u0442 \u2014 \u043D\u0435\u0442\xBB."
