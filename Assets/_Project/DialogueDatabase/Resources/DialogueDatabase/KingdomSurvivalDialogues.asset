      speakerId: miron
      text: 
      textBlocks:
      - blockId: chapter01.node.06_main
        kind: 0
        speakerIdOverride: 
        text: "\u0420\u0435\u043C\u043E\u043D\u0442 \u0437\u0430\u0432\u0435\u0440\u0448\u0451\u043D,
          \u0432\u043E\u0434\u0430 \u043A\u0430\u043A \u0431\u0443\u0434\u0442\u043E
          \u0442\u0435\u0447\u0451\u0442 \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E
          \u2014 \u043D\u043E \u041C\u0438\u0440\u043E\u043D \u0445\u043C\u0443\u0440\u0438\u0442\u0441\u044F:
          \u0447\u0442\u043E-\u0442\u043E \u0432 \u0435\u0451 \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u0438
          \u043F\u043E-\u043F\u0440\u0435\u0436\u043D\u0435\u043C\u0443 \u043D\u0435
          \u0442\u0430\u043A, \u043A\u0430\u043A \u0434\u043E\u043B\u0436\u043D\u043E
