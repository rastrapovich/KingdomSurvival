  qualities:
  - quality: 0
    displayName: "\u0421\u0438\u043B\u0430"
    description: "\u0424\u0438\u0437\u0438\u0447\u0435\u0441\u043A\u043E\u0435 \u0432\u043E\u0437\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435."
  - quality: 1
    displayName: "\u0421\u043D\u043E\u0440\u043E\u0432\u043A\u0430"
    description: "\u041A\u043E\u043E\u0440\u0434\u0438\u043D\u0430\u0446\u0438\u044F,
      \u0442\u043E\u0447\u043D\u043E\u0441\u0442\u044C \u0438 \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u044C."
  - quality: 2
    displayName: "\u0421\u0442\u043E\u0439\u043A\u043E\u0441\u0442\u044C"
    description: "\u0417\u0434\u043E\u0440\u043E\u0432\u044C\u0435 \u0438 \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043A\u0438\u0435
      \u043B\u0438\u0448\u0435\u043D\u0438\u044F."
  - quality: 3
    displayName: "\u0427\u0443\u0442\u044C\u0451"
    description: "\u041D\u0430\u0431\u043B\u044E\u0434\u0435\u043D\u0438\u0435, \u0441\u043B\u0435\u0434\u044B
      \u0438 \u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u044C."
  - quality: 4
    displayName: "\u0421\u0443\u0436\u0434\u0435\u043D\u0438\u0435"
    description: "\u0410\u043D\u0430\u043B\u0438\u0437, \u043F\u043B\u0430\u043D\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u0435
      \u0438 \u0438\u043D\u0442\u0435\u0440\u043F\u0440\u0435\u0442\u0430\u0446\u0438\u044F."
  - quality: 5
    displayName: "\u0425\u0430\u0440\u0430\u043A\u0442\u0435\u0440"
    description: "\u0421\u0438\u043B\u0430 \u043B\u0438\u0447\u043D\u043E\u0441\u0442\u0438,
      \u0432\u043B\u0438\u044F\u043D\u0438\u0435 \u0438 \u0441\u043E\u043F\u0440\u043E\u0442\u0438\u0432\u043B\u0435\u043D\u0438\u0435
      \u0434\u0430\u0432\u043B\u0435\u043D\u0438\u044E."
  traits:
  - id: knows_the_way
    displayName: "\u0417\u043D\u0430\u044E\u0449\u0438\u0439 \u0434\u043E\u0440\u043E\u0433\u0443"
    description: "\u041F\u0440\u0438 \u0443\u0441\u043F\u0435\u0448\u043D\u043E\u043C
      \u043E\u0431\u043D\u0430\u0440\u0443\u0436\u0435\u043D\u0438\u0438 \u0434\u043E\u0440\u043E\u0436\u043D\u044B\u0439
      Encounter \u043D\u0430\u0447\u0438\u043D\u0430\u0435\u0442\u0441\u044F \u0432
      \u043F\u043E\u0434\u0433\u043E\u0442\u043E\u0432\u043B\u0435\u043D\u043D\u043E\u043C
      \u0441\u043E\u0441\u0442\u043E\u044F\u043D\u0438\u0438: \u0433\u0435\u0440\u043E\u0439
      \u0437\u0430\u043C\u0435\u0447\u0430\u0435\u0442 \u0441\u043E\u0431\u044B\u0442\u0438\u0435
      \u0440\u0430\u043D\u044C\u0448\u0435, \u043C\u043E\u0436\u0435\u0442 \u043D\u0430\u0431\u043B\u044E\u0434\u0430\u0442\u044C,
      \u043E\u0431\u043E\u0439\u0442\u0438 \u0438\u043B\u0438 \u0437\u0430\u043D\u044F\u0442\u044C
      \u0432\u044B\u0433\u043E\u0434\u043D\u0443\u044E \u043F\u043E\u0437\u0438\u0446\u0438\u044E."
  - id: naturalist
    displayName: "\u041D\u0430\u0442\u0443\u0440\u0430\u043B\u0438\u0441\u0442"
    description: "\u041E\u0442\u043A\u0440\u044B\u0432\u0430\u0435\u0442 \u0430\u0432\u0442\u043E\u0440\u0441\u043A\u0438\u0435
      \u0431\u043B\u043E\u043A\u0438 \u0438 \u0432\u0430\u0440\u0438\u0430\u043D\u0442\u044B,
      \u0441\u0432\u044F\u0437\u0430\u043D\u043D\u044B\u0435 \u0441 \u0440\u0430\u0441\u0442\u0435\u043D\u0438\u044F\u043C\u0438,
      \u0436\u0438\u0432\u043E\u0442\u043D\u044B\u043C\u0438, \u043F\u043E\u0433\u043E\u0434\u043E\u0439,
      \u0431\u043E\u043B\u0435\u0437\u043D\u044F\u043C\u0438, \u0432\u043E\u0434\u043E\u0439
      \u0438 \u043F\u0440\u0438\u0440\u043E\u0434\u043D\u044B\u043C\u0438 \u0438\u0437\u043C\u0435\u043D\u0435\u043D\u0438\u044F\u043C\u0438."
  competencies:
  - id: fieldcraft
    displayName: "\u0421\u043B\u0435\u0434\u043E\u043F\u044B\u0442\u0441\u0442\u0432\u043E"
    description: "\u0427\u0438\u0442\u0430\u0442\u044C \u0441\u043B\u0435\u0434\u044B
      \u0438 \u0438\u0437\u043C\u0435\u043D\u0435\u043D\u0438\u044F \u043C\u0435\u0441\u0442\u043D\u043E\u0441\u0442\u0438."
