    - id: chapter01.node.09.synthesis
      speakerId: narrator
      text: 
      textBlocks:
      - blockId: chapter01.node.09.synthesis_main
        kind: 0
        speakerIdOverride: 
        text: "Здесь, возле Дома, больше нечего проверять. След продолжается вместе с водой — дальше привычных работ, знакомых троп и людей, которые ещё помнят хоть что-то наверняка."
        conditions:
          Combinator: 0
          Conditions: []
        hasPassiveCheck: 0
        passiveCheck:
          CheckId: 
          Kind: 0
          Quality: 0
          CompetencyId: 
          Difficulty: 13
          ModifierRules: []
        onRevealEffects: []
      choices:
      - text: "Проследить старый ход воды. Найти, куда продолжалась эта система."
        nextNodeId: chapter01.node.09.departure_decided
        endsDialogue: 0
        choiceId: chapter01.node.09.synthesis_choice
        kind: 0
        conditions:
          Combinator: 0
          Conditions: []
        unavailablePresentation: 0
