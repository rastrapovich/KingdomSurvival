          Description: "\u041E\u0442\u0434\u0435\u043B\u044C\u043D\u0430\u044F \u043A\u043B\u0435\u0442\u044C
            \u0441 \u0437\u0430\u0441\u043E\u0432\u043E\u043C \u0438 \u0441\u043E\u043B\u043E\u043C\u0435\u043D\u043D\u044B\u043C
            \u0442\u044E\u0444\u044F\u043A\u043E\u043C. \u0417\u0430 \u0447\u0430\u0441\u0442\u043E\u043A\u043E\u043B\u043E\u043C
            \u0441\u043F\u0438\u0442\u0441\u044F \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u0435\u0435."
      Board:
        Enabled: 1
        Name: "\u0422\u0430\u0431\u043B\u0438\u0447\u043A\u0438 \u0443 \u0432\u043E\u0440\u043E\u0442"
        Description: "\u041F\u043E\u0434 \u0432\u043E\u0440\u043E\u0442\u043D\u043E\u0439
          \u0431\u0430\u0448\u043D\u0435\u0439 \u2014 \u0434\u043E\u0441\u043A\u0430
          \u0441 \u0442\u0430\u0431\u043B\u0438\u0447\u043A\u0430\u043C\u0438. \u0423\u0433\u043B\u0451\u043C,
          \u043D\u043E\u0436\u043E\u043C, \u0430 \u043E\u0434\u043D\u0430 \u2014
          \u0433\u0432\u043E\u0437\u0434\u0451\u043C: \u0432\u0438\u0434\u043D\u043E,
          \u043F\u0438\u0441\u0430\u043B\u0438 \u0432 \u0441\u043F\u0435\u0448\u043A\u0435."
        ReaderNote: "\u0421\u0442\u043E\u0440\u043E\u0436 \u0447\u0438\u0442\u0430\u0435\u0442
          \u0432\u0441\u043B\u0443\u0445, \u043A\u0430\u0448\u043B\u044F\u044F \u043D\u0430
          \u0437\u043D\u0430\u043A\u0430\u0445 \u043F\u0440\u0435\u043F\u0438\u043D\u0430\u043D\u0438\u044F."
        Notices:
        - Id: notice.town.message
          Title: "\u0412\u0435\u0441\u0442\u044C \u0432 \u0434\u0435\u0440\u0435\u0432\u043D\u044E
            \u0443 \u0434\u043E\u0440\u043E\u0433\u0438"
          Text: "\u0423\u0433\u043B\u0451\u043C \u043D\u0430 \u0442\u0430\u0431\u043B\u0438\u0447\u043A\u0435:
            \xAB\u041D\u0443\u0436\u0435\u043D \u0447\u0435\u043B\u043E\u0432\u0435\u043A
            \u0434\u043E \u0434\u0435\u0440\u0435\u0432\u043D\u0438 \u0443 \u0434\u043E\u0440\u043E\u0433\u0438
            \u2014 \u0432\u0435\u0441\u0442\u044C \u0441\u0442\u0430\u0440\u043E\u0441\u0442\u0435.
            \u041F\u043B\u0430\u0442\u0430 \u043F\u043E \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0435\u043D\u0438\u0438.
            \u0421\u043F\u0440\u043E\u0441\u0438\u0442\u044C \u041C\u0438\u043B\u0430\u043D\u0443
            \u0432 \u043A\u043E\u0440\u0447\u043C\u0435\xBB. \u0421\u0442\u043E\u0440\u043E\u0436
            \u0434\u043E\u0431\u0430\u0432\u043B\u044F\u0435\u0442 \u043E\u0442 \u0441\u0435\u0431\u044F:
            \xAB\u0416\u0435\u043D\u0430 \u043C\u043E\u044F. \u041D\u0435 \u043E\u0431\u0438\u0436\u0430\u0439\u0442\u0435\xBB."
          Type: 1
          Medium: 1
          AuthorName: "\u0441\u0442\u043E\u0440\u043E\u0436 \u0443 \u0432\u043E\u0440\u043E\u0442"
          ContactName: "\u041C\u0438\u043B\u0430\u043D\u0430, \u0432 \u043A\u043E\u0440\u0447\u043C\u0435
            \u0443 \u0432\u043E\u0440\u043E\u0442"
          ContactPersonId: milana
          ErrandId: settlement.errand.town_message
