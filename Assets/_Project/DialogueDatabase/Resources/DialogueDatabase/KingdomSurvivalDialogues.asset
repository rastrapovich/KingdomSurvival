  - id: chapter01_dialogue_08_seven_teeth
    title: "N08 \u2014 \u0421\u0435\u043C\u044C \u0437\u0443\u0431\u0446\u043E\u0432"
    category: 1
    status: 1
    developerComment: "\u0427\u0435\u0440\u043D\u043E\u0432\u043E\u0439 \u0443\u0437\u0435\u043B
      P03 (\u0435\u0434\u0438\u043D\u0430\u044F \u0438\u043D\u0441\u0442\u0440\u0443\u043A\u0446\u0438\u044F
      \xA78/\xA79): \u043D\u0435 \u043F\u043E\u043B\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u0439
      \u0442\u0435\u043A\u0441\u0442, \u0442\u043E\u043B\u044C\u043A\u043E \u043A\u0430\u0440\u043A\u0430\u0441
      \u043F\u0435\u0440\u0435\u0445\u043E\u0434\u043E\u0432 \u0438 \u0444\u043B\u0430\u0433\u043E\u0432."
    startNodeId: chapter01.node.08
    tags:
    - "\u0433\u043B\u0430\u0432\u043001"
    - "\u0447\u0435\u0440\u043D\u043E\u0432\u0438\u043A"
    nodes:
    - id: chapter01.node.08
      speakerId: ostafiy
      text: 
      textBlocks:
      - blockId: chapter01.node.08_main
        kind: 0
        speakerIdOverride: 
        text: "\u0420\u0435\u0431\u0451\u043D\u043E\u043A \u0414\u043E\u043C\u0430
          \u0438\u0433\u0440\u0430\u0435\u0442 \u0441\u043E \u0441\u0442\u0430\u0440\u043E\u0439
          \u0441\u0435\u043C\u0438\u0437\u0443\u0431\u043E\u0439 \u0436\u0435\u043B\u0435\u0437\u043D\u043E\u0439
          \u043F\u043B\u0430\u0441\u0442\u0438\u043D\u043E\u0439, \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u044F
          \u0435\u0451 \u043A\u0430\u043A \u0433\u0440\u0435\u0431\u0435\u043D\u044C
          \u0434\u043B\u044F \u0441\u043E\u0431\u0430\u043A\u0438. \u041E\u0441\u0442\u0430\u0444\u0438\u0439
          \u0443\u0437\u043D\u0430\u0451\u0442 \u0432\u0435\u0449\u044C \u2014 \u0438
          \u0445\u043C\u0443\u0440\u0438\u0442\u0441\u044F: \u044D\u0442\u043E \u043D\u0435
          \u0438\u0433\u0440\u0443\u0448\u043A\u0430."
