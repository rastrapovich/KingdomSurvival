/* ================================================================
   ДОБЫЧА ОТРЯДА И ИССЛЕДОВАНИЕ ЛОКАЦИИ
   ================================================================ */

.army-gold-value {
    margin-bottom: 8px;
    color: rgb(235, 194, 104);
    font-size: 15px;
    -unity-font-style: bold;
}

.supply-subtitle {
    margin-bottom: 5px;
    color: rgb(193, 183, 158);
    font-size: 11px;
    -unity-font-style: bold;
}

.research-expedition-button {
    display: none;
    height: 38px;
    margin-bottom: 7px;
    background-color: rgb(56, 79, 64);
    color: rgb(228, 235, 220);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(103, 140, 109);
    border-right-color: rgb(103, 140, 109);
    border-top-color: rgb(103, 140, 109);
    border-bottom-color: rgb(103, 140, 109);
    border-radius: 4px;
    -unity-font-style: bold;
}

.research-expedition-button:hover {
    background-color: rgb(69, 96, 77);
}

.research-expedition-button:disabled {
    opacity: 0.55;
}

/* ================================================================
   НАДЁЖНЫЙ SPLIT-VIEW АРМИИ / ЭКСПЕДИЦИЙ
   ================================================================ */

.military-split-screen {
    width: 100%;
    height: 100%;
    min-height: 0;
    flex-direction: row;
    align-items: stretch;
}

.military-column-scroll {
    width: 50%;
    min-width: 0;
    height: 100%;
    flex-grow: 0;
    flex-shrink: 1;
}

.military-column-divider {
    width: 8px;
    min-width: 8px;
    max-width: 8px;
    height: 100%;
    margin-left: 5px;
    margin-right: 5px;
    background-color: rgb(20, 23, 29);
}

.military-panel-fill {
    min-height: 100%;
    margin-bottom: 0;
}

.commander-supply-row {
    width: 100%;
    flex-direction: row;
    align-items: flex-start;
    justify-content: space-between;
}

.commander-profile-column {
    width: 52%;
    min-width: 0;
    margin-right: 10px;
}

.commander-section-title {
    margin-top: 0;
}

.commander-image-placeholder {
    width: 170px;
    max-width: 100%;
    height: 190px;
    margin-bottom: 9px;
    align-items: center;
    justify-content: center;
    background-color: rgb(40, 45, 54);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(92, 80, 58);
    border-right-color: rgb(92, 80, 58);
    border-top-color: rgb(92, 80, 58);
    border-bottom-color: rgb(92, 80, 58);
    border-radius: 5px;
}

.commander-image-placeholder-text {
    max-width: 145px;
    color: rgb(119, 124, 133);
    font-size: 10px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: normal;
}

.commander-profile-column .commander-dropdown {
    width: 100%;
}

.commander-profile-column .commander-dropdown > .unity-base-field__label {
    min-width: 72px;
}

.military-supply-block {
    width: 44%;
    min-width: 190px;
    margin-top: 0;
}

.military-supply-block .supply-controls {
    width: 100%;
}

.military-supply-block .supply-value {
    min-width: 54px;
    margin-left: 4px;
    margin-right: 4px;
}

.fighters-scroll {
    width: 100%;
    height: 196px;
    max-height: 196px;
}

.fighters-list-horizontal {
    flex-direction: row;
    flex-wrap: nowrap;
    align-items: flex-start;
}

.fighters-list-horizontal .fighter-card {
    width: 112px;
    min-width: 112px;
    max-width: 112px;
    min-height: 166px;
    margin-right: 7px;
    margin-bottom: 4px;
    padding-left: 6px;
    padding-right: 6px;
    padding-top: 6px;
    padding-bottom: 6px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(92, 80, 58);
    border-right-color: rgb(72, 76, 85);
    border-top-color: rgb(72, 76, 85);
    border-bottom-color: rgb(72, 76, 85);
    border-radius: 4px;
    align-items: flex-start;
    -unity-text-align: upper-left;
}

.fighter-image-placeholder {
    width: 90px;
    height: 88px;
    margin-bottom: 6px;
    align-items: center;
    justify-content: center;
    background-color: rgb(35, 40, 48);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(74, 80, 91);
    border-right-color: rgb(74, 80, 91);
    border-top-color: rgb(74, 80, 91);
    border-bottom-color: rgb(74, 80, 91);
    border-radius: 3px;
}

.fighter-image-placeholder-text {
    color: rgb(105, 111, 121);
    font-size: 8px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.fighters-list-horizontal .fighter-role {
    font-size: 12px;
    white-space: normal;
}

.fighters-list-horizontal .fighter-info {
    font-size: 9px;
    white-space: normal;
}

.fighter-name {
    margin-bottom: 2px;
    color: rgb(237, 232, 217);
    font-size: 12px;
    -unity-font-style: bold;
    white-space: normal;
}

.fighter-assignment {
    margin-top: 5px;
    color: rgb(147, 186, 151);
    font-size: 8px;
    -unity-font-style: bold;
    white-space: normal;
}

.fighter-card-selected {
    background-color: rgb(67, 57, 39);
    border-left-color: rgb(224, 187, 102);
    border-right-color: rgb(165, 132, 73);
    border-top-color: rgb(165, 132, 73);
    border-bottom-color: rgb(165, 132, 73);
}

.fighter-card-selected .fighter-assignment {
    color: rgb(235, 194, 104);
}

.fighter-card-garrison {
    background-color: rgb(39, 51, 47);
    border-left-color: rgb(92, 138, 102);
}

.fighter-card:disabled {
    opacity: 1;
}

/* ================================================================
   ВЫБОР БОЙЦОВ И ПРЕДПРОСМОТР ГАРНИЗОНА
   ================================================================ */

.fighter-selection-hint {
    margin-top: 7px;
    margin-bottom: 7px;
    color: rgb(204, 193, 168);
    font-size: 11px;
    white-space: normal;
}

.army-split-preview-row {
    width: 100%;
    flex-direction: row;
    align-items: stretch;
    margin-bottom: 5px;
}

.army-split-preview {
    width: 49%;
    min-width: 0;
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 8px;
    padding-bottom: 8px;
    background-color: rgb(37, 42, 50);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-radius: 4px;
}

.expedition-preview {
    margin-right: 2%;
    border-left-color: rgb(137, 109, 60);
    border-right-color: rgb(89, 77, 57);
    border-top-color: rgb(89, 77, 57);
    border-bottom-color: rgb(89, 77, 57);
}

.garrison-preview {
    border-left-color: rgb(73, 112, 82);
    border-right-color: rgb(61, 82, 68);
    border-top-color: rgb(61, 82, 68);
    border-bottom-color: rgb(61, 82, 68);
}

.garrison-preview-empty {
    background-color: rgb(67, 42, 42);
    border-left-color: rgb(184, 91, 82);
    border-right-color: rgb(132, 68, 63);
    border-top-color: rgb(132, 68, 63);
    border-bottom-color: rgb(132, 68, 63);
}

.army-split-preview-title {
    margin-bottom: 5px;
    color: rgb(224, 187, 102);
    font-size: 10px;
    -unity-font-style: bold;
    white-space: normal;
}

.garrison-preview .army-split-preview-title {
    color: rgb(142, 190, 151);
}

.garrison-preview-empty .army-split-preview-title {
    color: rgb(222, 116, 106);
}

.army-split-preview-value {
    color: rgb(235, 230, 215);
    font-size: 12px;
    -unity-font-style: bold;
    white-space: normal;
}

.army-split-preview-note,
.army-split-preview-names {
    margin-top: 3px;
    color: rgb(164, 166, 165);
    font-size: 9px;
    white-space: normal;
}

.military-expedition-column .location-info-row {
    flex-wrap: wrap;
}

.military-expedition-column .active-expedition-details,
.military-expedition-column .location-name,
.military-expedition-column .location-info,
.military-expedition-column .status-label {
    white-space: normal;
}

/* ================================================================
   ИЗОБРАЖЕНИЯ НА КАРТОЧКАХ ЛОКАЦИЙ
   ================================================================ */

.location-image-placeholder {
    width: 100%;
    height: 112px;
    margin-bottom: 9px;
    align-items: center;
    justify-content: center;
    background-color: rgb(35, 40, 48);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(74, 80, 91);
    border-right-color: rgb(74, 80, 91);
    border-top-color: rgb(74, 80, 91);
    border-bottom-color: rgb(74, 80, 91);
    border-radius: 4px;
}

.location-image-placeholder-text {
    color: rgb(105, 111, 121);
    font-size: 9px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

/* ================================================================
   ВСПЛЫВАЮЩИЙ РАСХОД ГОРОДСКОЙ ПИЩИ
   ================================================================ */

.food-expense-popup {
    top: 100%;
    margin-top: 2px;
}
