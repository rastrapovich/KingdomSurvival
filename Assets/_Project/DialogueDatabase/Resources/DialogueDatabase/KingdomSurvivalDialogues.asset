      choices:
      - text: "\u041F\u043E\u0434\u043D\u044F\u0442\u044C\u0441\u044F \u0438 \u0440\u0435\u0448\u0438\u0442\u044C,
          \u0447\u0442\u043E \u0434\u0435\u043B\u0430\u0442\u044C \u0442\u0435\u043F\u0435\u0440\u044C."
