  - EncounterId: ROAD_WARM_SHEEP_01
    DisplayName: "\u0422\u0451\u043F\u043B\u0430\u044F \u043E\u0432\u0446\u0430"
    Description: "\u041E\u0432\u0446\u0430 \u043B\u0435\u0436\u0438\u0442 \u043F\u043E\u0447\u0442\u0438
      \u043F\u043E\u0441\u0440\u0435\u0434\u0438 \u0434\u043E\u0440\u043E\u0433\u0438,
      \u0435\u0449\u0451 \u0442\u0451\u043F\u043B\u0430\u044F. \u0413\u043E\u0440\u043B\u043E
      \u0446\u0435\u043B\u043E, \u0437\u0430\u0434\u043D\u044F\u044F \u043D\u043E\u0433\u0430
      \u043E\u0431\u043E\u0434\u0440\u0430\u043D\u0430 \u0434\u043E \u043A\u043E\u0441\u0442\u0438."
