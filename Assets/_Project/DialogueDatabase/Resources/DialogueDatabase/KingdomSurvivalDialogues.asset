  - id: freeplay_carter_tells
    title: "12\u0422 \u2014 \u0420\u0430\u0441\u0441\u043A\u0430\u0437 \u0432\u043E\u0437\u0447\u0438\u043A\u0430
      \u043E\u0431 \u0438\u0432\u0435"
    category: 2
    status: 1
    developerComment: "12\u0422 [\u0420\u0410\u0411\u041E\u0427\u0415\u0415]. \u0421\u0446\u0435\u043D\u0430
      \u043F\u043E\u0441\u043B\u0435 \u043E\u043F\u043B\u0430\u0442\u044B \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0435\u043D\u0438\u044F
      \u043A\u043E\u0440\u0447\u043C\u044B \xAB\u0413\u0434\u0435 \u0434\u0435\u0434
      \u043F\u0440\u044F\u0442\u0430\u043B\xBB. \u0417\u043D\u0430\u043D\u0438\u0435
      \u0432\u044B\u0434\u0430\u0451\u0442 \u0441\u0430\u043C\u0430 \u043A\u043E\u043C\u0430\u043D\u0434\u0430
      \u043E\u043F\u043B\u0430\u0442\u044B; \u044D\u0444\u0444\u0435\u043A\u0442
      \u0437\u0434\u0435\u0441\u044C \u2014 \u0438\u0441\u0442\u043E\u0447\u043D\u0438\u043A
      \u0442\u0435\u043A\u0441\u0442\u0430 \u0434\u043B\u044F \u0436\u0443\u0440\u043D\u0430\u043B\u0430
      (\u043F\u043E\u0432\u0442\u043E\u0440 \u043D\u0438\u0447\u0435\u0433\u043E
      \u043D\u0435 \u0434\u0430\u0451\u0442)."
    sceneIllustration: {fileID: 0}
    sceneIllustrationFillFrame: 0
    sceneIllustrationScale: 1
    sceneIllustrationOffsetNormalized: {x: 0, y: 0}
    startNodeId: freeplay.carter.tells.start
    tags:
    - "\u043F\u043E\u0441\u0435\u043B\u0435\u043D\u0438\u044F"
