      choices:
      - text: "\u041F\u0435\u0440\u0435\u0432\u0435\u0441\u0442\u0438 \u0434\u044B\u0445\u0430\u043D\u0438\u0435."
        nextNodeId:
        endsDialogue: 1
        choiceId: chapter01.node.04.failure_mill_exit
        kind: 3
        conditions:
          Combinator: 0
          Conditions: []
        unavailablePresentation: 0
        check:
          CheckId:
          Kind: 0
          Quality: 0
          CompetencyId:
