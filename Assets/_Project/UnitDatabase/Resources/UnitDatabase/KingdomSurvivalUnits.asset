  - id: combat.pack
    displayLabel: "\u0421\u0442\u0430\u044F"
    category: "\u041F\u043E\u0432\u0435\u0434\u0435\u043D\u0438\u0435"
    color: {r: 0.55, g: 0.47, b: 0.33, a: 1}
    description: "\u041F\u0440\u0430\u0432\u0438\u043B\u043E, \u043D\u0435 \u043A\u043D\u043E\u043F\u043A\u0430:
      +1 \u0410\u0442\u0430\u043A\u0430 \u043F\u0440\u0438 \u043A\u043E\u043D\u0442\u0430\u043A\u0442\u043D\u043E\u0439
      \u0430\u0442\u0430\u043A\u0435, \u0435\u0441\u043B\u0438 \u0440\u044F\u0434\u043E\u043C
      \u0441 \u0442\u043E\u0439 \u0436\u0435 \u0446\u0435\u043B\u044C\u044E \u0441\u0442\u043E\u0438\u0442
      \u0434\u0440\u0443\u0433\u043E\u0439 \u0436\u0438\u0432\u043E\u0439 \u043D\u043E\u0441\u0438\u0442\u0435\u043B\u044C
      \xAB\u0421\u0442\u0430\u0438\xBB. \u041D\u0435 \u0441\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0435\u0442\u0441\u044F
      \u043E\u0442 \u0447\u0438\u0441\u043B\u0430 \u0437\u0432\u0435\u0440\u0435\u0439;
      \u0434\u0430\u043B\u044C\u043D\u0438\u0439 \u0432\u044B\u0441\u0442\u0440\u0435\u043B
      \u0431\u043E\u043D\u0443\u0441\u0430 \u043D\u0435 \u043F\u043E\u043B\u0443\u0447\u0430\u0435\u0442.
      \u0427\u0438\u0441\u043B\u043E \u2014 \u0440\u0430\u0431\u043E\u0447\u0430\u044F
      \u043D\u0430\u0441\u0442\u0440\u043E\u0439\u043A\u0430."
