/*
    ================================================================
    ОБЩИЙ ЭКРАН
    ================================================================
*/

.screen {
    flex-grow: 1;

    padding-left: 16px;
    padding-right: 16px;
    padding-top: 16px;
    padding-bottom: 16px;

    background-color: rgb(20, 23, 29);
    color: rgb(225, 218, 200);
}


/*
    ================================================================
    ВЕРХНЯЯ ПАНЕЛЬ
    ================================================================
*/

.top-bar {
    min-height: 76px;

    flex-direction: row;
    align-items: center;

    padding-left: 14px;
    padding-right: 14px;
    padding-top: 10px;
    padding-bottom: 10px;

    background-color: rgb(35, 39, 47);

    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;

    border-left-color: rgb(92, 80, 58);
    border-right-color: rgb(92, 80, 58);
    border-top-color: rgb(92, 80, 58);
    border-bottom-color: rgb(92, 80, 58);

    border-radius: 6px;
}

.game-title {
    min-width: 210px;
    margin-right: 16px;

    color: rgb(224, 187, 102);
    font-size: 21px;

    -unity-font-style: bold;
}

.resource-strip {
    flex-grow: 1;
    flex-direction: row;
    flex-wrap: wrap;
}

.resource-box {
    min-width: 112px;

    margin-right: 8px;
    margin-bottom: 4px;

    padding-left: 9px;
    padding-right: 9px;
    padding-top: 7px;
    padding-bottom: 7px;

    background-color: rgb(47, 51, 60);
    border-radius: 4px;
}

.food-box {
    min-width: 135px;
}

.resource-value {
    color: rgb(237, 232, 217);
    font-size: 14px;
    -unity-font-style: bold;
}

.resource-note {
    margin-top: 2px;
    color: rgb(182, 171, 143);
    font-size: 11px;
}

.end-day-button {
    min-width: 150px;
    height: 45px;

    margin-left: 12px;

    background-color: rgb(116, 75, 42);
    color: rgb(255, 240, 204);

    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;

    border-left-color: rgb(199, 154, 82);
    border-right-color: rgb(199, 154, 82);
    border-top-color: rgb(199, 154, 82);
    border-bottom-color: rgb(199, 154, 82);

    border-radius: 5px;

    font-size: 15px;
    -unity-font-style: bold;
}

.end-day-button:hover {
    background-color: rgb(145, 94, 51);
}


/*
    ================================================================
    ОСНОВНАЯ ОБЛАСТЬ
    ================================================================
*/

.main-scroll {
    flex-grow: 1;
    margin-top: 12px;
}

.main-grid {
    flex-direction: row;
    align-items: flex-start;
}

.left-column {
    flex-grow: 1;
    flex-basis: 52%;

    min-width: 470px;
    margin-right: 12px;
}

.right-column {
    flex-grow: 1;
    flex-basis: 48%;

    min-width: 410px;
}

.panel {
    margin-bottom: 12px;

    padding-left: 14px;
    padding-right: 14px;
    padding-top: 13px;
    padding-bottom: 14px;

    background-color: rgb(31, 35, 43);

    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;

    border-left-color: rgb(69, 74, 84);
    border-right-color: rgb(69, 74, 84);
    border-top-color: rgb(69, 74, 84);
    border-bottom-color: rgb(69, 74, 84);

    border-radius: 6px;
}

.panel-title {
    margin-bottom: 5px;

    color: rgb(224, 187, 102);
    font-size: 19px;

    -unity-font-style: bold;
}

.panel-description {
    margin-bottom: 10px;

    color: rgb(158, 163, 171);
    font-size: 12px;

    white-space: normal;
}

.section-title {
    margin-top: 7px;
    margin-bottom: 7px;

    color: rgb(193, 183, 158);
    font-size: 13px;

    -unity-font-style: bold;
}

.section-divider {
    height: 1px;

    margin-top: 12px;
    margin-bottom: 8px;

    background-color: rgb(72, 76, 85);
}


/*
    ================================================================
    ЗДАНИЯ СТОЛИЦЫ
    ================================================================
*/

.building-grid {
    flex-direction: row;
    flex-wrap: wrap;
}

.building-card {
    width: 48%;
    min-height: 43px;

    margin-right: 2%;
    margin-bottom: 8px;

    background-color: rgb(50, 55, 65);
    color: rgb(222, 216, 199);

    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;

    border-left-color: rgb(82, 87, 97);
    border-right-color: rgb(82, 87, 97);
    border-top-color: rgb(82, 87, 97);
    border-bottom-color: rgb(82, 87, 97);

    border-radius: 4px;
}

.building-card:hover {
    background-color: rgb(63, 69, 80);
}


/*
    ================================================================
    КОМАНДИР И АРМИЯ
    ================================================================
*/

.commander-dropdown {
    margin-bottom: 8px;
}

.commander-dropdown > .unity-base-field__label {
    min-width: 90px;

    color: rgb(205, 196, 174);
    -unity-font-style: bold;
}

.commander-dropdown .unity-base-field__input {
    min-height: 34px;

    background-color: rgb(46, 51, 60);
    color: rgb(238, 230, 210);

    border-radius: 4px;
}

.commander-detail {
    margin-bottom: 7px;

    color: rgb(208, 202, 187);
    font-size: 13px;

    white-space: normal;
}

.status-label {
    margin-top: 3px;
    margin-bottom: 8px;

    padding-left: 8px;
    padding-right: 8px;
    padding-top: 6px;
    padding-bottom: 6px;

    background-color: rgb(42, 47, 56);
    color: rgb(183, 194, 203);

    border-radius: 3px;

    white-space: normal;
}

.fighter-card {
    min-height: 50px;

    margin-bottom: 6px;

    padding-left: 10px;
    padding-right: 10px;
    padding-top: 7px;
    padding-bottom: 7px;

    background-color: rgb(43, 47, 56);

    border-left-width: 3px;
    border-left-color: rgb(146, 112, 62);

    border-radius: 3px;
}

.fighter-name {
    color: rgb(232, 222, 197);
    font-size: 14px;

    -unity-font-style: bold;
}

.fighter-info {
    margin-top: 2px;

    color: rgb(156, 163, 173);
    font-size: 12px;
}


/*
    ================================================================
    КАРТОЧКИ НАЙДЕННЫХ ЛОКАЦИЙ
    ================================================================
*/

.location-card {
    margin-bottom: 9px;

    padding-left: 11px;
    padding-right: 11px;
    padding-top: 10px;
    padding-bottom: 10px;

    background-color: rgb(42, 46, 55);

    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;

    border-left-color: rgb(72, 78, 89);
    border-right-color: rgb(72, 78, 89);
    border-top-color: rgb(72, 78, 89);
    border-bottom-color: rgb(72, 78, 89);

    border-radius: 5px;
}

.location-name {
    margin-bottom: 7px;

    color: rgb(230, 219, 192);
    font-size: 16px;

    -unity-font-style: bold;
}

.location-info-row {
    flex-direction: row;
    justify-content: space-between;

    margin-bottom: 9px;
}

.location-info {
    color: #AEA289;
    font-size: 13px;
}