    - id: chapter01.node.11c.branch
      speakerId: narrator
      text: 
      textBlocks:
      - blockId: chapter01.node.11c.branch_saved_both
        kind: 0
        speakerIdOverride: 
        text: "\u0412 \u0441\u043A\u043B\u0430\u0434\u043A\u0435 \u0440\u0443\u043A\u0430\u0432\u0430
          \u043D\u0430\u0445\u043E\u0434\u044F\u0442\u0441\u044F \u0442\u0440\u0438
          \u0437\u0435\u0440\u043D\u0430. \u041D\u0430\u0432\u0435\u0440\u043D\u043E\u0435,
          \u043F\u043E\u043F\u0430\u043B\u0438 \u0442\u0443\u0434\u0430, \u043A\u043E\u0433\u0434\u0430
          \u0440\u0430\u0437\u0433\u0440\u0443\u0436\u0430\u043B\u0438 \u0442\u0435\u043B\u0435\u0433\u0443.\n\n\u041D\u0430
          \u0434\u043E\u0440\u043E\u0433\u0435 \u0445\u0432\u0430\u0442\u0438\u043B\u043E
          \u0440\u0443\u043A \u0438 \u043D\u0430 \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430,
          \u0438 \u043D\u0430 \u043C\u0435\u0448\u043A\u0438. \u041D\u0435 \u0431\u0435\u0441\u043F\u043B\u0430\u0442\u043D\u043E.
          \u041D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0447\u0430\u0441\u043E\u0432
          \u043F\u0443\u0442\u0438 \u043E\u0441\u0442\u0430\u043B\u0438\u0441\u044C
          \u0442\u0430\u043C.\n\n\u0423 \u043A\u043E\u0441\u0442\u0440\u0430 \u044D\u0442\u043E
          \u0432\u043F\u0435\u0440\u0432\u044B\u0435 \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0441\u044F
          \u0437\u0430\u043C\u0435\u0442\u043D\u043E: \u0414\u043E\u043C \u0441\u0435\u0433\u043E\u0434\u043D\u044F
          \u0434\u0430\u043B\u044C\u0448\u0435, \u0447\u0435\u043C \u043C\u043E\u0433
          \u0431\u044B \u0431\u044B\u0442\u044C.\n\n\u0417\u0430\u0442\u043E \u043D\u0430
          \u0434\u043E\u0440\u043E\u0433\u0435 \u043F\u043E\u0437\u0430\u0434\u0438
          \u043E\u0441\u0442\u0430\u043B\u0438\u0441\u044C \u0438 \u0447\u0435\u043B\u043E\u0432\u0435\u043A,
          \u0438 \u0435\u0433\u043E \u0432\u0435\u0441\u043D\u0430."
