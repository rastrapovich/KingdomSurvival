  - id: species.beast
    displayLabel: "\u0417\u0432\u0435\u0440\u044C"
    category: "\u041F\u0440\u043E\u0438\u0441\u0445\u043E\u0436\u0434\u0435\u043D\u0438\u0435"
    color: {r: 0.62, g: 0.27, b: 0.2, a: 1}
    description: "\u0417\u0432\u0435\u0440\u044C; \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0435\u0442\u0441\u044F
      \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u044F\u043C\u0438
      \u0438 \u0431\u043E\u043D\u0443\u0441\u043E\u043C \u043A\u043E\u043F\u0435\u0439\u0449\u0438\u043A\u0430."
  - id: combat.melee
    displayLabel: "\u0411\u043B\u0438\u0436\u043D\u0438\u0439 \u0431\u043E\u0439"
