      - text: "\u0421\u0445\u043E\u0434\u0438\u0442\u044C \u0438 \u0432\u0437\u0433\u043B\u044F\u043D\u0443\u0442\u044C
          \u043D\u0430 \u0437\u0430\u0442\u0432\u043E\u0440 \u0441\u0430\u043C\u043E\u043C\u0443."
