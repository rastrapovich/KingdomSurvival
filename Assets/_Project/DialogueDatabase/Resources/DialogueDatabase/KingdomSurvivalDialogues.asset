    - id: chapter01.node.13.tension
      speakerId: downstream_voice
      text:
      textBlocks:
      - blockId: chapter01.node.13.tension_main
        kind: 0
        speakerIdOverride:
        text: "\u2014 \u0414\u043E\u043B\u0433\u043E \u0436\u0435 \u0432\u044B \u0448\u043B\u0438, \u2014 \u0433\u043E\u0432\u043E\u0440\u0438\u0442 \u043E\u043D, \u043D\u0435 \u043A\u0430\u043A \u0432\u043E\u043F\u0440\u043E\u0441. \u2014 \u0423 \u043D\u0430\u0441
          \u043D\u0435 \u043F\u0435\u0440\u0432\u044B\u0439 \u0433\u043E\u0434 \u0433\u043E\u0432\u043E\u0440\u044F\u0442, \u0447\u0442\u043E \u0441\u0432\u0435\u0440\u0445\u0443 \u0440\u0430\u043D\u043E \u0438\u043B\u0438 \u043F\u043E\u0437\u0434\u043D\u043E \u0432\u0441\u043F\u043E\u043C\u043D\u044F\u0442
          \u043F\u0440\u043E \u043D\u0438\u0436\u043D\u0438\u0439 \u043A\u0430\u043D\u0430\u043B. \u0412\u043E\u0442 \u0438 \u0432\u0441\u043F\u043E\u043C\u043D\u0438\u043B\u0438, \u0433\u043B\u044F\u0436\u0443."
        conditions:
          Combinator: 0
          Conditions: []
        hasPassiveCheck: 0
        passiveCheck:
          CheckId:
          Kind: 0
          Quality: 0
          CompetencyId:
          Difficulty: 13
          ModifierRules: []
        onRevealEffects: []
      choices:
      - text: "[\u041F\u0420\u041E\u0412\u0415\u0420\u041A\u0410 \u0425\u0410\u0420\u0410\u041A\u0422\u0415\u0420\u0410] \u041F\u043E\u043A\u0430\u0437\u0430\u0442\u044C, \u0447\u0442\u043E \u043E\u0442\u0440\u044F\u0434 \u043F\u0440\u0438\u0448\u0451\u043B \u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C,
