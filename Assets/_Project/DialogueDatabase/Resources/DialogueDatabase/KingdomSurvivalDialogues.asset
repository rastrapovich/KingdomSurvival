    - id: chapter01.node.04.success_livestock
      speakerId: narrator
      text:
      textBlocks:
      - blockId: chapter01.node.04.success_livestock_main
        kind: 0
        speakerIdOverride:
        text: "\u0422\u044B \u0433\u043E\u043D\u0438\u0448\u044C \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0445 \u043A\u043E\u0440\u043E\u0432 \u043F\u0440\u043E\u0447\u044C \u043E\u0442 \u0432\u043E\u0434\u044B, \u0438 \u043E\u043D\u0438, \u0442\u044F\u0436\u0435\u043B\u043E \u0434\u044B\u0448\u0430, \u0441\u0431\u0438\u0432\u0430\u044E\u0442\u0441\u044F \u0432 \u043A\u0443\u0447\u0443 \u043D\u0430 \u043F\u0440\u0438\u0433\u043E\u0440\u043A\u0435 \u2014 \u0432\u0441\u0435 \u0446\u0435\u043B\u044B. \u0420\u0430\u0431\u043E\u0442\u043D\u0438\u043A\u0438 \u0443\u0441\u043F\u0435\u0432\u0430\u044E\u0442 \u0443\u0439\u0442\u0438 \u0441\u0430\u043C\u0438, \u043F\u043E\u043A\u0430 \u0442\u044B \u0437\u0430\u043D\u044F\u0442 \u0441\u043A\u043E\u0442\u043E\u043C. \u0417\u0430 \u0441\u043F\u0438\u043D\u043E\u0439 \u0440\u0430\u0437\u0434\u0430\u0451\u0442\u0441\u044F \u0442\u0440\u0435\u0441\u043A: \u043D\u0430\u0441\u0442\u0438\u043B \u0443 \u043C\u0435\u043B\u044C\u043D\u0438\u0446\u044B \u043D\u0435 \u0432\u044B\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0435\u0442 \u0438 \u043F\u0440\u043E\u0441\u0435\u0434\u0430\u0435\u0442 \u0432 \u043F\u043E\u0442\u043E\u043A. \u041C\u0438\u0440\u043E\u043D \u043C\u043E\u043B\u0447\u0430 \u0441\u043C\u043E\u0442\u0440\u0438\u0442 \u043D\u0430 \u0442\u043E, \u0447\u0442\u043E \u043E\u0441\u0442\u0430\u043B\u043E\u0441\u044C \u043E\u0442 \u0435\u0433\u043E \u043A\u043E\u043B\u0435\u0441\u0430."
