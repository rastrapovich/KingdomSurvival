    - id: chapter01.node.01_ostafiy
      speakerId: ostafiy
      text: 
      textBlocks:
      - blockId: chapter01.node.01_ostafiy_main
        kind: 0
        speakerIdOverride: 
        text: "\u041E\u0441\u0442\u0430\u0444\u0438\u0439 \u0441\u0438\u0434\u0438\u0442
          \u043D\u0430 \u043A\u043E\u0440\u0442\u043E\u0447\u043A\u0430\u0445 \u0443
          \u0441\u0442\u0430\u0440\u043E\u0433\u043E \u0437\u0430\u0441\u043E\u0432\u0430
          \u0438 \u043A\u0430\u0447\u0430\u0435\u0442 \u0435\u0433\u043E \u043B\u0430\u0434\u043E\u043D\u044C\u044E
          \u2014 \u043D\u0435 \u0447\u0438\u043D\u0438\u0442, \u043F\u0440\u043E\u0441\u0442\u043E
          \u043F\u0440\u043E\u0432\u0435\u0440\u044F\u0435\u0442, \u043D\u0430 \u043C\u0435\u0441\u0442\u0435
          \u043B\u0438. \u041E\u043D \u0441\u043C\u043E\u0442\u0440\u0438\u0442 \u043D\u0430
          \u0441\u0432\u0451\u0440\u0442\u043E\u043A \u0443 \u0442\u0435\u0431\u044F
          \u0432 \u0440\u0443\u043A\u0430\u0445. \xAB\u041E\u043F\u044F\u0442\u044C
          \u043A \u0441\u0435\u0434\u044C\u043C\u043E\u043C\u0443\xBB, \u2014 \u0433\u043E\u0432\u043E\u0440\u0438\u0442
          \u043F\u0440\u043E\u0441\u0442\u043E, \u043D\u0435 \u043A\u0430\u043A \u0432\u043E\u043F\u0440\u043E\u0441,
          \u0438 \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u0435\u0442\u0441\u044F
          \u043A \u0437\u0430\u0441\u043E\u0432\u0443."
        conditions:
          Combinator: 0
          Conditions: []
        hasPassiveCheck: 0
        passiveCheck:
