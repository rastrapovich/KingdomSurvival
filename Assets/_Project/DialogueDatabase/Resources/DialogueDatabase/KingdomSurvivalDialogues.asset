      OldTraceFound + \u043E\u0434\u043D\u0430 \u0438\u0437 \u043A\u043E\u043C\u0431\u0438\u043D\u0430\u0446\u0438\u0439
      \u0437\u043D\u0430\u043D\u0438\u0439 A/B/C) \u2014 \u0441\u0430\u043C \u0434\u0438\u0430\u043B\u043E\u0433
      \u043E\u0431 \u044D\u0442\u043E\u043C \u043D\u0435 \u0437\u043D\u0430\u0435\u0442
      \u0438 \u043D\u0435 \u043F\u0440\u043E\u0432\u0435\u0440\u044F\u0435\u0442.
      Presentation-\u043F\u0440\u0430\u0432\u0438\u043B\u043E \xAB\u043E\u0434\u043D\u0430
      \u0440\u0435\u043F\u043B\u0438\u043A\u0430 = \u043E\u0434\u0438\u043D \u0448\u0430\u0433\xBB:
      DialogueChoiceKind.Continue \u043C\u0435\u0436\u0434\u0443 \u0443\u0437\u043B\u0430\u043C\u0438.
      FarRouteUnlocked \u0441\u0442\u0430\u0432\u0438\u0442\u0441\u044F \u043D\u0435
      \u043D\u0430 \u0432\u0445\u043E\u0434\u0435 \u0432 \u0441\u0446\u0435\u043D\u0443,
      \u0430 \u043D\u0430 \u0443\u0437\u043B\u0435 departure_decided \u2014 \u041F\u041E\u0421\u041B\u0415
      \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0435\u0433\u043E \u0440\u0435\u0448\u0435\u043D\u0438\u044F
      \u0433\u0435\u0440\u043E\u044F (\u0435\u0434\u0438\u043D\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0439
      Normal choice \u0432 \u0441\u0438\u043D\u0442\u0435\u0437\u0435), \u0430 \u043D\u0435
      \u043F\u0440\u0438 \u043E\u0442\u043A\u0440\u044B\u0442\u0438\u0438 \u0434\u0438\u0430\u043B\u043E\u0433\u0430.
      \u0414\u0432\u0435 \u043E\u043F\u0446\u0438\u043E\u043D\u0430\u043B\u044C\u043D\u044B\u0435
      \u0446\u0435\u043B\u0438 \u043F\u043E\u0445\u043E\u0434\u0430 (\u0432\u0442\u043E\u0440\u043E\u0439
      \u0445\u043B\u0435\u0431, \u0441\u0435\u043C\u0438\u0437\u0443\u0431\u044B\u0439
      \u043A\u0430\u043B\u0438\u0431\u0440) \u2014 \u043D\u0435 \u043E\u0442\u0434\u0435\u043B\u044C\u043D\u044B\u0435
      map marker \u0438 \u043D\u0435 \u0441\u0447\u0451\u0442\u0447\u0438\u043A,
      \u0430 \u0434\u0432\u0430 \u0431\u043B\u043E\u043A\u0430 \u0441 Conditions
      \u043F\u043E \u0443\u0436\u0435 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u044E\u0449\u0438\u043C
      \u0437\u043D\u0430\u043D\u0438\u044F\u043C P07: \u0435\u0441\u043B\u0438 \u0437\u043D\u0430\u043D\u0438\u0435
      \u043D\u0435 \u043F\u043E\u043B\u0443\u0447\u0435\u043D\u043E, \u0431\u043B\u043E\u043A
      \u043F\u0440\u043E\u0441\u0442\u043E \u043D\u0435 \u0432\u0438\u0434\u0435\u043D
      \u0438 \u0441\u0446\u0435\u043D\u0430 \u0441\u0440\u0430\u0437\u0443 \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0430\u0435\u0442\u0441\u044F
      \u0434\u0430\u043B\u044C\u0448\u0435 (\u0441\u043C. EveryNode_HasAtMostOneTextBlock
      \u2014 \u043D\u043E\u043B\u044C \u0431\u043B\u043E\u043A\u043E\u0432 \u0442\u0430\u043A\u043E\u0439
      \u0436\u0435 \u0437\u0430\u043A\u043E\u043D\u043D\u044B\u0439 \u0441\u043B\u0443\u0447\u0430\u0439,
      \u043A\u0430\u043A \u043E\u0434\u0438\u043D). \u0420\u0430\u0441\u043A\u0440\u044B\u0442\u0438\u0435
      \u043E\u0431\u043B\u0430\u0441\u0442\u0438 \u043F\u043E\u0438\u0441\u043A\u0430
      \u043D\u0430 \u043A\u0430\u0440\u0442\u0435 \u2014 \u043D\u0435 \u044D\u0444\u0444\u0435\u043A\u0442
      \u0434\u0438\u0430\u043B\u043E\u0433\u0430, \u0430 Chapter01OutcomeApplier.ApplyDepartureConsequences,
      \u0432\u044B\u0437\u0432\u0430\u043D\u043D\u044B\u0439 Chapter01StoryDirector.HandleDialogueCompleted
      \u043F\u043E \u0444\u0430\u043A\u0442\u0443 \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043D\u0438\u044F
      D09."
