    - id: chapter01.node.04.dexterity_success
      speakerId: narrator
      text: 
      textBlocks:
      - blockId: chapter01.node.04.dexterity_success_main
        kind: 0
        speakerIdOverride: 
        text: "\u0411\u0430\u043B\u043A\u0430 \u043F\u043E\u0434 \u043D\u043E\u0433\u043E\u0439
          \u043F\u0440\u043E\u0433\u0438\u0431\u0430\u0435\u0442\u0441\u044F, \u043D\u043E
          \u0434\u0435\u0440\u0436\u0438\u0442. \u0422\u044B \u0443\u0441\u043F\u0435\u0432\u0430\u0435\u0448\u044C
          \u043F\u0435\u0440\u0435\u0431\u0440\u0430\u0442\u044C\u0441\u044F \u0442\u0443\u0434\u0430,
          \u0433\u0434\u0435 \u043F\u0440\u044F\u043C\u043E\u0433\u043E \u043F\u0443\u0442\u0438
          \u0443\u0436\u0435 \u043D\u0435\u0442, \u0438 \u0432\u0431\u0438\u0432\u0430\u0435\u0448\u044C
          \u043A\u043B\u0438\u043D \u0432 \u0449\u0435\u043B\u044C \u0441\u0442\u0432\u043E\u0440\u0430,
          \u043D\u0430 \u043C\u0438\u0433 \u043E\u0442\u0432\u043E\u0434\u044F \u043F\u043E\u0442\u043E\u043A
          \u0432 \u0441\u0442\u043E\u0440\u043E\u043D\u0443. \u041D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E
          \u043C\u0433\u043D\u043E\u0432\u0435\u043D\u0438\u0439 \u0432\u044B\u0438\u0433\u0440\u0430\u043D\u043E
          \u2014 \u043D\u043E \u0432\u043E\u0434\u0430 \u0432\u0441\u0451 \u0440\u0430\u0432\u043D\u043E
          \u043F\u0440\u0438\u0431\u044B\u0432\u0430\u0435\u0442 \u0431\u044B\u0441\u0442\u0440\u0435\u0435,
          \u0447\u0435\u043C \u0442\u044B \u043C\u043E\u0436\u0435\u0448\u044C \u0432\u0435\u0437\u0434\u0435
          \u0443\u0441\u043F\u0435\u0442\u044C."
