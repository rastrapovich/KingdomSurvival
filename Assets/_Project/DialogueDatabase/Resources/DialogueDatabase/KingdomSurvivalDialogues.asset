    - id: chapter01.node.01_ask
      speakerId: ulyana
      text: 
      textBlocks:
      - blockId: chapter01.node.01_ask_main
        kind: 0
        speakerIdOverride: 
        text: "\xAB\u041A\u043E\u043C\u0443?\xBB \u2014 \u043F\u0435\u0440\u0435\u0441\u043F\u0440\u0430\u0448\u0438\u0432\u0430\u0435\u0448\u044C
          \u0442\u044B. \xAB\u041A\u043E\u043C\u0443 \u0432\u0441\u0435\u0433\u0434\u0430\xBB,
          \u2014 \u043E\u0442\u0432\u0435\u0447\u0430\u0435\u0442 \u0423\u043B\u044C\u044F\u043D\u0430,
          \u043D\u0435 \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u044F \u0433\u043B\u0430\u0437,
          \u0438 \u0443\u0436\u0435 \u0442\u044F\u043D\u0435\u0442\u0441\u044F \u0437\u0430
          \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0439 \u043A\u0440\u044B\u043D\u043A\u043E\u0439."
        conditions:
          Combinator: 0
          Conditions: []
        hasPassiveCheck: 0
        passiveCheck:
          CheckId: 
          Kind: 0
          Quality: 0
          CompetencyId: 
          Difficulty: 13
          ModifierRules: []
        onRevealEffects: []
      choices:
      - text: "\u041F\u043E\u0439\u0442\u0438 \u0434\u0430\u043B\u044C\u0448\u0435."
        nextNodeId: chapter01.node.01_ostafiy
        endsDialogue: 0
        choiceId: chapter01.node.01_ask_exit
        kind: 0
        conditions:
