        \u0442\u0440\u043E\u043F\u0435: \u0432\u043D\u0443\u0442\u0440\u044C \u0438
        \u043E\u0431\u0440\u0430\u0442\u043D\u043E. \u0422\u0440\u043E\u043F\u0430
        \u043D\u0430\u0431\u0438\u0442\u0430, \u043A\u0430\u043A \u0443 \u043A\u043E\u043B\u043E\u0434\u0446\u0430."
