        speakerIdOverride: 
        text: "Вода ушла с настила, но оставила после себя ил, сорванные крепления и тёмную полосу на брёвнах выше человеческого колена."
        conditions:
          Combinator: 0
          Conditions: []
        hasPassiveCheck: 0
        passiveCheck:
          CheckId:
          Kind: 0
          Quality: 0
          CompetencyId:
          Difficulty: 13
