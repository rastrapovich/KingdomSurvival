    - id: chapter01.node.04.failure_livestock
      speakerId: narrator
      text:
      textBlocks:
      - blockId: chapter01.node.04.failure_livestock_main
        kind: 0
        speakerIdOverride:
        text: "\u0422\u044B \u0443\u0441\u043F\u0435\u0432\u0430\u0435\u0448\u044C \u0442\u043E\u043B\u044C\u043A\u043E \u0432\u044B\u0433\u043D\u0430\u0442\u044C \u0441\u043A\u043E\u0442\u0438\u043D\u0443 \u043D\u0430 \u043F\u0440\u0438\u0433\u043E\u0440\u043E\u043A, \u0441\u0440\u044B\u0432\u0430\u044F \u0433\u043E\u043B\u043E\u0441 \u0438 \u0446\u0435\u043F\u043B\u044F\u044F\u0441\u044C \u0437\u0430 \u0432\u0435\u0440\u0451\u0432\u043A\u0438 \u0440\u0430\u0437\u0431\u0438\u0442\u043E\u0439 \u0440\u0443\u043A\u043E\u0439. \u041A \u043C\u0435\u043B\u044C\u043D\u0438\u0446\u0435, \u0433\u0434\u0435 \u043E\u0441\u0442\u0430\u043B\u0438\u0441\u044C \u0440\u0430\u0431\u043E\u0442\u043D\u0438\u043A\u0438, \u043F\u0440\u043E\u0431\u0438\u0442\u044C\u0441\u044F \u0443\u0436\u0435 \u043D\u0435 \u0443\u0441\u043F\u0435\u0432\u0430\u0435\u0448\u044C \u2014 \u043A\u0440\u0438\u043A\u0438 \u0442\u043E\u043D\u0443\u0442 \u0432 \u0448\u0443\u043C\u0435 \u0432\u043E\u0434\u044B. \u041D\u0430\u0441\u0442\u0438\u043B \u0437\u0430 \u0441\u043F\u0438\u043D\u043E\u0439 \u0443\u0445\u043E\u0434\u0438\u0442 \u043F\u043E\u0434 \u0432\u043E\u0434\u0443 \u0432\u043C\u0435\u0441\u0442\u0435 \u0441 \u0447\u0430\u0441\u0442\u044C\u044E \u043C\u0435\u0445\u0430\u043D\u0438\u0437\u043C\u0430."
