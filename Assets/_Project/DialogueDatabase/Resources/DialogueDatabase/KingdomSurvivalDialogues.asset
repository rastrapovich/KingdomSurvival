    - id: chapter01.node.07c.fish
      speakerId: narrator
      text: 
      textBlocks:
      - blockId: chapter01.node.07c.fish_old
        kind: 0
        speakerIdOverride: 
        text: "\u0423 \u0431\u0435\u0440\u0435\u0433\u0430 \u043B\u0435\u0436\u0438\u0442
          \u0440\u044B\u0431\u0430. \u041D\u0435 \u043C\u043D\u043E\u0433\u043E \u2014
          \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0448\u0442\u0443\u043A.
          \u0412\u0441\u0435 \u043E\u043A\u0430\u0437\u0430\u043B\u0438\u0441\u044C
          \u0432\u044B\u0431\u0440\u043E\u0448\u0435\u043D\u044B \u043D\u0430 \u043E\u0434\u043D\u043E\u0439
          \u0438 \u0442\u043E\u0439 \u0436\u0435 \u0441\u0442\u043E\u0440\u043E\u043D\u0435
          \u0440\u0443\u0441\u043B\u0430 \u043F\u043E\u0441\u043B\u0435 \u043E\u0447\u0435\u0440\u0435\u0434\u043D\u043E\u0433\u043E
