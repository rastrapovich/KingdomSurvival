    - id: chapter01.node.05.check_injured
      speakerId: narrator
      text: 
      textBlocks:
      - blockId: chapter01.node.05.check_injured_main
        kind: 0
        speakerIdOverride: ulyana
        text: "\u0423\u043B\u044C\u044F\u043D\u0430 \u0441\u043C\u043E\u0442\u0440\u0438\u0442
          \u043D\u0430 \u0442\u0432\u043E\u044E \u043F\u0435\u0440\u0435\u0432\u044F\u0437\u0430\u043D\u043D\u0443\u044E
          \u0440\u0443\u043A\u0443. \u2014 \u0418 \u0442\u0435\u0431\u044F \u044F
          \u0437\u0430 \u0440\u0430\u0431\u043E\u0447\u0435\u0433\u043E \u043D\u0435
