      - blockId: freeplay.mine.entry.iron.text
        kind: 5
        speakerIdOverride: 
        text: "\u041F\u043E\u0434 \u0440\u0436\u0430\u0432\u0447\u0438\u043D\u043E\u0439
          \u2014 \u0434\u043E\u0431\u0440\u0430\u044F \u043F\u043E\u043B\u043E\u0441\u0430
