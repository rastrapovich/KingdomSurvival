      - blockId: cave.cutter.start.greet
        kind: 0
        speakerIdOverride: nezhata
        text: "\u2014 \u0421\u043B\u044B\u0448\u0430\u043B \u044F \u0432\u0430\u0441
          \u0442\u0430\u043C. \u0412\u0441\u0435 \u0436\u0438\u0432\u044B? \u0412\u043E\u0442
          \u0438 \u043B\u0430\u0434\u043D\u043E."
        conditions:
          Combinator: 0
          Conditions:
