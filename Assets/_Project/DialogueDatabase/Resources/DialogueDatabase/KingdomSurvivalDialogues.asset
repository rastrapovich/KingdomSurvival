        speakerIdOverride:
        text: "\u2014 \u0420\u0430\u0437 \u0414\u043E\u043C \u0434\u0435\u0440\u0436\u0438\u0442\u0441\u044F \u0441\u0442\u0430\u0440\u043E\u0433\u043E, \u2014 \u0433\u043E\u0432\u043E\u0440\u0438\u0442 \u043E\u043D\u0430, \u2014 \u043C\u043E\u0436\u0435\u0442, \u0438
