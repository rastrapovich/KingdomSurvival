        onRevealEffects: []
      choices:
      - text: "\u041E\u0442\u043D\u0435\u0441\u0442\u0438 \u0445\u043B\u0435\u0431
          \u043A \u0437\u0430\u0442\u0432\u043E\u0440\u0443."
