  dialogues:
  - id: prototype_miller
    title: "\u0412\u0438\u0442\u0440\u0438\u043D\u0430 \u0443\u0441\u043B\u043E\u0432\u0438\u0439
      \u043E\u0442\u0432\u0435\u0442\u0430"
    category: 0
    status: 0
    developerComment: "\u0422\u0435\u0445\u043D\u0438\u0447\u0435\u0441\u043A\u0438\u0439
      \u0434\u0438\u0430\u043B\u043E\u0433 \u0434\u043B\u044F \u043D\u0430\u0433\u043B\u044F\u0434\u043D\u043E\u0439
      \u043F\u0440\u043E\u0432\u0435\u0440\u043A\u0438 \u0432\u0441\u0435\u0445 NarrativeConditionType,
      \u0433\u0440\u0443\u043F\u043F All/Any \u0438 Negate. \u041D\u0435 \u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F
      \u0441\u044E\u0436\u0435\u0442\u043D\u044B\u043C \u043A\u0430\u043D\u043E\u043D\u043E\u043C."
    startNodeId: opening
    tags:
    - "\u0442\u0435\u0441\u0442"
    - "\u0443\u0441\u043B\u043E\u0432\u0438\u044F"
    - "\u043F\u0440\u043E\u0432\u0435\u0440\u043A\u0438"
    nodes:
    - id: opening
      speakerId: miller
      text: "\u042D\u0442\u043E \u0442\u0435\u0445\u043D\u0438\u0447\u0435\u0441\u043A\u0430\u044F
        \u0432\u0438\u0442\u0440\u0438\u043D\u0430 \u0443\u0441\u043B\u043E\u0432\u0438\u0439
        \u043E\u0442\u0432\u0435\u0442\u0430, \u0430 \u043D\u0435 \u0441\u044E\u0436\u0435\u0442\u043D\u044B\u0439
        \u0434\u0438\u0430\u043B\u043E\u0433. \u041E\u0442\u043A\u0440\u043E\u0439
        \u0441\u043F\u0440\u0430\u0432\u0430 \xAB\u0422\u0435\u0441\u0442\u043E\u0432\u044B\u0439
        \u0433\u0435\u0440\u043E\u0439 (Preview)\xBB. \u041F\u043E\u0441\u043B\u0435
        \u0438\u0437\u043C\u0435\u043D\u0435\u043D\u0438\u044F \u043F\u0430\u0440\u0430\u043C\u0435\u0442\u0440\u043E\u0432
        \u043D\u0430\u0436\u0438\u043C\u0430\u0439 \xAB\u25B6 \u0417\u0430\u043F\u0443\u0441\u0442\u0438\u0442\u044C
        / \u0441 \u043D\u0430\u0447\u0430\u043B\u0430\xBB. \u0421\u0435\u0440\u044B\u0439
        \u043E\u0442\u0432\u0435\u0442 \u043E\u0437\u043D\u0430\u0447\u0430\u0435\u0442,
        \u0447\u0442\u043E \u0443\u0441\u043B\u043E\u0432\u0438\u0435 \u043D\u0435
        \u0432\u044B\u043F\u043E\u043B\u043D\u0435\u043D\u043E; \u0430\u043A\u0442\u0438\u0432\u043D\u0430\u044F
        \u043A\u043D\u043E\u043F\u043A\u0430 \u2014 \u0447\u0442\u043E \u043E\u043D\u043E
        \u0441\u0440\u0430\u0431\u043E\u0442\u0430\u043B\u043E."
      textBlocks: []
      choices:
      - text: "1. \u041C\u0438\u0440 \u0438 \u043F\u0440\u043E\u0448\u043B\u044B\u0435
          \u0440\u0435\u0448\u0435\u043D\u0438\u044F \u2014 \u0444\u043B\u0430\u0433,
          \u0437\u043D\u0430\u043D\u0438\u0435, \u043E\u0442\u043D\u043E\u0448\u0435\u043D\u0438\u0435,
          \u0441\u043F\u0443\u0442\u043D\u0438\u043A, \u043F\u0440\u0435\u0434\u043C\u0435\u0442."
        nextNodeId: world_conditions
        endsDialogue: 0
        choiceId: opening_world
        kind: 0
        conditions:
          Combinator: 0
          Conditions: []
        unavailablePresentation: 0
        check:
          CheckId: 
          Kind: 0
          Quality: 0
          CompetencyId: 
          Difficulty: 13
          ModifierRules: []
        successNodeId: 
        failureNodeId: 
        successEffects: []
        failureEffects: []
      - text: "2. \u0413\u0435\u0440\u043E\u0439 \u2014 \u043A\u0430\u0447\u0435\u0441\u0442\u0432\u043E,
          \u043A\u043E\u043C\u043F\u0435\u0442\u0435\u043D\u0446\u0438\u044F, \u043E\u0441\u043E\u0431\u0435\u043D\u043D\u043E\u0441\u0442\u044C."
        nextNodeId: hero_conditions
        endsDialogue: 0
        choiceId: opening_hero
        kind: 0
        conditions:
          Combinator: 0
          Conditions: []
        unavailablePresentation: 0
        check:
          CheckId: 
          Kind: 0
          Quality: 0
          CompetencyId: 
          Difficulty: 13
          ModifierRules: []
        successNodeId: 
        failureNodeId: 
        successEffects: []
        failureEffects: []
      - text: "3. \u0418\u0441\u0442\u043E\u0440\u0438\u044F \u043F\u0440\u043E\u0432\u0435\u0440\u043A\u0438
          \u2014 \u0435\u0449\u0451 \u043D\u0435 \u0432\u044B\u043F\u043E\u043B\u043D\u044F\u043B\u0430\u0441\u044C
          / \u0443\u0441\u043F\u0435\u0445 / \u043F\u0440\u043E\u0432\u0430\u043B."
        nextNodeId: check_conditions
        endsDialogue: 0
        choiceId: opening_checks
        kind: 0
        conditions:
          Combinator: 0
          Conditions: []
        unavailablePresentation: 0
        check:
          CheckId: 
          Kind: 0
          Quality: 0
          CompetencyId: 
          Difficulty: 13
          ModifierRules: []
        successNodeId: 
        failureNodeId: 
        successEffects: []
        failureEffects: []
      - text: "4. \u041B\u043E\u0433\u0438\u043A\u0430 \u0433\u0440\u0443\u043F\u043F\u044B
          \u2014 \u0412\u0421\u0415 / \u0425\u041E\u0422\u042F \u0411\u042B \u041E\u0414\u041D\u041E
          / \u043E\u0431\u0440\u0430\u0449\u0435\u043D\u0438\u0435 \u0443\u0441\u043B\u043E\u0432\u0438\u044F."
        nextNodeId: logic_conditions
        endsDialogue: 0
        choiceId: opening_logic
        kind: 0
        conditions:
          Combinator: 0
          Conditions: []
        unavailablePresentation: 0
        check:
