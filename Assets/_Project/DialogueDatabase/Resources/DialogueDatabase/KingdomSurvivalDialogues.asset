      textBlocks:
      - blockId: cave.cutter.wall.a
        kind: 0
        speakerIdOverride: nezhata
        text: "\u2014 \u041D\u0435 \u043C\u043E\u044F. \u042F \u043F\u0440\u0438\u0448\u0451\u043B
          \u2014 \u043E\u043D\u0430 \u0443\u0436\u0435 \u0441\u0442\u043E\u044F\u043B\u0430.
          \u0422\u0430\u043A \u0443 \u043D\u0430\u0441 \u043D\u0435 \u043A\u043B\u0430\u0434\u0443\u0442:
          \u043D\u0430 \u0441\u0443\u0445\u0443\u044E, \u0448\u043E\u0432 \u0432
          \u0448\u043E\u0432, \u043D\u0438 \u043D\u043E\u0436\u0430 \u043D\u0435
          \u0432\u0441\u0443\u043D\u0435\u0448\u044C."
        conditions:
          Combinator: 0
