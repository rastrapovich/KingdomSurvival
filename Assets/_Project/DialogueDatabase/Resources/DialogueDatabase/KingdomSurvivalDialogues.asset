    nodes:
    - id: freeplay.carter.tells.start
      speakerId: carter
      text: 
      textBlocks:
      - blockId: freeplay.carter.tells.line
        kind: 0
        speakerIdOverride: 
        text: "\u2014 \u041E\u0442 \u0442\u043E\u0440\u0433\u0430 \u043F\u043E\u043B\u0434\u043D\u044F
          \u0445\u043E\u0434\u0443. \u0421\u0442\u0430\u0440\u043E\u0435 \u0440\u0443\u0441\u043B\u043E
          \u0442\u0430\u043C \u043F\u0435\u0440\u0435\u0441\u043E\u0445\u043B\u043E,
          \u043E\u0441\u043E\u043A\u043E\u0439 \u043F\u043E\u0440\u043E\u0441\u043B\u043E
          \u2014 \u0440\u0435\u043A\u0430 \u0434\u0430\u0432\u043D\u043E \u0443\u0448\u043B\u0430,
          \u0430 \u0431\u0435\u0440\u0435\u0433 \u043E\u0441\u0442\u0430\u043B\u0441\u044F.
          \u0418\u0432\u0430 \u0443 \u043A\u0440\u0430\u044F \u0440\u0430\u0441\u043A\u043E\u043B\u043E\u0442\u0430
          \u043D\u0430\u0434\u0432\u043E\u0435, \u043D\u0430 \u043E\u0434\u043D\u043E\u0439
          \u043F\u043E\u043B\u043E\u0432\u0438\u043D\u0435 \u0442\u0440\u0438 \u0437\u0430\u0440\u0443\u0431\u043A\u0438.
          \u041A\u043E\u0440\u043E\u0439 \u0443\u0436\u0435 \u0437\u0430\u0442\u044F\u043D\u0443\u043B\u043E,
          \u043D\u043E \u0438\u0449\u0438\u0442\u0435 \u2014 \u043D\u0430\u0439\u0434\u0451\u0442\u0435."
