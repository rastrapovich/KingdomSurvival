/* Stable army portrait layout. Loaded once at runtime after the base shell USS. */

.shell-main-row {
    margin-bottom: 5px;
}

.shell-bottom-bar {
    height: 42px;
    min-height: 42px;
    max-height: 42px;
}

.shell-navigation-bar {
    padding-top: 2px;
    padding-bottom: 2px;
}

.shell-nav-button {
    font-size: 11px;
    padding-top: 1px;
    padding-bottom: 1px;
}

.shell-time-label { font-size: 12px; }

.shell-time-toggle-button {
    height: 32px;
    min-height: 32px;
    max-height: 32px;
    margin-left: 6px;
    border-radius: 5px;
    font-size: 12px;
}

.incident-notification-stack {
    bottom: 68px;
}
