    - id: chapter01.node.01_lada
      speakerId: lada
      text: 
      textBlocks:
      - blockId: chapter01.node.01_lada_main
        kind: 0
        speakerIdOverride: 
        text: "\u041B\u0430\u0434\u0430 \u0434\u0435\u0440\u0436\u0438\u0442 \u0437\u0443\u0431\u0430\u043C\u0438
          \u0437\u0430\u043F\u0430\u0441\u043D\u043E\u0439 \u043A\u043E\u043B\u044B\u0448\u0435\u043A,
          \u043E\u0431\u0435\u0438\u043C\u0438 \u0440\u0443\u043A\u0430\u043C\u0438
          \u2014 \u0440\u0430\u0441\u043F\u043E\u0440\u043A\u0443 \u043D\u0430\u0441\u0442\u0438\u043B\u0430,
          \u0438 \u043E\u0434\u043D\u0438\u043C \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u0435\u043C
          \u0437\u0430\u0433\u043E\u043D\u044F\u0435\u0442 \u043A\u043E\u043B\u044B\u0448\u0435\u043A
          \u043D\u0430 \u043C\u0435\u0441\u0442\u043E. \u0422\u043E\u043B\u044C\u043A\u043E
          \u0442\u043E\u0433\u0434\u0430 \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0435\u0442
          \u0432\u0437\u0433\u043B\u044F\u0434. \xAB\u0415\u0441\u043B\u0438 \u0431\u044B
          \u041E\u0441\u0442\u0430\u0444\u0438\u0439 \u043D\u0435 \u0431\u0435\u0440\u0451\u0433
          \u043A\u0430\u0436\u0434\u0443\u044E \u0449\u0435\u043F\u043A\u0443, \u044F
          \u0431\u044B \u043F\u0435\u0440\u0435\u0434\u0435\u043B\u0430\u043B\u0430
          \u044D\u0442\u043E \u0435\u0449\u0451 \u0432\u0447\u0435\u0440\u0430 \u2014
          \u0438 \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E\xBB."
        conditions:
          Combinator: 0
          Conditions: []
        hasPassiveCheck: 0
        passiveCheck:
          CheckId: 
          Kind: 0
          Quality: 0
          CompetencyId: 
          Difficulty: 13
          ModifierRules: []
        onRevealEffects: []
      choices:
      - text: "\u041F\u043E\u0439\u0442\u0438 \u0434\u0430\u043B\u044C\u0448\u0435,
          \u043A \u043C\u0435\u043B\u044C\u043D\u0438\u0446\u0435."
