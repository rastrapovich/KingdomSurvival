  - id: freeplay_mine_entry
    title: "\u0418-2 \u2014 \u0421\u0443\u0445\u0430\u044F \u0448\u0430\u0445\u0442\u0430"
    category: 2
    status: 1
    developerComment: "\u041F\u0420-12\u0411, \u0438\u0441\u0442\u043E\u0440\u0438\u044F
      \u0418-2 [\u0420\u0410\u0411\u041E\u0427\u0415\u0415][KINGDOM SURVIVAL]. \u041F\u0435\u0440\u0432\u044B\u0439
      \u0432\u0445\u043E\u0434 \u0432 \u0448\u0430\u0445\u0442\u0443. \u041E\u0442\u0432\u0430\u043B\u044B
      \u2014 \u0440\u0435\u0448\u0430\u044E\u0449\u0430\u044F \u041D\u0430\u0431\u043B\u044E\u0434\u0430\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u044C
      (\u0427\u0443\u0442\u044C\u0451, 13): \u0443\u0441\u043F\u0435\u0445 \u2014
      \u0436\u0435\u043B\u0435\u0437\u043E (freeplay.mine.iron_dumps) \u0438 \u043A\u043B\u0435\u0439\u043C\u043E.
      \u041A\u043B\u0435\u0439\u043C\u043E: \u041E\u0441\u0442\u0430\u0444\u0438\u0439
      \u0432 \u043E\u0442\u0440\u044F\u0434\u0435 \u0447\u0438\u0442\u0430\u0435\u0442
      \u0441\u0430\u043C (\u0444\u0443\u043D\u043A\u0446\u0438\u044F \u043F\u0440\u0438\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u044F)
      \u0438\u043B\u0438 \u0440\u0435\u0448\u0430\u044E\u0449\u0435\u0435 \u0420\u0430\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u043D\u0438\u0435
      (\u0421\u0443\u0436\u0434\u0435\u043D\u0438\u0435, 13) \u2192 freeplay.mine.mark.
      \u0414\u0430\u043B\u044C\u043D\u044F\u044F \u0448\u0442\u043E\u043B\u044C\u043D\u044F
      \u2014 \u0444\u043B\u0430\u0433 freeplay.mine.deep, \u043F\u043E\u0441\u043B\u0435
      \u0440\u0430\u0437\u0433\u043E\u0432\u043E\u0440\u0430 \u0431\u043E\u0439 \xAB\u041B\u043E\u0433\u043E\u0432\u043E
      \u0432 \u0448\u0442\u043E\u043B\u044C\u043D\u0435\xBB (2 \xD7 forest_beast,
      \u043E\u0442\u0445\u043E\u0434 \u0440\u0430\u0437\u0440\u0435\u0448\u0451\u043D)."
    sceneIllustration: {fileID: 0}
    sceneIllustrationFillFrame: 0
    sceneIllustrationScale: 1
    sceneIllustrationOffsetNormalized: {x: 0, y: 0}
