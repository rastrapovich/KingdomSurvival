    - id: world_conditions
      speakerId: miller
      text: "\u041C\u0435\u043D\u044F\u0439 \u043F\u043E\u043B\u044F Preview \u0438
        \u043A\u0430\u0436\u0434\u044B\u0439 \u0440\u0430\u0437 \u0437\u0430\u043F\u0443\u0441\u043A\u0430\u0439
        \u0440\u0430\u0437\u0433\u043E\u0432\u043E\u0440 \u0441 \u043D\u0430\u0447\u0430\u043B\u0430.
        \u0414\u043B\u044F \u043E\u0442\u043D\u043E\u0448\u0435\u043D\u0438\u0439
        \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439 \u0437\u0430\u043F\u0438\u0441\u044C
        miller:\u0447\u0438\u0441\u043B\u043E. \u0423 \u043A\u0430\u0436\u0434\u043E\u0433\u043E
        \u043E\u0442\u0432\u0435\u0442\u0430 \u043D\u0438\u0436\u0435 \u0440\u043E\u0432\u043D\u043E
        \u043E\u0434\u043D\u043E \u0443\u0441\u043B\u043E\u0432\u0438\u0435 \u2014
        \u0442\u0430\u043A \u0432\u0438\u0434\u043D\u043E \u0435\u0433\u043E \u0432\u043B\u0438\u044F\u043D\u0438\u0435
        \u0431\u0435\u0437 \u043F\u0440\u0438\u043C\u0435\u0441\u0435\u0439."
      textBlocks: []
      choices:
      - text: "[\u0421\u043E\u0431\u044B\u0442\u0438\u0435 / \u0440\u0435\u0448\u0435\u043D\u0438\u0435
          \u0443\u0436\u0435 \u0431\u044B\u043B\u043E] \u0424\u043B\u0430\u0433 demo_event_done."
