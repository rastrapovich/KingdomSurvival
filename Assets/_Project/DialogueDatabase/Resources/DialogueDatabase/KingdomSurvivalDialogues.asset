    - id: chapter01.node.13.approach_tense
      speakerId: downstream_voice
      text:
      textBlocks:
      - blockId: chapter01.node.13.approach_tense_main
        kind: 0
        speakerIdOverride:
        text: "\u041E\u0442\u0440\u044F\u0434 \u043D\u0435 \u043C\u0435\u043D\u044F\u0435\u0442 \u0448\u0430\u0433\u0430 \u0438 \u043D\u0435 \u0443\u0431\u0438\u0440\u0430\u0435\u0442 \u043E\u0440\u0443\u0436\u0438\u0435 \u2014 \u043F\u0440\u043E\u0441\u0442\u043E \u0438\u0434\u0451\u0442,
          \u043A\u0430\u043A \u0448\u0451\u043B. \u041C\u0443\u0436\u0447\u0438\u043D\u0430 \u043D\u0435 \u043E\u0442\u0441\u0442\u0443\u043F\u0430\u0435\u0442, \u043D\u043E \u0438 \u043D\u0435 \u043F\u043E\u0434\u0445\u043E\u0434\u0438\u0442 \u0431\u043B\u0438\u0436\u0435;
          \u043B\u0430\u0434\u043E\u043D\u044C \u0443 \u043D\u0435\u0433\u043E \u0442\u0430\u043A \u0438 \u043E\u0441\u0442\u0430\u0451\u0442\u0441\u044F \u043D\u0430 \u043F\u043E\u044F\u0441\u0435."
