    - id: chapter01.node.02_neutral
      speakerId: miron
      text: 
      textBlocks:
      - blockId: chapter01.node.02_neutral_main
        kind: 0
        speakerIdOverride: 
        text: "\u041C\u0438\u0440\u043E\u043D \u0445\u043C\u044B\u043A\u0430\u0435\u0442,
          \u043D\u0435 \u043E\u0442\u0440\u044B\u0432\u0430\u044F\u0441\u044C \u043E\u0442
          \u043A\u043E\u043B\u0435\u0441\u0430: \xAB\u041C\u0443\u0434\u0440\u043E\u0435
          \u0434\u0435\u043B\u043E. \u0421\u0430\u043C\u043E \u043A\u043E\u043B\u0435\u0441\u043E
          \u043F\u043E\u043A\u0430\u0436\u0435\u0442, \u043A\u0442\u043E \u0431\u044B\u043B
          \u043F\u0440\u0430\u0432 \u2014 \u043E\u043D\u043E \u0432\u0440\u0430\u0442\u044C
          \u043D\u0435 \u0443\u043C\u0435\u0435\u0442\xBB."
