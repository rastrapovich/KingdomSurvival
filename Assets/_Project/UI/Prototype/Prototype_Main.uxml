                </ui:ScrollView>
            </ui:VisualElement>
            <ui:VisualElement name="hero-screen-unit-card-dimmer" class="hero-screen-unit-card-dimmer" focusable="true" />
            <ui:VisualElement name="hero-screen-unit-card" class="hero-screen-unit-card">
                <ui:VisualElement class="hero-screen-unit-card-header">
                    <ui:Label name="hero-screen-unit-card-title" class="hero-screen-unit-card-title ks-gold-text" />
                    <ui:Button name="hero-screen-unit-card-close-button" text="×" class="ks-button hero-screen-unit-card-close-button" />
                </ui:VisualElement>
                <ui:VisualElement class="hero-screen-unit-card-body">
                    <ui:VisualElement name="hero-screen-unit-card-portrait" class="hero-screen-unit-card-portrait">
                        <ui:VisualElement name="hero-screen-unit-card-portrait-healthbar" class="hero-screen-unit-card-portrait-healthbar">
                            <ui:VisualElement name="hero-screen-unit-card-portrait-healthbar-fill" class="hero-screen-unit-card-portrait-healthbar-fill" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="hero-screen-unit-card-stats">
                        <ui:Label text="БОЕВЫЕ ХАРАКТЕРИСТИКИ" class="hero-screen-unit-card-section-title" />
                        <ui:VisualElement name="hero-screen-unit-card-stat-health" class="hero-screen-stat-row">
                            <ui:Label text="ЖИЗНИ" class="hero-screen-stat-row-title" />
                            <ui:Label name="hero-screen-unit-card-stat-health-value" class="hero-screen-stat-row-value" />
                        </ui:VisualElement>
                        <ui:VisualElement name="hero-screen-unit-card-stat-attack" class="hero-screen-stat-row">
                            <ui:Label text="АТАКА" class="hero-screen-stat-row-title" />
                            <ui:Label name="hero-screen-unit-card-stat-attack-value" class="hero-screen-stat-row-value" />
                        </ui:VisualElement>
                        <ui:VisualElement name="hero-screen-unit-card-stat-defense" class="hero-screen-stat-row">
                            <ui:Label text="ЗАЩИТА" class="hero-screen-stat-row-title" />
                            <ui:Label name="hero-screen-unit-card-stat-defense-value" class="hero-screen-stat-row-value" />
                        </ui:VisualElement>
                        <ui:VisualElement name="hero-screen-unit-card-stat-damage" class="hero-screen-stat-row">
                            <ui:Label text="УРОН" class="hero-screen-stat-row-title" />
                            <ui:Label name="hero-screen-unit-card-stat-damage-value" class="hero-screen-stat-row-value" />
                        </ui:VisualElement>
                        <ui:VisualElement name="hero-screen-unit-card-stat-movement" class="hero-screen-stat-row">
                            <ui:Label text="ХОД" class="hero-screen-stat-row-title" />
                            <ui:Label name="hero-screen-unit-card-stat-movement-value" class="hero-screen-stat-row-value" />
                        </ui:VisualElement>
                        <ui:VisualElement name="hero-screen-unit-card-stat-initiative" class="hero-screen-stat-row">
                            <ui:Label text="ИНИЦИАТИВА" class="hero-screen-stat-row-title" />
                            <ui:Label name="hero-screen-unit-card-stat-initiative-value" class="hero-screen-stat-row-value" />
                        </ui:VisualElement>
                        <ui:VisualElement name="hero-screen-unit-card-stat-attack-range" class="hero-screen-stat-row">
                            <ui:Label text="ДАЛЬНОСТЬ АТАКИ" class="hero-screen-stat-row-title" />
                            <ui:Label name="hero-screen-unit-card-stat-attack-range-value" class="hero-screen-stat-row-value" />
                        </ui:VisualElement>
                        <ui:VisualElement name="hero-screen-unit-card-tags" class="hero-screen-wrap-row hero-screen-unit-card-tags" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="hero-screen-stat-tooltip" picking-mode="Ignore" class="hero-screen-tooltip">
                <ui:Label name="hero-screen-stat-tooltip-title" class="hero-screen-stat-tooltip-title" />
                <ui:Label name="hero-screen-stat-tooltip-text" class="hero-screen-tooltip-text hero-screen-stat-tooltip-text" />
            </ui:VisualElement>
            <ui:VisualElement name="hero-screen-tag-tooltip" picking-mode="Ignore" class="hero-screen-tooltip">
                <ui:Label name="hero-screen-tag-tooltip-title" class="hero-screen-tag-tooltip-title" />
                <ui:Label name="hero-screen-tag-tooltip-text" class="hero-screen-tooltip-text hero-screen-tag-tooltip-text" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- UI-M04: Диалог — постоянный, скрытый по умолчанию экран (та же
             роль верхнего уровня, что camp-screen/journal-overlay/
             hero-screen-overlay выше). Позиция/размеры/оформление — из
             Narrative.uss и Kingdom Survival -> UI Конструктор
             (KingdomSurvivalUILayouts.asset, экран "narrative-dialogue").
             Родительство speaker/role — дети overlay, а не panel (совпадает
             с requiredElements базы): так они позиционируются рядом с
             портретом, а не внутри текстовой панели. portrait — исключение
             по §8 доктрины: изображение и точную кадрировку всегда ставит
             защищённый портретный конвейер
             (PrototypeUIController.Narrative.cs — ApplyNarrativeSpeakerPortrait),
             сюда не переносится и не трогается. -->
        <ui:VisualElement name="narrative-dialogue-overlay" class="narrative-dialogue-overlay">
            <ui:VisualElement name="narrative-dialogue-panel" class="narrative-dialogue-panel">
                <ui:ScrollView name="narrative-dialogue-text" class="narrative-dialogue-text-scroll">
                    <ui:VisualElement name="narrative-dialogue-history" class="narrative-dialogue-history" />
                </ui:ScrollView>
                <ui:VisualElement name="narrative-dialogue-choices" class="narrative-dialogue-choices" />
            </ui:VisualElement>
            <ui:VisualElement name="narrative-dialogue-portrait" class="narrative-dialogue-portrait">
                <ui:Label name="narrative-dialogue-portrait-placeholder" text="ПОРТРЕТ&#10;ПЕРСОНАЖА" class="narrative-dialogue-portrait-placeholder" />
            </ui:VisualElement>
            <ui:Label name="narrative-dialogue-speaker" class="narrative-dialogue-speaker" />
            <ui:Label name="narrative-dialogue-role" class="narrative-dialogue-role" />
            <ui:VisualElement name="narrative-check-tooltip" picking-mode="Ignore" class="narrative-check-tooltip" />
        </ui:VisualElement>

        <!-- UI-M06: Быстрый попап "Открытые локации" — постоянный, скрытый
             по умолчанию узел (display:none в .quick-expedition-popup,
             Prototype_Shell.uss). Позиция (left/top) считается по границам
             persistent-commander-expedition-button во время выполнения
             (PositionQuickExpeditionPopup) — это зависит от текущей раскладки
             панели командира, а не от статичных данных, поэтому остаётся в
             коде. Карточки локаций добавляются в конец этого узла кодом
             (BindQuickExpeditionPopup) — по одной на LocationData, из
             Templates/ExpeditionLocationCard.uxml. -->
        <ui:VisualElement name="quick-expedition-popup" class="quick-expedition-popup">
            <ui:Label name="quick-expedition-popup-title" text="ОТКРЫТЫЕ ЛОКАЦИИ" class="quick-expedition-popup-title" />
            <ui:Label name="quick-expedition-order-label" text="ПРИКАЗ НА СЕГОДНЯ: нет" class="quick-expedition-order-label" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
