      "textBlocks": [
        {
          "blockId": "freeplay.mine.local.mark.start.scene",
          "kind": 5,
          "text": "В старой крепи — кованые скобы. На каждой одно и то же клеймо: два угла, вписанные один в другой."
        },
        {
          "blockId": "freeplay.mine.local.mark.start.ostafiy",
          "kind": 4,
          "speakerIdOverride": "ostafiy",
          "text": "— Уходили отсюда не второпях. Инструмент сложен, а не брошен.",
          "conditions": { "Combinator": 0, "Conditions": [ { "Type": 4, "StringParam": "ostafiy" } ] }
        }
      ],
      "choices": [
        {
          "choiceId": "freeplay.mine.local.mark.ask_ostafiy",
          "text": "Остафий, взгляни на клеймо.",
          "kind": 0,
          "nextNodeId": "freeplay.mine.local.mark.ostafiy",
          "conditions": { "Combinator": 0, "Conditions": [ { "Type": 4, "StringParam": "ostafiy" } ] }
        },
        {
          "choiceId": "freeplay.mine.local.mark.read",
          "text": "Разобрать клеймо самим.",
          "kind": 2,
          "check": { "CheckId": "freeplay.mine.mark_check", "Kind": 2, "Quality": 4, "CompetencyId": "investigation", "Difficulty": 13 },
          "successNodeId": "freeplay.mine.local.mark.read_ok",
          "failureNodeId": "freeplay.mine.local.mark.lost",
          "conditions": { "Combinator": 0, "Conditions": [ { "Type": 10, "StringParam": "freeplay.mine.mark_check" } ] }
        },
        { "choiceId": "freeplay.mine.local.mark.leave", "text": "Оставить скобы.", "kind": 3, "endsDialogue": true }
