    - id: chapter01.node.12.woman
      speakerId: ford_woman
      text:
      textBlocks:
      - blockId: chapter01.node.12.woman_arrival
        kind: 5
        speakerIdOverride:
        text: "\u0423 \u0432\u043E\u0434\u044B, \u043F\u043E \u043A\u043E\u043B\u0435\u043D\u043E \u0432 \u0438\u043B\u0435, \u0436\u0435\u043D\u0449\u0438\u043D\u0430 \u0447\u0438\u043D\u0438\u0442 \u0441\u0442\u0430\u0440\u0443\u044E \u0441\u0435\u0442\u044C \u2014
          \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u044F \u0431\u044B\u0441\u0442\u0440\u044B\u0435, \u043F\u0440\u0438\u0432\u044B\u0447\u043D\u044B\u0435, \u043D\u0435 \u0434\u043B\u044F \u0433\u043E\u0441\u0442\u0435\u0439. \u0413\u043E\u043B\u043E\u0432\u0443 \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0435\u0442
          \u043D\u0435 \u0441\u0440\u0430\u0437\u0443: \u043F\u043E\u0445\u043E\u0436\u0435, \u0440\u0430\u0441\u0441\u0447\u0438\u0442\u044B\u0432\u0430\u0435\u0442, \u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0435\u0449\u0451 \u043C\u043E\u0436\u043D\u043E \u043D\u0435 \u0437\u0430\u043C\u0435\u0447\u0430\u0442\u044C
          \u0447\u0443\u0436\u0438\u0445."
        conditions:
          Combinator: 0
          Conditions: []
        hasPassiveCheck: 0
        passiveCheck:
          CheckId:
