    Status: 1
    FutureUseNotes: "Future hook \u0434\u043B\u044F follow-up \u0441\u0446\u0435\u043D
      \u043E \u0441\u0430\u043C\u043E\u0439 \u043D\u0430\u0445\u043E\u0434\u043A\u0435
      \u043C\u0435\u0441\u0442\u0430."
  - FlagId: ROAD_WARM_SHEEP_MAN_FOUND
    DisplayName: "\u0427\u0435\u043B\u043E\u0432\u0435\u043A \u0443 \u043A\u043E\u0441\u0442\u0440\u0430
      \u043D\u0430\u0439\u0434\u0435\u043D"
    Description: "\u0413\u0435\u0440\u043E\u0439 \u043D\u0430\u0448\u0451\u043B \u0440\u0430\u043D\u0435\u043D\u043E\u0433\u043E
      \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430 \u0432 \u043D\u0438\u0437\u0438\u043D\u0435
      \u0437\u0430 \u0434\u043E\u0440\u043E\u0433\u043E\u0439."
    Category: road_warm_sheep
    Status: 1
    FutureUseNotes: "Future hook: \u044D\u0442\u043E\u0442 \u0447\u0435\u043B\u043E\u0432\u0435\u043A
      \u043C\u043E\u0436\u0435\u0442 \u0443\u043F\u043E\u043C\u0438\u043D\u0430\u0442\u044C\u0441\u044F
      \u0438\u043B\u0438 \u0432\u0441\u0442\u0440\u0435\u0442\u0438\u0442\u044C\u0441\u044F
