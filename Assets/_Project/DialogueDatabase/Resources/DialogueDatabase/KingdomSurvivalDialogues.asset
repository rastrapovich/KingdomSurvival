      \u0432\u0435\u0434\u0451\u0442 \u0441\u0446\u0435\u043D\u0443 \u043A\u0430\u043A
      \u0433\u043E\u043B\u043E\u0441 \u0431\u044B\u0442\u043E\u0432\u043E\u0439 \u0446\u0435\u043D\u044B
      (\u043D\u0435 \xAB\u0432\u0441\u0435 \u0432\u043C\u0435\u0441\u0442\u0435 \u0440\u0430\u0441\u0441\u043A\u0430\u0437\u044B\u0432\u0430\u044E\u0442\xBB).
      InvestigatedCattle \u0441\u0442\u0430\u0432\u0438\u0442\u0441\u044F \u043D\u0430
      \u043D\u0430\u0431\u043B\u044E\u0434\u0435\u043D\u0438\u0438 \u0437\u0430 \u043F\u043E\u0432\u0435\u0434\u0435\u043D\u0438\u0435\u043C
      \u0441\u043A\u043E\u0442\u0430, CattleAvoidOldBranch \u2014 \u043D\u0430 \u0444\u0438\u043D\u0430\u043B\u044C\u043D\u043E\u0439
      \u0440\u0435\u043F\u043B\u0438\u043A\u0435 \u0423\u043B\u044C\u044F\u043D\u044B."
