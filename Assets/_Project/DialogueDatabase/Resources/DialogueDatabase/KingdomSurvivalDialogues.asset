      - blockId: cave.cutter.start.empty
        kind: 5
        speakerIdOverride: 
        text: "\u0414\u0430\u043B\u044C\u043D\u0438\u0439 \u0437\u0430\u043B \u043F\u0443\u0441\u0442.
          \u041D\u0430 \u043F\u043B\u043E\u0441\u043A\u043E\u043C \u043A\u0430\u043C\u043D\u0435
          \u043E\u0441\u0442\u0430\u0432\u043B\u0435\u043D \u0431\u0440\u0443\u0441\u043E\u043A
          \u2014 \u0441\u0435\u0440\u044B\u0439, \u0440\u043E\u0432\u043D\u044B\u0439,
          \u0441 \u043E\u0434\u043D\u043E\u0433\u043E \u0431\u043E\u043A\u0430 \u043E\u0442\u043F\u043E\u043B\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u0439.
          \u0420\u044F\u0434\u043E\u043C \u0443\u0433\u043B\u0451\u043C \u043D\u0430\u0447\u0435\u0440\u0447\u0435\u043D\u044B
          \u0442\u0440\u0438 \u0437\u0430\u0440\u0443\u0431\u043A\u0438: \u043E\u0434\u043D\u0430,
          \u043F\u043E\u0442\u043E\u043C \u0434\u0432\u0435."
        conditions:
          Combinator: 0
          Conditions:
          - Type: 0
            StringParam: freeplay.cave.cutter_gone
