          CompetencyId: 
          Difficulty: 13
          ModifierRules: []
        onRevealEffects: []
      - blockId: cave.cutter.start.wall
        kind: 5
        speakerIdOverride: 
        text: "\u0421\u0442\u0435\u043D\u0443 \u0432 \u0433\u043B\u0443\u0431\u0438\u043D\u0435
          \u0437\u0430\u043B\u0430 \u043A\u043E\u0433\u0434\u0430-\u0442\u043E \u0432\u044B\u043B\u043E\u0436\u0438\u043B\u0438
          \u043A\u0430\u043C\u043D\u0435\u043C \u2014 \u043D\u0430 \u0441\u0443\u0445\u0443\u044E,
          \u0431\u0435\u0437 \u0433\u043B\u0438\u043D\u044B, \u043F\u043B\u043E\u0442\u043D\u0435\u0435,
          \u0447\u0435\u043C \u043A\u043B\u0430\u043B \u0431\u044B \u043F\u0435\u0447\u043D\u0438\u043A.
          \u041D\u0430 \u043A\u0440\u0430\u0439\u043D\u0435\u043C \u043A\u0430\u043C\u043D\u0435
          \u0432\u044B\u0431\u0438\u0442 \u0437\u043D\u0430\u043A: \u0434\u0432\u0430
          \u0443\u0433\u043B\u0430, \u0432\u043F\u0438\u0441\u0430\u043D\u043D\u044B\u0435
          \u043E\u0434\u0438\u043D \u0432 \u0434\u0440\u0443\u0433\u043E\u0439."
