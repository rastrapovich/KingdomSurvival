    nodes:
    - id: chapter01.node.05
      speakerId: narrator
      text: "Паводок сошёл, но плотина повреждена. Остафий настаивает на старом, проверенном ремонте всех семи затворов. Лада предлагает новое решение — перекрыть седьмое русло и стабилизировать поток через мельницу. Выбор — за героем."
      textBlocks: []
      choices:
      - text: "Восстановить старый порядок."
        nextNodeId: "chapter01.node.05.old"
