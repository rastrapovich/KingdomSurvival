        \u0441 7 \u043D\u043E\u0432\u044B\u043C\u0438 \u0433\u043E\u0432\u043E\u0440\u044F\u0449\u0438\u043C\u0438
        (\u041E\u0441\u0442\u0430\u0444\u0438\u0439/\u041B\u0430\u0434\u0430/\u041C\u0438\u0440\u043E\u043D/\u0423\u043B\u044C\u044F\u043D\u0430/\u0440\u0430\u0441\u0441\u043A\u0430\u0437\u0447\u0438\u043A/\u0447\u0435\u043B\u043E\u0432\u0435\u043A
        \u0441 \u043D\u0438\u0437\u043E\u0432\u044C\u044F/\u0441\u0432\u0438\u0434\u0435\u0442\u0435\u043B\u044C
        \u0443 \u0431\u0440\u043E\u0434\u0430 \u2014 \u0440\u0430\u0431\u043E\u0447\u0438\u0435
        \u0438\u043C\u0435\u043D\u0430 DEC-02/DEC-10). \u041A\u0430\u0436\u0434\u044B\u0439
        \u0443\u0437\u0435\u043B \u2014 \u043E\u0434\u0438\u043D textBlock \u0441
        onRevealEffects (SetFlag/AddKnowledge) \u0438 \u043E\u0434\u0438\u043D Exit-\u0432\u044B\u0431\u043E\u0440;
        branch-\u0434\u0438\u0430\u043B\u043E\u0433\u0438 N05 \u0438 N14\xBD \u2014
        \u0434\u0432\u0430 \u0434\u043E\u0447\u0435\u0440\u043D\u0438\u0445 \u0443\u0437\u043B\u0430
        \u0441 \u044D\u0444\u0444\u0435\u043A\u0442\u0430\u043C\u0438 \u043D\u0430
        \u043A\u043E\u043D\u043A\u0440\u0435\u0442\u043D\u0443\u044E \u0432\u0435\u0442\u043A\u0443.
        Effects \u043D\u0430 \u0441\u0430\u043C\u043E\u043C \u0432\u044B\u0431\u043E\u0440\u0435
        (successEffects), \u0430 \u043D\u0435 \u043D\u0430 textBlock, \u041D\u0415
        \u0441\u0440\u0430\u0431\u043E\u0442\u0430\u043B\u0438 \u0431\u044B \u0434\u043B\u044F
        Normal/Exit choice \u2014 \u0432 runtime \u043E\u043D\u0438 \u043F\u0440\u0438\u043C\u0435\u043D\u044F\u044E\u0442\u0441\u044F
        \u0442\u043E\u043B\u044C\u043A\u043E \u0434\u043B\u044F ActiveCheck choice
