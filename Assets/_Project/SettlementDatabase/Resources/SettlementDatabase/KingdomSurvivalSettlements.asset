      - Id: village.board
        Type: 5
        Label: "\u0421\u0442\u043E\u043B\u0431 \u0443 \u043A\u043E\u043B\u043E\u0434\u0446\u0430"
        Hint: "\u0417\u043D\u0430\u043A\u0438, \u0431\u0435\u0440\u0435\u0441\u0442\u0430
          \u0438 \u0442\u043E, \u0447\u0442\u043E \u043F\u0435\u0440\u0435\u0441\u043A\u0430\u0436\u0435\u0442
          \u0441\u0442\u0430\u0440\u043E\u0441\u0442\u0430."
