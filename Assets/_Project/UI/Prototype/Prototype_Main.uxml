<?xml version="1.0" encoding="utf-8"?>

<ui:UXML
    xmlns:ui="UnityEngine.UIElements"
    xmlns:uie="UnityEditor.UIElements"
    editor-extension-mode="False">

    <Style src="Prototype_Main.uss" />
    <Style src="Prototype_DebugAndGameOver.uss" />
    <Style src="Prototype_Exploration.uss" />

    <ui:VisualElement name="screen" class="screen">

        <ui:VisualElement class="top-bar">
            <ui:Label text="KINGDOM SURVIVAL" class="game-title" />

            <ui:VisualElement class="resource-strip">
                <ui:VisualElement class="resource-box">
                    <ui:Label name="day-label" text="День: 1" class="resource-value" />
                </ui:VisualElement>

                <ui:VisualElement class="resource-box">
                    <ui:Label name="gold-label" text="Золото: 120" class="resource-value" />
                    <ui:Label name="gold-income-label" text="+3" class="resource-income" />
                    <ui:VisualElement class="resource-test-controls">
                        <ui:Button name="gold-minus10-button" text="−10" class="resource-test-button" />
                        <ui:Button name="gold-plus10-button" text="+10" class="resource-test-button" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:VisualElement class="resource-box food-box">
                    <ui:Label name="food-label" text="Пища: 72" class="resource-value" />
                    <ui:Label name="food-income-label" text="+7" class="resource-income" />
                    <ui:VisualElement class="resource-test-controls">
                        <ui:Button name="food-minus10-button" text="−10" class="resource-test-button" />
                        <ui:Button name="food-plus10-button" text="+10" class="resource-test-button" />
                    </ui:VisualElement>

                    <ui:VisualElement class="food-expense-popup" style="top: 100%; margin-top: 2px;">
                        <ui:Label
                            name="food-consumption-label"
                            text="Расход: 24 в день"
                            class="food-expense-text" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:VisualElement class="resource-box">
                    <ui:Label name="population-label" text="Население: 24" class="resource-value" />
                    <ui:VisualElement class="resource-test-controls">
                        <ui:Button name="population-minus10-button" text="−10" class="resource-test-button" />
                        <ui:Button name="population-plus10-button" text="+10" class="resource-test-button" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:VisualElement class="resource-box">
                    <ui:Label name="mood-label" text="Настроение: 64/100" class="resource-value" />
                    <ui:VisualElement class="resource-test-controls">
                        <ui:Button name="mood-minus10-button" text="−10" class="resource-test-button" />
                        <ui:Button name="mood-plus10-button" text="+10" class="resource-test-button" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement class="navigation-bar">
            <ui:Button name="nav-capital-button" text="С" tooltip="Столица" class="nav-button" />
            <ui:Button name="nav-army-button" text="АЭ" tooltip="Армия / Экспедиции" class="nav-button" />
        </ui:VisualElement>

        <!-- Технические скрытые элементы сохранены только для совместимости
             с текущим контроллером. В навигации и на экране они не отображаются. -->
        <ui:Button name="nav-expeditions-button" text="" style="display: none;" />

        <ui:VisualElement name="main-screen-scroll" class="main-screen-scroll">

            <ui:VisualElement name="capital-screen" class="game-screen">
                <ui:VisualElement class="panel">
                    <ui:Label text="СТОЛИЦА" class="panel-title" />
                    <ui:Label text="Здания и основные городские действия" class="panel-description" />

                    <ui:VisualElement class="building-grid">
                        <ui:Button text="Тронный зал" class="building-card" />
                        <ui:Button text="Амбар" class="building-card" />
                        <ui:Button text="Казармы" class="building-card" />
                        <ui:Button text="Рынок" class="building-card" />
                        <ui:Button text="Шахта" class="building-card" />
                        <ui:Button text="Городские проекты" class="building-card" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement
                name="army-screen"
                class="game-screen military-split-screen"
                style="flex-direction: row; width: 100%; height: 100%; min-height: 0;">

                <ui:ScrollView
                    class="military-column-scroll military-army-column"
                    style="width: 50%; min-width: 0; height: 100%; flex-grow: 0; flex-shrink: 1;">
                    <ui:VisualElement class="panel army-panel military-panel-fill">
                        <ui:Label text="АРМИЯ" class="panel-title" />
                        <ui:Label text="Командир, бойцы и походные запасы единственной армии" class="panel-description" />

                        <ui:VisualElement class="commander-supply-row">
                            <ui:VisualElement class="commander-profile-column">
                                <ui:Label text="КОМАНДИР" class="section-title commander-section-title" />

                                <ui:VisualElement class="commander-image-placeholder">
                                    <ui:Label text="ИЗОБРАЖЕНИЕ КОМАНДИРА" class="commander-image-placeholder-text" />
                                </ui:VisualElement>

                                <ui:DropdownField name="commander-dropdown" label="Командир" class="commander-dropdown" />
                                <ui:Label name="commander-detail-label" text="Командир пока не выбран" class="commander-detail" />
                            </ui:VisualElement>

                            <ui:VisualElement class="supply-block military-supply-block">
                                <ui:Label text="ЗАПАСЫ ОТРЯДА" class="supply-title" />

                                <ui:Label text="ЗОЛОТО" class="supply-subtitle" />
                                <ui:VisualElement class="supply-controls">
                                    <ui:Button name="army-gold-minus-button" text="−" class="supply-step-button" />
                                    <ui:Label name="army-gold-label" text="0" class="supply-value" />
                                    <ui:Button name="army-gold-plus-button" text="+" class="supply-step-button" />
                                </ui:VisualElement>

                                <ui:Label text="СНАБЖЕНИЕ" class="supply-subtitle" />
                                <ui:VisualElement class="supply-controls">
                                    <ui:Button name="supply-minus-button" text="−" class="supply-step-button" />
                                    <ui:Label name="supply-value-label" text="0" class="supply-value" />
                                    <ui:Button name="supply-plus-button" text="+" class="supply-step-button" />
                                </ui:VisualElement>

                                <ui:Label
                                    name="supply-consumption-label"
                                    text="Расход в походе: 6 / день"
                                    class="supply-note" />

                                <ui:Label
                                    name="supply-days-label"
                                    text="Хватит на 0 дней"
                                    class="supply-note" />
                            </ui:VisualElement>
                        </ui:VisualElement>

                        <ui:Label name="army-status-label" text="Статус армии: в столице" class="status-label" />

                        <ui:VisualElement class="section-divider" />
                        <ui:Label text="ВОИНЫ — 5 ИЗ 6" class="section-title" />
                        <ui:Label text="Постоянные бойцы отряда" class="panel-description" />

                        <ui:ScrollView class="fighters-scroll" mode="Horizontal">
                            <ui:VisualElement name="fighters-list" class="fighters-list-horizontal" />
                        </ui:ScrollView>
                    </ui:VisualElement>
                </ui:ScrollView>

                <ui:VisualElement class="military-column-divider" />

                <ui:ScrollView
                    class="military-column-scroll military-expedition-column"
                    style="width: 50%; min-width: 0; height: 100%; flex-grow: 0; flex-shrink: 1;">
                    <ui:VisualElement class="panel expedition-panel military-panel-fill">
                        <ui:Label text="ЭКСПЕДИЦИИ" class="panel-title" />
                        <ui:Label name="expedition-status-label" text="Активная экспедиция: нет" class="status-label" />

                        <ui:VisualElement name="active-expedition-card" class="active-expedition-card">
                            <ui:Label name="active-expedition-title" text="АКТИВНАЯ ЭКСПЕДИЦИЯ" class="active-expedition-title" />
                            <ui:Label name="active-expedition-details" text="Данные экспедиции" class="active-expedition-details" />
                            <ui:Button name="research-expedition-button" text="ИССЛЕДОВАТЬ" class="research-expedition-button" />
                            <ui:Button name="return-expedition-button" text="Приказать возвращаться" class="return-expedition-button" />
                        </ui:VisualElement>

                        <ui:Label text="НАЙДЕННЫЕ ЛОКАЦИИ" class="section-title" />

                        <ui:VisualElement class="location-card">
                            <ui:Label text="Затопленные руины" class="location-name" />
                            <ui:VisualElement class="location-image-placeholder">
                                <ui:Label text="ИЗОБРАЖЕНИЕ ЛОКАЦИИ" class="location-image-placeholder-text" />
                            </ui:VisualElement>
                            <ui:VisualElement class="location-info-row">
                                <ui:Label text="Расстояние: 2 дня" class="location-info" />
                                <ui:Label text="Угроза: низкая" class="threat-low" />
                            </ui:VisualElement>
                            <ui:Button name="send-ruins-button" text="Отправить" class="send-button" />
                        </ui:VisualElement>

                        <ui:VisualElement class="location-card">
                            <ui:Label text="Старая шахта" class="location-name" />
                            <ui:VisualElement class="location-image-placeholder">
                                <ui:Label text="ИЗОБРАЖЕНИЕ ЛОКАЦИИ" class="location-image-placeholder-text" />
                            </ui:VisualElement>
                            <ui:VisualElement class="location-info-row">
                                <ui:Label text="Расстояние: 3 дня" class="location-info" />
                                <ui:Label text="Угроза: средняя" class="threat-medium" />
                            </ui:VisualElement>
                            <ui:Button name="send-mine-button" text="Отправить" class="send-button" />
                        </ui:VisualElement>

                        <ui:VisualElement class="location-card">
                            <ui:Label text="Чёрный лес" class="location-name" />
                            <ui:VisualElement class="location-image-placeholder">
                                <ui:Label text="ИЗОБРАЖЕНИЕ ЛОКАЦИИ" class="location-image-placeholder-text" />
                            </ui:VisualElement>
                            <ui:VisualElement class="location-info-row">
                                <ui:Label text="Расстояние: 5 дней" class="location-info" />
                                <ui:Label text="Угроза: высокая" class="threat-high" />
                            </ui:VisualElement>
                            <ui:Button name="send-forest-button" text="Отправить" class="send-button" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:ScrollView>
            </ui:VisualElement>

            <ui:VisualElement name="expeditions-screen" class="game-screen" style="display: none;" />

        </ui:VisualElement>

        <ui:VisualElement class="reports-dock">
            <ui:VisualElement class="panel reports-panel">
                <ui:Label text="КОРОЛЕВСКИЕ ДОНЕСЕНИЯ" class="panel-title" />
                <ui:ScrollView name="report-history-scroll" class="report-history-scroll">
                    <ui:Label name="report-history-label" text="Донесений пока нет." class="report-text" />
                </ui:ScrollView>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement
            name="incident-notification-stack"
            class="incident-notification-stack" />

        <ui:Button name="end-day-button" text="ДЕНЬ" tooltip="Завершить день" class="end-day-button" />

        <ui:VisualElement
            name="incident-modal-overlay"
            class="incident-modal-overlay">

            <ui:VisualElement class="incident-modal-window">
                <ui:Label
                    name="incident-modal-title"
                    text="ПРОИСШЕСТВИЕ"
                    class="incident-modal-title" />

                <ui:VisualElement class="incident-modal-body">
                    <ui:VisualElement class="incident-image-placeholder">
                        <ui:Label text="ИЗОБРАЖЕНИЕ" class="incident-image-placeholder-text" />
                    </ui:VisualElement>

                    <ui:VisualElement class="incident-modal-text-column">
                        <ui:Label
                            name="incident-modal-description"
                            text="Описание происшествия"
                            class="incident-modal-description" />

                        <ui:Label
                            name="incident-modal-consequence"
                            text="Последствие"
                            class="incident-modal-consequence" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:Button
                    name="incident-understood-button"
                    text="ПОНЯТНО"
                    class="incident-understood-button" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="game-over-overlay" class="game-over-overlay">
            <ui:VisualElement class="game-over-window">
                <ui:Label text="ВАС СВЕРГЛИ" class="game-over-title" />
                <ui:Label
                    text="Подданные наконец достигли редкого политического согласия: король им больше не нужен."
                    class="game-over-description" />
                <ui:Label
                    name="game-over-days-label"
                    text="Вы удерживали трон: 0 дней"
                    class="game-over-days" />
                <ui:Button
                    name="restart-game-button"
                    text="НАЧАТЬ ЗАНОВО"
                    class="game-over-restart-button" />
            </ui:VisualElement>
        </ui:VisualElement>

    </ui:VisualElement>

</ui:UXML>
