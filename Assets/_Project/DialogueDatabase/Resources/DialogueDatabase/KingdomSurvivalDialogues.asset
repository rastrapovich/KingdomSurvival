        text: "\u0418\u0437 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0445 \u0441\u0438\u043B \u0442\u044B \u0443\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0435\u0448\u044C \u043C\u0435\u0445\u0430\u043D\u0438\u0437\u043C \u2014 \u0438\u0441\u0446\u0430\u0440\u0430\u043F\u0430\u043D\u043D\u044B\u0435 \u0440\u0443\u043A\u0438 \u0435\u0434\u0432\u0430 \u0441\u043B\u0443\u0448\u0430\u044E\u0442\u0441\u044F, \u043D\u043E \u0441\u0442\u0432\u043E\u0440 \u0438 \u043D\u0430\u0441\u0442\u0438\u043B \u0434\u0435\u0440\u0436\u0430\u0442\u0441\u044F. \u041A \u043B\u044E\u0434\u044F\u043C \u0438 \u0441\u043A\u043E\u0442\u0438\u043D\u0435 \u043F\u0440\u043E\u0431\u0438\u0442\u044C\u0441\u044F \u0442\u044B \u0443\u0436\u0435 \u043D\u0435 \u043C\u043E\u0436\u0435\u0448\u044C: \u0432\u043E\u0434\u0430 \u043E\u0442\u0440\u0435\u0437\u0430\u043B\u0430 \u043E\u0431\u0430 \u043F\u0443\u0442\u0438. \u041A\u0440\u0438\u043A\u0438 \u0443 \u043C\u0435\u043B\u044C\u043D\u0438\u0446\u044B \u0438 \u0440\u0451\u0432 \u0441\u043A\u043E\u0442\u0438\u043D\u044B \u0432\u0434\u0430\u043B\u0435\u043A\u0435 \u0441\u043B\u0438\u0432\u0430\u044E\u0442\u0441\u044F \u0432 \u043E\u0434\u0438\u043D \u0448\u0443\u043C, \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u0442\u044B \u043D\u0435 \u0432 \u0441\u0438\u043B\u0430\u0445 \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C."
        conditions:
          Combinator: 0
          Conditions: []
        hasPassiveCheck: 0
        passiveCheck:
          CheckId:
          Kind: 0
          Quality: 0
          CompetencyId:
          Difficulty: 13
          ModifierRules: []
        onRevealEffects:
        - EffectExecutionId: chapter01.effect.n04_failure_mill_livestock_lost
          Type: 0
          StringParam: chapter01.flag.flood_livestock_lost
          IntParam: 0
        - EffectExecutionId: chapter01.effect.n04_failure_mill_hero_injured
          Type: 0
          StringParam: chapter01.flag.hero_injured_by_flood
          IntParam: 0
        - EffectExecutionId: chapter01.effect.n04_failure_mill_flood_happened
          Type: 0
