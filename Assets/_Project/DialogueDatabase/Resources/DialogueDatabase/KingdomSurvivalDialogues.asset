    - id: chapter01.node.03_pass
      speakerId: narrator
      text: 
      textBlocks:
      - blockId: chapter01.node.03_pass_main
        kind: 5
        speakerIdOverride: 
        text: "\u0414\u0435\u043B\u0430 \u043D\u0435 \u0436\u0434\u0443\u0442 \u2014
          \u0430 \u043F\u0430\u0432\u043E\u0434\u043E\u043A, \u0441\u043B\u0443\u0447\u0438\u0441\u044C
          \u043E\u043D, \u0431\u0443\u0434\u0435\u0442 \u0436\u0434\u0430\u0442\u044C
          \u0435\u0449\u0451 \u043C\u0435\u043D\u044C\u0448\u0435. \u0422\u044B \u0438\u0434\u0451\u0448\u044C
          \u0434\u0430\u043B\u044C\u0448\u0435, \u043E\u0441\u0442\u0430\u0432\u043B\u044F\u044F
          \u0441\u0442\u0440\u0430\u043D\u043D\u043E\u0441\u0442\u044C \u043D\u0430
          \u043F\u043E\u0442\u043E\u043C."
