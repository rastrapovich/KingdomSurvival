        failureEffects: []
      editorPosition: {x: 460, y: 0}
      hasEditorPosition: 1
    - id: chapter01.node.09.ulyana
      speakerId: ulyana
      text: 
      textBlocks:
      - blockId: chapter01.node.09.ulyana_main
        kind: 0
        speakerIdOverride: 
        text: "— И скот тоже? Он к мельнице отношения не имеет."
        conditions:
          Combinator: 0
          Conditions: []
        hasPassiveCheck: 0
        passiveCheck:
          CheckId: 
          Kind: 0
          Quality: 0
          CompetencyId: 
          Difficulty: 13
          ModifierRules: []
        onRevealEffects: []
      choices:
      - text: "…"
        nextNodeId: chapter01.node.09.lada
