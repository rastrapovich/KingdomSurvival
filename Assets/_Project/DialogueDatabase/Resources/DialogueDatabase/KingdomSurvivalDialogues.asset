          Kind: 0
          Quality: 0
          CompetencyId: 
          Difficulty: 13
          ModifierRules: []
        successNodeId: 
        failureNodeId: 
        successEffects: []
        failureEffects: []
      - text: "\u0417\u0430\u043A\u0440\u044B\u0442\u044C \u0442\u0435\u0445\u043D\u0438\u0447\u0435\u0441\u043A\u0438\u0439
          \u0440\u0430\u0437\u0433\u043E\u0432\u043E\u0440."
        nextNodeId: 
        endsDialogue: 1
        choiceId: opening_exit
        kind: 3
