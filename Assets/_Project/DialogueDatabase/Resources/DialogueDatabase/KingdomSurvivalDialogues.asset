        text: "\u041F\u043B\u043E\u0442\u0438\u043D\u0430 \u0441\u043D\u043E\u0432\u0430
          \u0434\u0435\u0440\u0436\u0438\u0442 \u0432\u043E\u0434\u0443. \u041F\u0440\u043E\u0431\u0438\u0442\u044B\u0435
          \u043C\u0435\u0441\u0442\u0430 \u0437\u0430\u043A\u0440\u044B\u0442\u044B,
          \u0441\u0432\u0435\u0436\u0438\u0435 \u043A\u043B\u0438\u043D\u044C\u044F
          \u0440\u0430\u0437\u0431\u0443\u0445\u043B\u0438 \u0432 \u043F\u0430\u0437\u0430\u0445,
