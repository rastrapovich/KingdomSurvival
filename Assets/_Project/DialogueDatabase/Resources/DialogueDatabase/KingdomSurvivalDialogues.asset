    - id: chapter01.node.04.dexterity_failure
      speakerId: narrator
      text: 
      textBlocks:
      - blockId: chapter01.node.04.dexterity_failure_main
        kind: 0
        speakerIdOverride: 
        text: "\u041D\u043E\u0433\u0430 \u0441\u043E\u0441\u043A\u0430\u043B\u044C\u0437\u044B\u0432\u0430\u0435\u0442
          \u0441 \u043C\u043E\u043A\u0440\u043E\u0433\u043E \u0434\u0435\u0440\u0435\u0432\u0430.
          \u0411\u0430\u043B\u043A\u0430 \u0443\u0445\u043E\u0434\u0438\u0442 \u0438\u0437-\u043F\u043E\u0434
          \u0442\u0435\u0431\u044F, \u0438 \u0442\u0435\u0447\u0435\u043D\u0438\u0435
          \u0443\u0442\u0430\u0441\u043A\u0438\u0432\u0430\u0435\u0442 \u0442\u0435\u0431\u044F
          \u0432 \u0441\u0442\u043E\u0440\u043E\u043D\u0443, \u043F\u0440\u0435\u0436\u0434\u0435
          \u0447\u0435\u043C \u0442\u044B \u0443\u0441\u043F\u0435\u0432\u0430\u0435\u0448\u044C
          \u0443\u0445\u0432\u0430\u0442\u0438\u0442\u044C\u0441\u044F \u0437\u0430
          \u0447\u0442\u043E-\u0442\u043E \u043D\u0430\u0434\u0451\u0436\u043D\u043E\u0435.
          \u041F\u043E\u043A\u0430 \u0442\u044B \u0432\u044B\u0431\u0438\u0440\u0430\u0435\u0448\u044C\u0441\u044F
          \u043D\u0430 \u0431\u0435\u0440\u0435\u0433, \u0432\u0440\u0435\u043C\u044F
          \u0443\u0436\u0435 \u043F\u043E\u0442\u0435\u0440\u044F\u043D\u043E."
        conditions:
          Combinator: 0
          Conditions: []
        hasPassiveCheck: 0
        passiveCheck:
          CheckId: 
          Kind: 0
          Quality: 0
          CompetencyId: 
          Difficulty: 13
          ModifierRules: []
        onRevealEffects: []
      choices:
      - text: "\u041F\u043E\u0434\u043D\u044F\u0442\u044C\u0441\u044F \u0438 \u0440\u0435\u0448\u0438\u0442\u044C,
          \u0447\u0442\u043E \u0434\u0435\u043B\u0430\u0442\u044C \u0442\u0435\u043F\u0435\u0440\u044C."
