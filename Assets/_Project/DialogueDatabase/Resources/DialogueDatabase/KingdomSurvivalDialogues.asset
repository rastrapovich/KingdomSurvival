    - id: chapter01.node.04.success_mill
      speakerId: narrator
      text: 
      textBlocks:
      - blockId: chapter01.node.04.success_mill_main
        kind: 0
        speakerIdOverride: 
        text: "\u0422\u044B \u0434\u0435\u0440\u0436\u0438\u0448\u044C \u043C\u0435\u0445\u0430\u043D\u0438\u0437\u043C
          \u0438 \u043D\u0430\u0441\u0442\u0438\u043B, \u043F\u043E\u043A\u0430 \u0446\u0435\u043B\u0430
          \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u044F\u044F \u043E\u043F\u043E\u0440\u0430
          \u2014 \u0434\u0435\u0440\u0435\u0432\u043E \u0442\u0440\u0435\u0449\u0438\u0442,
          \u043D\u043E \u0432\u044B\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0435\u0442.
          \u041C\u0438\u0440\u043E\u043D \u0443\u0436\u0435 \u0433\u043E\u043D\u0438\u0442
          \u043F\u0435\u0440\u0435\u043F\u0443\u0433\u0430\u043D\u043D\u044B\u0439
          \u0441\u043A\u043E\u0442 \u043F\u0440\u043E\u0447\u044C \u043E\u0442 \u0431\u0435\u0440\u0435\u0433\u0430,
          \u0438 \u0442\u043E\u0442, \u0445\u043E\u0442\u044C \u0438 \u043C\u0435\u0447\u0435\u0442\u0441\u044F,
          \u043E\u0441\u0442\u0430\u0451\u0442\u0441\u044F \u0446\u0435\u043B. \u041E\u0442
          \u043C\u0435\u043B\u044C\u043D\u0438\u0446\u044B, \u0433\u0434\u0435 \u0431\u044B\u043B\u0438
          \u0440\u0430\u0431\u043E\u0442\u043D\u0438\u043A\u0438, \u0441\u043A\u0432\u043E\u0437\u044C
          \u0448\u0443\u043C \u0432\u043E\u0434\u044B \u0434\u043E\u043D\u043E\u0441\u044F\u0442\u0441\u044F
          \u043A\u0440\u0438\u043A\u0438 \u2014 \u043D\u043E \u0434\u043E\u0431\u0440\u0430\u0442\u044C\u0441\u044F
          \u0434\u043E \u043D\u0438\u0445 \u0442\u044B \u0443\u0436\u0435 \u043D\u0435
          \u0443\u0441\u043F\u0435\u0432\u0430\u0435\u0448\u044C. \u0427\u0442\u043E
          \u0441 \u043D\u0438\u043C\u0438, \u0441\u0442\u0430\u043D\u0435\u0442 \u044F\u0441\u043D\u043E
          \u043D\u0435 \u0441\u0435\u0439\u0447\u0430\u0441."
