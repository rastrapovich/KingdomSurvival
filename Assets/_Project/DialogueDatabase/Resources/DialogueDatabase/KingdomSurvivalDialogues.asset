      - blockId: chapter01.node.07a.water_push_main
        kind: 0
        speakerIdOverride: 
        text: "\u0427\u0435\u0440\u0435\u0437 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E
