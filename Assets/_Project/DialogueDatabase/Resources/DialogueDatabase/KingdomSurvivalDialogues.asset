  - id: freeplay_mine_local_dumps
    title: "\u0418-2 \u2014 \u041E\u0442\u0432\u0430\u043B\u044B (\u0448\u0430\u0445\u0442\u0430
      \u043D\u0430 \u043B\u043E\u043A\u0430\u043B\u044C\u043D\u043E\u0439 \u043A\u0430\u0440\u0442\u0435)"
    category: 2
    status: 1
    developerComment: "\u041F\u0420-12\u041A, \u043F\u0438\u043B\u043E\u0442 \u0421\u0442\u0430\u0440\u043E\u0439
      \u0448\u0430\u0445\u0442\u044B [\u0420\u0410\u0411\u041E\u0427\u0415\u0415][KINGDOM
      SURVIVAL]. \u041E\u0431\u044A\u0435\u043A\u0442 \xAB\u041E\u0442\u0432\u0430\u043B\u044B\xBB
      \u043B\u043E\u043A\u0430\u043B\u044C\u043D\u043E\u0439 \u043A\u0430\u0440\u0442\u044B.
      \u0422\u0435\u043A\u0441\u0442 \u0438 \u043F\u0440\u043E\u0432\u0435\u0440\u043A\u0430
      \u2014 \u0438\u0437 \u043F\u0440\u0435\u0436\u043D\u0435\u0433\u043E \u043F\u0435\u0440\u0432\u043E\u0433\u043E
      \u0432\u0445\u043E\u0434\u0430 (freeplay_mine_entry): \u0440\u0435\u0448\u0430\u044E\u0449\u0430\u044F
      \u041D\u0430\u0431\u043B\u044E\u0434\u0430\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u044C
      (\u0427\u0443\u0442\u044C\u0451, 13), \u0442\u043E\u0442 \u0436\u0435 CheckId.
      \u0423\u0441\u043F\u0435\u0445 \u2014 \u0436\u0435\u043B\u0435\u0437\u043E
      (freeplay.mine.iron_dumps). \u0421\u0446\u0435\u043D\u0430 \u0441\u0442\u0430\u0432\u0438\u0442
      freeplay.mine.entered; \u043E\u0434\u0438\u043D \u0440\u0430\u0437."
    sceneIllustration: {fileID: 0}
    sceneIllustrationFillFrame: 0
    sceneIllustrationScale: 1
    sceneIllustrationOffsetNormalized: {x: 0, y: 0}
    startNodeId: freeplay.mine.local.dumps.start
    tags:
    - "\u0441\u0432\u043E\u0431\u043E\u0434\u043D\u0430\u044F_\u0438\u0433\u0440\u0430"
    - "\u0418-2"
    - "\u041F\u0420-12\u041A"
    nodes:
    - id: freeplay.mine.local.dumps.start
      speakerId: narrator
      text: 
      textBlocks:
      - blockId: freeplay.mine.local.dumps.start.scene
        kind: 5
        speakerIdOverride: 
        text: "\u0428\u0442\u043E\u043B\u044C\u043D\u0438 \u0441\u0443\u0445\u0438\u0435,
          \u043A\u0430\u043A \u0438 \u0433\u043E\u0432\u043E\u0440\u0438\u043B\u0438.
          \u041E\u0442\u0432\u0430\u043B\u044B \u0437\u0430\u0440\u043E\u0441\u043B\u0438
          \u0438\u0432\u0430\u043D-\u0447\u0430\u0435\u043C, \u0438 \u0438\u0437
          \u043D\u0438\u0445 \u0442\u043E\u0440\u0447\u0438\u0442 \u0436\u0435\u043B\u0435\u0437\u043E:
          \u0433\u0434\u0435 \u0441\u043A\u043E\u0431\u0430, \u0433\u0434\u0435 \u043E\u0431\u0443\u0445,
          \u0433\u0434\u0435 \u0447\u0442\u043E-\u0442\u043E, \u0447\u0435\u043C\u0443
          \u0443\u0436\u0435 \u043D\u0435\u0442 \u0438\u043C\u0435\u043D\u0438."
