              "IntParam": 8
            },
            {
              "EffectExecutionId": "settlement.milana.paid.xp",
              "Type": 12,
              "IntParam": 8
            }
          ]
        }
      ],
      "choices": [
        {
          "choiceId": "settlement.milana.paid.bye",
          "text": "Доброго дня.",
          "kind": 3,
          "endsDialogue": true
        }
      ]
    }
  ]
}
