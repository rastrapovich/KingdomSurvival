      Tavern:
        Enabled: 1
        Id: village.inn
        Name: "\u0418\u0437\u0431\u0430 \u0443 \u0434\u043E\u0440\u043E\u0433\u0438"
        Description: "\u041D\u0438\u0437\u043A\u0430\u044F \u0438\u0437\u0431\u0430
          \u0441 \u043F\u0435\u0447\u044C\u044E \u043F\u043E-\u0447\u0451\u0440\u043D\u043E\u043C\u0443.
          \u0414\u044B\u043C \u0443\u0445\u043E\u0434\u0438\u0442 \u0432 \u0432\u043E\u043B\u043E\u043A\u043E\u0432\u043E\u0435
          \u043E\u043A\u043E\u0448\u043A\u043E, \u0442\u0435\u043F\u043B\u043E \u043E\u0441\u0442\u0430\u0451\u0442\u0441\u044F.
          \u041D\u0430 \u043B\u0430\u0432\u043A\u0430\u0445 \u2014 \u0434\u0432\u043E\u0435
          \u0432\u043E\u0437\u0447\u0438\u043A\u043E\u0432 \u0438 \u0447\u044C\u044F-\u0442\u043E
          \u043A\u043E\u0437\u0430."
        Keeper:
          Id: village_hostess
          SpeakerId: village_hostess
          DisplayName: "\u041C\u043E\u043A\u0440\u0438\u043D\u0430"
          Role: "\u0445\u043E\u0437\u044F\u0439\u043A\u0430"
          Activity: "\u041C\u0435\u0448\u0430\u0435\u0442 \u0449\u0438 \u0432 \u0433\u043E\u0440\u0448\u043A\u0435"
          DialogueId: settlement_village_hostess
          MerchantId: village.shop
          Conditions:
            Combinator: 0
            Conditions: []
        Visitors: []
        Offers: []
        Lodging:
          Enabled: 1
          Price: 3
          Hours: 8
          HealHitPoints: 2
          Description: "\u041B\u0430\u0432\u043A\u0430 \u0443 \u0442\u0451\u043F\u043B\u043E\u0439
            \u0441\u0442\u0435\u043D\u044B, \u0449\u0438 \u0438 \u0445\u043B\u0435\u0431.
            \u0423\u0442\u0440\u043E\u043C \u041C\u043E\u043A\u0440\u0438\u043D\u0430
            \u0431\u0443\u0434\u0438\u0442 \u0432\u0441\u0435\u0445 \u043E\u0434\u043D\u0438\u043C
            \u0441\u043B\u043E\u0432\u043E\u043C."
      Board:
        Enabled: 1
        Name: "\u0421\u0442\u043E\u043B\u0431 \u0443 \u043A\u043E\u043B\u043E\u0434\u0446\u0430"
        Description: "\u041D\u0430 \u0441\u0442\u043E\u043B\u0431\u0435 \u0443 \u043A\u043E\u043B\u043E\u0434\u0446\u0430
          \u2014 \u0437\u0430\u0440\u0443\u0431\u043A\u0438, \u043B\u043E\u0441\u043A\u0443\u0442\u044B
          \u0431\u0435\u0440\u0435\u0441\u0442\u044B \u043D\u0430 \u0433\u0432\u043E\u0437\u0434\u044F\u0445
          \u0438 \u043F\u0443\u0447\u043E\u043A \u043F\u0435\u0440\u044C\u0435\u0432
          \u043D\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043D\u043E\u0433\u043E
          \u043D\u0430\u0437\u043D\u0430\u0447\u0435\u043D\u0438\u044F."
        ReaderNote: "\u0427\u0438\u0442\u0430\u0442\u044C \u0443\u043C\u0435\u0435\u0442
          \u0442\u043E\u043B\u044C\u043A\u043E \u0412\u044B\u0448\u0430\u0442\u0430
          \u2014 \u043E\u043D \u0438 \u043F\u0435\u0440\u0435\u0441\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442,
          \u043D\u0435 \u0442\u043E\u0440\u043E\u043F\u044F\u0441\u044C."
        Notices:
        - Id: notice.village.ford
          Title: "\u0417\u043D\u0430\u043A \u0443 \u0431\u0440\u043E\u0434\u0430"
          Text: "\u0423 \u0441\u0442\u043E\u043B\u0431\u0430 \u0432\u043E\u0442\u043A\u043D\u0443\u0442\u0430
            \u043F\u0430\u043B\u043A\u0430 \u0441 \u0442\u0440\u044F\u043F\u0438\u0446\u0435\u0439,
            \u0432\u044B\u043C\u043E\u0447\u0435\u043D\u043D\u043E\u0439 \u0432 \u0433\u0440\u044F\u0437\u0438
            \u043F\u043E \u0441\u0430\u043C\u0443\u044E \u0432\u0435\u0440\u0445\u0443\u0448\u043A\u0443.
            \u0412\u044B\u0448\u0430\u0442\u0430 \u043F\u043E\u044F\u0441\u043D\u044F\u0435\u0442:
            \u0442\u0430\u043A \u0437\u0434\u0435\u0441\u044C \u043F\u043E\u043C\u0435\u0447\u0430\u044E\u0442
            \u0431\u0440\u043E\u0434, \u0433\u0434\u0435 \u0442\u0435\u043B\u0435\u0433\u0438
            \u0441\u0430\u0434\u044F\u0442\u0441\u044F. \u0427\u0435\u0440\u0435\u0437
            \u0441\u0442\u0430\u0440\u043E\u0435 \u0440\u0443\u0441\u043B\u043E \u043F\u043E\u0441\u043B\u0435
            \u0434\u043E\u0436\u0434\u044F \u2014 \u043E\u0431\u044A\u0435\u0437\u0436\u0430\u0442\u044C
            \u0432\u044B\u0448\u0435, \u043F\u043E \u043A\u0430\u043C\u043D\u044F\u043C."
          Type: 2
          Medium: 2
          AuthorName: "\u0441\u0442\u0430\u0440\u043E\u0441\u0442\u0430 \u0412\u044B\u0448\u0430\u0442\u0430"
          ContactName: "\u0441\u0442\u0430\u0440\u043E\u0441\u0442\u0430 \u0412\u044B\u0448\u0430\u0442\u0430"
          ContactPersonId: village_elder
          ErrandId: 
          DialogueId: 
          KnowledgeId: settlement.knowledge.ford_mud
          KnowledgeText: "\u0411\u0440\u043E\u0434 \u0447\u0435\u0440\u0435\u0437
            \u0441\u0442\u0430\u0440\u043E\u0435 \u0440\u0443\u0441\u043B\u043E \u043F\u043E\u0441\u043B\u0435
            \u0434\u043E\u0436\u0434\u044F \u0432\u044F\u0437\u043A\u0438\u0439:
            \u0442\u0435\u043B\u0435\u0433\u0438 \u043E\u0431\u044A\u0435\u0437\u0436\u0430\u044E\u0442
            \u0432\u044B\u0448\u0435, \u043F\u043E \u043A\u0430\u043C\u043D\u044F\u043C."
          LocationId: 
          MerchantId: 
          ShowConditions:
            Combinator: 0
            Conditions: []
          HideConditions:
            Combinator: 0
            Conditions: []
          LifetimeHours: 0
          RepostAfterHours: 0
          RewardText: 
        - Id: notice.village.wolf
          Title: "\u0412\u043E\u043B\u043A \u0443 \u0434\u043E\u0440\u043E\u0433\u0438"
          Text: "\u041D\u0430 \u0431\u0435\u0440\u0435\u0441\u0442\u0435 \u043D\u0430\u0446\u0430\u0440\u0430\u043F\u0430\u043D
            \u0432\u043E\u043B\u043A \u0438 \u0442\u0440\u0438 \u043E\u0432\u0446\u044B,
            \u0434\u0432\u0435 \u0438\u0437 \u043D\u0438\u0445 \u043F\u0435\u0440\u0435\u0447\u0451\u0440\u043A\u043D\u0443\u0442\u044B.
            \u041F\u0430\u0441\u0442\u0443\u0445 \u043F\u0440\u043E\u0441\u0438\u0442:
            \u043F\u043E \u0442\u0435\u043C\u043D\u043E\u0442\u0435 \u043A \u043B\u0435\u0441\u0443
            \u0441\u043A\u043E\u0442 \u043D\u0435 \u0433\u043E\u043D\u044F\u0442\u044C
            \u0438 \u0434\u0435\u0442\u0435\u0439 \u043D\u0435 \u043F\u0443\u0441\u043A\u0430\u0442\u044C."
          Type: 2
          Medium: 0
          AuthorName: "\u043F\u0430\u0441\u0442\u0443\u0445"
          ContactName: 
          ContactPersonId: 
          ErrandId: 
          DialogueId: 
          KnowledgeId: settlement.knowledge.wolf_road
          KnowledgeText: "\u0423 \u043B\u0435\u0441\u043D\u043E\u0439 \u0434\u043E\u0440\u043E\u0433\u0438
            \u0445\u043E\u0434\u0438\u0442 \u0441\u0442\u0430\u0440\u044B\u0439 \u0432\u043E\u043B\u043A:
            \u0440\u0435\u0436\u0435\u0442 \u043E\u0432\u0435\u0446 \u0438 \u043D\u0435
            \u0431\u043E\u0438\u0442\u0441\u044F \u043E\u0433\u043D\u044F."
          LocationId: 
          MerchantId: 
          ShowConditions:
            Combinator: 0
            Conditions: []
          HideConditions:
