        kind: 0
        speakerIdOverride: 
        text: "\u041E\u0441\u0442\u0430\u0444\u0438\u0439 \u043F\u043E\u0441\u0442\u0443\u043A\u0438\u0432\u0430\u0435\u0442
          \u0448\u0435\u0441\u0442\u043E\u043C \u043F\u043E \u043F\u0435\u0440\u0432\u043E\u043C\u0443
          \u0437\u0430\u0442\u0432\u043E\u0440\u0443, \u043F\u043E\u0442\u043E\u043C
          \u043F\u043E \u0432\u0442\u043E\u0440\u043E\u043C\u0443 \u0438 \u0442\u0430\u043A
          \u0434\u043E \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0435\u0433\u043E.
