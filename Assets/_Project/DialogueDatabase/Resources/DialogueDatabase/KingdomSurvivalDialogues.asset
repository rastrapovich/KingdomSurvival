        speakerIdOverride:
        text: "\u041E\u043D\u0430 \u0447\u0443\u0442\u044C \u043C\u0435\u043D\u044F\u0435\u0442\u0441\u044F \u0432 \u043B\u0438\u0446\u0435. \u2014 \u041F\u0440\u043E \u0441\u0435\u0434\u044C\u043C\u043E\u0439 \u0440\u0443\u043A\u0430\u0432 \u043C\u0430\u043B\u043E \u043A\u0442\u043E
