    - id: check_conditions
      speakerId: miller
      text: "\u0414\u043E \u043F\u0435\u0440\u0432\u043E\u0439 \u043F\u043E\u043F\u044B\u0442\u043A\u0438
        \u0434\u043E\u0441\u0442\u0443\u043F\u043D\u043E \u0443\u0441\u043B\u043E\u0432\u0438\u0435
        \xAB\u041F\u0440\u043E\u0432\u0435\u0440\u043A\u0430 \u0435\u0449\u0451 \u043D\u0435
        \u0432\u044B\u043F\u043E\u043B\u043D\u044F\u043B\u0430\u0441\u044C\xBB. \u0412\u044B\u043F\u043E\u043B\u043D\u0438
        \u0432\u043E\u0437\u0432\u0440\u0430\u0442\u043D\u0443\u044E \u043F\u0440\u043E\u0432\u0435\u0440\u043A\u0443
        \u043D\u0438\u0436\u0435. \u041F\u043E\u0441\u043B\u0435 \u043D\u0435\u0451
        \u0441\u0442\u0430\u043D\u0435\u0442 \u0434\u043E\u0441\u0442\u0443\u043F\u0435\u043D
        \u043B\u0438\u0431\u043E \xAB\u0443\u0441\u043F\u0435\u0445\xBB, \u043B\u0438\u0431\u043E
        \xAB\u043F\u0440\u043E\u0432\u0430\u043B\xBB. \u0412 Preview \u043C\u043E\u0436\u043D\u043E
        \u043F\u0440\u0438\u043D\u0443\u0434\u0438\u0442\u0435\u043B\u044C\u043D\u043E
        \u0432\u044B\u0431\u0440\u0430\u0442\u044C \u0438\u0441\u0445\u043E\u0434."
