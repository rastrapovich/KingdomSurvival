    - id: chapter01.node.01_mill
      speakerId: narrator
      text: 
      textBlocks:
      - blockId: chapter01.node.01_mill_main
        kind: 5
        speakerIdOverride: 
        text: "\u0423 \u043C\u0435\u043B\u044C\u043D\u0438\u0446\u044B \u0443\u0436\u0435
          \u0448\u0443\u043C\u0438\u0442 \u043A\u043E\u043B\u0435\u0441\u043E \u2014
          \u0440\u043E\u0432\u043D\u043E, \u043A\u0430\u043A \u043A\u0430\u0436\u0434\u043E\u0435
          \u0443\u0442\u0440\u043E. \u041C\u0438\u0440\u043E\u043D \u0441\u0442\u043E\u0438\u0442
          \u0432 \u0434\u0432\u0435\u0440\u044F\u0445, \u043E\u0442\u0440\u044F\u0445\u0438\u0432\u0430\u0435\u0442
          \u043C\u0443\u0447\u043D\u0443\u044E \u043F\u044B\u043B\u044C \u0441 \u0440\u0443\u043A\u0430\u0432\u0430
          \u0438 \u043C\u043E\u043B\u0447\u0430 \u043A\u0438\u0432\u0430\u0435\u0442
          \u043F\u0440\u043E\u0445\u043E\u0434\u044F\u0449\u0435\u043C\u0443 \u0433\u0435\u0440\u043E\u044E:
          \u0435\u043C\u0443 \u0441\u0435\u0439\u0447\u0430\u0441 \u043D\u0435 \u0434\u043E
          \u0440\u0430\u0437\u0433\u043E\u0432\u043E\u0440\u043E\u0432, \u043C\u0435\u0448\u043E\u043A
          \u0436\u0434\u0451\u0442."
        conditions:
          Combinator: 0
          Conditions: []
        hasPassiveCheck: 0
        passiveCheck:
          CheckId: 
          Kind: 0
          Quality: 0
          CompetencyId: 
          Difficulty: 13
          ModifierRules: []
        onRevealEffects: []
      - blockId: chapter01.node.01_mill_water
        kind: 1
        speakerIdOverride: 
        text: "\u0423 \u0432\u043E\u0434\u043E\u043F\u043E\u044F \u0441\u043A\u043E\u0442
          \u043F\u044C\u0451\u0442 \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u043E,
          \u043D\u0435 \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u044F \u0433\u043E\u043B\u043E\u0432\u044B.
          \u0412\u043E\u0434\u0430 \u0438\u0434\u0451\u0442 \u043F\u043E \u0440\u0443\u0441\u043B\u0443
          \u0442\u0430\u043A \u043F\u0440\u0438\u0432\u044B\u0447\u043D\u043E, \u0447\u0442\u043E
          \u043D\u0430 \u043D\u0435\u0451 \u043D\u0438\u043A\u0442\u043E \u0443\u0436\u0435
          \u0438 \u043D\u0435 \u0441\u043C\u043E\u0442\u0440\u0438\u0442 \u2014 \u043D\u0430
          \u043D\u0435\u0451 \u0432\u043E\u043E\u0431\u0449\u0435 \u0441\u043C\u043E\u0442\u0440\u044F\u0442,
          \u0442\u043E\u043B\u044C\u043A\u043E \u043A\u043E\u0433\u0434\u0430 \u0447\u0442\u043E-\u0442\u043E
          \u043D\u0435 \u0442\u0430\u043A."
        conditions:
          Combinator: 0
          Conditions: []
        hasPassiveCheck: 0
        passiveCheck:
          CheckId: 
          Kind: 0
          Quality: 0
          CompetencyId: 
          Difficulty: 13
          ModifierRules: []
        onRevealEffects: []
      choices:
      - text: "\u041E\u0442\u043D\u0435\u0441\u0442\u0438 \u0445\u043B\u0435\u0431
          \u043A \u0437\u0430\u0442\u0432\u043E\u0440\u0443."
        nextNodeId: 
